+    <p v-else-if="!shown.length" class="text-sm text-n-slate-11">Nothing matches "{{ query }}".</p>
+    <div v-else class="overflow-x-auto border rounded-xl border-n-weak">
+      <table class="w-full text-sm border-collapse">
