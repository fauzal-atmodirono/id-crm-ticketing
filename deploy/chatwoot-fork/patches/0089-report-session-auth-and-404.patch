From: Proton CRM <noreply@proton.local>
Subject: [PATCH] Reports: weekly download sends the session; AI performance
 and role scope hide on a backend without them (final review I4, I5, M4)

* protonMetrics.js: protonBackendHeaders() is the one header builder for
  /metrics/* (shared key + Chatwoot session triplet). The weekly report's
  PDF/Excel download used x-api-key only and 401'd with
  DATA_SCOPED_RBAC_ENABLED on; it now sends the same headers.
* ProtonAiPerformanceSection (0083) and ProtonRoleScopeEditor (0084): a 404
  (Wave 1 backend, route absent) hides the section/card instead of a red
  error box, like 0069 and 0085 do.
* ProtonRoleScopeEditor: the Inboxes/Teams pickers are <div>s, not <label>s
  wrapping <button> chips.

---
diff --git a/app/javascript/dashboard/api/protonMetrics.js b/app/javascript/dashboard/api/protonMetrics.js
index 3bc342a..d4eaf7f 100644
--- a/app/javascript/dashboard/api/protonMetrics.js
+++ b/app/javascript/dashboard/api/protonMetrics.js
@@ -13,23 +13,34 @@ import Auth from './auth';
 // DATA_SCOPED_RBAC_ENABLED on the backend can narrow each report to the
 // viewer's scope (a 403 then means "not available within your scope"). With
 // the flag off the backend ignores these headers.
+//
+// Patch 0089 (review I4): the headers live in protonBackendHeaders() so a
+// caller that needs the raw response (the weekly report's PDF/Excel
+// download, which reads a blob, not JSON) sends exactly the same auth.
+// Sending only x-api-key there made the export 401 once
+// DATA_SCOPED_RBAC_ENABLED was on.
+export function protonBackendHeaders() {
+  const { backendKey } = useProtonConfig();
+  const authData = Auth.hasAuthCookie() ? Auth.getAuthData() : null;
+  return {
+    'Content-Type': 'application/json',
+    ...(backendKey ? { 'x-api-key': backendKey } : {}),
+    ...(authData
+      ? {
+          'x-chatwoot-access-token': authData['access-token'],
+          'x-chatwoot-client': authData.client,
+          'x-chatwoot-uid': authData.uid,
+        }
+      : {}),
+  };
+}
+
 async function metricsRequest(path) {
-  const { backendUrl, backendKey } = useProtonConfig();
+  const { backendUrl } = useProtonConfig();
   if (!backendUrl) throw new Error('PROTON_BACKEND_URL not configured');
 
-  const authData = Auth.hasAuthCookie() ? Auth.getAuthData() : null;
   const response = await fetch(`${backendUrl}${path}`, {
-    headers: {
-      'Content-Type': 'application/json',
-      ...(backendKey ? { 'x-api-key': backendKey } : {}),
-      ...(authData
-        ? {
-            'x-chatwoot-access-token': authData['access-token'],
-            'x-chatwoot-client': authData.client,
-            'x-chatwoot-uid': authData.uid,
-          }
-        : {}),
-    },
+    headers: protonBackendHeaders(),
   });
 
   if (!response.ok) {
