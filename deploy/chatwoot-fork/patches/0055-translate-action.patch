+    // Task 3 (P7): translate the latest customer message into English.
+    // POST /assist/translate posts the result directly into the
+    // conversation as a private note (translate_router.py) -- there is no
+    // reply/note text for this panel to insert, so this stays a separate
+    // method rather than folding into PROTON_ACTIONS/handleCopilotAction
+    // above, which both assume exactly that: text to insert somewhere.
+    const translating = ref(false);
+    const handleTranslateLastCustomerMessage = async () => {
+      if (!protonEnabled.value || translating.value) return;
+      const chat = store.getters.getSelectedChat;
+      const lastCustomerMessage = [...(chat?.messages || [])]
+        .reverse()
+        .find(m => m.content && m.message_type === 0);
+      // FIX-21: with text in the composer, translate that draft into the
+      // picked language; otherwise translate the customer's last message
+      // (English unless the agent picked another language).
+      const draftText = (props.editorContent || '').trim();
+      const target = translateTarget.value;
+      if (!draftText && !lastCustomerMessage) {
+        useAlert('No customer message to translate yet.');
+        return;
+      }
+      translating.value = true;
+      try {
+        const result = await callAssist('translate', {
+          conversation_id: String(props.conversationId),
+          text: draftText || lastCustomerMessage.content,
+          target_language: target,
+        });
+        if (result.disabled) {
+          useAlert('Translation is not enabled on this account.');
+        } else {
+          useAlert(
+            `Translated (${result.detected_source_language} → ${target}) and posted as a private note.`
+          );
+        }
+      } catch (err) {
+        // eslint-disable-next-line no-console
+        console.error('[proton-assist]', 'translate', 'failed', err);
+        // Outbound Tamil is refused (403) until its evaluation is signed off.
+        useAlert(
+          String(err?.message).includes(' 403 ')
+            ? 'Translating into Tamil is not enabled yet.'
+            : 'Translation failed. Please try again.'
+        );
+      } finally {
+        translating.value = false;
+      }
+    };
+
+    // FIX-21: language picker. codes match the backend's allow-list.
+    const TRANSLATE_LANGUAGES = [
+      { code: 'en', label: 'English' },
+      { code: 'ms', label: 'Bahasa Malaysia' },
+      { code: 'zh', label: '中文' },
+      { code: 'ta', label: 'தமிழ்' },
+    ];
+    const translateTarget = ref('en');
+    const showTranslateMenu = ref(false);
+    const pickTranslateLanguage = code => {
+      translateTarget.value = code;
+      showTranslateMenu.value = false;
+      handleTranslateLastCustomerMessage();
+    };
+
