          "event": "noMatch",
          "next": "hours_weekday_open"
        },
        {
          "event": "match",
          "next": "hours_weekend_open",
          "conditions": [
            {
              "friendly_name": "Sat or Sun",
              "arguments": [
                "{{ 'now' | date: '%s' | plus: 28800 | divided_by: 86400 | plus: 4 | modulo: 7 }}"
              ],
              "type": "matches_any_of",
              "value": "0,6"
            }
          ]
        }
      ],
      "properties": {
        "input": "{{ 'now' | date: '%s' | plus: 28800 | divided_by: 86400 | plus: 4 | modulo: 7 }}",
        "offset": {
          "x": 0,
          "y": 420
        }
      }
    },
