       label: t('SIDEBAR.CONTACTS'),
diff --git a/app/javascript/dashboard/components/widgets/ProtonCasesTable.vue b/app/javascript/dashboard/components/widgets/ProtonCasesTable.vue
new file mode 100644
index 0000000..84a98b2
--- /dev/null
+++ b/app/javascript/dashboard/components/widgets/ProtonCasesTable.vue
@@ -0,0 +1,260 @@
+<!-- ProtonCasesTable.vue — OUR file. The filterable Cases table itself,
+     deliberately separate from ProtonCasesPage.vue (which owns fetching) so
+     Package E's reporting pages can drop this component onto their own
+     already-loaded case rows instead of building a second table. Takes the
+     already-mapped rows from protonCases.js's `mapConversationToCaseRow`
+     (id, caseType, division, concern, purchasedFrom, escalatedTo, dealer,
+     carPlate, agingDays, status, channel) — it does no Chatwoot API calls of
+     its own. Columns and filters are the client's own WIP-table shape (see
+     the Package D design doc): Case ID, Division, Concern, Purchased From,
+     Escalated To, Car Plate, Aging (days), Status; filterable by division,
+     case type, status, channel, dealer.
+
+     Legacy conversations are the normal case: any of the above fields may
+     be null (see protonCases.js's field-provenance comment for why), so
+     every cell falls back to an em dash rather than rendering
+     null/undefined/NaN — the same '—' convention ProtonWipAgingSection.vue
+     and ProtonDealerEscalationSection.vue already use for this. -->
+<script>
+import { frontendURL, conversationUrl } from 'dashboard/helper/URLHelper.js';
+
+const ALL = 'all';
+
+// Builds ["all", ...sorted unique non-null values of `key` across `cases`].
+function filterOptions(cases, key) {
+  const values = new Set();
+  cases.forEach(row => {
+    if (row[key]) values.add(row[key]);
+  });
+  return [ALL, ...Array.from(values).sort((a, b) => a.localeCompare(b))];
+}
+
+export default {
+  name: 'ProtonCasesTable',
+  props: {
+    cases: {
+      type: Array,
+      default: () => [],
+    },
+  },
+  data() {
+    return {
+      divisionFilter: ALL,
+      caseTypeFilter: ALL,
+      statusFilter: ALL,
+      channelFilter: ALL,
+      dealerFilter: ALL,
+    };
+  },
+  computed: {
+    divisionOptions() {
+      return filterOptions(this.cases, 'division');
+    },
+    caseTypeOptions() {
+      return filterOptions(this.cases, 'caseType');
+    },
+    statusOptions() {
+      return filterOptions(this.cases, 'status');
+    },
+    channelOptions() {
+      return filterOptions(this.cases, 'channel');
+    },
+    dealerOptions() {
+      return filterOptions(this.cases, 'dealer');
+    },
+    filteredCases() {
+      return this.cases.filter(row => {
+        if (
+          this.divisionFilter !== ALL &&
+          row.division !== this.divisionFilter
+        ) {
+          return false;
+        }
+        if (
+          this.caseTypeFilter !== ALL &&
+          row.caseType !== this.caseTypeFilter
+        ) {
+          return false;
+        }
+        if (this.statusFilter !== ALL && row.status !== this.statusFilter) {
+          return false;
+        }
+        if (this.channelFilter !== ALL && row.channel !== this.channelFilter) {
+          return false;
+        }
+        if (this.dealerFilter !== ALL && row.dealer !== this.dealerFilter) {
+          return false;
+        }
+        return true;
+      });
+    },
+  },
+  methods: {
+    resetFilters() {
+      this.divisionFilter = ALL;
+      this.caseTypeFilter = ALL;
+      this.statusFilter = ALL;
+      this.channelFilter = ALL;
+      this.dealerFilter = ALL;
+    },
+    conversationLink(row) {
+      return frontendURL(
+        conversationUrl({
+          accountId: this.$route.params.accountId,
+          id: row.id,
+        })
+      );
+    },
+  },
+};
+</script>
+
+<template>
+  <div>
+    <!-- Filters -->
+    <div class="flex flex-wrap items-end gap-3 mb-4">
+      <div>
+        <label class="block mb-1 text-xs text-n-slate-11">Division</label>
+        <select
+          v-model="divisionFilter"
+          class="px-3 py-2 text-sm border rounded-lg border-n-weak bg-n-alpha-black2 text-n-slate-12"
+        >
+          <option
+            v-for="option in divisionOptions"
+            :key="option"
+            :value="option"
+          >
+            {{ option === 'all' ? 'All divisions' : option }}
+          </option>
+        </select>
+      </div>
+      <div>
+        <label class="block mb-1 text-xs text-n-slate-11">Case type</label>
+        <select
+          v-model="caseTypeFilter"
+          class="px-3 py-2 text-sm border rounded-lg border-n-weak bg-n-alpha-black2 text-n-slate-12"
+        >
+          <option
+            v-for="option in caseTypeOptions"
+            :key="option"
+            :value="option"
+          >
+            {{ option === 'all' ? 'All case types' : option }}
+          </option>
+        </select>
+      </div>
+      <div>
+        <label class="block mb-1 text-xs text-n-slate-11">Status</label>
+        <select
+          v-model="statusFilter"
+          class="px-3 py-2 text-sm border rounded-lg border-n-weak bg-n-alpha-black2 text-n-slate-12"
+        >
+          <option v-for="option in statusOptions" :key="option" :value="option">
+            {{ option === 'all' ? 'All statuses' : option }}
+          </option>
+        </select>
+      </div>
+      <div>
+        <label class="block mb-1 text-xs text-n-slate-11">Channel</label>
+        <select
+          v-model="channelFilter"
+          class="px-3 py-2 text-sm border rounded-lg border-n-weak bg-n-alpha-black2 text-n-slate-12"
+        >
+          <option
+            v-for="option in channelOptions"
+            :key="option"
+            :value="option"
+          >
+            {{ option === 'all' ? 'All channels' : option }}
+          </option>
+        </select>
+      </div>
+      <div>
+        <label class="block mb-1 text-xs text-n-slate-11">Dealer</label>
+        <select
+          v-model="dealerFilter"
+          class="px-3 py-2 text-sm border rounded-lg border-n-weak bg-n-alpha-black2 text-n-slate-12"
+        >
+          <option v-for="option in dealerOptions" :key="option" :value="option">
+            {{ option === 'all' ? 'All dealers' : option }}
+          </option>
+        </select>
+      </div>
+      <button
+        type="button"
+        class="px-3 py-2 text-sm text-n-slate-11 hover:underline"
+        @click="resetFilters"
+      >
+        Reset filters
+      </button>
+      <span class="ml-auto text-sm text-n-slate-11">
+        {{ filteredCases.length }} of {{ cases.length }} cases
+      </span>
+    </div>
+
+    <!-- Table -->
+    <p v-if="!cases.length" class="text-sm text-n-slate-11">No cases found.</p>
+    <p v-else-if="!filteredCases.length" class="text-sm text-n-slate-11">
+      No cases match the selected filters.
+    </p>
+    <div v-else class="overflow-x-auto border rounded-lg border-n-weak">
+      <table class="w-full text-sm border-collapse text-n-slate-11">
+        <thead>
+          <tr class="text-left border-b border-n-weak text-n-slate-12">
+            <th class="px-3 py-2 font-medium whitespace-nowrap">Case ID</th>
+            <th class="px-3 py-2 font-medium whitespace-nowrap">Division</th>
+            <th class="px-3 py-2 font-medium whitespace-nowrap">Concern</th>
+            <th class="px-3 py-2 font-medium whitespace-nowrap">
+              Purchased From
+            </th>
+            <th class="px-3 py-2 font-medium whitespace-nowrap">
+              Escalated To
+            </th>
+            <th class="px-3 py-2 font-medium whitespace-nowrap">Car Plate</th>
+            <th class="px-3 py-2 font-medium whitespace-nowrap text-right">
+              Aging (days)
+            </th>
+            <th class="px-3 py-2 font-medium whitespace-nowrap">Status</th>
+          </tr>
+        </thead>
+        <tbody>
+          <tr
+            v-for="row in filteredCases"
+            :key="row.id"
+            class="border-b border-n-weak last:border-b-0"
+          >
+            <td class="px-3 py-2 whitespace-nowrap">
+              <router-link
+                :to="conversationLink(row)"
+                class="font-medium text-n-brand hover:underline"
+              >
+                #{{ row.id }}
+              </router-link>
+            </td>
+            <td class="px-3 py-2 whitespace-nowrap">
+              {{ row.division ?? '—' }}
+            </td>
+            <td class="px-3 py-2 whitespace-nowrap">
+              {{ row.concern ?? '—' }}
+            </td>
+            <td class="px-3 py-2 whitespace-nowrap">
+              {{ row.purchasedFrom ?? '—' }}
+            </td>
+            <td class="px-3 py-2 whitespace-nowrap">
+              {{ row.escalatedTo ?? '—' }}
+            </td>
+            <td class="px-3 py-2 whitespace-nowrap">
+              {{ row.carPlate ?? '—' }}
+            </td>
+            <td class="px-3 py-2 text-right whitespace-nowrap tabular-nums">
+              {{ row.agingDays ?? '—' }}
+            </td>
+            <td class="px-3 py-2 capitalize whitespace-nowrap">
+              {{ row.status ?? '—' }}
+            </td>
+          </tr>
+        </tbody>
+      </table>
+    </div>
+  </div>
+</template>
