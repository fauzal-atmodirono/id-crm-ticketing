+<!-- ProtonRsaPage.vue — OUR file. Standalone roadside-assistance (RSA)
+     incident-log entry/report page. Three stacked sections sharing one page
+     shell: (a) an aggregate summary (cases by cause, cases by dealer, from
+     GET /rsa/incidents/aggregate), (b) a data-entry form that POSTs a new
+     incident, and (c) a table of existing incidents with per-row inline edit
+     (PATCH) and delete. Manual staff data entry only — no dispatch-system
+     integration. Mirrors ProtonSlaPoliciesPage.vue's shell (header, n-* tokens,
+     useAlert toasts). Field names match Task 20's _IncidentRequest exactly. -->
+<script>
+import { useAlert } from 'dashboard/composables';
+import {
+  listRsaIncidents,
+  getRsaAggregate,
+  createRsaIncident,
+  updateRsaIncident,
+  deleteRsaIncident,
+} from 'dashboard/api/protonRsa';
+
+// The editable fields, in deck-column order. Kept as one list so the create
+// form, the inline-edit row, and the payload builder all stay in lockstep.
+const EMPTY_FORM = {
+  incident_date: '',
+  vehicle_no: '',
+  vehicle_model: '',
+  cause: '',
+  purchased_from: '',
+  breakdown_location: '',
+  arrived_location: '',
+  customer_called_in_time: '',
+  towing_assigned_time: '',
+  time_arrived_breakdown_area: '',
+  time_arrived_outlet: '',
+  total_km: null,
+  late_reason: '',
+  remarks: '',
+};
+
+// datetime-local inputs want a 'YYYY-MM-DDTHH:mm' string; backend returns ISO
+// (possibly with seconds/offset), so slice for display and drop empties on send.
+function toLocalInput(value) {
+  return value ? String(value).slice(0, 16) : '';
+}
+
+export default {
+  name: 'ProtonRsaPage',
+  data() {
+    return {
+      aggregate: { by_cause: [], by_dealer: [] },
+      incidents: [],
+      form: { ...EMPTY_FORM },
+      editingId: null,
+      editForm: { ...EMPTY_FORM },
+      loading: true,
+      errored: false,
+      saving: false,
+    };
+  },
+  async mounted() {
+    await this.load();
+  },
+  methods: {
+    // Empty strings mean "unset" — convert them to null so the backend's
+    // Optional[...] fields (and PATCH's "skip null" filter) behave correctly.
+    buildPayload(source) {
+      const payload = {};
+      Object.keys(EMPTY_FORM).forEach(key => {
+        const value = source[key];
+        payload[key] = value === '' || value === undefined ? null : value;
+      });
+      return payload;
+    },
+    async load() {
+      this.loading = true;
+      this.errored = false;
+      try {
+        const [incidents, aggregate] = await Promise.all([
+          listRsaIncidents(),
+          getRsaAggregate(),
+        ]);
+        this.incidents = incidents;
+        this.aggregate = {
+          by_cause: Array.isArray(aggregate.by_cause) ? aggregate.by_cause : [],
+          by_dealer: Array.isArray(aggregate.by_dealer)
+            ? aggregate.by_dealer
+            : [],
+        };
+      } catch (err) {
+        this.errored = true;
+        useAlert(
+          'Failed to load RSA incidents: ' + (err.message || String(err))
+        );
+      } finally {
+        this.loading = false;
+      }
+    },
+    async create() {
+      this.saving = true;
+      try {
+        await createRsaIncident(this.buildPayload(this.form));
+        useAlert('Incident logged.');
+        this.form = { ...EMPTY_FORM };
+        await this.load();
+      } catch (err) {
+        useAlert('Failed to log incident: ' + (err.message || String(err)));
+      } finally {
+        this.saving = false;
+      }
+    },
+    startEdit(incident) {
+      this.editingId = incident.id;
+      this.editForm = {
+        ...EMPTY_FORM,
+        ...incident,
+        total_km: incident.total_km ?? null,
+        customer_called_in_time: toLocalInput(incident.customer_called_in_time),
+        towing_assigned_time: toLocalInput(incident.towing_assigned_time),
+        time_arrived_breakdown_area: toLocalInput(
+          incident.time_arrived_breakdown_area
+        ),
+        time_arrived_outlet: toLocalInput(incident.time_arrived_outlet),
+      };
+    },
+    cancelEdit() {
+      this.editingId = null;
+      this.editForm = { ...EMPTY_FORM };
+    },
+    async saveEdit(id) {
+      this.saving = true;
+      try {
+        await updateRsaIncident(id, this.buildPayload(this.editForm));
+        useAlert('Incident updated.');
+        this.cancelEdit();
+        await this.load();
+      } catch (err) {
+        useAlert('Failed to update incident: ' + (err.message || String(err)));
+      } finally {
+        this.saving = false;
+      }
+    },
+    async remove(id) {
+      // eslint-disable-next-line no-alert
+      if (!window.confirm('Delete this incident? This cannot be undone.')) {
+        return;
+      }
+      this.saving = true;
+      try {
+        await deleteRsaIncident(id);
+        useAlert('Incident deleted.');
+        if (this.editingId === id) this.cancelEdit();
+        await this.load();
+      } catch (err) {
+        useAlert('Failed to delete incident: ' + (err.message || String(err)));
+      } finally {
+        this.saving = false;
+      }
+    },
+  },
+};
