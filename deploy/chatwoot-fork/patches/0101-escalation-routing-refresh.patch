+const editing = ref(null);
+
+const shown = computed(() =>
+  props.dealers.filter(d => matches(query.value, d.dealer, d.region, ...dealerMembers(d), ...Object.values(d.contacts || {})))
+);
+
+function hasLadder(d) {
+  return Boolean(d.contacts && Object.keys(d.contacts).length);
+}
+function membersText(d) {
