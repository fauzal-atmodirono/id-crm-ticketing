     body: { chatwoot_user_id: chatwootUserId },
   });
 }
+
+// ── Escalation routing (department PICs + dealer contacts) ─────────────────
+// Backs pic_admin_router.py — PUT is upsert-by-key (department/dealer live
+// in the URL path, not the body), there is no separate POST.
+
+export async function listPics() {
+  const data = await adminRequest('/admin/escalation/pics');
+  return Array.isArray(data.pics) ? data.pics : [];
+}
+
+export function upsertPic(department, body) {
+  return adminRequest(`/admin/escalation/pics/${encodeURIComponent(department)}`, {
+    method: 'PUT',
+    body,
+  });
+}
+
+export function deletePic(department) {
+  return adminRequest(`/admin/escalation/pics/${encodeURIComponent(department)}`, {
+    method: 'DELETE',
+  });
+}
+
+export async function listDealers() {
+  const data = await adminRequest('/admin/escalation/dealers');
+  return Array.isArray(data.dealers) ? data.dealers : [];
+}
+
+export function upsertDealer(dealer, body) {
+  return adminRequest(`/admin/escalation/dealers/${encodeURIComponent(dealer)}`, {
+    method: 'PUT',
+    body,
+  });
+}
+
+export function deleteDealer(dealer) {
+  return adminRequest(`/admin/escalation/dealers/${encodeURIComponent(dealer)}`, {
+    method: 'DELETE',
+  });
+}
