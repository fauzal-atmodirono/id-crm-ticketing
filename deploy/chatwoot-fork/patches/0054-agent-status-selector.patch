+// ── Availability statuses (the My status page) ───────────────────────────
+// Backs status_router.py. getPresenceStatuses is the catalogue an agent picks
+// from, gated by `presence.set_own_status` -- the one permission the default
+// Agent role carries, because choosing your own availability is an agent's
+// own job. upsertPresenceStatus edits the catalogue and is gated by
+// `workforce.manage` (administrators only).
+//
+// setMyPresenceStatus deliberately sends NO agent_id: with RBAC on the
+// backend resolves the caller from the same Chatwoot session triplet
+// adminRequest already forwards, so this page cannot ask to change a
+// colleague's status even by mistake. Setting someone else's requires
+// `workforce.manage` and is not offered anywhere in this UI.
+
+export function getPresenceStatuses() {
+  return adminRequest('/routing/presence/statuses');
+}
+
+export function getMyPresenceStatus() {
+  return adminRequest('/routing/presence/status');
+}
+
+export function setMyPresenceStatus(key) {
+  return adminRequest('/routing/presence/status', {
+    method: 'POST',
+    body: { key },
+  });
+}
+
+export function upsertPresenceStatus(key, entry) {
+  return adminRequest(`/routing/presence/statuses/${key}`, {
+    method: 'PUT',
+    body: entry,
+  });
+}
