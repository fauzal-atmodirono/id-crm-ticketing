@@ -74,7 +80,20 @@ export default {
       }
     },
 
+    // Primary is always first in the priority list, so a channel that is
+    // primary is implicitly handled and must not also appear as an extra --
+    // the backend de-duplicates on save anyway, and showing it selected in
+    // both places reads as a double-count.
+    orderedFor(row) {
+      return [row.primary, ...row.also.filter(c => c !== row.primary)].filter(Boolean);
+    },
+
+    isDirty(row) {
+      return this.orderedFor(row).join(',') !== row.saved;
+    },
+
     toggleAlso(row, channel) {
+      row.justSaved = false;
       if (row.also.includes(channel)) {
         row.also = row.also.filter(c => c !== channel);
