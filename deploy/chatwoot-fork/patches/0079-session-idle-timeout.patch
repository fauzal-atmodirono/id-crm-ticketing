diff --git a/app/javascript/dashboard/composables/idleMonitor.js b/app/javascript/dashboard/composables/idleMonitor.js
new file mode 100644
index 0000000..7ee2c0f
--- /dev/null
+++ b/app/javascript/dashboard/composables/idleMonitor.js
@@ -0,0 +1,56 @@
+// Pure idle-timeout monitor (FIX-18, patch 0079). No imports and no globals,
+// so it can be unit-tested under plain node: every side effect (clock, timers,
+// shared storage, the logout itself) is injected.
+//
+// Activity is shared across tabs through `storage` (localStorage in the SPA):
+// a user active in tab B must not be logged out because tab A saw no input.
+// Reading the shared stamp on every check is the whole cross-tab mechanism.
+export const ACTIVITY_KEY = 'proton_last_activity_ms';
+const CHECK_EVERY_MS = 15000;
+
+export function createIdleMonitor({
+  timeoutMinutes,
+  now = () => Date.now(),
+  storage = null,
+  onIdle,
+  setIntervalFn = setInterval,
+  clearIntervalFn = clearInterval,
+}) {
+  const timeoutMs = Number(timeoutMinutes) * 60 * 1000;
+  // Off unless a positive number of minutes was configured.
+  if (!Number.isFinite(timeoutMs) || timeoutMs <= 0) {
+    return { enabled: false, touch() {}, check: () => false, stop() {} };
+  }
+
+  let last = now();
+  let fired = false;
+  const read = () => {
+    try {
+      const v = Number(storage && storage.getItem(ACTIVITY_KEY));
+      return Number.isFinite(v) && v > 0 ? v : 0;
+    } catch (e) {
+      return 0;
+    }
+  };
+  const touch = () => {
+    last = now();
+    try {
+      if (storage) storage.setItem(ACTIVITY_KEY, String(last));
+    } catch (e) {
+      /* storage blocked: per-tab tracking still works */
+    }
+  };
+  const check = () => {
+    if (fired) return false;
+    const latest = Math.max(last, read());
+    if (now() - latest >= timeoutMs) {
+      fired = true; // fire once; the logout navigates away
+      onIdle();
+      return true;
+    }
+    return false;
+  };
+  touch();
+  const timer = setIntervalFn(check, CHECK_EVERY_MS);
+  return { enabled: true, touch, check, stop: () => clearIntervalFn(timer) };
+}
