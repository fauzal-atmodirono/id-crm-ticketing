@@ -0,0 +1,122 @@
+<script setup>
+// ProtonCallRecordingPanel.vue — OUR file (patch 0094). Plays a call's
+// archived recording inside the conversation sidebar: the conversation's
+// LATEST call (patch 0095 puts a player for every call inside its own
+// archive note in the timeline).
+//
+// The fetch / signed link / refresh-on-expiry / transcript / re-transcribe
+// logic is the shared useProtonCallRecording composable (see its header).
+//
+// Hidden unless the backend says a recording is available (or was deleted by
+// retention): no permission (403), feature off (404), not configured (503) or
+// any other failure all render nothing. Only asks for conversations the
+// backend marked as recorded calls, so ordinary chats cost no request.
+import { computed, watch } from 'vue';
+import { useMapGetter } from 'dashboard/composables/store';
+import { useProtonCallRecording } from 'dashboard/components/proton/useProtonCallRecording.js';
+
+const props = defineProps({
+  conversationId: {
+    type: [Number, String],
+    required: true,
+  },
+});
+
+const currentChat = useMapGetter('getSelectedChat');
+const attrs = computed(() => currentChat.value?.custom_attributes || {});
+// Written by the backend on every recorded call and voicemail
+// (set_call_recording / set_call_recording_archive).
+const isRecordedCall = computed(
+  () =>
+    !!(
+      attrs.value.call_recording_object ||
+      attrs.value.recording_sid ||
+      attrs.value.recording_url
+    )
+);
+
+const {
+  state,
+  playUrl,
+  transcriptUrl,
+  transcriptText,
+  transcriptOpen,
+  canRetranscribe,
+  message,
+  busy,
+  audioEl,
+  reset,
+  load,
+  onPlay,
+  onError,
+  toggleTranscript,
+  retranscribe,
+} = useProtonCallRecording({ conversationId: () => props.conversationId });
+
+watch(
+  () => [
+    props.conversationId,
+    isRecordedCall.value,
+    attrs.value.call_recording_object,
+  ],
+  () => {
+    reset();
+    if (isRecordedCall.value) load();
+  },
+  { immediate: true }
+);
+</script>
+
+<template>
+  <div
+    v-if="state === 'available' || state === 'deleted'"
+    class="px-2 pt-2"
+    data-proton-call-recording
+  >
+    <div
+      class="flex flex-col gap-2 p-3 border rounded-xl border-n-weak bg-n-alpha-1"
+    >
+      <div class="text-sm font-medium text-n-slate-12">Call recording</div>
+      <p v-if="state === 'deleted'" class="text-xs text-n-slate-11">
+        This recording was deleted under the retention policy.
+      </p>
+      <template v-else>
+        <audio
+          ref="audioEl"
+          controls
+          preload="none"
+          controlslist="nodownload"
+          class="w-full"
+          :src="playUrl"
+          @play="onPlay"
+          @error="onError"
+        />
+        <div class="flex items-center gap-3 text-xs">
+          <button
+            v-if="transcriptUrl"
+            type="button"
+            class="text-n-brand hover:underline"
+            @click="toggleTranscript"
+          >
+            {{ transcriptOpen ? 'Hide transcript' : 'Transcript' }}
+          </button>
+          <button
+            v-if="canRetranscribe"
+            type="button"
+            class="text-n-brand hover:underline disabled:opacity-50"
+            :disabled="busy"
+            @click="retranscribe"
+          >
+            Re-transcribe
+          </button>
+        </div>
+        <pre
+          v-if="transcriptOpen"
+          class="max-h-64 overflow-y-auto whitespace-pre-wrap text-xs text-n-slate-12 bg-n-background rounded-lg p-2 border border-n-weak"
+          >{{ transcriptText }}</pre
+        >
+        <p v-if="message" class="text-xs text-n-slate-11">{{ message }}</p>
+      </template>
+    </div>
+  </div>
+</template>
diff --git a/app/javascript/dashboard/components/proton/useProtonCallRecording.js b/app/javascript/dashboard/components/proton/useProtonCallRecording.js
new file mode 100644
index 0000000..2b52b84
--- /dev/null
+++ b/app/javascript/dashboard/components/proton/useProtonCallRecording.js
@@ -0,0 +1,221 @@
+// useProtonCallRecording.js — OUR file (patch 0094, shared with 0095).
+//
+// Everything a call-recording player needs from the backend
+// (features/chat/phone/recording_router.py), used by the sidebar panel
+// (ProtonCallRecordingPanel.vue: the conversation's latest call) and by the
+// in-note player (ProtonCallNoteBubble.vue, patch 0095: one archive note's
+// call, `?message_id=`).
+//
+// The backend checks `call_recording.listen` + the caller's data scope and
+// answers with a short-lived signed BACKEND link. An <audio> element cannot
+// send the Chatwoot session headers adminRequest adds, which is why the link
+// carries its own (<= 5 minute) credential and why this re-mints it when it
+// has expired instead of letting the player fail -- keeping the listener's
+// position.
+//
+// Each minted link is one audit row on first play; re-minting after expiry
+// starts a new link (and a new row). The transcript is fetched with its token
+// in a header and shown inline, so that token never sits in a URL or history.
+//
+// Nothing here runs on its own: callers decide when to `load()` (the panel on
+// open, the note bubble only when the agent presses a control).
+import { ref, nextTick } from 'vue';
+import { useProtonConfig } from 'dashboard/composables/useProtonConfig';
+import { adminRequest } from 'dashboard/api/protonAdmin';
+
+// Must match recording_access.ARCHIVE_NOTE_HEADER in the backend.
+const ARCHIVE_NOTE_HEADER = '[Call archived to Cloud Storage]';
+
+// Re-mint this long before the link's real expiry, so a click never races it.
+const EXPIRY_MARGIN_MS = 30000;
+
+export function isProtonCallArchiveNote(content) {
+  return (
+    typeof content === 'string' &&
+    content.trimStart().startsWith(ARCHIVE_NOTE_HEADER)
+  );
+}
+
+function absolute(path) {
+  if (!path) return '';
+  if (!path.startsWith('/')) return path;
+  const { backendUrl } = useProtonConfig();
+  return `${backendUrl || ''}${path}`;
+}
+
+// The backend puts the 429's wait (also its Retry-After header) in the body,
+// which is what adminRequest keeps on the error as `detail`.
+function retryMinutes(error) {
+  try {
+    const seconds = Number(
+      JSON.parse(error?.detail || '{}')?.detail?.retry_after_seconds
+    );
+    return seconds > 0 ? Math.ceil(seconds / 60) : null;
+  } catch (e) {
+    return null;
+  }
+}
+
+/**
+ * @param {{ conversationId: () => (number|string), messageId?: () => (number|string|null) }} opts
+ */
+export function useProtonCallRecording({ conversationId, messageId = () => null }) {
+  // idle (not asked yet) | available | deleted | unavailable (403/404/503/...)
+  const state = ref('idle');
+  const playUrl = ref('');
+  const transcriptUrl = ref('');
+  const transcriptToken = ref('');
+  const transcriptText = ref('');
+  const transcriptOpen = ref(false);
+  const canRetranscribe = ref(false);
+  const expiresAtMs = ref(0);
+  const message = ref('');
+  const busy = ref(false);
+  const audioEl = ref(null);
+  let requestSeq = 0;
+  let retriedAfterError = false;
+
+  function recordingPath() {
+    return `/calls/${encodeURIComponent(conversationId())}/recording`;
+  }
+
+  function noteQuery() {
+    const m = messageId();
+    return m ? `?message_id=${encodeURIComponent(m)}` : '';
+  }
+
+  function reset() {
+    requestSeq += 1;
+    state.value = 'idle';
+    playUrl.value = '';
+    transcriptUrl.value = '';
+    transcriptToken.value = '';
+    transcriptText.value = '';
+    transcriptOpen.value = false;
+    canRetranscribe.value = false;
+    expiresAtMs.value = 0;
+    message.value = '';
+  }
+
+  async function load() {
+    const mine = ++requestSeq;
+    message.value = '';
+    busy.value = true;
+    try {
+      const res = await adminRequest(`${recordingPath()}${noteQuery()}`);
+      if (mine !== requestSeq) return;
+      if (res?.status === 'available' && res.play_url) {
+        playUrl.value = absolute(res.play_url);
+        transcriptUrl.value = absolute(res.transcript_url || '');
+        transcriptToken.value = res.transcript_token || '';
+        canRetranscribe.value = !!res.can_retranscribe;
+        expiresAtMs.value = Date.parse(res.expires_at) || 0;
+        retriedAfterError = false;
+        state.value = 'available';
+      } else if (res?.status === 'deleted') {
+        state.value = 'deleted';
+      } else {
+        state.value = 'unavailable';
+      }
+    } catch (e) {
+      // 403 / 404 / 503 / network: no player, never an error banner.
+      if (mine === requestSeq) state.value = 'unavailable';
+    } finally {
+      if (mine === requestSeq) busy.value = false;
+    }
+  }
+
+  function isStale() {
+    return Date.now() > expiresAtMs.value - EXPIRY_MARGIN_MS;
+  }
+
+  // Swap in a fresh link without losing the listener's position.
+  async function remintAndResume(play) {
+    const audio = audioEl.value;
+    const at = audio ? audio.currentTime : 0;
+    await load();
+    await nextTick();
+    const fresh = audioEl.value;
+    if (!fresh || state.value !== 'available') return;
+    fresh.currentTime = at;
+    if (play) fresh.play().catch(() => {});
+  }
+
+  async function onPlay() {
+    if (!isStale()) return;
+    audioEl.value?.pause();
+    await remintAndResume(true);
+  }
+
+  async function onError() {
+    // An expired link mid-listen (a seek after five minutes) — re-mint once.
+    if (retriedAfterError || state.value !== 'available') return;
+    retriedAfterError = true;
+    await remintAndResume(false);
+  }
+
+  async function toggleTranscript() {
+    if (transcriptOpen.value) {
+      transcriptOpen.value = false;
+      return;
+    }
+    if (!transcriptText.value) {
+      if (isStale()) await load();
+      if (!transcriptUrl.value || !transcriptToken.value) return;
+      try {
+        const response = await fetch(transcriptUrl.value, {
+          headers: { 'x-recording-token': transcriptToken.value },
+        });
+        if (!response.ok) throw new Error(String(response.status));
+        transcriptText.value = await response.text();
+      } catch (e) {
+        message.value = 'Could not load the transcript.';
+        return;
+      }
+    }
+    transcriptOpen.value = true;
+  }
+
+  async function retranscribe() {
+    busy.value = true;
+    message.value = '';
+    try {
+      await adminRequest(`${recordingPath()}/retranscribe${noteQuery()}`, {
+        method: 'POST',
+      });
+      message.value =
+        'Re-transcription queued. The new transcript will appear as a private note shortly.';
+    } catch (e) {
+      if (e?.status === 429) {
+        const minutes = retryMinutes(e);
+        message.value = minutes
+          ? `Re-transcribe limit reached — try again in ${minutes} min`
+          : 'Re-transcribe limit reached — try again later';
+      } else if ([403, 404, 503].includes(e?.status)) {
+        state.value = 'unavailable';
+      } else {
+        message.value = 'Could not start re-transcription.';
+      }
+    } finally {
+      busy.value = false;
+    }
+  }
+
+  return {
+    state,
+    playUrl,
+    transcriptUrl,
+    transcriptText,
+    transcriptOpen,
+    canRetranscribe,
+    message,
+    busy,
+    audioEl,
+    reset,
+    load,
+    onPlay,
+    onError,
+    toggleTranscript,
+    retranscribe,
+  };
+}
