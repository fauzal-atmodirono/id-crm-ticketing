      "name": "Trigger",
      "type": "trigger",
      "transitions": [
        {
          "event": "incomingMessage"
        },
        {
          "event": "incomingCall",
          "next": "split_holiday"
        },
        {
          "event": "incomingConversationMessage"
        },
        {
          "event": "incomingRequest"
        },
        {
          "event": "incomingParent"
        }
      ],
      "properties": {
        "offset": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "name": "split_holiday",
      "type": "split-based-on",
      "transitions": [
        {
          "event": "noMatch",
          "next": "split_dow"
        },
        {
          "event": "match",
          "next": "hours_weekend_open",
          "conditions": [
            {
              "friendly_name": "public holiday",
              "arguments": [
                "{{ 'now' | date: '%s' | plus: 28800 | date: '%Y-%m-%d' }}"
              ],
              "type": "matches_any_of",
              "value": "2026-01-01,2026-02-17,2026-02-18,2026-03-21,2026-03-22,2026-05-01,2026-05-27,2026-05-31,2026-06-01,2026-06-17,2026-08-25,2026-08-31,2026-09-16,2026-11-08,2026-12-25"
            }
          ]
        }
      ],
      "properties": {
        "input": "{{ 'now' | date: '%s' | plus: 28800 | date: '%Y-%m-%d' }}",
        "offset": {
          "x": 0,
          "y": 200
        }
      }
    },
    {
      "name": "split_dow",
      "type": "split-based-on",
      "transitions": [
