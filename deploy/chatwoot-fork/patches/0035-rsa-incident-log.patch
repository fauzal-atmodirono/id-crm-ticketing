+++ b/app/javascript/dashboard/api/protonRsa.js
@@ -0,0 +1,64 @@
+import { useProtonConfig } from 'dashboard/composables/useProtonConfig';
+
+// Thin client for the Proton backend RSA incident-log endpoints
+// (/rsa/incidents*). Auth is the shared PROTON_BACKEND_KEY sent as x-api-key —
+// the RSA router authorizes against faq_admin_api_key / proton_backend_key
+// exactly like the /kb/* and /metrics/* endpoints do (NOT the RBAC
+// require_permission session triplet used by protonAdmin.js's /admin + /authz
+// routes). Errors carry a numeric `.status` so callers can special-case
+// 401/503.
+async function rsaRequest(path, { method = 'GET', body } = {}) {
+  const { backendUrl, backendKey } = useProtonConfig();
+  if (!backendUrl) throw new Error('PROTON_BACKEND_URL not configured');
+
+  const response = await fetch(`${backendUrl}${path}`, {
+    method,
+    headers: {
+      'Content-Type': 'application/json',
+      ...(backendKey ? { 'x-api-key': backendKey } : {}),
+    },
+    ...(body ? { body: JSON.stringify(body) } : {}),
+  });
+
+  if (!response.ok) {
+    const text = await response.text().catch(() => response.statusText);
+    const err = new Error(`${response.status}: ${text.slice(0, 200)}`);
+    err.status = response.status;
+    throw err;
+  }
+  const text = await response.text();
+  return text ? JSON.parse(text) : {};
+}
+
+// GET /rsa/incidents -> [{ id, incident_date, vehicle_no, vehicle_model, cause,
+//   purchased_from, breakdown_location, arrived_location,
+//   customer_called_in_time, towing_assigned_time, time_arrived_breakdown_area,
+//   time_arrived_outlet, total_km, late_reason, remarks, created_by }]
+export async function listRsaIncidents() {
+  const data = await rsaRequest('/rsa/incidents');
+  return Array.isArray(data.incidents) ? data.incidents : [];
+}
+
+// GET /rsa/incidents/aggregate -> { by_cause: [{ cause, count }],
+//   by_dealer: [{ dealer, count }] }
+export function getRsaAggregate() {
+  return rsaRequest('/rsa/incidents/aggregate');
+}
+
+// body: the _IncidentRequest fields (incident_date, vehicle_no, cause required)
+export function createRsaIncident(payload) {
+  return rsaRequest('/rsa/incidents', { method: 'POST', body: payload });
+}
+
+export function updateRsaIncident(id, payload) {
+  return rsaRequest(`/rsa/incidents/${encodeURIComponent(id)}`, {
+    method: 'PATCH',
+    body: payload,
+  });
+}
+
+export function deleteRsaIncident(id) {
+  return rsaRequest(`/rsa/incidents/${encodeURIComponent(id)}`, {
+    method: 'DELETE',
+  });
+}
