diff --git a/app/javascript/dashboard/api/protonCases.js b/app/javascript/dashboard/api/protonCases.js
new file mode 100644
index 0000000..d2e5197
--- /dev/null
+++ b/app/javascript/dashboard/api/protonCases.js
@@ -0,0 +1,179 @@
+// protonCases.js — OUR file. Data access for the Cases list (Package D,
+// Task 5): reads existing Chatwoot conversation data straight off Chatwoot's
+// own `/conversations` endpoint (dashboard/api/inbox/conversation.js).
+// Deliberately NOT routed through the Proton backend — there is no new
+// backend storage or endpoint for this feature, per the task brief, so this
+// file has no useProtonConfig/backendUrl dependency the way protonRsa.js /
+// protonAdmin.js do.
+//
+// Package E's reporting pages should reuse `fetchAllCases` /
+// `mapConversationToCaseRow` here (and `ProtonCasesTable.vue`) rather than
+// re-implementing the pagination / row-mapping logic — that's the seam this
+// task was asked to leave. Note `fetchAllCases` returns an object (`rows` +
+// the truncation fields below), not a bare array — read `.rows`.
+//
+// Field provenance (see backend/apps/backend/src/chatbot/features/metrics/
+// mapping.py and deploy/scripts/seed_demo_data/client.py for what actually
+// writes these — do not invent new attribute names without checking there):
+//   - conversation.custom_attributes.division / .concern / .case_type /
+//     .channel / .dealer — written by the demo seeder (Package D Task 1/2)
+//     directly onto the conversation.
+//   - conversation.custom_attributes.case_category / .case_subcategory —
+//     written by the live AI-classification flow (agent/'s ChatwootAdapter,
+//     read back by mapping.py). Used as a fallback for real conversations
+//     that predate/skip the demo vocabulary above.
+//   - division_<slug> / dealer_<slug> labels — the convention both the demo
+//     seeder and agent/app/services/sync.py write, read back by mapping.py's
+//     _DIVISION_TAG / _DEALER_TAG. Used as a second fallback when neither
+//     custom_attributes field is present.
+//   - conversation.meta.sender.custom_attributes.vehicle_no / .purchased_from
+//     — the *contact's* custom attributes, embedded on every conversation
+//     Chatwoot returns (see client.py's comment on why these aren't
+//     duplicated onto the conversation itself — the Cases list joins
+//     through meta.sender instead).
+//
+// Most existing (legacy) conversations have none of the above. Every
+// accessor here degrades to `null` rather than throwing or producing
+// `undefined`/`NaN` — ProtonCasesTable.vue renders a null field as a blank
+// cell.
+import ConversationApi from 'dashboard/api/inbox/conversation';
+
+const RESULTS_PER_PAGE = 25;
+// Hard cap so a very large real account can't turn one page load into an
+// unbounded number of sequential requests. 40 * 25 = 1000 conversations,
+// comfortably past Package D's ~250-300 seeded demo cases.
+const MAX_PAGES = 40;
+
+function slugToLabel(slug) {
+  if (!slug) return null;
+  return slug
+    .split('_')
+    .filter(Boolean)
+    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
+    .join(' ');
+}
+
+function firstLabelValue(labels, prefix) {
+  if (!Array.isArray(labels)) return null;
+  const match = labels.find(
+    label => typeof label === 'string' && label.startsWith(prefix)
+  );
+  return match ? match.slice(prefix.length) : null;
+}
+
+function blankToNull(value) {
+  if (value === undefined || value === null) return null;
+  if (typeof value === 'string' && value.trim() === '') return null;
+  return value;
+}
+
+// conversation.meta.channel is Chatwoot's own inbox channel_type, e.g.
+// "Channel::Api" / "Channel::Whatsapp" / "Channel::Email". Every demo
+// conversation is created on one API-channel inbox regardless of the
+// "pretend" channel its narrative is demoing, so custom_attributes.channel
+// (when present) always wins; this is only the fallback for real
+// conversations that never got a channel custom attribute.
+function channelFromMeta(meta) {
+  const channelType = meta && meta.channel;
+  if (!channelType || typeof channelType !== 'string') return null;
+  const short = channelType.split('::').pop();
+  return blankToNull(short);
+}
+
+// created_at is unix epoch seconds (see the conversations jbuilder partial).
+// Missing, zero, or unparsable all degrade to a blank "Aging" cell rather
+// than a crash or a negative/NaN number.
+export function agingDaysFromCreatedAt(createdAt) {
+  const seconds = Number(createdAt);
+  if (!createdAt || Number.isNaN(seconds) || seconds <= 0) return null;
+  const days = (Date.now() - seconds * 1000) / (1000 * 60 * 60 * 24);
+  if (Number.isNaN(days)) return null;
+  return Math.max(0, Math.floor(days));
+}
+
+export function mapConversationToCaseRow(conversation) {
+  const customAttributes = conversation.custom_attributes || {};
+  const senderAttributes =
+    (conversation.meta &&
+      conversation.meta.sender &&
+      conversation.meta.sender.custom_attributes) ||
+    {};
+  const labels = conversation.labels || [];
+
+  const division =
+    blankToNull(customAttributes.division) ||
+    slugToLabel(firstLabelValue(labels, 'division_')) ||
+    blankToNull(customAttributes.case_category);
+
+  const concern =
+    blankToNull(customAttributes.concern) ||
+    blankToNull(customAttributes.case_subcategory);
+
+  const dealer =
+    blankToNull(customAttributes.dealer) ||
+    slugToLabel(firstLabelValue(labels, 'dealer_'));
+
+  return {
+    id: conversation.id,
+    caseType: blankToNull(customAttributes.case_type),
+    division,
+    concern,
+    purchasedFrom: blankToNull(senderAttributes.purchased_from),
+    // "Escalated To" and the dealer filter read the same field: in this
+    // client's model, a case escalates to a dealer. Kept as two keys so a
+    // future distinct "escalated to" target (e.g. a PIC/department) can be
+    // introduced without moving the dealer filter's data source.
+    escalatedTo: dealer,
+    dealer,
+    carPlate: blankToNull(senderAttributes.vehicle_no),
+    agingDays: agingDaysFromCreatedAt(conversation.created_at),
+    status: blankToNull(conversation.status),
+    channel:
+      blankToNull(customAttributes.channel) ||
+      channelFromMeta(conversation.meta),
+  };
+}
+
+// Fetches every conversation the current user can see (status=all, across
+// their assigned inboxes — same scoping Chatwoot's own conversation list
+// uses) and maps each to a case row. Paginates sequentially rather than in
+// parallel: page count isn't known up front, and this is a manually
+// triggered admin-page load, not a hot path.
+//
+// Returns { rows, truncated, fetchedCount, totalCount } rather than a bare
+// array. `truncated` is true only when paging stopped *because MAX_PAGES was
+// reached* while Chatwoot reported more conversations than we'd fetched —
+// not for the ordinary case where paging finishes on its own. A silently
+// incomplete Cases list is worse than a bounded one, so the page (not this
+// module) is expected to surface `truncated` to the user rather than just
+// showing "N of N cases" over a partial `rows`.
+export async function fetchAllCases() {
+  const rows = [];
+  let page = 1;
+  let keepGoing = true;
+  let allCount = 0;
+  let hitPageCap = false;
+  while (keepGoing) {
+    if (page > MAX_PAGES) {
+      hitPageCap = true;
+      break;
+    }
+    // eslint-disable-next-line no-await-in-loop
+    const response = await ConversationApi.get({ status: 'all', page });
+    const body = (response && response.data && response.data.data) || {};
+    const payload = Array.isArray(body.payload) ? body.payload : [];
+    payload.forEach(conversation => {
+      rows.push(mapConversationToCaseRow(conversation));
+    });
+    allCount = (body.meta && body.meta.all_count) || 0;
+    const fetchedSoFar = page * RESULTS_PER_PAGE;
+    keepGoing = payload.length > 0 && fetchedSoFar < allCount;
+    page += 1;
+  }
+  return {
+    rows,
+    fetchedCount: rows.length,
+    totalCount: allCount,
+    truncated: hitPageCap && rows.length < allCount,
+  };
+}
