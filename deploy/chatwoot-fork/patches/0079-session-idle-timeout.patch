diff --git a/app/javascript/dashboard/composables/useProtonIdleTimeout.js b/app/javascript/dashboard/composables/useProtonIdleTimeout.js
new file mode 100644
index 0000000..6c304a8
--- /dev/null
+++ b/app/javascript/dashboard/composables/useProtonIdleTimeout.js
@@ -0,0 +1,61 @@
+// Idle-timeout wiring (FIX-18, patch 0079). RFP 2026_028 7.5 asks for
+// "Idle Time-out Rules"; Chatwoot has none (Devise timeoutable is off and the
+// session token lasts 2 months). The minutes come from the Rails layout
+// (window.__PROTON_IDLE_TIMEOUT_MINUTES__, env SESSION_IDLE_TIMEOUT_MINUTES);
+// 0 / absent leaves behaviour exactly as upstream.
+import Cookies from 'js-cookie';
+import Auth from 'dashboard/api/auth';
+import { createIdleMonitor } from './idleMonitor';
+
+let installed = false;
+
+async function signOut() {
+  // Best effort: invalidate the token server-side, then always drop the
+  // browser session so the next navigation lands on the login page.
+  try {
+    if (Auth.hasAuthCookie()) {
+      const a = Auth.getAuthData();
+      await fetch('/auth/sign_out', {
+        method: 'DELETE',
+        headers: {
+          'access-token': a['access-token'],
+          client: a.client,
+          uid: a.uid,
+        },
+      });
+    }
+  } catch (e) {
+    /* the cookie removal below still ends the session client-side */
+  }
+  Cookies.remove('cw_d_session_info');
+  window.location.href = '/app/login';
+}
+
+export function installProtonIdleTimeout() {
+  if (installed || typeof window === 'undefined') return;
+  const minutes = Number(window.__PROTON_IDLE_TIMEOUT_MINUTES__ || 0);
+  if (!(minutes > 0)) return;
+  installed = true;
+  let storage = null;
+  try {
+    storage = window.localStorage;
+  } catch (e) {
+    storage = null;
+  }
+  const monitor = createIdleMonitor({
+    timeoutMinutes: minutes,
+    storage,
+    onIdle: signOut,
+  });
+  // Throttle the storage write: input events fire many times a second.
+  let lastTouch = 0;
+  const onInput = () => {
+    const t = Date.now();
+    if (t - lastTouch < 1000) return;
+    lastTouch = t;
+    monitor.touch();
+  };
+  ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach(
+    ev => window.addEventListener(ev, onInput, { passive: true, capture: true })
+  );
+}
