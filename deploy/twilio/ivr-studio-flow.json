        {
          "event": "noMatch",
          "next": "after_hours_en"
        },
        {
          "event": "match",
          "next": "hours_weekday_close",
          "conditions": [
            {
              "friendly_name": "after 08:30",
              "arguments": [
                "{{ 'now' | date: '%s' | plus: 28800 | modulo: 86400 | divided_by: 60 }}"
              ],
              "type": "greater_than",
              "value": "509"
            }
          ]
        }
      ],
      "properties": {
        "input": "{{ 'now' | date: '%s' | plus: 28800 | modulo: 86400 | divided_by: 60 }}",
        "offset": {
          "x": -260,
          "y": 640
