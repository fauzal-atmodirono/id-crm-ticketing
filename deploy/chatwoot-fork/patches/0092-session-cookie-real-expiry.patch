   });
   setUser(response.data.data, expiryDate);
 };
diff --git a/config/initializers/zz_proton_session.rb b/config/initializers/zz_proton_session.rb
index 0354a24..91237b1 100644
--- a/config/initializers/zz_proton_session.rb
+++ b/config/initializers/zz_proton_session.rb
@@ -10,4 +10,10 @@
 # timer (the idle timer is client side, SESSION_IDLE_TIMEOUT_MINUTES). Tokens
 # already issued keep their old expiry; the cap applies from the next login.
 hours = ENV.fetch('SESSION_TOKEN_LIFESPAN_HOURS', '').to_i
-DeviseTokenAuth.token_lifespan = hours.hours if hours.positive?
+# Second guard (patch 0092): a lifespan under 48 h is refused. Short lifespans
+# are not a supported way to get an idle timeout (use SESSION_IDLE_TIMEOUT_MINUTES).
+if hours.positive? && hours < 48
+  Rails.logger.warn("SESSION_TOKEN_LIFESPAN_HOURS=#{hours} ignored: values under 48 are refused")
+elsif hours.positive?
+  DeviseTokenAuth.token_lifespan = hours.hours
+end
