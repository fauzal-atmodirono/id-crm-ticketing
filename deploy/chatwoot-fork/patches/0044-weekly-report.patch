diff --git a/app/javascript/dashboard/routes/dashboard/settings/reports/components/proton/reportScope.js b/app/javascript/dashboard/routes/dashboard/settings/reports/components/proton/reportScope.js
new file mode 100644
index 0000000..92677e7
--- /dev/null
+++ b/app/javascript/dashboard/routes/dashboard/settings/reports/components/proton/reportScope.js
@@ -0,0 +1,97 @@
+// reportScope.js — OUR file. Shared vocabulary for Package E's Weekly Report
+// (Task 4) so every section on the page describes its own data the same way.
+//
+// The backend (Task 2/3) attaches a `BlockScope.status` to every period-aware
+// block: "ok" | "unavailable" | "unsupported_granularity" | "unfiltered" (see
+// backend chatbot/features/metrics/query_port.py's BlockScope docstring).
+// Those four states collapse what would otherwise look like the same thing
+// (an empty or non-empty rows array) into four genuinely different situations
+// a reader needs to tell apart -- a quiet week is not the same as a broken
+// query, and neither is the same as a block that was never period-scoped in
+// the first place. This module is the one place that maps each status to the
+// label (always shown) and the empty-body message (shown only when a
+// section's current rows are empty) used across the page.
+//
+// Several sections on this page are fed by endpoints that carry no
+// `BlockScope` at all -- either because the endpoint has no date dimension to
+// filter on (departments, callcenter, dealer-escalation, sla-buckets,
+// case-aging all 400 if given period params -- see insights_router.py's
+// docstring) or because this page chooses not to call the endpoint with a
+// period even though the HTTP route now supports one (/metrics/dashboard --
+// see protonMetrics.js's getDashboard comment). Both are reported here as
+// the literal status "unfiltered": the row data is real, it just is not
+// scoped to the selected week, exactly the same as a genuine
+// BlockScope("unfiltered") the backend would attach to a block with no date
+// column.
+export const SCOPE_STATUS = {
+  OK: 'ok',
+  UNAVAILABLE: 'unavailable',
+  UNSUPPORTED_GRANULARITY: 'unsupported_granularity',
+  UNFILTERED: 'unfiltered',
+};
+
+const LABELS = {
+  [SCOPE_STATUS.OK]: 'This week',
+  [SCOPE_STATUS.UNAVAILABLE]: 'Temporarily unavailable',
+  [SCOPE_STATUS.UNSUPPORTED_GRANULARITY]: 'Not available at week granularity',
+  [SCOPE_STATUS.UNFILTERED]: 'All time',
+};
+
+// Badge colour tokens, matching the palette Banner.vue already uses
+// (bg-n-<color>-3 / border-n-<color>-4 / text-n-<color>-11).
+const COLORS = {
+  [SCOPE_STATUS.OK]: 'teal',
+  [SCOPE_STATUS.UNAVAILABLE]: 'amber',
+  [SCOPE_STATUS.UNSUPPORTED_GRANULARITY]: 'amber',
+  [SCOPE_STATUS.UNFILTERED]: 'slate',
+};
+
+// The message shown in a section's body when its current rows are empty.
+// "ok" with zero rows is a genuinely quiet week, never rendered as "0" or as
+// a bare blank table -- it says so explicitly.
+const EMPTY_MESSAGES = {
+  [SCOPE_STATUS.OK]: 'No data for this period.',
+  [SCOPE_STATUS.UNAVAILABLE]:
+    'Temporarily unavailable — this data could not be loaded. Try again shortly.',
+  [SCOPE_STATUS.UNSUPPORTED_GRANULARITY]:
+    'Not available at week granularity — the underlying data does not support a window this narrow.',
+  [SCOPE_STATUS.UNFILTERED]:
+    'No data available (all time — this section is not scoped to the selected week).',
+};
+
+export function scopeLabel(status) {
+  return LABELS[status] || LABELS[SCOPE_STATUS.OK];
+}
+
+export function scopeColor(status) {
+  return COLORS[status] || COLORS[SCOPE_STATUS.OK];
+}
+
+export function scopeEmptyMessage(status) {
+  return EMPTY_MESSAGES[status] || EMPTY_MESSAGES[SCOPE_STATUS.OK];
+}
+
+// A block only ever renders its rows when the backend actually ran a query
+// for it ("ok" -- rows may legitimately be an empty list -- or "unfiltered"
+// -- rows are real, just all-time). "unavailable" and
+// "unsupported_granularity" mean no query ran at all, so any rows present
+// would be stale/misleading and are not shown, only the explanatory message.
+export function scopeHasRenderableRows(status) {
+  return status === SCOPE_STATUS.OK || status === SCOPE_STATUS.UNFILTERED;
+}
+
+// `deltas` on a period-wrapped response is `null` whenever either comparison
+// leg's scope isn't "ok" (see insights_router.py's `_block_delta`). Renders
+// nothing misleading -- never falls back to "0%", which would read as "no
+// change" instead of "not comparable".
+export function formatDelta(delta) {
+  if (delta === null || delta === undefined || Number.isNaN(delta)) {
+    return null;
+  }
+  // `|| 0` normalises -0 (e.g. Math.round(-0.4)) to plain 0 -- -0 is falsy,
+  // so this is the standard idiom, and it keeps the sign check below
+  // unambiguous rather than silently relying on `-0 > 0 === false`.
+  const rounded = Math.round(delta) || 0;
+  const sign = rounded > 0 ? '+' : '';
+  return `${sign}${rounded}%`;
+}
