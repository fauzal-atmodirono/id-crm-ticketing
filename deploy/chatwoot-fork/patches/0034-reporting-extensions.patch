@@ -0,0 +1,111 @@
+<script setup>
+import { ref, computed, onMounted } from 'vue';
+import BarChart from 'shared/components/charts/BarChart.vue';
+import { getSlaBuckets } from 'dashboard/api/protonMetrics';
+
+// ── State ──────────────────────────────────────────────────────────────────────
+
+const buckets = ref([]);
+const error = ref(null);
+const loading = ref(true);
+
+onMounted(async () => {
+  try {
+    const result = await getSlaBuckets();
+    buckets.value = result.buckets ?? [];
+  } catch (e) {
+    error.value = e.message || 'Failed to load SLA bucket data';
+  } finally {
+    loading.value = false;
+  }
+});
+
+// ── Computed ───────────────────────────────────────────────────────────────────
+
+// Distinct series colours, indexed by case_type order of appearance.
+const SERIES_COLORS = [
+  '#6366f1',
+  '#22c55e',
+  '#f59e0b',
+  '#ef4444',
+  '#06b6d4',
+  '#a855f7',
+];
+
+// buckets: [{ case_type, bucket_label, cases }] — pivot into a grouped bar
+// chart where each bucket_label is a column and each case_type is a series.
+const slaBucketCollection = computed(() => {
+  if (!buckets.value.length) return null;
+
+  const bucketLabels = [];
+  const caseTypes = [];
+  buckets.value.forEach(row => {
+    const label = row.bucket_label ?? '—';
+    const caseType = row.case_type ?? '—';
+    if (!bucketLabels.includes(label)) bucketLabels.push(label);
+    if (!caseTypes.includes(caseType)) caseTypes.push(caseType);
+  });
+
+  const datasets = caseTypes.map((caseType, i) => ({
+    label: caseType,
+    backgroundColor: SERIES_COLORS[i % SERIES_COLORS.length],
+    data: bucketLabels.map(label =>
+      buckets.value
+        .filter(
+          row =>
+            (row.case_type ?? '—') === caseType &&
+            (row.bucket_label ?? '—') === label
+        )
+        .reduce((s, row) => s + (row.cases ?? 0), 0)
+    ),
+  }));
+
+  return { labels: bucketLabels, datasets };
+});
+
+const barChartOptions = {
+  plugins: { legend: { display: true, position: 'bottom' } },
+  scales: { y: { beginAtZero: true } },
+};
+</script>
+
+<template>
+  <div
+    class="shadow outline-1 outline outline-n-container rounded-xl bg-n-solid-2 px-6 py-5"
+  >
+    <h3 class="text-sm font-semibold text-n-slate-12 mb-4">
+      SLA Compliance by Bucket
+    </h3>
+
+    <!-- Loading state -->
+    <woot-loading-state
+      v-if="loading"
+      class="text-xs"
+      message="Loading SLA compliance data…"
+    />
+
+    <!-- Error state -->
+    <div
+      v-else-if="error"
+      class="flex items-center justify-center h-24 text-sm text-n-slate-10"
+    >
+      {{ error }}
+    </div>
+
+    <!-- Empty state -->
+    <div
+      v-else-if="!slaBucketCollection"
+      class="flex items-center justify-center h-24 text-sm text-n-slate-10"
+    >
+      No SLA compliance data available
+    </div>
+
+    <!-- Content -->
+    <div v-else class="h-64">
+      <BarChart
+        :collection="slaBucketCollection"
+        :chart-options="barChartOptions"
+      />
+    </div>
+  </div>
+</template>
