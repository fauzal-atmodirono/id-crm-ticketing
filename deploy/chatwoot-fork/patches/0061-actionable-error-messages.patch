+// protonError.js — OUR file. One place that turns a failed Proton backend
+// response into a sentence an operator can act on.
+//
+// WHY THIS EXISTS. Every Proton request helper used to throw
+// `new Error(`${status}: ${text.slice(0, 200)}`)`, and every page rendered
+// that string straight into the UI. When a backend path is not routed by the
+// tenant's Caddy vhost the request falls through to Chatwoot, which answers
+// with its own HTML error page — so the alert preferences page displayed
+//
+//   Could not load alert preferences: 404: <!DOCTYPE html> <html lang="en">…
+//
+// to an operator, who has no way to read that as "an ops person must add
+// /alerts/* to the tenant's reverse-proxy route". That exact failure went
+// unnoticed until someone clicked the page, because the backend route was
+// mounted and healthy the whole time. A raw HTTP body is diagnostic output,
+// not a message; this module keeps the diagnosis on the error object (and the
+// console) and gives the UI a sentence instead.
+//
+// It deliberately does NOT swallow anything: the original status and body stay
+// on the returned Error as `.status` and `.detail` for logging and for tests.
+
+// A response Chatwoot rendered (or any HTML error page) means the request
+// never reached the backend at all — the single most useful thing this module
+// can tell anyone, and the one case the old message obscured completely.
+function looksLikeHtml(text) {
+  const head = (text || '').trimStart().slice(0, 200).toLowerCase();
+  return head.startsWith('<!doctype') || head.startsWith('<html') || head.startsWith('<');
+}
+
+// FastAPI puts its message in `detail`; some routers answer {"reason": …}.
+function jsonDetail(text) {
+  try {
+    const parsed = JSON.parse(text);
+    if (!parsed || typeof parsed !== 'object') return null;
+    const value = parsed.detail ?? parsed.reason ?? parsed.message;
+    if (typeof value === 'string' && value.trim()) return value.trim();
+    return null;
+  } catch (_e) {
+    return null;
+  }
+}
+
+// `what` names the thing the caller was doing, lowercase and without a
+// trailing period — e.g. 'load alert preferences'. It is used only when the
+// backend gave us nothing better to say.
+export function describeHttpFailure(status, bodyText, what = 'complete that request') {
+  if (looksLikeHtml(bodyText)) {
+    return (
+      `The CRM could not reach the Proton backend for this page (HTTP ${status}). ` +
+      `The request was answered by the CRM itself instead of the backend, which ` +
+      `means this feature's path is not routed to it. An operator needs to add ` +
+      `it to the tenant's reverse-proxy route — nothing is wrong with your input.`
+    );
+  }
+
+  const detail = jsonDetail(bodyText);
+
+  if (status === 401) {
+    return (
+      detail ||
+      'Your session is not authorised for this. Signing out and back in usually fixes it.'
+    );
+  }
+  if (status === 403) {
+    return (
+      detail ||
+      'You do not have permission for this. An administrator can grant it under ' +
+        'Settings → Roles & Permissions.'
+    );
+  }
+  if (status === 404) {
+    return (
+      detail ||
+      'This feature is not switched on for this account, so there is nothing to show yet.'
+    );
+  }
+  if (status === 422) {
+    return detail || 'The backend rejected that as invalid. Check the values and try again.';
+  }
+  if (status >= 500) {
+    return (
+      `The Proton backend failed while trying to ${what} (HTTP ${status}). ` +
+      `Please try again — if it keeps happening, an operator should check the backend logs.`
+    );
+  }
+  return detail || `Could not ${what} (HTTP ${status}).`;
+}
+
+// Build the Error every Proton request helper throws. Keeps `.status` (several
+// callers branch on it, notably the 404-means-not-configured paths in patch
+// 0033) and adds `.detail` so the raw body is still available to a console log
+// or a test without ever being rendered.
+export function httpFailure(status, bodyText, what) {
+  const err = new Error(describeHttpFailure(status, bodyText, what));
+  err.status = status;
+  err.detail = bodyText;
+  return err;
+}
