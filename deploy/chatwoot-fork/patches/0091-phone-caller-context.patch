diff --git a/app/javascript/dashboard/components-next/softphone/ProtonSoftphonePanel.vue b/app/javascript/dashboard/components-next/softphone/ProtonSoftphonePanel.vue
index c1a4a63..ed6b191 100644
--- a/app/javascript/dashboard/components-next/softphone/ProtonSoftphonePanel.vue
+++ b/app/javascript/dashboard/components-next/softphone/ProtonSoftphonePanel.vue
@@ -76,12 +76,36 @@ function openConversation() {
     });
   }
 }
+
+// 0091 caller context: Accept also opens the caller's conversation here and
+// their Customer 360 in a new tab. Done from a CAPTURE-phase click on the
+// panel (marked Accept button) rather than from the SDK's async `accept`
+// event, because a browser only allows window.open inside the user's click.
+// A browser-softphone caller id (client:...) is not a number to look up.
+function openCustomer360() {
+  const q = incoming.value?.from || '';
+  if (!q || q.startsWith('client:')) return;
+  const { href } = router.resolve({
+    name: 'proton_customer360',
+    params: { accountId: router.currentRoute.value.params.accountId },
+    query: { q },
+  });
+  window.open(href, '_blank', 'noopener');
+}
+
+function onPanelClickCapture(event) {
+  if (status.value !== 'ringing') return;
+  if (!event.target?.closest?.('[data-proton-accept]')) return;
+  openConversation();
+  openCustomer360();
+}
 </script>
 
