From: Proton CRM <build@proton.local>
Subject: [PATCH 0099] conversation panel: partner-system (DMS/TSP) card keyed by conversation (not connected until the DMS is configured)

diff --git a/app/javascript/dashboard/components/proton/ProtonDmsCard.vue b/app/javascript/dashboard/components/proton/ProtonDmsCard.vue
new file mode 100644
index 0000000..8bec2b7
--- /dev/null
+++ b/app/javascript/dashboard/components/proton/ProtonDmsCard.vue
@@ -0,0 +1,237 @@
+<script setup>
+// ProtonDmsCard.vue — OUR file (patch 0099). The partner-system ("DMS/TSP"
+// on automotive tenants) card in the conversation's right panel: the open
+// conversation's customer as the DMS knows them (assets + service history).
+//
+// No second DMS client: the backend's Customer 360 router owns the DMS path
+// (customer360_router.py _build_dms_block, same permission, data scope and
+// PII masking as the Customer 360 page).
+//   - GET /admin/customer360/dms/status — fetched ONCE per page (module-level
+//     promise, like useProtonPermissions), so while the integration is off
+//     every conversation says "not connected" with no request of its own.
+//   - GET /admin/customer360/dms?conversation_id=N — only when connected.
+//     Keyed by the conversation, never by a phone or plate in the URL (R59):
+//     the backend reads the conversation itself, checks it is inside the
+//     caller's data scope, then asks the DMS (phone first, plate fallback).
+//
+// States: off (not connected) · loading · none (no record) · data · error.
+// Every failure is a short message; the panel around it never breaks.
+// Shown only where Customer 360 is: the tenant has the `customer360` feature
+// (0072/0074) and the agent holds customer360.view (the cached RBAC set — UX
+// only, the backend's require_permission is the boundary). Wording comes
+// from the tenant term dictionary (0075), as the Customer 360 page's does.
+import { computed, ref, watch } from 'vue';
+import { useMapGetter } from 'dashboard/composables/store';
+import { useProtonPermissions } from 'dashboard/composables/useProtonPermissions';
+import { useCustomFeatures } from 'dashboard/composables/useCustomFeatures';
+import { adminRequest } from 'dashboard/api/protonAdmin';
+
+const props = defineProps({
+  contact: {
+    type: Object,
+    default: () => ({}),
+  },
+  conversationId: {
+    type: [Number, String],
+    required: true,
+  },
+});
+
+const STATUS_TIMEOUT_MS = 10000;
+const LOOKUP_TIMEOUT_MS = 15000;
+
+// Shared by every card on the page. A failure (or a timeout) is NOT cached:
+// the next conversation opened asks again instead of reading "off" forever.
+let statusPromise = null;
+function loadStatus() {
+  if (!statusPromise) {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), STATUS_TIMEOUT_MS);
+    statusPromise = adminRequest('/admin/customer360/dms/status', {
+      signal: controller.signal,
+    })
+      .catch(e => {
+        statusPromise = null;
+        throw e;
+      })
+      .finally(() => clearTimeout(timer));
+  }
+  return statusPromise;
+}
+
+const { hasPermission } = useProtonPermissions();
+const { hasFeature, t } = useCustomFeatures();
+const permitted = computed(
+  () => hasFeature('customer360') && hasPermission('customer360.view')
+);
+
+const currentChat = useMapGetter('getSelectedChat');
+
+const state = ref('loading');
+const dms = ref(null);
+let requestToken = 0;
+
+const contactId = computed(() => props.contact?.id || null);
+// Only to notice that the customer's keys changed (the backend derives the
+// lookup itself from the conversation); none of this is sent.
+const lookupKey = computed(() => {
+  if (!permitted.value || !contactId.value) return '';
+  const contactAttrs = props.contact?.custom_attributes || {};
+  const convAttrs = currentChat.value?.custom_attributes || {};
+  return [
+    props.conversationId,
+    contactId.value,
+    props.contact?.phone_number || '',
+    contactAttrs.vehicle_no || '',
+    convAttrs.vehicle_plate || '',
+  ].join('|');
+});
+
+async function load() {
+  if (!permitted.value) return;
+  requestToken += 1;
+  const token = requestToken;
+  state.value = 'loading';
+  dms.value = null;
+  let status;
+  try {
+    status = await loadStatus();
+  } catch {
+    if (token !== requestToken) return;
+    state.value = 'error';
+    return;
+  }
+  if (token !== requestToken) return;
+  if (!status.connected) {
+    state.value = 'off';
+    return;
+  }
+  const params = new URLSearchParams({
+    conversation_id: String(props.conversationId),
+  });
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), LOOKUP_TIMEOUT_MS);
+  try {
+    const res = await adminRequest(
+      `/admin/customer360/dms?${params.toString()}`,
+      { signal: controller.signal }
+    );
+    if (token !== requestToken) return;
+    const block = res?.dms;
+    if (!block) {
+      // Switched off since the status call, or outside the caller's scope.
+      state.value = 'off';
+      return;
+    }
+    if (block.status !== 'ok') {
+      state.value = 'error';
+      return;
+    }
+    if (!block.customer) {
+      state.value = 'none';
+      return;
+    }
+    dms.value = {
+      mock: !!block.mock,
+      customer: block.customer,
+      vehicles: Array.isArray(block.vehicles) ? block.vehicles : [],
+      service_history: Array.isArray(block.service_history)
+        ? block.service_history
+        : [],
+    };
+    state.value = 'data';
+  } catch {
+    if (token !== requestToken) return;
+    state.value = 'error';
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+watch(
+  lookupKey,
+  key => {
+    if (key) {
+      load();
+    } else {
+      // No contact yet (or no longer permitted): stay in loading, no request.
+      requestToken += 1;
+      state.value = 'loading';
+      dms.value = null;
+    }
+  },
+  { immediate: true }
+);
+</script>
+
+<template>
+  <div v-if="permitted" class="px-2 pt-2" data-proton-dms-card>
+    <div
+      class="flex flex-col gap-2 p-3 border rounded-xl border-n-weak bg-n-alpha-1"
+    >
+      <div class="flex items-center justify-between gap-2">
+        <div class="text-sm font-medium text-n-slate-12">
+          {{ t('partner_system') }} / {{ t('asset') }}
+        </div>
+        <span
+          v-if="state === 'off'"
+          class="px-2 py-0.5 text-xs rounded-full bg-n-alpha-2 text-n-slate-11"
+        >
+          Not connected
+        </span>
+      </div>
+      <p v-if="state === 'off'" class="text-xs text-n-slate-11">
+        {{ t('partner_system') }} not connected — {{ t('asset', 'lower') }} and
+        service history will appear here once the {{ t('partner_system') }} is
+        connected.
+      </p>
+      <p v-else-if="state === 'loading'" class="text-xs text-n-slate-11">
+        Loading {{ t('partner_system') }} record…
+      </p>
+      <p v-else-if="state === 'none'" class="text-xs text-n-slate-11">
+        No {{ t('partner_system') }} record for this customer.
+      </p>
+      <p v-else-if="state === 'error'" class="text-xs text-n-ruby-11">
+        Couldn't reach the {{ t('partner_system') }} right now — try again
+        later.
+      </p>
+      <template v-else-if="state === 'data' && dms">
+        <p
+          v-if="dms.mock"
+          class="px-2 py-1 text-xs font-medium border rounded-lg border-n-amber-6 bg-n-amber-2 text-n-amber-11"
+        >
+          Mock data — for demo purposes only, not from a live
+          {{ t('partner_system') }}.
+        </p>
+        <div class="text-xs text-n-slate-12">{{ dms.customer.name }}</div>
+        <div class="text-xs font-medium text-n-slate-12">
+          {{ t('asset', 'plural') }}
+        </div>
+        <p v-if="!dms.vehicles.length" class="text-xs text-n-slate-11">
+          No {{ t('asset', 'plural_lower') }} on file.
+        </p>
+        <ul v-else class="text-xs list-disc list-inside text-n-slate-11">
+          <li
+            v-for="(vehicle, index) in dms.vehicles"
+            :key="`${index}-${vehicle.vehicle_no}`"
+          >
+            {{ vehicle.vehicle_no }} — {{ vehicle.model }}
+            <template v-if="vehicle.purchased_from">
+              (purchased from {{ vehicle.purchased_from }})
+            </template>
+          </li>
+        </ul>
+        <div class="text-xs font-medium text-n-slate-12">Service history</div>
+        <p v-if="!dms.service_history.length" class="text-xs text-n-slate-11">
+          No service history on file.
+        </p>
+        <ul v-else class="text-xs list-disc list-inside text-n-slate-11">
+          <li v-for="(record, index) in dms.service_history" :key="index">
+            {{ record.date }} — {{ record.description }}
+            <template v-if="record.dealer">({{ record.dealer }})</template>
+          </li>
+        </ul>
+      </template>
+    </div>
+  </div>
+</template>
