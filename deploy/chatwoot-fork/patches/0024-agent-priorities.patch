diff --git a/app/javascript/dashboard/components/proton/AgentPrioritiesEditor.vue b/app/javascript/dashboard/components/proton/AgentPrioritiesEditor.vue
new file mode 100644
index 0000000..058598f
--- /dev/null
+++ b/app/javascript/dashboard/components/proton/AgentPrioritiesEditor.vue
@@ -0,0 +1,208 @@
+<!-- AgentPrioritiesEditor.vue — OUR file. Chrome-less editor for per-agent
+     channel priorities. Embedded in Settings → Inboxes → Collaborators tab.
+     Each agent has a Primary channel (the first in channel_priorities[]) and
+     zero-or-more "Also handles" channels (the rest).
+     Reads from GET /routing/agents + GET /routing/priorities; writes via
+     POST /routing/priorities. Part of Phase 5 WhatsApp custom auto-assignment. -->
+<script>
+import { useAlert } from 'dashboard/composables';
+import {
+  getRoutingAgents,
+  getRoutingPriorities,
+  setRoutingPriority,
+} from 'dashboard/api/protonKnowledge';
+
+const CHANNELS = ['whatsapp', 'call', 'email', 'social', 'web'];
+
+export default {
+  name: 'AgentPrioritiesEditor',
+  data() {
+    return {
+      rows: [],
+      loading: true,
+      errored: false,
+      savingRows: new Set(),
+      channels: CHANNELS,
+    };
+  },
+  async mounted() {
+    await this.load();
+  },
+  methods: {
+    async load() {
+      this.loading = true;
+      this.errored = false;
+      try {
+        const [agents, priorities] = await Promise.all([
+          getRoutingAgents(),
+          getRoutingPriorities(),
+        ]);
+        const priMap = {};
+        const priArr = Array.isArray(priorities)
+          ? priorities
+          : priorities.priorities || [];
+        priArr.forEach(p => {
+          priMap[p.agent_id] = p.channel_priorities || [];
+        });
+
+        const agentArr = Array.isArray(agents)
+          ? agents
+          : agents.agents || [];
+
+        this.rows = agentArr.map(a => {
+          const cp = priMap[a.id] || [];
+          return {
+            id: a.id,
+            name: a.name || String(a.id),
+            availability_status: a.availability_status || '',
+            primary: cp[0] || '',
+            also: cp.slice(1),
+          };
+        });
+      } catch (err) {
+        this.errored = true;
+        if (err.status === 401) {
+          useAlert('Unauthorized (401) — check the backend key configuration.');
+        } else if (err.status === 503) {
+          useAlert('Routing service unavailable (503) on the backend.');
+        } else {
+          useAlert('Failed to load agent priorities: ' + (err.message || String(err)));
+        }
+      } finally {
+        this.loading = false;
+      }
+    },
+
+    toggleAlso(row, channel) {
+      if (row.also.includes(channel)) {
+        row.also = row.also.filter(c => c !== channel);
+      } else {
+        row.also = [...row.also, channel];
+      }
+    },
+
+    async save(row) {
+      if (!row.primary) {
+        useAlert('Pick a primary channel before saving.');
+        return;
+      }
+      const channelPriorities = [
+        row.primary,
+        ...row.also.filter(c => c !== row.primary),
+      ];
+      this.savingRows = new Set([...this.savingRows, row.id]);
+      try {
+        await setRoutingPriority(row.id, channelPriorities);
+        useAlert('Agent "' + row.name + '" priorities saved.');
+      } catch (err) {
+        useAlert('Failed to save "' + row.name + '": ' + (err.message || String(err)));
+      } finally {
+        const next = new Set(this.savingRows);
+        next.delete(row.id);
+        this.savingRows = next;
+      }
+    },
+
+    statusLabel(status) {
+      if (!status) return '—';
+      return status.charAt(0).toUpperCase() + status.slice(1).replace(/_/g, ' ');
+    },
+  },
+};
+</script>
+
+<template>
+  <div>
+    <p class="mb-3 text-xs text-n-slate-11">
+      Priorities apply account-wide per agent; used to auto-assign a priority agent on handoff.
+    </p>
+    <div v-if="loading" class="py-10 text-sm text-center text-n-slate-11">
+      Loading agents...
+    </div>
+    <div
+      v-else-if="errored"
+      class="py-10 text-sm text-center text-n-slate-11"
+    >
+      Could not load agent priorities.
+    </div>
+    <div
+      v-else-if="!rows.length"
+      class="py-10 text-sm text-center text-n-slate-11"
+    >
+      No agents found.
+    </div>
+    <div
+      v-else
+      class="overflow-hidden border rounded-lg border-n-weak bg-n-background"
+    >
+      <table class="w-full text-sm border-collapse">
+        <thead>
+          <tr class="text-left border-b border-n-weak bg-n-alpha-black1">
+            <th class="px-3 py-2 font-medium text-n-slate-11">Agent</th>
+            <th class="px-3 py-2 font-medium text-n-slate-11">Status</th>
+            <th class="px-3 py-2 font-medium text-n-slate-11">Primary channel</th>
+            <th class="px-3 py-2 font-medium text-n-slate-11">Also handles</th>
+            <th class="px-3 py-2 font-medium text-n-slate-11"></th>
+          </tr>
+        </thead>
+        <tbody>
+          <tr
+            v-for="row in rows"
+            :key="row.id"
+            class="border-b border-n-weak last:border-0 align-middle"
+          >
+            <td class="px-3 py-2 font-medium text-n-slate-12">
+              {{ row.name }}
+            </td>
+            <td class="px-3 py-2 text-n-slate-11">
+              {{ statusLabel(row.availability_status) }}
+            </td>
+            <td class="px-3 py-2">
+              <select
+                v-model="row.primary"
+                class="w-full max-w-[160px] px-2 py-1 text-sm border rounded-lg border-n-weak bg-n-alpha-black1 text-n-slate-12 focus:outline-none disabled:opacity-50"
+                :disabled="savingRows.has(row.id)"
+              >
+                <option value="">select</option>
+                <option
+                  v-for="ch in channels"
+                  :key="ch"
+                  :value="ch"
+                >
+                  {{ ch }}
+                </option>
+              </select>
+            </td>
+            <td class="px-3 py-2">
+              <div class="flex flex-wrap gap-3">
+                <label
+                  v-for="ch in channels"
+                  :key="ch"
+                  class="flex items-center gap-1 text-xs text-n-slate-11 cursor-pointer select-none"
+                >
+                  <input
+                    type="checkbox"
+                    :checked="row.also.includes(ch)"
+                    :disabled="savingRows.has(row.id)"
+                    class="accent-n-brand"
+                    @change="toggleAlso(row, ch)"
+                  />
+                  {{ ch }}
+                </label>
+              </div>
+            </td>
+            <td class="px-3 py-2">
+              <button
+                class="px-3 py-1.5 text-xs font-medium rounded-lg text-n-slate-12 border border-n-weak hover:bg-n-alpha-black1 disabled:opacity-50"
+                :disabled="savingRows.has(row.id)"
+                @click="save(row)"
+              >
+                Save
+              </button>
+            </td>
+          </tr>
+        </tbody>
+      </table>
+    </div>
+  </div>
+</template>
