diff --git a/app/javascript/dashboard/routes/dashboard/settings/reports/ProtonWeeklyReport.vue b/app/javascript/dashboard/routes/dashboard/settings/reports/ProtonWeeklyReport.vue
new file mode 100644
index 0000000..6633164
--- /dev/null
+++ b/app/javascript/dashboard/routes/dashboard/settings/reports/ProtonWeeklyReport.vue
@@ -0,0 +1,1358 @@
+<!-- ProtonWeeklyReport.vue — OUR file. Package E (reporting deck parity),
+     Task 4: one page, sections in the weekly deck's own order (see
+     docs/superpowers/specs/2026-08-04-pkg-e-reporting-deck-parity-design.md
+     §2 "Weekly (16 slides)"), each carrying a week picker and a
+     week-over-week delta beside its headline number.
+
+     The week picker defaults to the current ISO Monday-Sunday week but the
+     window start is user-choosable to any day (Task 5 reconciliation
+     finding: Proton's own weekly deck runs Friday-Thursday — 17-23 July
+     2026 starts on a Friday — so a Monday-locked picker cannot select the
+     window the deck reports on). See the "Week picker" comment block below
+     for why this needed no backend change.
+
+     Composition, not new chart components: the dealer-escalation, SLA-
+     compliance, and WIP-aging sections below are patch 0034's
+     ProtonDealerEscalationSection / ProtonSlaComplianceSection /
+     ProtonWipAgingSection, unmodified, embedded as-is (per the Task 4
+     brief). ProtonCallCentrePlaceholder (also 0034) is reused for the same
+     reason: it already says, honestly, that telephony metrics (AHT/AQT/
+     abandoned calls/SLA-within-20s -- gap G2 in the spec) aren't built yet.
+     ProtonCasesTable + fetchAllCases are Package D's seam (see
+     dashboard/api/protonCases.js's file-header comment), reused here for the
+     per-case detail table rather than re-implementing pagination/row
+     mapping.
+
+     Two of the endpoints this page reads are genuinely period-capable at
+     the HTTP layer: /metrics/lifecycle and /metrics/volume-by-type (see
+     insights_router.py). /metrics/departments, /metrics/callcenter,
+     /metrics/dealer-escalation, /metrics/sla-buckets, and /metrics/case-aging
+     all 400 if given period params -- their underlying views have no date
+     column -- so they're fetched with no period at all and labelled "All
+     time" throughout this page (reportScope.js's SCOPE_STATUS.UNFILTERED).
+     /metrics/dashboard is ALSO period-capable now (a later backend wave
+     wired from/to/granularity into dashboard_router.py -- see
+     protonMetrics.js's getDashboard comment), but this page still doesn't
+     call it: volume-by-type's rows already carry `channel` alongside
+     `case_type`/`division`, so the channel-mix and type/division cuts below
+     both come from the one endpoint rather than also wiring up dashboard's
+     overlapping `volume` block for no new information. -->
+<script setup>
+import { ref, computed, onMounted, watch } from 'vue';
+import { useAlert } from 'dashboard/composables';
+import V4Button from 'dashboard/components-next/button/Button.vue';
+import ReportHeader from './components/ReportHeader.vue';
+import ProtonScopeBadge from './components/proton/ProtonScopeBadge.vue';
+import ProtonDealerEscalationSection from './components/proton/ProtonDealerEscalationSection.vue';
+import ProtonSlaComplianceSection from './components/proton/ProtonSlaComplianceSection.vue';
+import ProtonWipAgingSection from './components/proton/ProtonWipAgingSection.vue';
+import ProtonCallCentrePlaceholder from './components/proton/ProtonCallCentrePlaceholder.vue';
+import ProtonCasesTable from 'dashboard/components/widgets/ProtonCasesTable.vue';
+import { fetchAllCases } from 'dashboard/api/protonCases';
+import {
+  getVolumeByType,
+  getLifecycle,
+  getDepartments,
+  getCallCentre,
+} from 'dashboard/api/protonMetrics';
+import {
+  SCOPE_STATUS,
+  scopeEmptyMessage,
+  scopeHasRenderableRows,
+  formatDelta,
+} from './components/proton/reportScope';
+
+const TOP_N = 10;
+
+// ── Week picker ──────────────────────────────────────────────────────────
+// Defaults to the current ISO calendar week (Monday-Sunday), matching the
+// backend's own `bucket_key` (period.py: `date.isocalendar()`, not
+// `strftime("%Y-%W")`) — the sane default for most operators. But the window
+// start is NOT locked to Monday: Proton's own weekly deck runs Friday-
+// Thursday (17-23 July 2026 is a Friday-start week), and the reconciliation
+// this page exists for is unreachable if the picker can't express that.
+// `parse_period` imposes no alignment on `from`/`to` (see period.py) and the
+// day-grain sibling views (query_adapter.py) accept any date range at any
+// granularity, so this is purely a UI change: the date input below sets
+// `weekStart` to exactly the day picked, no snapping, and `weekEnd` /
+// `periodParams` follow whatever `weekStart` is — an operator can dial in
+// Friday 17 Jul and step week-by-week from there with the same Friday start
+// every time. `previous_period` (backend) already takes the immediately
+// preceding window of equal length for a non-full-calendar-month range —
+// exactly right for a Friday-start week — so the WoW delta compares against
+// the 7 days before the *chosen* window, not a re-aligned ISO week, with no
+// change needed here beyond not forcing ISO alignment in the first place.
+
+function pad2(n) {
+  return String(n).padStart(2, '0');
+}
+
+function toISODate(d) {
+  return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
+}
+
+function mondayOf(d) {
+  const date = new Date(d.getFullYear(), d.getMonth(), d.getDate());
+  const day = date.getDay(); // 0=Sun..6=Sat
+  const diff = day === 0 ? -6 : 1 - day;
+  date.setDate(date.getDate() + diff);
+  return date;
+}
+
+function addDays(d, n) {
+  const date = new Date(d.getFullYear(), d.getMonth(), d.getDate());
+  date.setDate(date.getDate() + n);
+  return date;
+}
+
+const MONTH_ABBR = [
+  'Jan',
+  'Feb',
+  'Mar',
+  'Apr',
+  'May',
+  'Jun',
+  'Jul',
+  'Aug',
+  'Sep',
+  'Oct',
+  'Nov',
+  'Dec',
+];
+
+const DAY_NAMES = [
+  'Sunday',
+  'Monday',
+  'Tuesday',
+  'Wednesday',
+  'Thursday',
+  'Friday',
+  'Saturday',
+];
+
+// Fixed "D Mon YYYY" formatting rather than `toLocaleDateString(undefined, …)`
+// — a reader reconciling against the deck needs the exact same wording every
+// time regardless of the browser's locale, and "17 Jul 2026" reads
+// unambiguously as day-month-year everywhere, which a locale-dependent
+// format does not guarantee.
+function fmtDisplayDate(d, { withYear = true } = {}) {
+  const day = d.getDate();
+  const month = MONTH_ABBR[d.getMonth()];
+  return withYear ? `${day} ${month} ${d.getFullYear()}` : `${day} ${month}`;
+}
+
+const weekStart = ref(mondayOf(new Date()));
+const weekEnd = computed(() => addDays(weekStart.value, 6));
+
+// Full dates on both ends, e.g. "17 Jul – 23 Jul 2026" — never "week of X".
+// A reader comparing against Proton's deck needs to see the exact window
+// and confirm it matches, not infer it from a single anchor date. The start
+// date repeats its own year only when it differs from the end date's (a
+// window spanning a year boundary), to avoid "1 Jan 2026 – 1 Jan 2026"-style
+// redundancy on the common case.
+const weekLabel = computed(() => {
+  const start = weekStart.value;
+  const end = weekEnd.value;
+  const sameYear = start.getFullYear() === end.getFullYear();
+  const startLabel = fmtDisplayDate(start, { withYear: !sameYear });
+  const endLabel = fmtDisplayDate(end, { withYear: true });
+  return `${startLabel} – ${endLabel}`;
+});
+
+// States which 7 days of the week this window actually spans (e.g.
+// "Friday–Thursday"), since it's no longer always "Monday–Sunday" once the
+// start date is user-chosen.
+const windowSpanLabel = computed(
+  () =>
+    `${DAY_NAMES[weekStart.value.getDay()]}–${DAY_NAMES[weekEnd.value.getDay()]}`
+);
+
+const periodParams = computed(() => ({
+  from: toISODate(weekStart.value),
+  to: toISODate(weekEnd.value),
+  granularity: 'week',
+}));
+
+// Bound to a plain <input type="date"> — sets `weekStart` to exactly the day
+// picked (no snapping to Monday), so the window can start on any day of the
+// week. Stepping with prevWeek/nextWeek afterwards preserves that start day.
+const weekStartInputValue = computed({
+  get: () => toISODate(weekStart.value),
+  set: val => {
+    if (!val) return;
+    const [y, m, day] = val.split('-').map(Number);
+    weekStart.value = new Date(y, m - 1, day);
+  },
+});
+
+function prevWeek() {
+  weekStart.value = addDays(weekStart.value, -7);
+}
+function nextWeek() {
+  weekStart.value = addDays(weekStart.value, 7);
+}
+// Resets to the current ISO Monday-start week — the default, not the only
+// option; a user reconciling against a Friday-start deck week uses the date
+// input above instead.
+function thisWeek() {
+  weekStart.value = mondayOf(new Date());
+}
+
+// ── Formatting helpers (same convention as ProtonDepartments.vue /
+// ProtonDealerEscalationSection.vue: Number.isNaN, never global isNaN) ────
+
+function fmtNum(n, decimals = 1) {
+  if (n == null || Number.isNaN(Number(n))) return '—';
+  const num = Number(n);
+  return decimals === 0 ? String(Math.round(num)) : num.toFixed(decimals);
+}
+
+function fmtPct(n) {
+  if (n == null || Number.isNaN(Number(n))) return '—';
+  return `${(Number(n) * 100).toFixed(1)}%`;
+}
+
+// ── Period-scoped data: /metrics/volume-by-type, /metrics/lifecycle ──────
+
+const volumeByType = ref(null);
+const lifecycleData = ref(null);
+const loadingPeriod = ref(true);
+const erroredPeriod = ref(null);
+
+async function loadPeriodScoped() {
+  loadingPeriod.value = true;
+  erroredPeriod.value = null;
+  try {
+    const [volumeResult, lifecycleResult] = await Promise.all([
+      getVolumeByType(periodParams.value),
+      getLifecycle(periodParams.value),
+    ]);
+    volumeByType.value = volumeResult;
+    lifecycleData.value = lifecycleResult;
+  } catch (e) {
+    erroredPeriod.value = e.message || 'Failed to load week-scoped data';
+    useAlert('Failed to load week-scoped report data: ' + erroredPeriod.value);
+  } finally {
+    loadingPeriod.value = false;
+  }
+}
+
+watch(weekStart, loadPeriodScoped);
+
+// Missing `scopes.volume` (an old backend deployed ahead of Task 3/the SPA,
+// or genuinely absent for any other reason) defaults to UNAVAILABLE, not OK
+// -- fork patches and the backend deploy independently, so a response that
+// doesn't say "ok" must never be read as if it did. Defaulting to OK here
+// would show a "This week" badge over C1's since-fixed false "0 total
+// cases" for exactly that scenario.
+const volumeScopeStatus = computed(
+  () =>
+    volumeByType.value?.scopes?.volume?.current?.status ??
+    SCOPE_STATUS.UNAVAILABLE
+);
+const volumePreviousScopeStatus = computed(
+  () => volumeByType.value?.scopes?.volume?.previous?.status ?? null
+);
+const volumeRows = computed(() => {
+  if (!scopeHasRenderableRows(volumeScopeStatus.value)) return [];
+  return volumeByType.value?.current?.volume ?? [];
+});
+const volumeDelta = computed(() =>
+  formatDelta(volumeByType.value?.deltas?.volume)
+);
+// Null covers two different situations the API deliberately can't tell
+// apart at the number level (both legitimately serialise as `deltas.volume:
+// null` -- see insights_router.py's `_block_delta`): a genuine first period
+// on record (previous leg is "ok" but its total was zero) vs. a previous
+// leg that couldn't be loaded at all. `scopes.volume.previous.status` is
+// what distinguishes them, so read it rather than leaving both cases behind
+// one "not comparable" string.
+const volumeDeltaReason = computed(() => {
+  if (volumeDelta.value) return null;
+  return volumePreviousScopeStatus.value === SCOPE_STATUS.OK
+    ? 'vs last week: no prior data (nothing recorded the week before)'
+    : 'vs last week: unavailable (previous period could not be loaded)';
+});
+const volumeTotal = computed(() =>
+  volumeRows.value.reduce((sum, r) => sum + (r.volume ?? 0), 0)
+);
+
+const channelMix = computed(() => {
+  const byChannel = new Map();
+  volumeRows.value.forEach(row => {
+    const channel = row.channel ?? 'Unknown';
+    byChannel.set(channel, (byChannel.get(channel) ?? 0) + (row.volume ?? 0));
+  });
+  const total = volumeTotal.value;
+  return Array.from(byChannel.entries())
+    .map(([channel, volume]) => ({
+      channel,
+      volume,
+      sharePct: total > 0 ? volume / total : null,
+    }))
+    .sort((a, b) => b.volume - a.volume);
+});
+
+// `volumeRows` rows are graded at (bucket, channel, case_type, division) --
+// finer than the (case_type, division) the table below displays. A window
+// that spans more than one bucket (any non-ISO-aligned week does, e.g.
+// Proton's own Friday-start 17-23 Jul 2026 straddles ISO weeks W29 and W30)
+// or that mixes channels returns multiple rows per (case_type, division),
+// which rendered as visually-identical duplicate rows before this fix and
+// silently truncated the split under `.slice(TOP_N)`. Aggregated the same
+// way `channelMix` above already aggregates over channel: sum `volume` for
+// every row sharing a (case_type, division) pair, regardless of which
+// bucket or channel it came from. No TOP_N cap here -- (case_type, division)
+// combinations are small and bounded (a handful of case types × divisions),
+// so capping would reintroduce exactly the "table doesn't sum to the
+// headline" problem this fix exists to close.
+const volumeByTypeDivisionAggregated = computed(() => {
+  const byKey = new Map();
+  volumeRows.value.forEach(row => {
+    const caseType = row.case_type ?? 'Unknown';
+    const division = row.division ?? 'Unknown';
+    const key = `${caseType} :: ${division}`;
+    const existing = byKey.get(key);
+    if (existing) {
+      existing.volume += row.volume ?? 0;
+    } else {
+      byKey.set(key, {
+        case_type: caseType,
+        division,
+        volume: row.volume ?? 0,
+      });
+    }
+  });
+  return Array.from(byKey.values()).sort((a, b) => b.volume - a.volume);
+});
+
+const stateTrendScopeStatus = computed(
+  () =>
+    lifecycleData.value?.scopes?.state_trend?.current?.status ??
+    SCOPE_STATUS.UNAVAILABLE
+);
+const stateTrendPreviousScopeStatus = computed(
+  () => lifecycleData.value?.scopes?.state_trend?.previous?.status ?? null
+);
+const stateTrendRows = computed(() => {
+  if (!scopeHasRenderableRows(stateTrendScopeStatus.value)) return [];
+  return lifecycleData.value?.current?.state_trend ?? [];
+});
+const stateTrendDelta = computed(() =>
+  formatDelta(lifecycleData.value?.deltas?.state_trend)
+);
+const stateTrendDeltaReason = computed(() => {
+  if (stateTrendDelta.value) return null;
+  return stateTrendPreviousScopeStatus.value === SCOPE_STATUS.OK
+    ? 'vs last week: no prior data (nothing recorded the week before)'
+    : 'vs last week: unavailable (previous period could not be loaded)';
+});
+const stateTrendTotal = computed(() =>
+  stateTrendRows.value.reduce((sum, r) => sum + (r.cases ?? 0), 0)
+);
+// Same grain mismatch and fix as `volumeByTypeDivisionAggregated` above:
+// `stateTrendRows` is graded at (bucket, status, division), the table shows
+// (division, status) — aggregate across bucket before sorting, no TOP_N cap
+// for the same "must sum to the headline" reason.
+const stateTrendAggregated = computed(() => {
+  const byKey = new Map();
+  stateTrendRows.value.forEach(row => {
+    const division = row.division ?? 'Unknown';
+    const status = row.status ?? 'Unknown';
+    const key = `${division} :: ${status}`;
+    const existing = byKey.get(key);
+    if (existing) {
+      existing.cases += row.cases ?? 0;
+    } else {
+      byKey.set(key, { division, status, cases: row.cases ?? 0 });
+    }
+  });
+  return Array.from(byKey.values()).sort((a, b) => b.cases - a.cases);
+});
+
+// ── All-time data: /metrics/departments, /metrics/callcenter ─────────────
+// Neither endpoint accepts a period (400 if given one — see
+// insights_router.py's `_reject_period`), so these load once and are
+// labelled "All time" (SCOPE_STATUS.UNFILTERED) regardless of the week
+// picker above.
+//
+// Fetched and error-handled independently (two separate loading/errored
+// pairs, two separate calls — NOT a shared Promise.all) so a failure in one
+// endpoint doesn't paint the other section's already-succeeded data with a
+// generic error. Departments & PIC Detail and Call Centre & SLA Performance
+// are unrelated sections and must reflect their own outcome only.
+
+const departments = ref(null);
+const loadingDepartments = ref(true);
+const erroredDepartments = ref(null);
+
+async function loadDepartments() {
+  loadingDepartments.value = true;
+  erroredDepartments.value = null;
+  try {
+    departments.value = await getDepartments();
+  } catch (e) {
+    erroredDepartments.value = e.message || 'Failed to load department data';
+    useAlert('Failed to load department data: ' + erroredDepartments.value);
+  } finally {
+    loadingDepartments.value = false;
+  }
+}
+
+const callCentre = ref(null);
+const loadingCallCentre = ref(true);
+const erroredCallCentre = ref(null);
+
+async function loadCallCentre() {
+  loadingCallCentre.value = true;
+  erroredCallCentre.value = null;
+  try {
+    callCentre.value = await getCallCentre();
+  } catch (e) {
+    erroredCallCentre.value = e.message || 'Failed to load call-centre data';
+    useAlert('Failed to load call-centre data: ' + erroredCallCentre.value);
+  } finally {
+    loadingCallCentre.value = false;
+  }
+}
+
+const deptPicRows = computed(() =>
+  [...(departments.value?.dept_pic ?? [])].slice(0, TOP_N)
+);
+const reopenRows = computed(() =>
+  [...(departments.value?.reopen ?? [])].slice(0, TOP_N)
+);
+const categoryByVehicleModelRows = computed(() =>
+  [...(departments.value?.category_by_vehicle_model ?? [])]
+    .sort((a, b) => (b.cases ?? 0) - (a.cases ?? 0))
+    .slice(0, TOP_N)
+);
+
+const slaRows = computed(() => callCentre.value?.sla ?? []);
+const firstResponseRows = computed(
+  () => callCentre.value?.first_response ?? []
+);
+const resolutionTimeRows = computed(
+  () => callCentre.value?.resolution_time ?? []
+);
+const complaintTypeRows = computed(() =>
+  [...(callCentre.value?.complaint_types ?? [])]
+    .sort((a, b) => (b.cases ?? 0) - (a.cases ?? 0))
+    .slice(0, TOP_N)
+);
+const npsByAgentRows = computed(() => callCentre.value?.nps_by_agent ?? []);
+
+const allTimeHasAnyRows = computed(
+  () =>
+    deptPicRows.value.length > 0 ||
+    reopenRows.value.length > 0 ||
+    categoryByVehicleModelRows.value.length > 0
+);
+const callCentreHasAnyRows = computed(
+  () =>
+    slaRows.value.length > 0 ||
