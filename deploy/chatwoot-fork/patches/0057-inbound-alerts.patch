+// useProtonInboundAlerts.js — OUR file. Subscribes the alert primitives in
+// helper/protonAlerts.js to new inbound customer messages, from inside the
+// Chatwoot bundle.
+//
+// WHY HERE AND NOT IN THE my-tasks IFRAME. A dashboard-app iframe is
+// cross-origin and sandboxed, is only loaded while the agent has that panel
+// open, and cannot know what the agent is looking at. This composable is
+// called from Sidebar.vue, which is mounted on every dashboard page, so
+// alerting is live wherever Chatwoot is.
+//
+// THE EVENT SOURCE. Chatwoot's ActionCable connector writes pushed
+// conversation/message events into the Vuex store — that is how the SPA's own
+// conversation list updates without a refresh — so watching the store IS
+// subscribing to the stream, with no second socket and no second subscription
+// to authenticate.
+//
+// NEVER GO SILENT. If that store path yields nothing, or yields it too late, a
+// 60 s poll of Chatwoot's own conversations API takes over AND a degraded
+// indicator appears. Both paths deduplicate through one shared set keyed on
+// message id, so their overlap on reconnect raises nothing twice. See
+// nextAlertMode/claimAlert in helper/protonAlerts.js for the reasoning; the
+// mechanics are here.
+import { onScopeDispose, ref, watch } from 'vue';
+import { useMapGetter, useStore } from 'dashboard/composables/store';
+import { useProtonConfig } from 'dashboard/composables/useProtonConfig';
+import Auth from 'dashboard/api/auth';
+import { getMyAlertRules } from 'dashboard/api/protonAlerts';
+import {
+  DEFAULT_ALERT_RULES,
+  STREAM_GRACE_MS,
+  STREAM_WATCHDOG_MS,
+  alertKey,
+  claimAlert,
+  conversationSignature,
+  degradedReason,
+  hideAlertStatus,
+  isAlertableCustomerMessage,
+  isConversationInScope,
+  mergeAlertRules,
+  messageCreatedAtMs,
+  messagesOf,
+  nextAlertMode,
+  raiseAlert,
+  readConversations,
+  readInboxIds,
+  resolveModalities,
+  showAlertStatus,
+} from 'dashboard/helper/protonAlerts';
+
+// Sidebar.vue can be re-created (route changes, hot reload). Installing twice
+// would double every alert, which is the same failure as the reconnection race
+// and is prevented the same way: once only, at module scope.
+let installed = false;
+
+const NEW_INBOUND = 'new_inbound';
+
+export function useProtonInboundAlerts() {
+  const { hasFeature } = useProtonConfig();
+  // The fork's real client-side gate. See this patch's header: it is NOT the
+  // same switch as the backend's INBOUND_ALERTS_ENABLED, and nothing here
+  // pretends otherwise. Off → this composable does nothing at all and the
+  // page behaves exactly as it did before this patch.
+  if (!hasFeature('inbound_alerts')) return { enabled: false, mode: ref('off') };
+  if (installed) return { enabled: true, mode: ref('installed-elsewhere') };
+  installed = true;
+
+  const store = useStore();
+  const currentUser = useMapGetter('getCurrentUser');
+  const currentAccountId = useMapGetter('getCurrentAccountId');
+
+  const rules = ref({ ...DEFAULT_ALERT_RULES });
+  const mode = ref('stream');
+  const streamCoverage = ref('none');
+  // Messages that existed before this page loaded are not news. Without this,
+  // every reload replays the morning's backlog as a burst of toasts.
+  const startedAtMs = Date.now();
+  const seen = new Set();
+  let watchdogTimer = null;
+
+  const viewer = () => ({
+    id: currentUser.value && currentUser.value.id,
+    inboxIds: readInboxIds(store),
+    teamIds: [],
+  });
+
+  const paintIndicator = () => {
+    const reason = degradedReason(mode.value, streamCoverage.value === 'list');
+    if (reason) showAlertStatus({ reason });
+    else hideAlertStatus();
+  };
+
+  // Load the agent's resolved rules once. A failure (or ALERT_RULES_ENABLED
+  // off, which answers {disabled:true}) leaves `rules` on the built-in
+  // defaults — mergeAlertRules' whole contract — so alerting works before and
+  // regardless of this call.
+  const loadRules = async () => {
+    try {
+      const agentId = currentUser.value && currentUser.value.id;
+      rules.value = mergeAlertRules(await getMyAlertRules(agentId));
+    } catch (err) {
+      // eslint-disable-next-line no-console
+      console.warn('[proton-alerts]', 'rule fetch failed; using built-in defaults', err);
+      rules.value = mergeAlertRules(null);
+    }
+  };
+
+  // Decide about one message. Returns true only when an alert actually fired.
+  //
+  // The key is claimed BEFORE the modality/scope checks, so "this module has
+  // handled this message" and "this module alerted about it" stay distinct: a
+  // message the rules deliberately ignore must not be re-examined by the poll
+  // for ever, and must not be counted as stream-loss evidence.
+  const consider = (conversation, message) => {
+    if (!isAlertableCustomerMessage(message)) return false;
+    const key = alertKey(NEW_INBOUND, conversation.id, message.id);
+    if (!claimAlert(seen, key)) return false;
+    const rule = rules.value[NEW_INBOUND];
+    const modalities = resolveModalities(rules.value, NEW_INBOUND);
+    if (!modalities.length) return false;
+    if (!isConversationInScope(rule.scope, conversation, viewer())) return false;
+    const meta = conversation.meta || {};
+    const who = (meta.sender && meta.sender.name) || 'Customer';
+    raiseAlert({
+      modalities,
+      title: `New message from ${who}`,
+      body: String(message.content).slice(0, 160),
+      kind: 'info',
+    });
+    return true;
+  };
+
+  // ---- the stream path ----------------------------------------------------
+  const scanStream = () => {
+    const { conversations, coverage } = readConversations(store);
+    streamCoverage.value = coverage;
+    let delivered = false;
+    for (const conversation of conversations) {
+      if (!conversation || !conversation.id) continue;
+      for (const message of messagesOf(conversation)) {
+        if (messageCreatedAtMs(message, Date.now()) < startedAtMs) {
+          // Pre-existing: claim it so the poll does not later mistake it for
+          // evidence the stream is broken, but never alert on it.
+          claimAlert(seen, alertKey(NEW_INBOUND, conversation.id, message && message.id));
+          continue;
+        }
+        if (consider(conversation, message)) delivered = true;
+      }
+    }
+    mode.value = nextAlertMode(mode.value, {
+      streamSourceAvailable: coverage === 'list',
+      streamDelivered: delivered,
+      staleFoundByPoll: false,
+    });
+    paintIndicator();
+  };
+
+  // ---- the fallback poll --------------------------------------------------
+  const authHeaders = () => {
+    const data = Auth.hasAuthCookie() ? Auth.getAuthData() : null;
+    return data
+      ? {
+          'access-token': data['access-token'],
+          'token-type': 'Bearer',
+          client: data.client,
+          uid: data.uid,
+        }
+      : {};
+  };
+
+  // Chatwoot's own conversations API, same-origin, with the same auth headers
+  // the SPA's own axios client sends. `updated_within` is load-bearing: it is
+  // the one branch of ConversationFinder that does NOT paginate. See header.
+  const fetchOpenConversations = async () => {
+    const accountId = currentAccountId.value;
+    if (!accountId) return null;
+    try {
+      const response = await fetch(
+        `/api/v1/accounts/${accountId}/conversations?status=open&sort_by=last_activity_at_desc&updated_within=600`,
+        { headers: authHeaders() }
+      );
+      if (!response.ok) return null;
+      const body = await response.json();
+      const payload =
+        (body && body.data && body.data.payload) || (body && body.payload) || null;
+      return Array.isArray(payload) ? payload : null;
+    } catch (_e) {
+      return null;
+    }
+  };
+
+  const runWatchdog = async () => {
+    // Re-probe the store first: it may have populated after this composable
+    // ran, and a coverage change on its own can end degraded mode.
+    streamCoverage.value = readConversations(store).coverage;
+    const conversations = await fetchOpenConversations();
+    if (conversations === null) {
+      // The poll itself failed. Say nothing new about the stream — but if
+      // there is no stream path either, the indicator must still be up.
+      mode.value = nextAlertMode(mode.value, {
+        streamSourceAvailable: streamCoverage.value === 'list',
+        streamDelivered: false,
+        staleFoundByPoll: false,
+      });
+      paintIndicator();
+      return;
+    }
+    const now = Date.now();
+    let stale = false;
+    for (const conversation of conversations) {
+      if (!conversation || !conversation.id) continue;
+      for (const message of messagesOf(conversation)) {
+        if (!isAlertableCustomerMessage(message)) continue;
+        const createdAt = messageCreatedAtMs(message, now);
+        if (createdAt < startedAtMs) continue;
+        const key = alertKey(NEW_INBOUND, conversation.id, message.id);
+        if (seen.has(key)) continue;
+        // Proof, not inference: this message is old enough that the stream
+        // should have delivered it, and it did not.
+        if (now - createdAt > STREAM_GRACE_MS) stale = true;
+        consider(conversation, message);
+      }
+    }
+    mode.value = nextAlertMode(mode.value, {
+      streamSourceAvailable: streamCoverage.value === 'list',
+      streamDelivered: false,
+      staleFoundByPoll: stale,
+    });
+    paintIndicator();
+  };
+
+  // ---- boot ---------------------------------------------------------------
+  loadRules();
+  scanStream();
+  watch(
+    () => conversationSignature(readConversations(store).conversations),
+    () => scanStream()
+  );
+  watchdogTimer = setInterval(runWatchdog, STREAM_WATCHDOG_MS);
+  onScopeDispose(() => {
+    if (watchdogTimer) clearInterval(watchdogTimer);
+    watchdogTimer = null;
+    installed = false;
+  });
+
+  return { enabled: true, mode, rules, streamCoverage };
+}
diff --git a/app/javascript/dashboard/helper/protonAlerts.js b/app/javascript/dashboard/helper/protonAlerts.js
new file mode 100644
index 0000000..20053fb
--- /dev/null
+++ b/app/javascript/dashboard/helper/protonAlerts.js
@@ -0,0 +1,486 @@
+// protonAlerts.js — OUR file. The three alert primitives (toast, sound,
+// desktop notification), extracted from backend/apps/chatwoot-my-tasks/
+// index.html and moved into the Chatwoot bundle so they fire in the window an
+// agent is actually looking at, plus the decision logic that chooses between
+// them.
+//
+// NOTHING HERE IS A REIMPLEMENTATION. beep(), requestNotificationPermission(),
+// sendDesktopNotification() and toast() are the my-tasks app's own working
+// code, transcribed with only the two changes the new host requires: the toast
+// container is created on demand instead of relying on a static
+// <div id="toasts">, and the notification helpers take an options object. The
+// my-tasks app is NOT modified and keeps its own copies and its own SLA
+// alerts — this is an ADDITION. Trading a working alert surface for a new one
+// would be a net loss.
+//
+// Every decision function below is deliberately PURE — no Vue, no DOM, no
+// network — so it can be executed directly by this patch's tests. The DOM
+// primitives touch `document`/`window` only inside a function body, never at
+// module scope, so importing this file in a non-browser context is safe.
+
+// ---------------------------------------------------------------------------
+// Rules
+// ---------------------------------------------------------------------------
+
+// The six events features/alerts/rules_store.py knows about, in its order.
+export const ALERT_EVENTS = [
+  'assigned_to_me',
+  'new_inbound',
+  'sla_warn',
+  'sla_breach',
+  'escalated',
+  'anomaly',
+];
+
+// The built-in defaults. These MUST match features/alerts/rules_store.py's
+// seeded defaults: they are what fires when the rule store is off, unreachable
+// or has never been configured, and a divergence would mean an agent's
+// preferences page showed one thing while their browser did another.
+//
+// NEW_INBOUND IS TOAST-ONLY, DELIBERATELY. Sound and desktop notification
+// exist for the event and are off. On a tenant where WhatsApp carries most of
+// the volume an audible alert per inbound message is a beep every few seconds,
+// and the first thing every agent does is switch off ALL alerting — including
+// the sla_breach alerts that actually matter. The requirement is met by the
+// capability being present and per-agent configurable, not by the loudest
+// default. If someone later "improves" this to include sound, the patch's
+// tests fail and they have to read this paragraph.
+export const DEFAULT_ALERT_RULES = {
+  assigned_to_me: { scope: 'mine', modalities: ['sound', 'desktop', 'toast'], enabled: true },
+  new_inbound: { scope: 'my_inbox', modalities: ['toast'], enabled: true },
+  sla_warn: { scope: 'mine', modalities: ['toast'], enabled: true },
+  sla_breach: { scope: 'mine', modalities: ['sound', 'desktop', 'toast'], enabled: true },
+  escalated: { scope: 'my_team', modalities: ['toast'], enabled: true },
+  anomaly: { scope: 'all', modalities: ['desktop'], enabled: true },
+};
+
+export const MODALITIES = ['sound', 'desktop', 'toast'];
+export const SCOPES = ['mine', 'my_inbox', 'my_team', 'all'];
+
+// The fallback poll's cadence — the same 60 s the my-tasks app already uses.
+export const STREAM_WATCHDOG_MS = 60000;
+// How late a message may be before its absence from the stream is treated as
+// proof the stream is not delivering. Deliberately larger than a plausible
+// render delay and far smaller than the poll interval.
+export const STREAM_GRACE_MS = 90000;
+export const ALERT_SOUND_HZ = 440;
+export const ALERT_SOUND_MS = 300;
+// Bound on the dedupe set, so a long shift cannot grow it without limit.
+export const MAX_REMEMBERED_ALERT_KEYS = 500;
+
+// ---------------------------------------------------------------------------
+// Pure decision logic
+// ---------------------------------------------------------------------------
+
+// Whether a message is one an agent should be alerted about.
+//
+// THE THREE EXCLUSIONS ARE THE POINT OF THIS FUNCTION. An agent's own reply
+// arrives back down the same stream as the customer's message, and alerting an
+// agent about their own send — their machine beeping at them the instant they
+// hit send — is the fastest way to make this feature contemptible. So:
+//   - `private === true`  → a private note (agent-authored) alerts nobody.
+//   - `message_type !== 0` → 0 is incoming; 1 outgoing (this is the agent's
+//     own reply, and the bot's), 2 activity, 3 template. Only 0 alerts.
+//   - `sender_type === 'User'` → a second, DELIBERATELY REDUNDANT guard. A
+//     User sender is a Chatwoot agent; a Contact sender is the customer. If a
+//     future channel ever delivered an agent-authored message with
+//     message_type 0, the redundant check is what stops the self-notification
+//     bug rather than a code review noticing it.
+export function isAlertableCustomerMessage(message) {
+  if (!message || typeof message !== 'object') return false;
+  if (message.private === true) return false;
+  if (message.message_type !== 0) return false;
+  if (message.sender_type === 'User') return false;
+  return Boolean(message.content);
+}
+
+// Whether a conversation falls inside a rule's scope for this viewer.
+//
+// `my_inbox` and `my_team` FAIL OPEN when the viewer's membership lists are
+// unknown (empty), and that is a decision rather than an oversight: every
+// conversation that reaches this code has already passed Chatwoot's own
+// inbox-visibility rules, so "an inbox I can see" is the wider of the two
+// filters, and silently alerting nothing because a membership lookup came back
+// empty is the failure mode this whole package exists to avoid. An
+// UNRECOGNISED scope, by contrast, alerts NOTHING — a typo in a rule must not
+// quietly widen it to everything.
+export function isConversationInScope(scope, conversation, viewer) {
+  const v = viewer || {};
+  const conv = conversation || {};
+  const meta = conv.meta || {};
+  switch (scope) {
+    case 'all':
+      return true;
+    case 'mine':
+      return Boolean(v.id) && Boolean(meta.assignee) && meta.assignee.id === v.id;
+    case 'my_inbox': {
+      const ids = Array.isArray(v.inboxIds) ? v.inboxIds : [];
+      return ids.length ? ids.includes(conv.inbox_id) : true;
+    }
+    case 'my_team': {
+      const ids = Array.isArray(v.teamIds) ? v.teamIds : [];
+      if (!ids.length) return true;
+      return Boolean(meta.team) && ids.includes(meta.team.id);
+    }
+    default:
+      return false;
+  }
+}
+
+// The modalities that should actually fire for an event. A disabled rule, an
+// unknown event and a rule with no recognised modality all resolve to [] —
+// i.e. to silence for that event only, never to a default.
+export function resolveModalities(rules, event) {
+  const rule = rules && rules[event];
+  if (!rule || rule.enabled === false) return [];
+  const modalities = Array.isArray(rule.modalities) ? rule.modalities : [];
+  return modalities.filter(m => MODALITIES.includes(m));
+}
+
+// Fold GET /alerts/rules/mine's answer onto the built-in defaults.
+//
+// A `{disabled: true}` body (ALERT_RULES_ENABLED off on the tenant), a network
+// failure (caller passes null), or a malformed payload must all leave alerting
+// WORKING on the defaults — never silent. That is the same fail-open position
+// features/alerts/rules_store.py takes for a store outage, for the same
+// reason: an alerting system whose configuration lookup failed must still
+// alert.
+export function mergeAlertRules(payload) {
+  const merged = {};
+  for (const event of ALERT_EVENTS) {
+    merged[event] = { ...DEFAULT_ALERT_RULES[event] };
+  }
+  const rules = payload && !payload.disabled ? payload.rules : null;
+  if (!rules || typeof rules !== 'object') return merged;
+  for (const event of ALERT_EVENTS) {
+    const rule = rules[event];
+    if (!rule || typeof rule !== 'object') continue;
+    merged[event] = {
+      scope: SCOPES.includes(rule.scope) ? rule.scope : merged[event].scope,
+      modalities: Array.isArray(rule.modalities) ? rule.modalities : merged[event].modalities,
+      enabled: rule.enabled !== false,
+    };
+  }
+  return merged;
+}
+
+// ---------------------------------------------------------------------------
+// Stream / poll mode
+// ---------------------------------------------------------------------------
+
+// The mode machine. Two properties matter and both are evidence-based rather
+// than guessed:
+//
+//   - We NEVER conclude "the stream is down" from a quiet period. A shift with
+//     no inbound messages produces no evidence either way, and inventing a
+//     degraded state from silence would put a red strip on every quiet
+//     morning.
+//   - We DO conclude it from the poll finding an inbound message older than
+//     STREAM_GRACE_MS that the stream never delivered. That is proof, not
+//     inference.
+//
+// `streamSourceAvailable === false` (the SPA store exposes no conversation
+// list this module can read) goes straight to poll mode, because in that state
+// there is no stream path at all — visibly degraded and still alerting beats
+// looking healthy and being silent.
+export function nextAlertMode(current, evidence) {
+  const e = evidence || {};
+  if (!e.streamSourceAvailable) return 'poll';
+  if (e.staleFoundByPoll) return 'poll';
+  if (e.streamDelivered) return 'stream';
+  return current;
+}
+
+// What the degraded indicator should say, or null when it should not be shown.
+export function degradedReason(mode, streamSourceAvailable) {
+  if (mode !== 'poll') return null;
+  return streamSourceAvailable ? 'stream-stale' : 'no-stream-source';
+}
+
+export const DEGRADED_TEXT = {
+  'stream-stale': 'Live alerts interrupted — checking every 60s',
+  'no-stream-source': 'Live alerts unavailable — checking every 60s',
+};
+
+// ---------------------------------------------------------------------------
+// Deduplication
+// ---------------------------------------------------------------------------
+
+export function alertKey(event, conversationId, messageId) {
+  return `${event}:${conversationId}:${messageId}`;
+}
+
+// Returns true exactly ONCE per key.
+//
+// THIS IS WHAT MAKES THE RECONNECTION RACE HARMLESS. The stream path and the
+// poll path share one set, so when they briefly overlap — the poll fires, the
+// stream reconnects, and both see the same message — whichever arrives first
+// alerts and the other silently drops. A duplicate-alert storm on reconnect
+// teaches agents to ignore alerts exactly as effectively as a beep every few
+// seconds does, so this is not an optimisation.
+//
+// Keying on the MESSAGE id (not the conversation) is deliberate: a second
+// inbound message on the same conversation is a new thing to know about.
+export function claimAlert(seen, key) {
+  if (!seen || seen.has(key)) return false;
+  seen.add(key);
+  if (seen.size > MAX_REMEMBERED_ALERT_KEYS) {
+    // Sets iterate in insertion order, so this evicts the oldest key.
+    seen.delete(seen.values().next().value);
+  }
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// Reading the SPA's own conversation state
+// ---------------------------------------------------------------------------
+
+// Candidate Vuex getters for the conversation list, tried in order.
+//
+// Chatwoot's ActionCable connector writes pushed conversation/message events
+// into the Vuex store — watching the store IS subscribing to the stream, and
+// it is how the SPA's own conversation list updates without a refresh. Only
+// ONE store getter is verified by this repo's own already-merged patches
+// (`getSelectedChat`, used by 0055), so the list getters below are candidates
+// rather than certainties, and this function reports which one it found.
+// `coverage: 'none'` is handled as "no stream path" (see nextAlertMode) rather
+// than pretended away, so a wrong guess here degrades to a visible 60 s poll
+// instead of to silence, and is fixable by editing this one array.
+export const CONVERSATION_GETTER_CANDIDATES = [
+  'getAllConversations',
+  'conversations/getAllConversations',
+];
+
+export const INBOX_GETTER_CANDIDATES = ['inboxes/getInboxes', 'getInboxes'];
+
+export function readConversations(store) {
+  const getters = (store && store.getters) || {};
+  for (const name of CONVERSATION_GETTER_CANDIDATES) {
+    if (Array.isArray(getters[name])) {
+      return { conversations: getters[name], coverage: 'list' };
+    }
+  }
+  // Last resort: the one getter this repo's own patches prove exists. It
+  // covers only the open conversation, which is NOT the whole surface an
+  // agent needs alerting on, so it counts as 'selected' — degraded, not
+  // healthy.
+  const selected = getters.getSelectedChat;
+  if (selected && selected.id) return { conversations: [selected], coverage: 'selected' };
+  return { conversations: [], coverage: 'none' };
+}
+
+export function readInboxIds(store) {
+  const getters = (store && store.getters) || {};
+  for (const name of INBOX_GETTER_CANDIDATES) {
+    const value = getters[name];
+    if (Array.isArray(value)) {
+      return value.map(inbox => inbox && inbox.id).filter(id => typeof id === 'number');
+    }
+  }
+  return [];
+}
+
+export function messagesOf(conversation) {
+  if (!conversation) return [];
+  if (Array.isArray(conversation.messages)) return conversation.messages;
+  const last = conversation.last_non_activity_message;
+  return last ? [last] : [];
+}
+
+// A cheap string that changes whenever any watched conversation gains a
+// message. Watching this instead of deep-watching the conversation array keeps
+// the watcher off the hot path of every unrelated store mutation.
+export function conversationSignature(conversations) {
+  if (!Array.isArray(conversations)) return '';
+  return conversations
+    .map(conversation => {
+      const messages = messagesOf(conversation);
+      const last = messages.length ? messages[messages.length - 1] : null;
+      return `${conversation && conversation.id}:${messages.length}:${last ? last.id : 0}`;
+    })
+    .join(',');
+}
+
+// Chatwoot serialises message timestamps as epoch SECONDS (`created_at`), and
+// occasionally as an ISO string. A message with no usable timestamp is treated
+// as NEW rather than old: the alternative is dropping a real alert.
+export function messageCreatedAtMs(message, nowMs) {
+  const raw = message && message.created_at;
+  if (typeof raw === 'number' && Number.isFinite(raw)) {
+    return raw > 1e11 ? raw : raw * 1000;
+  }
+  if (typeof raw === 'string') {
+    const parsed = Date.parse(raw);
+    if (!Number.isNaN(parsed)) return parsed;
+  }
+  return nowMs;
+}
+
+// ---------------------------------------------------------------------------
+// The primitives, transcribed from apps/chatwoot-my-tasks/index.html
+// ---------------------------------------------------------------------------
+
+const TOAST_CONTAINER_ID = 'proton-alert-toasts';
+const STATUS_STRIP_ID = 'proton-alert-status';
+
+// Web Audio API — no external file needed. Verbatim from the my-tasks app.
+export function beep(freq, durationMs) {
+  try {
+    const ctx = new (window.AudioContext || window.webkitAudioContext)();
+    const osc = ctx.createOscillator();
+    const gain = ctx.createGain();
+    osc.connect(gain);
+    gain.connect(ctx.destination);
+    osc.frequency.value = freq;
+    osc.type = 'sine';
+    gain.gain.setValueAtTime(0.3, ctx.currentTime);
+    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + durationMs / 1000);
+    osc.start(ctx.currentTime);
+    osc.stop(ctx.currentTime + durationMs / 1000);
+  } catch (_e) {
+    /* audio not available */
+  }
+}
+
+export function notificationPermission() {
+  if (typeof Notification === 'undefined') return 'unsupported';
+  return Notification.permission;
+}
+
+export function sendDesktopNotification(title, body) {
+  if (notificationPermission() !== 'granted') return false;
+  try {
+    const notification = new Notification(title, { body, icon: '' });
+    notification.onclick = () => window.focus();
+    return true;
+  } catch (_e) {
+    return false;
+  }
+}
+
+// A browser that has denied notification permission drops desktop alerts
+// FOREVER and silently. Chrome will not re-prompt after a denial either, so
+// this both re-requests (which works from 'default') and, when the answer is
+// still 'denied', tells the agent the only thing that can actually fix it.
+export function requestNotificationPermission() {
+  if (typeof Notification === 'undefined') {
+    toast('warning', 'This browser does not support desktop notifications.');
+    return Promise.resolve('unsupported');
+  }
+  return Notification.requestPermission().then(permission => {
+    if (permission === 'granted') {
+      toast('success', 'Desktop notifications enabled.');
+      hideAlertStatus();
+    } else {
+      toast(
+        'warning',
+        'Notification permission is blocked. Allow notifications for this site in your browser settings.'
+      );
+    }
+    return permission;
+  });
+}
+
+function ensureStyles() {
+  if (document.getElementById('proton-alert-styles')) return;
+  const style = document.createElement('style');
+  style.id = 'proton-alert-styles';
+  style.textContent = [
+    `#${TOAST_CONTAINER_ID}{position:fixed;top:14px;right:14px;display:flex;`,
+    'flex-direction:column;gap:6px;z-index:9999;max-width:320px;}',
+    `#${TOAST_CONTAINER_ID} .proton-toast{padding:9px 12px;border-radius:4px;`,
+    'font-size:12px;color:#fff;box-shadow:0 2px 8px rgba(0,0,0,.15);}',
+    `#${TOAST_CONTAINER_ID} .proton-toast.success{background:#34a853;}`,
+    `#${TOAST_CONTAINER_ID} .proton-toast.error{background:#ea4335;}`,
+    `#${TOAST_CONTAINER_ID} .proton-toast.warning{background:#f9ab00;color:#333;}`,
+    `#${TOAST_CONTAINER_ID} .proton-toast.info{background:#1a73e8;}`,
+    `#${STATUS_STRIP_ID}{position:fixed;bottom:12px;left:12px;z-index:9999;`,
+    'display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:4px;',
+    'font-size:11px;background:#fef7e0;border:1px solid #f9ab00;color:#7a4f01;}',
+    `#${STATUS_STRIP_ID} button{font-size:11px;padding:2px 8px;cursor:pointer;`,
+    'border:1px solid #b06000;border-radius:3px;background:#fff;color:#7a4f01;}',
+  ].join('');
+  document.head.appendChild(style);
+}
+
+function toastContainer() {
+  ensureStyles();
+  let container = document.getElementById(TOAST_CONTAINER_ID);
+  if (!container) {
+    container = document.createElement('div');
+    container.id = TOAST_CONTAINER_ID;
+    document.body.appendChild(container);
+  }
+  return container;
+}
+
+export function toast(kind, message) {
+  const el = document.createElement('div');
+  el.className = `proton-toast ${kind}`;
+  el.textContent = message;
+  toastContainer().appendChild(el);
+  setTimeout(() => el.remove(), 6000);
+  return el;
+}
+
+// The degraded indicator AND the denied-permission affordance share one strip,
+// because they are the same message to the agent: "alerting is not doing
+// everything you think it is doing, and here is the fix." Silent failure in an
+// alerting system is the worst outcome available, so this strip is the one
+// piece of UI in this patch that must never be optional.
+export function showAlertStatus({ reason = null, permissionDenied = false } = {}) {
+  if (!reason && !permissionDenied) return hideAlertStatus();
+  ensureStyles();
+  let strip = document.getElementById(STATUS_STRIP_ID);
+  if (!strip) {
+    strip = document.createElement('div');
+    strip.id = STATUS_STRIP_ID;
+    document.body.appendChild(strip);
+  }
+  strip.textContent = '';
+  const label = document.createElement('span');
+  const parts = [];
+  if (reason) parts.push(DEGRADED_TEXT[reason] || DEGRADED_TEXT['no-stream-source']);
+  if (permissionDenied) parts.push('Desktop notifications are blocked');
+  label.textContent = parts.join(' · ');
+  strip.appendChild(label);
+  if (permissionDenied) {
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.textContent = 'Enable notifications';
+    button.addEventListener('click', () => requestNotificationPermission());
+    strip.appendChild(button);
+  }
+  return strip;
+}
+
+export function hideAlertStatus() {
+  const strip = document.getElementById(STATUS_STRIP_ID);
+  if (strip) strip.remove();
+  return null;
+}
+
+// The single entry point every event goes through. Returns the modalities that
+// actually fired, so the caller can log what happened rather than what it
+// asked for.
+export function raiseAlert({ modalities = [], title = '', body = '', kind = 'info' } = {}) {
+  const fired = [];
+  if (modalities.includes('toast')) {
+    toast(kind, title ? `${title} — ${body}` : body);
+    fired.push('toast');
+  }
+  if (modalities.includes('sound')) {
+    beep(ALERT_SOUND_HZ, ALERT_SOUND_MS);
+    fired.push('sound');
+  }
+  if (modalities.includes('desktop')) {
+    if (sendDesktopNotification(title, body)) {
+      fired.push('desktop');
+    } else if (notificationPermission() === 'denied') {
+      // Configured for desktop, permanently blocked by the browser: surface
+      // it with the re-request affordance rather than dropping it forever.
+      showAlertStatus({ permissionDenied: true });
+    }
+  }
+  return fired;
+}
