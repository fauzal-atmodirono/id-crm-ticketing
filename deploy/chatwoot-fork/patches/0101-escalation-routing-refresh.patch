+++ b/app/javascript/dashboard/views/escalationRouting/OverviewTab.vue
@@ -0,0 +1,149 @@
+<script setup>
+// Overview tab (patch 0101): is the ladder sending, what is misconfigured, and
+// what is escalating right now. Everything here is derived from the data the
+// page shell already loaded -- this tab makes no request of its own.
+import { computed } from 'vue';
+import LadderStatusBanner from './LadderStatusBanner.vue';
+import { attentionItems, rowGap } from './routingHelpers';
+
+const props = defineProps({
+  pics: { type: Array, default: () => [] },
+  dealers: { type: Array, default: () => [] },
+  effective: { type: Object, default: null },
+  inFlight: { type: Array, default: () => [] },
+  inFlightError: { type: String, default: '' },
+  loadingInFlight: { type: Boolean, default: false },
+  labels: { type: Object, default: () => ({}) },
+  stateLabel: { type: Function, required: true },
+});
+const emit = defineEmits(['open-record', 'open-tab']);
+
+const items = computed(() => attentionItems(props.pics, props.dealers, props.labels));
+
+const rows = computed(() =>
+  props.inFlight.map(row => {
+    const gap = rowGap(row, props.dealers);
+    let due = '—';
+    if (row.next_due_in_working_hours === 0) due = 'due now';
+    else if (row.next_due_in_working_hours !== null && row.next_due_in_working_hours !== undefined)
+      due = `step ${row.next_step_no ?? '?'} in ${row.next_due_in_working_hours} h`;
+    let chip = { text: props.stateLabel(row.state), tone: 'bg-n-slate-3 text-n-slate-11' };
+    if (gap) chip = { text: 'Gap', tone: 'bg-n-ruby-3 text-n-ruby-11' };
+    else if (row.state === 'climbing') chip = { text: 'Climbing', tone: 'bg-n-blue-3 text-n-blue-11' };
+    return {
+      ...row,
+      where: row.rung ? `Step ${row.rung}` : '—',
+      next: gap || due,
+      chip,
+    };
+  })
+);
+
+const steps = [
+  'The agent adds a dept_… label and, for a dealer case, a dealer_… label.',
+  'The escalate label emails the people set on the Departments and Dealers tabs.',
+  "If the dealer doesn't reply, the ladder emails someone more senior at each step.",
+];
+</script>
+
+<template>
+  <div class="flex flex-col gap-6">
+    <LadderStatusBanner :effective="effective" show-link @open-ladder="emit('open-tab', 'ladder')" />
+
+    <div class="grid gap-5 grid-cols-[repeat(auto-fit,minmax(340px,1fr))]">
+      <section class="flex flex-col gap-3 p-5 border rounded-xl border-n-weak" aria-labelledby="er-attention">
+        <div class="flex items-baseline justify-between">
+          <h2 id="er-attention" class="text-sm font-semibold text-n-slate-12">Needs attention</h2>
+          <span class="text-xs text-n-slate-11">
+            {{ items.length ? `${items.length} item${items.length === 1 ? '' : 's'}` : 'All set' }}
+          </span>
+        </div>
+        <p v-if="!items.length" class="text-sm text-n-slate-11">
+          Every department and {{ labels.partnerLower || 'dealer' }} you can see has someone to email at each step.
+        </p>
+        <ul v-else class="flex flex-col">
+          <li
+            v-for="item in items"
+            :key="`${item.kind}-${item.id}-${item.text}`"
+            class="flex items-start gap-3 py-3 border-t border-n-weak first:border-t-0"
+          >
+            <span
+              class="mt-1.5 rounded-full size-2 shrink-0"
+              :class="item.severity === 'high' ? 'bg-n-ruby-9' : 'bg-n-amber-9'"
+              aria-hidden="true"
+            />
+            <div class="flex flex-col flex-1 min-w-0 gap-0.5">
+              <span class="text-sm text-n-slate-12">{{ item.text }}</span>
+              <span class="text-xs text-n-slate-11">{{ item.detail }}</span>
+            </div>
+            <button
+              type="button"
+              class="text-sm font-medium text-n-brand hover:underline"
+              @click="emit('open-record', { kind: item.kind, id: item.id })"
+            >
+              Fix
+            </button>
+          </li>
+        </ul>
+      </section>
+
+      <section class="flex flex-col gap-3 p-5 border rounded-xl border-n-weak" aria-labelledby="er-how">
+        <h2 id="er-how" class="text-sm font-semibold text-n-slate-12">How a case is routed</h2>
+        <ol class="flex flex-col gap-3">
+          <li v-for="(text, i) in steps" :key="i" class="flex gap-3 text-sm text-n-slate-12">
+            <span class="flex items-center justify-center text-xs font-semibold rounded-full size-6 shrink-0 bg-n-blue-3 text-n-blue-11">
+              {{ i + 1 }}
+            </span>
+            <span class="leading-relaxed">{{ text }}</span>
+          </li>
+        </ol>
+      </section>
+    </div>
+
+    <section class="overflow-hidden border rounded-xl border-n-weak" aria-labelledby="er-flight">
+      <div class="flex items-baseline justify-between px-5 py-4">
+        <h2 id="er-flight" class="text-sm font-semibold text-n-slate-12">
+          Escalations in flight ({{ inFlight.length }})
+        </h2>
+      </div>
+      <p v-if="inFlightError" class="px-5 pb-4 text-sm text-n-ruby-11">{{ inFlightError }}</p>
+      <p v-else-if="loadingInFlight" class="px-5 pb-4 text-sm text-n-slate-11">Loading…</p>
+      <p v-else-if="!inFlight.length" class="px-5 pb-4 text-sm text-n-slate-11">No escalated cases right now.</p>
+      <div v-else class="overflow-x-auto">
+        <table class="w-full text-sm border-collapse">
+          <thead>
+            <tr class="text-left bg-n-alpha-black1 text-n-slate-11">
+              <th class="px-5 py-2.5 font-medium">Case</th>
+              <th class="px-5 py-2.5 font-medium">{{ labels.partnerTitle || 'Dealer' }}</th>
+              <th class="px-5 py-2.5 font-medium">Where it is</th>
+              <th class="px-5 py-2.5 font-medium">Next</th>
+              <th class="px-5 py-2.5 font-medium">State</th>
+            </tr>
+          </thead>
+          <tbody>
+            <tr v-for="row in rows" :key="row.conv_id" class="border-t border-n-weak">
+              <td class="px-5 py-3">
+                <router-link
+                  :to="{ name: 'inbox_conversation', params: { conversation_id: row.conv_id } }"
+                  class="font-medium text-n-brand hover:underline"
+                >
+                  #{{ row.conv_id }}
+                </router-link>
+              </td>
+              <td class="px-5 py-3 text-n-slate-12">{{ row.dealer || '—' }}</td>
+              <td class="px-5 py-3 text-n-slate-11">{{ row.where }}</td>
+              <td class="px-5 py-3" :class="row.chip.text === 'Gap' ? 'text-n-ruby-11' : 'text-n-slate-11'">
+                {{ row.next }}
+              </td>
+              <td class="px-5 py-3">
+                <span class="px-2.5 py-0.5 text-xs font-medium rounded-full" :class="row.chip.tone">
+                  {{ row.chip.text }}
+                </span>
+              </td>
+            </tr>
+          </tbody>
+        </table>
+      </div>
+    </section>
+  </div>
+</template>
diff --git a/app/javascript/dashboard/views/escalationRouting/PicDrawer.vue b/app/javascript/dashboard/views/escalationRouting/PicDrawer.vue
new file mode 100644
index 0000000..86d0e17
