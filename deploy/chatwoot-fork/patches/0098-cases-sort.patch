+// CASE-002: re-applies the chosen order to already-fetched rows and drops
+// duplicate ids. Pages are fetched one after another, so a case created or
+// updated mid-load can shift across a page boundary and appear twice or out
+// of place; this makes the final list really be in the selected order.
+// Ties (same second) fall back to the case id in the same direction.
+export function sortCaseRows(rows, sortBy) {
+  const seen = new Set();
+  const unique = rows.filter(row => {
+    if (seen.has(row.id)) return false;
+    seen.add(row.id);
+    return true;
+  });
+  const key =
+    sortBy === 'last_activity_at_desc' ? 'lastActivityAt' : 'createdAt';
+  const dir = sortBy === 'created_at_asc' ? 1 : -1;
+  return unique.sort(
+    (a, b) =>
+      dir * ((Number(a[key]) || 0) - (Number(b[key]) || 0)) ||
+      dir * ((Number(a.id) || 0) - (Number(b.id) || 0))
+  );
+}
