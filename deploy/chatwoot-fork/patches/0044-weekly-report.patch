diff --git a/app/javascript/dashboard/routes/dashboard/settings/reports/ProtonWeeklyReport.vue b/app/javascript/dashboard/routes/dashboard/settings/reports/ProtonWeeklyReport.vue
new file mode 100644
index 0000000..fd211d6
--- /dev/null
+++ b/app/javascript/dashboard/routes/dashboard/settings/reports/ProtonWeeklyReport.vue
@@ -0,0 +1,1108 @@
+<!-- ProtonWeeklyReport.vue — OUR file. Package E (reporting deck parity),
+     Task 4: one page, sections in the weekly deck's own order (see
+     docs/superpowers/specs/2026-08-04-pkg-e-reporting-deck-parity-design.md
+     §2 "Weekly (16 slides)"), each carrying a week picker and a
+     week-over-week delta beside its headline number.
+
+     Composition, not new chart components: the dealer-escalation, SLA-
+     compliance, and WIP-aging sections below are patch 0034's
+     ProtonDealerEscalationSection / ProtonSlaComplianceSection /
+     ProtonWipAgingSection, unmodified, embedded as-is (per the Task 4
+     brief). ProtonCallCentrePlaceholder (also 0034) is reused for the same
+     reason: it already says, honestly, that telephony metrics (AHT/AQT/
+     abandoned calls/SLA-within-20s -- gap G2 in the spec) aren't built yet.
+     ProtonCasesTable + fetchAllCases are Package D's seam (see
+     dashboard/api/protonCases.js's file-header comment), reused here for the
+     per-case detail table rather than re-implementing pagination/row
+     mapping.
+
+     Only two of the endpoints this page reads are genuinely period-capable
+     at the HTTP layer today: /metrics/lifecycle and /metrics/volume-by-type
+     (see insights_router.py). /metrics/departments, /metrics/callcenter,
+     /metrics/dealer-escalation, /metrics/sla-buckets, and /metrics/case-aging
+     all 400 if given period params -- their underlying views have no date
+     column -- so they're fetched with no period at all and labelled "All
+     time" throughout this page (reportScope.js's SCOPE_STATUS.UNFILTERED).
+     /metrics/dashboard is deliberately NOT used here even though its
+     `volume` block overlaps with volume-by-type's channel breakdown: its
+     HTTP route never wires up from/to/granularity (see protonMetrics.js's
+     getDashboard comment), and volume-by-type's rows already carry `channel`
+     alongside `case_type`/`division`, so the channel-mix and type/division
+     cuts below both come from the one genuinely week-scoped endpoint rather
+     than mixing in an endpoint that can't actually honour the picker. -->
+<script setup>
+import { ref, computed, onMounted, watch } from 'vue';
+import { useAlert } from 'dashboard/composables';
+import V4Button from 'dashboard/components-next/button/Button.vue';
+import ReportHeader from './components/ReportHeader.vue';
+import ProtonScopeBadge from './components/proton/ProtonScopeBadge.vue';
+import ProtonDealerEscalationSection from './components/proton/ProtonDealerEscalationSection.vue';
+import ProtonSlaComplianceSection from './components/proton/ProtonSlaComplianceSection.vue';
+import ProtonWipAgingSection from './components/proton/ProtonWipAgingSection.vue';
+import ProtonCallCentrePlaceholder from './components/proton/ProtonCallCentrePlaceholder.vue';
+import ProtonCasesTable from 'dashboard/components/widgets/ProtonCasesTable.vue';
+import { fetchAllCases } from 'dashboard/api/protonCases';
+import {
+  getVolumeByType,
+  getLifecycle,
+  getDepartments,
+  getCallCentre,
+} from 'dashboard/api/protonMetrics';
+import {
+  SCOPE_STATUS,
+  scopeEmptyMessage,
+  scopeHasRenderableRows,
+  formatDelta,
+} from './components/proton/reportScope';
+
+const TOP_N = 10;
+
+// ── Week picker ──────────────────────────────────────────────────────────
+// Weeks are ISO calendar weeks (Monday-Sunday), matching the backend's own
+// `bucket_key` (period.py: `date.isocalendar()`, not `strftime("%Y-%W")`,
+// specifically so a week never splits across a month boundary).
+
+function pad2(n) {
+  return String(n).padStart(2, '0');
+}
+
+function toISODate(d) {
+  return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
+}
+
+function mondayOf(d) {
+  const date = new Date(d.getFullYear(), d.getMonth(), d.getDate());
+  const day = date.getDay(); // 0=Sun..6=Sat
+  const diff = day === 0 ? -6 : 1 - day;
+  date.setDate(date.getDate() + diff);
+  return date;
+}
+
+function addDays(d, n) {
+  const date = new Date(d.getFullYear(), d.getMonth(), d.getDate());
+  date.setDate(date.getDate() + n);
+  return date;
+}
+
+function fmtDisplayDate(d) {
+  return d.toLocaleDateString(undefined, {
+    day: 'numeric',
+    month: 'short',
+    year: 'numeric',
+  });
+}
+
+const weekStart = ref(mondayOf(new Date()));
+const weekEnd = computed(() => addDays(weekStart.value, 6));
+const weekLabel = computed(
+  () => `${fmtDisplayDate(weekStart.value)} – ${fmtDisplayDate(weekEnd.value)}`
+);
+
+const periodParams = computed(() => ({
+  from: toISODate(weekStart.value),
+  to: toISODate(weekEnd.value),
+  granularity: 'week',
+}));
+
+// Bound to a plain <input type="date"> — any day picked snaps to that day's
+// Monday, so the picker always represents a full ISO week rather than an
+// arbitrary 7-day window starting on whatever day was clicked.
+const weekStartInputValue = computed({
+  get: () => toISODate(weekStart.value),
+  set: val => {
+    if (!val) return;
+    const [y, m, day] = val.split('-').map(Number);
+    weekStart.value = mondayOf(new Date(y, m - 1, day));
+  },
+});
+
+function prevWeek() {
+  weekStart.value = addDays(weekStart.value, -7);
+}
+function nextWeek() {
+  weekStart.value = addDays(weekStart.value, 7);
+}
+function thisWeek() {
+  weekStart.value = mondayOf(new Date());
+}
+
+// ── Formatting helpers (same convention as ProtonDepartments.vue /
+// ProtonDealerEscalationSection.vue: Number.isNaN, never global isNaN) ────
+
+function fmtNum(n, decimals = 1) {
+  if (n == null || Number.isNaN(Number(n))) return '—';
+  const num = Number(n);
+  return decimals === 0 ? String(Math.round(num)) : num.toFixed(decimals);
+}
+
+function fmtPct(n) {
+  if (n == null || Number.isNaN(Number(n))) return '—';
+  return `${(Number(n) * 100).toFixed(1)}%`;
+}
+
+// ── Period-scoped data: /metrics/volume-by-type, /metrics/lifecycle ──────
+
+const volumeByType = ref(null);
+const lifecycleData = ref(null);
+const loadingPeriod = ref(true);
+const erroredPeriod = ref(null);
+
+async function loadPeriodScoped() {
+  loadingPeriod.value = true;
+  erroredPeriod.value = null;
+  try {
+    const [volumeResult, lifecycleResult] = await Promise.all([
+      getVolumeByType(periodParams.value),
+      getLifecycle(periodParams.value),
+    ]);
+    volumeByType.value = volumeResult;
+    lifecycleData.value = lifecycleResult;
+  } catch (e) {
+    erroredPeriod.value = e.message || 'Failed to load week-scoped data';
+    useAlert('Failed to load week-scoped report data: ' + erroredPeriod.value);
+  } finally {
+    loadingPeriod.value = false;
+  }
+}
+
+watch(weekStart, loadPeriodScoped);
+
+const volumeScopeStatus = computed(
+  () => volumeByType.value?.scopes?.volume?.current?.status ?? SCOPE_STATUS.OK
+);
+const volumeRows = computed(() => {
+  if (!scopeHasRenderableRows(volumeScopeStatus.value)) return [];
+  return volumeByType.value?.current?.volume ?? [];
+});
+const volumeDelta = computed(() =>
+  formatDelta(volumeByType.value?.deltas?.volume)
+);
+const volumeTotal = computed(() =>
+  volumeRows.value.reduce((sum, r) => sum + (r.volume ?? 0), 0)
+);
+
+const channelMix = computed(() => {
+  const byChannel = new Map();
+  volumeRows.value.forEach(row => {
+    const channel = row.channel ?? 'Unknown';
+    byChannel.set(channel, (byChannel.get(channel) ?? 0) + (row.volume ?? 0));
+  });
+  const total = volumeTotal.value;
+  return Array.from(byChannel.entries())
+    .map(([channel, volume]) => ({
+      channel,
+      volume,
+      sharePct: total > 0 ? volume / total : null,
+    }))
+    .sort((a, b) => b.volume - a.volume);
+});
+
+const volumeByTypeDivision = computed(() =>
+  [...volumeRows.value]
+    .sort((a, b) => (b.volume ?? 0) - (a.volume ?? 0))
+    .slice(0, TOP_N)
+);
+
+const stateTrendScopeStatus = computed(
+  () =>
+    lifecycleData.value?.scopes?.state_trend?.current?.status ?? SCOPE_STATUS.OK
+);
+const stateTrendRows = computed(() => {
+  if (!scopeHasRenderableRows(stateTrendScopeStatus.value)) return [];
+  return lifecycleData.value?.current?.state_trend ?? [];
+});
+const stateTrendDelta = computed(() =>
+  formatDelta(lifecycleData.value?.deltas?.state_trend)
+);
+const stateTrendTotal = computed(() =>
+  stateTrendRows.value.reduce((sum, r) => sum + (r.cases ?? 0), 0)
+);
+const sortedStateTrend = computed(() =>
+  [...stateTrendRows.value]
+    .sort((a, b) => (b.cases ?? 0) - (a.cases ?? 0))
+    .slice(0, TOP_N)
+);
+
+// ── All-time data: /metrics/departments, /metrics/callcenter ─────────────
+// Neither endpoint accepts a period (400 if given one — see
+// insights_router.py's `_reject_period`), so these load once and are
+// labelled "All time" (SCOPE_STATUS.UNFILTERED) regardless of the week
+// picker above.
+
+const departments = ref(null);
+const callCentre = ref(null);
+const loadingAllTime = ref(true);
+const erroredAllTime = ref(null);
+
+async function loadAllTime() {
+  loadingAllTime.value = true;
+  erroredAllTime.value = null;
+  try {
+    const [departmentsResult, callCentreResult] = await Promise.all([
+      getDepartments(),
+      getCallCentre(),
+    ]);
+    departments.value = departmentsResult;
+    callCentre.value = callCentreResult;
+  } catch (e) {
+    erroredAllTime.value = e.message || 'Failed to load all-time data';
+    useAlert('Failed to load all-time report data: ' + erroredAllTime.value);
+  } finally {
+    loadingAllTime.value = false;
+  }
+}
+
+const deptPicRows = computed(() =>
+  [...(departments.value?.dept_pic ?? [])].slice(0, TOP_N)
+);
+const reopenRows = computed(() =>
+  [...(departments.value?.reopen ?? [])].slice(0, TOP_N)
+);
+const categoryByVehicleModelRows = computed(() =>
+  [...(departments.value?.category_by_vehicle_model ?? [])]
+    .sort((a, b) => (b.cases ?? 0) - (a.cases ?? 0))
+    .slice(0, TOP_N)
+);
+
+const slaRows = computed(() => callCentre.value?.sla ?? []);
+const firstResponseRows = computed(
+  () => callCentre.value?.first_response ?? []
+);
+const resolutionTimeRows = computed(
+  () => callCentre.value?.resolution_time ?? []
+);
+const complaintTypeRows = computed(() =>
+  [...(callCentre.value?.complaint_types ?? [])]
+    .sort((a, b) => (b.cases ?? 0) - (a.cases ?? 0))
+    .slice(0, TOP_N)
+);
+const npsByAgentRows = computed(() => callCentre.value?.nps_by_agent ?? []);
+
+const allTimeHasAnyRows = computed(
+  () =>
+    deptPicRows.value.length > 0 ||
+    reopenRows.value.length > 0 ||
+    categoryByVehicleModelRows.value.length > 0
+);
+const callCentreHasAnyRows = computed(
+  () =>
+    slaRows.value.length > 0 ||
+    firstResponseRows.value.length > 0 ||
+    resolutionTimeRows.value.length > 0 ||
+    complaintTypeRows.value.length > 0 ||
+    npsByAgentRows.value.length > 0
+);
+
+// ── Per-case detail (this week): Package D's Cases-list seam ─────────────
+// fetchAllCases() reads existing Chatwoot conversation data directly (no
+// BigQuery, no period support server-side), so the week filter here is
+// applied client-side against each case's raw `createdAt` (unix epoch
+// seconds — see protonCases.js). This is the one section on the page whose
+// "This week" scoping is computed here rather than returned by the API.
+
+const allCases = ref([]);
+const loadingCases = ref(true);
+const erroredCases = ref(null);
+const casesTruncated = ref(false);
+const casesFetchedCount = ref(0);
+const casesTotalCount = ref(0);
+
+async function loadCases() {
+  loadingCases.value = true;
+  erroredCases.value = null;
+  try {
+    const { rows, truncated, fetchedCount, totalCount } = await fetchAllCases();
+    allCases.value = rows;
+    casesTruncated.value = truncated;
+    casesFetchedCount.value = fetchedCount;
+    casesTotalCount.value = totalCount;
+  } catch (e) {
+    erroredCases.value = e.message || 'Failed to load cases';
+    useAlert('Failed to load cases: ' + erroredCases.value);
+  } finally {
+    loadingCases.value = false;
+  }
+}
+
+const weekCases = computed(() => {
+  const startSeconds = Math.floor(weekStart.value.getTime() / 1000);
+  // End of Sunday: start of the following Monday, minus one second.
+  const endSeconds =
+    Math.floor(addDays(weekStart.value, 7).getTime() / 1000) - 1;
+  return allCases.value.filter(row => {
+    const created = Number(row.createdAt);
+    if (!row.createdAt || Number.isNaN(created)) return false;
+    return created >= startSeconds && created <= endSeconds;
+  });
+});
+
+onMounted(() => {
+  loadPeriodScoped();
+  loadAllTime();
+  loadCases();
+});
+</script>
+
+<template>
+  <ReportHeader
+    header-title="Weekly Report"
+    header-description="Every number in Proton's weekly deck, read off one screen instead of collated by hand."
+  />
+
+  <!-- Week picker ─────────────────────────────────────────────────────── -->
+  <div
+    class="flex flex-wrap items-center gap-3 mb-6 shadow outline-1 outline outline-n-container rounded-xl bg-n-solid-2 px-6 py-4"
+  >
+    <V4Button
+      icon="i-lucide-chevron-left"
+      variant="ghost"
+      color="slate"
+      size="sm"
+      @click="prevWeek"
+    />
+    <div class="flex flex-col items-center min-w-48">
+      <span class="text-sm font-semibold text-n-slate-12">{{ weekLabel }}</span>
+      <span class="text-xs text-n-slate-10">ISO week, Monday–Sunday</span>
+    </div>
+    <V4Button
+      icon="i-lucide-chevron-right"
+      variant="ghost"
+      color="slate"
+      size="sm"
+      @click="nextWeek"
+    />
+    <button
+      type="button"
+      class="px-3 py-1.5 text-sm text-n-slate-11 hover:underline"
+      @click="thisWeek"
+    >
+      This week
+    </button>
+    <div class="flex items-center gap-2 ml-auto">
+      <label class="text-xs text-n-slate-11" for="weekly-report-date">
+        Jump to week containing
+      </label>
+      <input
+        id="weekly-report-date"
+        v-model="weekStartInputValue"
+        type="date"
+        class="px-3 py-1.5 text-sm border rounded-lg border-n-weak bg-n-alpha-black2 text-n-slate-12"
+      />
+    </div>
+  </div>
+
+  <!-- Definitions ─────────────────────────────────────────────────────── -->
+  <div
+    class="mb-6 shadow outline-1 outline outline-n-container rounded-xl bg-n-solid-2 px-6 py-5"
+  >
+    <h3 class="text-sm font-semibold text-n-slate-12 mb-3">Definitions</h3>
+    <ul
+      class="flex flex-col gap-2 text-sm text-n-slate-11 list-disc list-inside"
+    >
+      <li>
+        <strong class="text-n-slate-12">A case</strong> is one CRM conversation
+        with a known creation time — one case per conversation, not per message.
+      </li>
+      <li>
+        <strong class="text-n-slate-12"
+          >The clock starts at case creation.</strong
+        >
+        First-response time and resolution time are both measured from
+        <code>created_at</code>; reopening a case does not reset its original
+        creation clock (reopen count is tracked separately).
+      </li>
+      <li>
+        <strong class="text-n-slate-12">Dealer-escalation turnaround</strong>
+        is measured from the moment a case is stamped as escalated to a dealer,
+        not from case creation — time spent unescalated does not count against a
+        dealer.
+      </li>
+      <li>
+        <strong class="text-n-slate-12">Work-in-progress / aging</strong>
+        counts only cases currently open or pending; age is calculated as of
+        now, in days since creation, bucketed 1–3 / 4–6 / 7+ days.
+      </li>
+      <li>
+        <strong class="text-n-slate-12">A week</strong> is an ISO calendar week
+        (Monday through Sunday) — the same boundary the week picker above and
+        the backend's own bucketing use.
+      </li>
+      <li>
+        <strong class="text-n-slate-12">"wh" in SLA buckets</strong> means
+        working hours, not calendar hours.
+      </li>
+      <li>
+        <strong class="text-n-slate-12">Known gaps:</strong> car plate,
+        purchased-from dealer, and delay reason are not yet captured on every
+        case (backfill is manual — see the per-case table below for which fields
+        are populated); call-centre telephony metrics (average handling time,
+        average queue time, abandoned calls, SLA-within-20- seconds) are not
+        built yet — they need call data this CRM does not ingest today.
+      </li>
+    </ul>
+  </div>
+
+  <!-- Section: Case Volume — This Week (volume-by-type) ─────────────────── -->
+  <div
+    class="mb-6 shadow outline-1 outline outline-n-container rounded-xl bg-n-solid-2 px-6 py-5"
+  >
+    <div class="flex items-center gap-2 mb-1">
+      <h3 class="text-sm font-semibold text-n-slate-12">Case Volume</h3>
+      <ProtonScopeBadge :status="volumeScopeStatus" />
+    </div>
+    <div class="flex items-baseline gap-2 mb-4">
+      <span class="text-2xl font-semibold tabular-nums text-n-slate-12">
+        {{ fmtNum(volumeTotal, 0) }}
+      </span>
+      <span class="text-sm text-n-slate-11">total cases</span>
+      <span v-if="volumeDelta" class="text-sm font-medium text-n-slate-11">
+        {{ volumeDelta }} vs last week
+      </span>
+      <span v-else class="text-sm text-n-slate-10">
+        vs last week: not comparable
+      </span>
+    </div>
+
+    <woot-loading-state
+      v-if="loadingPeriod"
+      class="text-xs"
+      message="Loading case volume…"
+    />
+    <div v-else-if="erroredPeriod" class="text-sm text-n-slate-10">
+      {{ erroredPeriod }}
+    </div>
+    <div
+      v-else-if="!volumeRows.length"
+      class="flex items-center justify-center h-16 text-sm text-n-slate-10"
+    >
+      {{ scopeEmptyMessage(volumeScopeStatus) }}
