+// GET /kb/inboxes/{inbox_id}/timing -> { idle_warn_minutes,
+//   idle_close_grace_minutes, idle_close_out_of_hours_grace_minutes,
+//   confirm_grace_minutes } (each int|null; null = inherit global default)
+export function getInboxTiming(inboxId) {
+  return kbRequest(`/kb/inboxes/${encodeURIComponent(inboxId)}/timing`);
+}
+
+// PUT /kb/inboxes/{inbox_id}/timing  body: the four fields (null = inherit)
+export function setInboxTiming(inboxId, body) {
+  return kbRequest(`/kb/inboxes/${encodeURIComponent(inboxId)}/timing`, {
+    method: 'PUT',
+    body,
+  });
+}
