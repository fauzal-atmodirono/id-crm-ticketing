+// ── pgvector uploads ──────────────────────────────────────────────────────────
+
+// GET /kb/knowledge -> [{id,title,source_type,status,error,char_count,chunk_count,created_at}]
+export async function listKnowledge() {
+  const data = await kbRequest('/kb/knowledge');
+  return Array.isArray(data.documents) ? data.documents : [];
+}
+
+// POST /kb/knowledge/text  (paste text)
+export function createKnowledgeText(body) {
+  return kbRequest('/kb/knowledge/text', { method: 'POST', body });
+}
+
+// DELETE /kb/knowledge/:id
+export function deleteKnowledge(id) {
+  return kbRequest(`/kb/knowledge/${encodeURIComponent(id)}`, { method: 'DELETE' });
+}
+
+// POST /kb/knowledge/file  (multipart — cannot use kbRequest which forces JSON)
+export async function uploadKnowledgeFile(file, title) {
+  const { backendUrl, backendKey } = useProtonConfig();
+  if (!backendUrl) throw new Error('PROTON_BACKEND_URL not configured');
+  const form = new FormData();
+  form.append('file', file);
+  if (title) form.append('title', title);
+  const response = await fetch(`${backendUrl}/kb/knowledge/file`, {
+    method: 'POST',
+    headers: { ...(backendKey ? { 'x-api-key': backendKey } : {}) }, // NO Content-Type — browser sets multipart boundary
+    body: form,
+  });
+  if (!response.ok) {
+    const text = await response.text().catch(() => response.statusText);
+    const err = new Error(`${response.status}: ${text.slice(0, 200)}`);
+    err.status = response.status;
+    throw err;
+  }
+  const text = await response.text();
+  return text ? JSON.parse(text) : {};
+}
+
 // ── Assistants ────────────────────────────────────────────────────────────────
 
 // GET /kb/assistants -> [{ id, name, description, product_name, config, enabled, is_default, created_at }]
