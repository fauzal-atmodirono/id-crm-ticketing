+++ b/app/javascript/dashboard/composables/useProtonSoftphone.js
@@ -96,6 +96,12 @@ export function useProtonSoftphone() {
     if (params.get('caller')) incoming.value.from = params.get('caller');
     incoming.value.transcriptPath = params.get('transcript_path') || '';
     incoming.value.transferredBy = params.get('transferred_by') || '';
+    // 0091 caller context: who is calling, as the AI identified them
+    // (backend PHONE_CALLER_CONTEXT_ENABLED). Absent params -> empty, and
