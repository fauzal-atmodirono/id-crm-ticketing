diff --git a/app/javascript/dashboard/views/ProtonTaxonomyPage.vue b/app/javascript/dashboard/views/ProtonTaxonomyPage.vue
new file mode 100644
index 0000000..dd6ad36
--- /dev/null
+++ b/app/javascript/dashboard/views/ProtonTaxonomyPage.vue
@@ -0,0 +1,630 @@
+<!-- ProtonTaxonomyPage.vue — OUR file. Case-taxonomy admin: the four-level
+     Type → Division → Category → Detail tree behind features/taxonomy/, plus
+     the category→department coverage report.
+
+     RETIRE, NEVER DELETE. The backend store has no delete method at all,
+     deliberately: a category referenced by a historical case has to stay
+     resolvable forever, so a "clean up the list" button would break last
+     quarter's reports. The control here says Retire and says why, because an
+     operator who expects Delete and finds Retire will otherwise assume it
+     failed and click again.
+
+     RETIRING A PARENT ORPHANS ITS CHILDREN, AND THAT IS WHY THE CONFIRMATION
+     PANEL EXISTS. `retire_node` marks only the node it was given and returns
+     the children that are still active. Those children keep `active: true` in
+     the store but vanish from `tree()` — it attaches a child to its parent only
+     if the parent is itself active, so an orphan is neither shown nor retired.
+     A page that dropped that response on the floor would leave live categories
+     that no operator can see and no picker can reach. So the list comes back as
+     a blocking panel with a Retire action per child, and it is phrased as what
+     it is: work still outstanding, not a warning that can be dismissed.
+
+     THE DEPARTMENT FIELD IS A MAPPING, NOT A ROUTE. Nothing applies a
+     dept_<slug> escalation label from it today; the coverage report is its only
+     reader. The help text says exactly that, because "department" next to a
+     category reads as automatic routing and this programme has already had to
+     correct client material that implied a mapping did more than it did.
+
+     TWO FLAGS. The tree needs TAXONOMY_ADMIN_ENABLED; the coverage report needs
+     CATEGORY_DEPARTMENT_MAPPING_ENABLED as well. Each 404 is rendered as its own
+     "switched off on this tenant" message, never as an empty table — an empty
+     table claims the taxonomy is empty, which is a different and worse thing to
+     tell an operator than "you have not turned this on".
+
+     Permission gating here is UX only. `taxonomy.manage` is enforced by the
+     backend's require_permission dependency; hiding the form just avoids
+     offering an action that would 403. -->
+<script>
+import { useAlert } from 'dashboard/composables';
+import { useProtonPermissions } from 'dashboard/composables/useProtonPermissions';
+import {
+  getTaxonomyTree,
+  saveTaxonomyNode,
+  retireTaxonomyNode,
+  getTaxonomyCoverage,
+  isDisabledError,
+} from 'dashboard/api/protonTaxonomy';
+
+const { hasPermission: protonHasPermission } = useProtonPermissions();
+
+const LEVEL_LABELS = {
+  1: 'Type',
+  2: 'Division',
+  3: 'Category',
+  4: 'Detail',
+};
+
+const EMPTY_FORM = {
+  level: 1,
+  key: '',
+  label: '',
+  parent: '',
+  department: '',
+  sort_order: 0,
+  active: true,
+};
+
+// Depth-first walk that keeps the tree's own ordering, so the flat list the
+// parent picker and the table use cannot disagree with what is rendered.
+function flatten(nodes, depth = 0, out = []) {
+  (nodes || []).forEach(node => {
+    out.push({ ...node, depth });
+    flatten(node.children, depth + 1, out);
+  });
+  return out;
+}
+
+export default {
+  name: 'ProtonTaxonomyPage',
+  data() {
+    return {
+      tree: [],
+      coverage: null,
+      form: { ...EMPTY_FORM },
+      editingKey: null,
+      loading: true,
+      saving: false,
+      errored: false,
+      disabled: false,
+      disabledReason: '',
+      coverageDisabled: false,
+      coverageError: '',
+      // Children left active by a retire that has already happened. Not a
+      // warning — outstanding work.
+      orphans: [],
+      orphanedParent: '',
+      retiring: '',
+    };
+  },
+  computed: {
+    // A computed, not a data field: useProtonPermissions loads the caller's
+    // permission set asynchronously, so a value snapshotted in data() would be
+    // false for every caller.
+    canManage() {
+      return protonHasPermission('taxonomy.manage');
+    },
+    flatNodes() {
+      return flatten(this.tree);
+    },
+    // Only nodes exactly one level up can parent the node being edited. Level 1
+    // takes no parent at all and the backend rejects one.
+    parentOptions() {
+      const level = Number(this.form.level);
+      if (level <= 1) return [];
+      return this.flatNodes.filter(node => node.level === level - 1);
+    },
+    levelLabels() {
+      return LEVEL_LABELS;
+    },
+    unmappedCount() {
+      return (this.coverage?.unmapped_categories || []).length;
+    },
+    unreferencedCount() {
+      return (this.coverage?.unreferenced_departments || []).length;
+    },
+  },
+  async mounted() {
+    await this.load();
+  },
+  methods: {
+    levelLabel(level) {
+      return LEVEL_LABELS[Number(level)] || `Level ${level}`;
+    },
+    async load() {
+      this.loading = true;
+      this.errored = false;
+      this.disabled = false;
+      try {
+        this.tree = await getTaxonomyTree();
+      } catch (err) {
+        if (isDisabledError(err)) {
+          this.disabled = true;
+          this.disabledReason =
+            'Case taxonomy administration is switched off on this tenant ' +
+            '(TAXONOMY_ADMIN_ENABLED=false). Nothing has been lost — the ' +
+            'stored taxonomy is untouched.';
+        } else {
+          this.errored = true;
+          useAlert(
+            'Failed to load the taxonomy: ' + (err.message || String(err))
+          );
+        }
+        this.loading = false;
+        return;
+      }
+      this.loading = false;
+      await this.loadCoverage();
+    },
+    // Separate call, separate flag, separate failure. A disabled coverage
+    // report must not read as a broken taxonomy page.
+    async loadCoverage() {
+      this.coverageDisabled = false;
+      this.coverageError = '';
+      try {
+        this.coverage = await getTaxonomyCoverage();
+      } catch (err) {
+        this.coverage = null;
+        if (isDisabledError(err)) {
+          this.coverageDisabled = true;
+        } else {
+          this.coverageError = err.message || String(err);
+        }
+      }
+    },
+    startEdit(node) {
+      this.editingKey = node.key;
+      this.form = {
+        level: node.level,
+        key: node.key,
+        label: node.label || '',
+        parent: node.parent || this.parentOfKey(node.key) || '',
+        department: node.department || '',
+        sort_order: node.sort_order ?? 0,
+        active: node.active !== false,
+      };
+    },
+    // The tree nests rather than carrying a `parent` field on each node, so the
+    // parent has to be recovered from the shape.
+    parentOfKey(key) {
+      const walk = (nodes, parentKey) => {
+        for (const node of nodes || []) {
+          if (node.key === key) return parentKey;
+          const found = walk(node.children, node.key);
+          if (found !== undefined) return found;
+        }
+        return undefined;
+      };
+      return walk(this.tree, null);
+    },
+    cancelEdit() {
+      this.editingKey = null;
+      this.form = { ...EMPTY_FORM };
+    },
+    async submit() {
+      if (!this.form.key.trim() || !this.form.label.trim()) {
+        useAlert('Key and label are required.');
+        return;
+      }
+      const level = Number(this.form.level);
+      if (level > 1 && !this.form.parent) {
+        useAlert(`A ${this.levelLabel(level)} needs a parent.`);
+        return;
+      }
+      this.saving = true;
+      try {
+        await saveTaxonomyNode({
+          level,
+          key: this.form.key.trim(),
+          label: this.form.label.trim(),
+          parent: level > 1 ? this.form.parent : null,
+          department: this.form.department.trim() || null,
+          sort_order: Number(this.form.sort_order) || 0,
+          active: this.form.active,
+        });
+        useAlert(this.editingKey ? 'Node updated.' : 'Node created.');
+        this.cancelEdit();
+        await this.load();
+      } catch (err) {
+        // The backend owns the level/parent rules; show its message verbatim
+        // rather than re-implementing them here and drifting.
+        useAlert('Failed to save: ' + (err.message || String(err)));
+      } finally {
+        this.saving = false;
+      }
+    },
+    async retire(node) {
+      const children = (node.children || []).length;
+      const warning = children
+        ? `\n\n"${node.label}" has ${children} active child node(s). Retiring ` +
+          'it does NOT retire them: they stay active but stop appearing ' +
+          'anywhere until you retire or re-parent them. You will be shown the ' +
+          'list.'
+        : '';
+      // eslint-disable-next-line no-alert
+      if (
+        !window.confirm(
+          `Retire "${node.label}" (${node.key})?\n\nRetiring hides it from ` +
+            'pickers and reports going forward. It is never deleted, so ' +
+            'historical cases that use it keep resolving — and there is no ' +
+            'delete, by design.' +
+            warning
+        )
+      ) {
+        return;
+      }
+      this.retiring = node.key;
+      try {
+        const result = await retireTaxonomyNode(node.key);
+        const active = Array.isArray(result?.active_children)
+          ? result.active_children
+          : [];
+        if (active.length) {
+          this.orphans = active;
+          this.orphanedParent = node.label || node.key;
+        } else {
+          useAlert('Node retired.');
+        }
+        if (this.editingKey === node.key) this.cancelEdit();
+        await this.load();
+      } catch (err) {
+        useAlert('Failed to retire: ' + (err.message || String(err)));
+      } finally {
+        this.retiring = '';
+      }
+    },
+    // Retiring an orphan from the panel. Its own children, if any, come back as
+    // the next batch — the panel is a queue, not a single step.
+    async retireOrphan(child) {
+      this.retiring = child.key;
+      try {
+        const result = await retireTaxonomyNode(child.key);
+        const active = Array.isArray(result?.active_children)
+          ? result.active_children
+          : [];
+        this.orphans = this.orphans
+          .filter(node => node.key !== child.key)
+          .concat(active);
+        if (!this.orphans.length) {
+          useAlert('No orphaned nodes left.');
+          this.orphanedParent = '';
+        }
+        await this.load();
+      } catch (err) {
+        useAlert('Failed to retire: ' + (err.message || String(err)));
+      } finally {
+        this.retiring = '';
+      }
+    },
+    // Deliberately does NOT clear `orphans` silently: it restates that the
+    // nodes are still invisible, so dismissing is a choice rather than an
+    // accident.
+    dismissOrphans() {
+      this.orphans = [];
+      this.orphanedParent = '';
+      useAlert(
+        'Left as they are. Those nodes stay active but will not appear until ' +
+          'retired or re-parented.'
+      );
+    },
+  },
+};
+</script>
+
+<template>
+  <div class="p-6">
+    <h1 class="mb-1 text-lg font-medium text-n-slate-12">Case Taxonomy</h1>
+    <p class="mb-6 max-w-3xl text-sm text-n-slate-11">
+      The four-level case taxonomy — Type → Division → Category → Detail — used
+      for case categorisation and reporting. Nodes are
+      <strong>retired, never deleted</strong>, so historical cases keep
+      resolving.
+    </p>
+
+    <div v-if="loading" class="py-10 text-sm text-center text-n-slate-11">
+      Loading…
+    </div>
+
+    <div
+      v-else-if="disabled"
+      class="max-w-3xl p-4 text-sm border rounded-lg border-n-weak text-n-slate-11"
+    >
+      {{ disabledReason }}
+    </div>
+
+    <div v-else-if="errored" class="py-10 text-sm text-center text-n-slate-11">
+      Could not load the taxonomy.
+    </div>
+
+    <template v-else>
+      <!-- Orphans left active by a retire that has already happened. Shown
+           first and before anything else, because it is outstanding work on
+           data the operator can no longer see any other way. -->
+      <div
+        v-if="orphans.length"
+        class="max-w-3xl p-4 mb-6 text-sm border rounded-lg border-n-amber-8 bg-n-amber-2 text-n-slate-12"
+      >
+        <p class="mb-2 font-medium">
+          {{ orphans.length }} node(s) under “{{ orphanedParent }}” are still
+          active
+        </p>
+        <p class="mb-3 text-n-slate-11">
+          Their parent is retired, so they no longer appear in the tree, in
+          pickers or in reports — but they are not retired either. Retire each
+          one, or re-parent it by editing it (its key is shown below).
+        </p>
+        <ul class="mb-3">
+          <li
+            v-for="child in orphans"
+            :key="child.key"
+            class="flex items-center gap-3 py-1"
+          >
+            <span class="font-medium">{{ child.label }}</span>
+            <span class="font-mono text-xs text-n-slate-11">{{
+              child.key
+            }}</span>
+            <span class="text-xs text-n-slate-11">{{
+              levelLabel(child.level)
+            }}</span>
+            <button
+              v-if="canManage"
+              type="button"
+              :disabled="retiring === child.key"
+              class="px-2 py-1 ml-auto text-xs rounded border border-n-weak text-n-slate-12 hover:opacity-90 disabled:opacity-50"
+              @click="retireOrphan(child)"
+            >
+              Retire
+            </button>
+          </li>
+        </ul>
+        <button
+          type="button"
+          class="text-xs underline text-n-slate-11"
+          @click="dismissOrphans"
+        >
+          Leave them for now
+        </button>
+      </div>
+
+      <p
+        v-if="!canManage"
+        class="max-w-3xl p-3 mb-6 text-sm border rounded-lg border-n-weak text-n-slate-11"
+      >
+        You have read-only access to the taxonomy. Editing needs the
+        <span class="font-mono text-xs">taxonomy.manage</span> permission.
+      </p>
+
+      <!-- Editor -->
+      <template v-if="canManage">
+        <h2 class="mb-3 text-base font-medium text-n-slate-12">
+          {{ editingKey ? 'Edit node' : 'Add a node' }}
+        </h2>
