diff --git a/app/javascript/dashboard/components/proton/AgentPrioritiesEditor.vue b/app/javascript/dashboard/components/proton/AgentPrioritiesEditor.vue
new file mode 100644
index 0000000..1f5592e
--- /dev/null
+++ b/app/javascript/dashboard/components/proton/AgentPrioritiesEditor.vue
@@ -0,0 +1,188 @@
+<!-- AgentPrioritiesEditor.vue — OUR file. Chrome-less editor for per-agent
+     channel priorities. Embedded in Settings → Inboxes → Collaborators tab.
+     Each agent has a Primary channel (the first in channel_priorities[]) and
+     zero-or-more "Also handles" channels (the rest).
+     Reads from GET /routing/agents + GET /routing/priorities; writes via
+     POST /routing/priorities. Part of Phase 5 WhatsApp custom auto-assignment. -->
+<script>
+import { useAlert } from 'dashboard/composables';
+import {
+  getRoutingAgents,
+  getRoutingPriorities,
+  setRoutingPriority,
+} from 'dashboard/api/protonKnowledge';
+
+const CHANNELS = ['whatsapp', 'call', 'email', 'social', 'web'];
+const CHANNEL_LABELS = { whatsapp: 'WhatsApp', call: 'Call', email: 'Email', social: 'Social', web: 'Web' };
+
+export default {
+  name: 'AgentPrioritiesEditor',
+  data() {
+    return {
+      rows: [],
+      loading: true,
+      errored: false,
+      savingRows: new Set(),
+      channels: CHANNELS,
+    };
+  },
+  async mounted() {
+    await this.load();
+  },
+  methods: {
+    async load() {
+      this.loading = true;
+      this.errored = false;
+      try {
+        const [agents, priorities] = await Promise.all([
+          getRoutingAgents(),
+          getRoutingPriorities(),
+        ]);
+        const priMap = {};
+        const priArr = Array.isArray(priorities)
+          ? priorities
+          : priorities.priorities || [];
+        priArr.forEach(p => {
+          priMap[p.agent_id] = p.channel_priorities || [];
+        });
+
+        const agentArr = Array.isArray(agents)
+          ? agents
+          : agents.agents || [];
+
+        this.rows = agentArr.map(a => {
+          const cp = priMap[a.id] || [];
+          return {
+            id: a.id,
+            name: a.name || String(a.id),
+            availability_status: a.availability_status || '',
+            primary: cp[0] || '',
+            also: cp.slice(1),
+          };
+        });
+      } catch (err) {
+        this.errored = true;
+        if (err.status === 401) {
+          useAlert('Unauthorized (401) — check the backend key configuration.');
+        } else if (err.status === 503) {
+          useAlert('Routing service unavailable (503) on the backend.');
+        } else {
+          useAlert('Failed to load agent priorities: ' + (err.message || String(err)));
+        }
+      } finally {
+        this.loading = false;
+      }
+    },
+
+    toggleAlso(row, channel) {
+      if (row.also.includes(channel)) {
+        row.also = row.also.filter(c => c !== channel);
+      } else {
+        row.also = [...row.also, channel];
+      }
+    },
+
+    async save(row) {
+      if (!row.primary) {
+        useAlert('Pick a primary channel before saving.');
+        return;
+      }
+      const channelPriorities = [
+        row.primary,
+        ...row.also.filter(c => c !== row.primary),
+      ];
+      this.savingRows = new Set([...this.savingRows, row.id]);
+      try {
+        await setRoutingPriority(row.id, channelPriorities);
+        useAlert('Agent "' + row.name + '" priorities saved.');
+      } catch (err) {
+        useAlert('Failed to save "' + row.name + '": ' + (err.message || String(err)));
+      } finally {
+        const next = new Set(this.savingRows);
+        next.delete(row.id);
+        this.savingRows = next;
+      }
+    },
+
+    statusLabel(status) {
+      if (!status) return '—';
+      return status.charAt(0).toUpperCase() + status.slice(1).replace(/_/g, ' ');
+    },
+
+    channelLabel(ch) { return CHANNEL_LABELS[ch] || ch; },
+  },
+};
+</script>
+
+<template>
+  <div>
+    <p class="mb-4 text-sm text-n-slate-11">
+      Priorities apply account-wide per agent. On a handoff, the highest-priority online agent for the channel is auto-assigned.
+    </p>
+    <div v-if="loading" class="py-10 text-sm text-center text-n-slate-11">Loading agents…</div>
+    <div v-else-if="errored" class="py-10 text-sm text-center text-n-slate-11">Could not load agent priorities.</div>
+    <div v-else-if="!rows.length" class="py-10 text-sm text-center text-n-slate-11">No agents in this inbox yet.</div>
+    <table v-else class="min-w-full table-auto outline outline-1 -outline-offset-1 outline-n-weak rounded-xl">
+      <thead>
+        <tr class="border-b border-n-weak">
+          <th class="py-3 px-4 text-start text-heading-3 text-n-slate-12">Agent</th>
+          <th class="py-3 px-4 text-start text-heading-3 text-n-slate-12">Status</th>
+          <th class="py-3 px-4 text-start text-heading-3 text-n-slate-12">Primary channel</th>
+          <th class="py-3 px-4 text-start text-heading-3 text-n-slate-12">Also handles</th>
+          <th class="py-3 px-4"></th>
+        </tr>
+      </thead>
+      <tbody class="divide-y divide-n-weak">
+        <tr v-for="row in rows" :key="row.id" class="align-middle">
+          <td class="py-3 px-4 text-sm font-medium text-n-slate-12 whitespace-nowrap">{{ row.name }}</td>
+          <td class="py-3 px-4 whitespace-nowrap">
+            <span class="inline-flex items-center gap-1.5 text-sm text-n-slate-11">
+              <span
+                class="w-2 h-2 rounded-full"
+                :class="row.availability_status === 'online' ? 'bg-n-teal-9' : 'bg-n-slate-8'"
+              />
+              {{ statusLabel(row.availability_status) }}
+            </span>
+          </td>
+          <td class="py-3 px-4">
+            <select
+              v-model="row.primary"
+              :disabled="savingRows.has(row.id)"
+              class="w-40 px-3 py-2 text-sm border rounded-lg border-n-weak bg-n-alpha-black2 text-n-slate-12 focus:outline-none disabled:opacity-50"
+            >
+              <option value="">Select…</option>
+              <option v-for="ch in channels" :key="ch" :value="ch">{{ channelLabel(ch) }}</option>
+            </select>
+          </td>
+          <td class="py-3 px-4">
+            <div class="flex flex-wrap gap-2">
+              <button
+                v-for="ch in channels"
+                :key="ch"
+                type="button"
+                :disabled="savingRows.has(row.id)"
+                class="px-2.5 py-1 text-xs font-medium border rounded-full transition-colors disabled:opacity-50"
+                :class="row.also.includes(ch)
+                  ? 'border-n-brand bg-n-alpha-black2 text-n-brand'
+                  : 'border-n-weak text-n-slate-11 hover:bg-n-alpha-black1'"
+                @click="toggleAlso(row, ch)"
+              >
+                {{ channelLabel(ch) }}
+              </button>
+            </div>
+          </td>
+          <td class="py-3 px-4 text-end whitespace-nowrap">
+            <button
+              type="button"
+              :disabled="savingRows.has(row.id)"
+              class="px-3 py-1.5 text-sm font-medium rounded-lg bg-n-brand text-white hover:opacity-90 disabled:opacity-50"
+              @click="save(row)"
+            >
+              Save
+            </button>
+          </td>
+        </tr>
+      </tbody>
+    </table>
+  </div>
+</template>
