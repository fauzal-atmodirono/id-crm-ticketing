+            // What the backend last told us. `isDirty` compares against this so
+            // Save is only offered when there is something to save -- a table of
+            // permanently-enabled Save buttons gives an operator no way to tell
+            // which rows they actually changed.
+            saved: cp.join(','),
+            justSaved: false,
           };
         });
