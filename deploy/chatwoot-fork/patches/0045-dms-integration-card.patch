diff --git a/app/javascript/dashboard/views/ProtonDmsIntegrationPage.vue b/app/javascript/dashboard/views/ProtonDmsIntegrationPage.vue
new file mode 100644
index 0000000..1be6e71
--- /dev/null
+++ b/app/javascript/dashboard/views/ProtonDmsIntegrationPage.vue
@@ -0,0 +1,455 @@
+<!-- ProtonDmsIntegrationPage.vue — OUR file. Config form for the DMS/TSP
+     integration shell (Package F), backing dms_admin_router.py. Mirrors
+     ProtonEscalationRoutingPage.vue's shell (header, n-* tokens, useAlert
+     toasts) plus ProtonSlaPoliciesPage.vue's load/edit/save single-form
+     shape — there is exactly one DMS config, no list of rows.
+
+     Two things this file exists to get right (see the package's SDD specs):
+
+     1. The credential is write-only. GET never returns it — not even a
+        flag saying whether one is stored — so the field can never be
+        populated from the API. It always renders as a masked, read-only
+        "••••••••" display with a Replace action; only clicking Replace
+        reveals a real input. On submit, the `credential` key is included
+        in the PUT body ONLY when the operator is in Replace mode AND typed
+        a non-empty value — never as `''`, because the backend treats an
+        explicitly-sent empty string as "overwrite with empty", while
+        omitting the key entirely (or `null`) is the only way to say "leave
+        whatever is stored alone". If the operator clicks Replace and tries
+        to save without typing anything, submission is blocked with an
+        alert rather than silently sending nothing or accidentally wiping
+        the secret. The typed value is trimmed before it's sent, so a
+        pasted credential with stray leading/trailing whitespace isn't
+        stored verbatim.
+     2. `extra_header_value` IS returned in plain text by GET, unlike the
+        credential — an operator could put a second secret there (e.g. a
+        bearer token in a custom header) and it would round-trip readable.
+        That's flagged inline, right under the field, so it's never mistaken
+        for the same write-only guarantee the Credential field has.
+
+     No "Retries" control is rendered, deliberately. `retries` is stored and
+     round-tripped (it stays in `form`, is loaded from GET and sent back
+     unchanged on PUT, so saving this form never silently resets a stored
+     value) but NOTHING reads it: neither dms_client.py nor
+     customer360_router.py. A settings control an operator can change that
+     has no effect is a small instance of exactly the failure this package
+     exists to prevent — a shell that looks like a working integration. It
+     gets a control when something honours it, in Phase 2. -->
+
+<script>
+import { useAlert } from 'dashboard/composables';
+import {
+  getDmsIntegration,
+  putDmsIntegration,
+  testDmsIntegration,
+} from 'dashboard/api/protonAdmin';
+
+const EMPTY_FORM = {
+  enabled: false,
+  provider_label: '',
+  base_url: '',
+  auth_type: 'bearer_token',
+  extra_header_name: '',
+  extra_header_value: '',
+  timeout_seconds: 10,
+  retries: 0,
+};
+
+const AUTH_TYPE_OPTIONS = [
+  { value: 'bearer_token', label: 'Bearer token' },
+  { value: 'basic', label: 'Basic auth' },
+  { value: 'api_key_header', label: 'API key header (X-Api-Key)' },
+];
+const VALID_AUTH_TYPES = new Set(AUTH_TYPE_OPTIONS.map(o => o.value));
+
+// The backend's never-configured state (dms_admin_router.py's
+// _empty_config()) returns auth_type: '' — not one of this form's three
+// <select> options. Left as-is, `{ ...EMPTY_FORM, ...data }` would put ''
+// into the model while the <select> visually shows nothing selected; an
+// operator who saves without ever opening the dropdown would then send
+// auth_type: '' verbatim (the store has no enum constraint), which
+// dms_client.py's _auth_headers() silently treats as the X-Api-Key
+// fallback — an auth scheme the operator never chose, misread as a bad
+// credential when the probe then fails. Normalising any value the
+// dropdown can't represent back to the same default EMPTY_FORM starts
+// with guarantees the visible selection and the value actually sent can
+// never diverge.
+function normalizeAuthType(value) {
+  return VALID_AUTH_TYPES.has(value) ? value : EMPTY_FORM.auth_type;
+}
+
+// Test-connection status -> plain-language title + tone.
+//
+// `unexpected_status` covers everything that isn't a clean 200 / a 401-403 /
+// a timeout — including a 404 from a correctly-configured server whose root
+// isn't a health endpoint. Its title and helper text deliberately do NOT say
+// "failed" or point at the credential, so an operator can tell "wrong path"
+// from "wrong key".
+//
+// `not_configured` is a PRE-FLIGHT state and is deliberately its own entry:
+// the backend returns it when there's no saved base URL or no stored
+// credential, i.e. when it never made a request at all. It used to reuse
+// `unexpected_status`, which rendered "No credential is stored for this
+// integration." under the title "Unexpected response" with helper text about
+// the base URL not being a health endpoint — sending the operator to check
+// the one thing that wasn't the problem.
+const TEST_STATUS_META = {
+  reachable: { title: 'Reachable', tone: 'positive' },
+  auth_failed: { title: 'Authentication failed', tone: 'negative' },
+  timeout: { title: 'Timed out', tone: 'negative' },
+  unexpected_status: { title: 'Unexpected response', tone: 'neutral' },
+  not_configured: { title: 'Not configured yet', tone: 'neutral' },
+};
+
+export default {
+  name: 'ProtonDmsIntegrationPage',
+  data() {
+    return {
+      form: { ...EMPTY_FORM },
+      credentialReplacing: false,
+      credentialInput: '',
+      authTypeOptions: AUTH_TYPE_OPTIONS,
+      loading: true,
+      errored: false,
+      saving: false,
+      testing: false,
+      testResult: null,
+    };
+  },
+  computed: {
+    notConnected() {
+      return !this.loading && (!this.form.enabled || !this.form.base_url);
+    },
+    testStatusMeta() {
+      if (!this.testResult) return null;
+      return (
+        TEST_STATUS_META[this.testResult.status] || {
+          title: 'Could not run the test',
+          tone: 'neutral',
+        }
+      );
+    },
+  },
+  async mounted() {
+    await this.load();
+  },
+  methods: {
+    async load() {
+      this.loading = true;
+      this.errored = false;
+      try {
+        const data = await getDmsIntegration();
+        this.form = { ...EMPTY_FORM, ...data };
+        this.form.auth_type = normalizeAuthType(this.form.auth_type);
+      } catch (err) {
+        this.errored = true;
+        useAlert(
+          'Failed to load the DMS/TSP integration: ' +
+            (err.message || String(err))
+        );
+      } finally {
+        this.loading = false;
+      }
+    },
+    startReplaceCredential() {
