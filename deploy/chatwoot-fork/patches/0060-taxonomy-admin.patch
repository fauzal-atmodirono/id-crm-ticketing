+// protonTaxonomy.js (api) — OUR file. The four /admin/taxonomy endpoints
+// features/taxonomy/router.py exposes.
+//
+// It reuses `adminRequest` from protonAdmin.js rather than adding another
+// request helper: `/node` and `/node/:key/retire` are gated by
+// require_permission('taxonomy.manage') and adminRequest is the one helper that
+// already forwards the devise_token_auth access-token/client/uid triplet that
+// check needs — see patch 0030, which fixed exactly this for the earlier admin
+// pages.
+//
+// TWO FLAGS, TWO DIFFERENT 404s, AND THE PAGE HAS TO TELL THEM APART.
+// `/tree`, `/node` and `/node/:key/retire` answer 404 when
+// TAXONOMY_ADMIN_ENABLED is false; `/coverage` answers 404 when EITHER that or
+// CATEGORY_DEPARTMENT_MAPPING_ENABLED is false. A 404 from this router is
+// therefore a statement about configuration, not a missing record, and the
+// callers below hand it back distinguishably so the page can say "switched off
+// on this tenant" instead of rendering an empty table — an empty table is a
+// claim that the taxonomy is empty, which is a different and worse thing to
+// tell an operator.
+import { adminRequest } from 'dashboard/api/protonAdmin';
+
+// A 404 from an /admin/taxonomy path means "disabled", never "not found":
+// every path here is static, so there is no record whose absence could 404.
+export function isDisabledError(error) {
+  if (!error) return false;
+  const status = error.status || error.response?.status;
+  if (status === 404) return true;
+  // adminRequest surfaces some failures as a message-only Error; the router's
+  // own detail text names the setting, which is the only reliable signal left.
+  return /_ENABLED=false|is disabled/i.test(error.message || '');
+}
+
+// The nested active taxonomy. Retired nodes are absent by construction — the
+// backend's tree() is built from active nodes only.
+export async function getTaxonomyTree() {
+  const data = await adminRequest('/admin/taxonomy/tree');
+  return Array.isArray(data?.tree) ? data.tree : [];
+}
+
+// Create-or-update by key. `level` and `parent` are validated server-side
+// (level 1 may not have a parent; levels 2-4 must); this sends what the form
+// holds and shows the 400 verbatim rather than second-guessing those rules in
+// two places.
+export function saveTaxonomyNode(node) {
+  return adminRequest('/admin/taxonomy/node', { method: 'POST', body: node });
+}
+
+// RETIRE, NEVER DELETE — there is deliberately no delete method on the backend
+// store, because a category referenced by a historical case has to stay
+// resolvable forever. The response carries `active_children`: the node's
+// children that are STILL ACTIVE after this call. See the page for why that
+// list is not cosmetic.
+export function retireTaxonomyNode(key) {
+  return adminRequest(`/admin/taxonomy/node/${encodeURIComponent(key)}/retire`, {
+    method: 'POST',
+  });
+}
+
+// Coverage report: active categories with no mapped department, and department
+// slugs no category maps to. Behind its own flag — see the note at the top.
+export function getTaxonomyCoverage() {
+  return adminRequest('/admin/taxonomy/coverage');
+}
