diff --git a/config/initializers/zz_proton_password_expiry.rb b/config/initializers/zz_proton_password_expiry.rb
new file mode 100644
index 0000000..6a16375
--- /dev/null
+++ b/config/initializers/zz_proton_password_expiry.rb
@@ -0,0 +1,63 @@
+# FIX-44 (patch 0082): password expiry. RFP 2026_028 7.6 asks to "prompt to
+# change password every 3 months". Upstream Chatwoot has no password ageing.
+#
+# PASSWORD_MAX_AGE_DAYS (env) unset / 0 / not a positive integer = OFF: nothing
+# is flagged and the JSON payload is byte-identical to upstream.
+#
+# Storage: the change time lives in users.custom_attributes['password_changed_at']
+# (jsonb, already exists) rather than a new column. Fork patches are applied with
+# `git apply` at image-build time and the runtime image only copies selected
+# files, so there is no migration step; a schema change here would need a
+# `db:migrate` on every tenant at deploy and a half-migrated Rails would crash.
+# A user with no stamp is treated as "changed at account creation" (created_at).
+#
+# Stamping is a before_save on encrypted_password, so EVERY path that changes the
+# password resets the clock: profile self-service change, the reset-password
+# email flow, an admin setting it in /super_admin, and account creation.
+#
+# Enforcement is advisory-plus-UI: the user payload carries password_expired and
+# the SPA routes the user to Profile settings until they change it. API access
+# tokens (non-browser) are never blocked, and SSO users (provider != 'email')
+# have no password of ours to expire.
+module ProtonPasswordExpiry
+  STAMP_KEY = 'password_changed_at'.freeze
+
+  def self.max_age_days
+    ENV.fetch('PASSWORD_MAX_AGE_DAYS', '0').to_i
+  end
+
+  def self.included(base)
+    base.before_save :stamp_password_changed_at
+  end
+
+  def password_changed_at
+    raw = (custom_attributes || {})[STAMP_KEY]
+    (raw.present? && Time.zone.parse(raw.to_s)) || created_at
+  rescue ArgumentError
+    created_at
+  end
+
+  def password_expired?
+    days = ProtonPasswordExpiry.max_age_days
+    return false unless days.positive?
+    return false unless provider == 'email'
+
+    changed = password_changed_at
+    return false if changed.nil?
+
+    Time.current >= changed + days.days
+  end
+
+  private
+
+  def stamp_password_changed_at
+    return unless will_save_change_to_encrypted_password?
+
+    self.custom_attributes = (custom_attributes || {}).merge(STAMP_KEY => Time.current.iso8601)
+  end
+end
+
+# to_prepare so the include survives code reloading in development; harmless once in production.
+Rails.application.config.to_prepare do
+  User.include(ProtonPasswordExpiry) unless User.include?(ProtonPasswordExpiry)
+end
diff --git a/spec/proton/password_expiry_spec.rb b/spec/proton/password_expiry_spec.rb
new file mode 100644
index 0000000..1e075f8
--- /dev/null
+++ b/spec/proton/password_expiry_spec.rb
@@ -0,0 +1,48 @@
+require 'rails_helper'
+
+# FIX-44 (patch 0082). Not runnable outside a full Chatwoot test bundle; shipped
+# so the Cloud Build/CI image check can run them: bundle exec rspec spec/proton
+RSpec.describe 'Proton password expiry' do
+  around do |example|
+    original = ENV.fetch('PASSWORD_MAX_AGE_DAYS', nil)
+    ENV['PASSWORD_MAX_AGE_DAYS'] = '90'
+    example.run
+  ensure
+    ENV['PASSWORD_MAX_AGE_DAYS'] = original
+  end
+
+  let(:user) { create(:user, password: 'Test@123456') }
+
+  it 'test_login_after_90_days_requires_change' do
+    user
+    expect(user.reload.password_expired?).to be(false)
+
+    travel_to(91.days.from_now) do
+      expect(user.reload.password_expired?).to be(true)
+      # the sign-in response carries the flag the SPA routes on
+      post '/auth/sign_in', params: { email: user.email, password: 'Test@123456' }, as: :json
+      expect(response).to have_http_status(:success)
+      expect(response.parsed_body.dig('data', 'password_expired')).to be(true)
+    end
+  end
+
+  it 'test_self_service_change_resets_clock' do
+    user
+    travel_to(91.days.from_now) do
+      expect(user.reload.password_expired?).to be(true)
+      user.update!(password: 'Another@123456')
+      expect(user.reload.password_expired?).to be(false)
+      expect(user.custom_attributes['password_changed_at']).to be_present
+    end
+  end
+
+  it 'is off when PASSWORD_MAX_AGE_DAYS is unset or 0' do
+    ENV['PASSWORD_MAX_AGE_DAYS'] = '0'
+    travel_to(400.days.from_now) { expect(user.reload.password_expired?).to be(false) }
+  end
+
+  it 'never expires SSO users' do
+    user.update_columns(provider: 'google_oauth2')
+    travel_to(400.days.from_now) { expect(user.reload.password_expired?).to be(false) }
+  end
+end
