 //
 // This is UX only: Chatwoot's own API still returns the raw value to the
 // browser. The backend-owned surfaces (Customer 360, RSA, case fields, AI
@@ -28,14 +29,32 @@ import { adminRequest } from 'dashboard/api/protonAdmin';
 
 const MASK = '•';
 const RETRY_MS = 5000;
-const masked = ref(true); // pending = masked
+const REQUEST_TIMEOUT_MS = 5000;
+// Patch 0088 (review I3, ruling R26): the Rails layout emits
+// window.__PROTON_PII_MASKING__ from env PII_MASKING_ENABLED. Flag absent or
+// false: never call /authz/me/pii and never mask (a flag-off tenant shows
+// exactly what it showed before patch 0085). Flag true: the fail-closed
+// behaviour below (masked while pending, on error and on a timeout; only a
+// 404 unmasks).
+const piiFlagOn = () =>
+  typeof window !== 'undefined' && window.__PROTON_PII_MASKING__ === true;
+const masked = ref(piiFlagOn());
 let loaded = false;
 let loadPromise = null;
 let retryTimer = null;
 
 function ensureLoaded() {
+  if (!piiFlagOn()) {
+    masked.value = false;
+    loaded = true;
+    return;
+  }
   if (loaded || loadPromise) return;
-  loadPromise = adminRequest('/authz/me/pii')
+  // A hung request must not keep the page masked forever: abort after 5 s,
+  // which lands in the error path (masked, retried).
+  const ctrl = new AbortController();
+  const timeout = setTimeout(() => ctrl.abort(), REQUEST_TIMEOUT_MS);
+  loadPromise = adminRequest('/authz/me/pii', { signal: ctrl.signal })
     .then(data => {
       masked.value = !!(data && data.masking_enabled && data.masked);
       loaded = true;
@@ -58,6 +77,7 @@ function ensureLoaded() {
       }
     })
     .finally(() => {
+      clearTimeout(timeout);
       loadPromise = null;
     });
 }
