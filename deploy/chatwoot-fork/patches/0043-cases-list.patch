diff --git a/app/javascript/dashboard/views/ProtonCasesPage.vue b/app/javascript/dashboard/views/ProtonCasesPage.vue
new file mode 100644
index 0000000..05ad61f
--- /dev/null
+++ b/app/javascript/dashboard/views/ProtonCasesPage.vue
@@ -0,0 +1,88 @@
+<!-- ProtonCasesPage.vue — OUR file. The Cases list: one filterable table
+     over existing Chatwoot conversation data (Package D, Task 5). No new
+     backend storage and no new backend endpoint — protonCases.js reads what
+     Chatwoot's own /conversations endpoint already returns. This page owns
+     the data load; ProtonCasesTable.vue (components/widgets/) owns the
+     table + filters and is the piece Package E reuses. Mirrors
+     ProtonRsaPage.vue / ProtonCustomer360Page.vue's shell (header, n-*
+     tokens, useAlert toasts).
+
+     `fetchAllCases` caps itself at MAX_PAGES (1,000 conversations) so one
+     page load can't turn into an unbounded number of sequential requests.
+     When that cap is what stopped paging — not the ordinary "ran out of
+     conversations" case — this page (not ProtonCasesTable, which Package E
+     reuses as-is) surfaces it via the same amber `Banner` core Chatwoot
+     already uses for other "there's more than we're showing you" cases
+     (e.g. Captain's document/response LimitBanner). A Cases list that
+     silently hides cases past the cap is worse than one that tells you
+     it's partial. -->
+<script>
+import { useAlert } from 'dashboard/composables';
+import { fetchAllCases } from 'dashboard/api/protonCases';
+import ProtonCasesTable from 'dashboard/components/widgets/ProtonCasesTable.vue';
+import Banner from 'dashboard/components-next/banner/Banner.vue';
+
+export default {
+  name: 'ProtonCasesPage',
+  components: { ProtonCasesTable, Banner },
+  data() {
+    return {
+      cases: [],
+      loading: true,
+      errored: false,
+      truncated: false,
+      fetchedCount: 0,
+      totalCount: 0,
