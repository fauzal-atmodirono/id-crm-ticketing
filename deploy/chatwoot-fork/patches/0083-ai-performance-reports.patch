diff --git a/app/javascript/dashboard/routes/dashboard/settings/reports/components/proton/ProtonAiPerformanceSection.vue b/app/javascript/dashboard/routes/dashboard/settings/reports/components/proton/ProtonAiPerformanceSection.vue
