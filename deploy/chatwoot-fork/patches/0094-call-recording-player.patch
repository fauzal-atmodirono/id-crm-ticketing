From: Proton CRM <build@proton.local>
Subject: [PATCH 0094] conversation sidebar: in-CRM call recording player (signed backend link, transcript, re-transcribe)

diff --git a/app/javascript/dashboard/components/proton/ProtonCallRecordingPanel.vue b/app/javascript/dashboard/components/proton/ProtonCallRecordingPanel.vue
new file mode 100644
index 0000000..2f677ec
--- /dev/null
+++ b/app/javascript/dashboard/components/proton/ProtonCallRecordingPanel.vue
@@ -0,0 +1,197 @@
+<script setup>
+// ProtonCallRecordingPanel.vue — OUR file (patch 0094). Plays a call's
+// archived recording inside the conversation sidebar.
+//
+// The backend (features/chat/phone/recording_router.py) finds the archived
+// GCS object, checks `call_recording.listen` + the caller's data scope, and
+// answers with a short-lived signed BACKEND link. An <audio> element cannot
+// send the Chatwoot session headers adminRequest adds, which is why the link
+// carries its own (<= 5 minute) credential and why this panel re-mints it when
+// it has expired instead of letting the player fail.
+//
+// Hidden unless the backend says a recording is available (or was deleted by
+// retention): no permission (403), feature off (404), not configured (503) or
+// any other failure all render nothing. Only asks for conversations the
+// backend marked as recorded calls, so ordinary chats cost no request.
+import { ref, computed, watch, nextTick } from 'vue';
+import { useMapGetter } from 'dashboard/composables/store';
+import { useProtonConfig } from 'dashboard/composables/useProtonConfig';
+import { adminRequest } from 'dashboard/api/protonAdmin';
+
+const props = defineProps({
+  conversationId: {
+    type: [Number, String],
+    required: true,
+  },
+});
+
+// Re-mint this long before the link's real expiry, so a click never races it.
+const EXPIRY_MARGIN_MS = 30000;
+
+const currentChat = useMapGetter('getSelectedChat');
+const attrs = computed(() => currentChat.value?.custom_attributes || {});
+// Written by the backend on every recorded call and voicemail
+// (set_call_recording / set_call_recording_archive).
+const isRecordedCall = computed(
+  () =>
+    !!(
+      attrs.value.call_recording_object ||
+      attrs.value.recording_sid ||
+      attrs.value.recording_url
+    )
+);
+
+const state = ref('hidden'); // hidden | available | deleted
+const playUrl = ref('');
+const transcriptUrl = ref('');
+const canRetranscribe = ref(false);
+const expiresAtMs = ref(0);
+const message = ref('');
+const busy = ref(false);
+const audioEl = ref(null);
+let requestSeq = 0;
+let retriedAfterError = false;
+
+function absolute(path) {
+  if (!path) return '';
+  if (!path.startsWith('/')) return path;
+  const { backendUrl } = useProtonConfig();
+  return `${backendUrl || ''}${path}`;
+}
+
+function recordingPath() {
+  return `/calls/${encodeURIComponent(props.conversationId)}/recording`;
+}
+
+async function load() {
+  const mine = ++requestSeq;
+  message.value = '';
+  if (!isRecordedCall.value) {
+    state.value = 'hidden';
+    return;
+  }
+  try {
+    const res = await adminRequest(recordingPath());
+    if (mine !== requestSeq) return;
+    if (res?.status === 'available' && res.play_url) {
+      playUrl.value = absolute(res.play_url);
+      transcriptUrl.value = absolute(res.transcript_url || '');
+      canRetranscribe.value = !!res.can_retranscribe;
+      expiresAtMs.value = Date.parse(res.expires_at) || 0;
+      retriedAfterError = false;
+      state.value = 'available';
+    } else if (res?.status === 'deleted') {
+      state.value = 'deleted';
+    } else {
+      state.value = 'hidden';
+    }
+  } catch (e) {
+    // 403 / 404 / 503 / network: no panel, never an error banner.
+    if (mine === requestSeq) state.value = 'hidden';
+  }
+}
+
+function isStale() {
+  return Date.now() > expiresAtMs.value - EXPIRY_MARGIN_MS;
+}
+
+// Swap in a fresh link without losing the listener's position.
+async function remintAndResume(play) {
+  const audio = audioEl.value;
+  const at = audio ? audio.currentTime : 0;
+  await load();
+  await nextTick();
+  const fresh = audioEl.value;
+  if (!fresh || state.value !== 'available') return;
+  fresh.currentTime = at;
+  if (play) fresh.play().catch(() => {});
+}
+
+async function onPlay() {
+  if (!isStale()) return;
+  audioEl.value?.pause();
+  await remintAndResume(true);
+}
+
+async function onError() {
+  // An expired link mid-listen (a seek after five minutes) — re-mint once.
+  if (retriedAfterError || state.value !== 'available') return;
+  retriedAfterError = true;
+  await remintAndResume(false);
+}
+
+async function openTranscript() {
+  if (isStale()) await load();
+  if (transcriptUrl.value) window.open(transcriptUrl.value, '_blank', 'noopener');
+}
+
+async function retranscribe() {
+  busy.value = true;
+  message.value = '';
+  try {
+    await adminRequest(`${recordingPath()}/retranscribe`, { method: 'POST' });
+    message.value =
+      'Re-transcription queued. The new transcript will appear as a private note shortly.';
+  } catch (e) {
+    message.value =
+      e?.status === 429
+        ? 'This call was re-transcribed recently. Try again later.'
+        : 'Could not start re-transcription.';
+  } finally {
+    busy.value = false;
+  }
+}
+
+watch(() => [props.conversationId, isRecordedCall.value], load, {
+  immediate: true,
+});
+</script>
+
+<template>
+  <div
+    v-if="state === 'available' || state === 'deleted'"
+    class="px-2 pt-2"
+    data-proton-call-recording
+  >
+    <div
+      class="flex flex-col gap-2 p-3 border rounded-xl border-n-weak bg-n-alpha-1"
+    >
+      <div class="text-sm font-medium text-n-slate-12">Call recording</div>
+      <p v-if="state === 'deleted'" class="text-xs text-n-slate-11">
+        This recording was deleted under the retention policy.
+      </p>
+      <template v-else>
+        <audio
+          ref="audioEl"
+          controls
+          preload="none"
+          controlslist="nodownload"
+          class="w-full"
+          :src="playUrl"
+          @play="onPlay"
+          @error="onError"
+        />
+        <div class="flex items-center gap-3 text-xs">
+          <button
+            v-if="transcriptUrl"
+            type="button"
+            class="text-n-brand hover:underline"
+            @click="openTranscript"
+          >
+            Transcript
+          </button>
+          <button
+            v-if="canRetranscribe"
+            type="button"
+            class="text-n-brand hover:underline disabled:opacity-50"
+            :disabled="busy"
+            @click="retranscribe"
+          >
+            Re-transcribe
+          </button>
+        </div>
+        <p v-if="message" class="text-xs text-n-slate-11">{{ message }}</p>
+      </template>
+    </div>
+  </div>
+</template>
