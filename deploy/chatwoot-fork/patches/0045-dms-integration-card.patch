+<!-- ProtonIntegrationsPage.vue — OUR file. Integrations list: currently a
+     single card for the DMS/TSP integration shell (Package F), structured
+     so a future integration is just another card in the same grid. The
+     card's status badge is deliberately conservative — it only ever reads
+     "Not connected" (disabled/unconfigured), "Status unavailable" (the
+     config couldn't even be fetched — never claim connected when we don't
+     know), or "Enabled" with an explicit "not verified" caption. It never
+     says "Connected", because GET /admin/integrations/dms never actually
+     probes the remote system — only the config form's "Test connection"
+     button does that. Showing a green "Connected" here from config fields
+     alone would be exactly the shell-mistaken-for-a-working-integration
+     failure this package exists to avoid. (Earlier drafts cited
+     demo-feedback #26 here; #26 is actually about customer-sent video. The
+     requirement stands; only the attribution was wrong.) A failed
+     GET also surfaces a useAlert toast, same as ProtonDmsIntegrationPage's
+     own load() — the "Status unavailable" badge alone would otherwise be
+     the only signal something's wrong, and it's easy to miss on a list
+     page that isn't being actively read. -->
+<script>
+import { useAlert } from 'dashboard/composables';
+import { getDmsIntegration } from 'dashboard/api/protonAdmin';
+
+export default {
+  name: 'ProtonIntegrationsPage',
+  data() {
+    return {
+      dmsLoading: true,
+      dmsErrored: false,
+      dmsConfig: null,
+    };
+  },
+  computed: {
+    dmsStatus() {
+      if (this.dmsLoading)
+        return { label: 'Checking status…', tone: 'neutral' };
+      if (this.dmsErrored)
+        return { label: 'Status unavailable', tone: 'neutral' };
+      const configured =
+        !!this.dmsConfig &&
+        !!this.dmsConfig.enabled &&
+        !!this.dmsConfig.base_url;
+      return configured
+        ? { label: 'Enabled', tone: 'positive' }
+        : { label: 'Not connected', tone: 'negative' };
+    },
+  },
+  async mounted() {
+    try {
+      this.dmsConfig = await getDmsIntegration();
+    } catch (err) {
+      this.dmsErrored = true;
+      useAlert(
+        'Failed to load the DMS/TSP integration status: ' +
+          (err.message || String(err))
+      );
+    } finally {
+      this.dmsLoading = false;
+    }
+  },
+};
+</script>
+
+<template>
+  <div class="p-6">
+    <h1 class="mb-1 text-lg font-medium text-n-slate-12">Integrations</h1>
+    <p class="mb-6 text-sm text-n-slate-11">
+      Third-party systems connected to this CRM.
+    </p>
+
