--- /dev/null
+++ b/app/javascript/dashboard/api/protonChatwootAgents.js
@@ -0,0 +1,56 @@
+// protonChatwootAgents.js — OUR file. Reads Chatwoot's OWN agent list so the
+// Roles & Permissions page can show "Yuda Adi — yudaa0110@gmail.com" instead
+// of the bare numeric id the /authz role-membership endpoints deal in.
+//
+// This deliberately does NOT go through protonAdmin.js's adminRequest: that
+// helper targets the Proton backend (PROTON_BACKEND_URL) and the backend has
+// no user-directory endpoint. Chatwoot's own /api/v1/accounts/:id/agents is
+// the directory, and it authorizes with the same devise_token_auth
+// access-token/client/uid triplet adminRequest already pulls out of the auth
+// cookie (see 0030-fix-admin-request-auth) — so we reuse ./auth rather than
+// reaching into a Vuex module.
+//
+// FAIL-OPEN, like every other Proton addition: any failure here resolves to
+// an empty list, and the caller falls back to rendering raw user ids. A
+// broken or slow directory lookup must never stop an admin from editing
+// permissions.
+import Auth from './auth';
+
+function authHeaders() {
+  const authData = Auth.hasAuthCookie() ? Auth.getAuthData() : null;
+  if (!authData) return null;
+  return {
+    'access-token': authData['access-token'],
+    client: authData.client,
+    uid: authData.uid,
+  };
+}
+
+// The signed-in user's uid (their email). Used to work out which agent row is
+// "you", which is what the self-lockout guard on the Roles page keys off.
+export function currentUserUid() {
+  const authData = Auth.hasAuthCookie() ? Auth.getAuthData() : null;
+  return authData ? authData.uid : null;
+}
+
+export async function listAccountAgents(accountId) {
+  const headers = authHeaders();
+  if (!headers || !accountId) return [];
+  try {
+    const response = await fetch(`/api/v1/accounts/${accountId}/agents`, {
+      headers,
+    });
+    if (!response.ok) return [];
+    const data = await response.json();
+    if (!Array.isArray(data)) return [];
+    return data.map(agent => ({
+      id: agent.id,
+      name: agent.available_name || agent.name || `User ${agent.id}`,
+      email: agent.email || '',
+      thumbnail: agent.thumbnail || '',
+      chatwootRole: agent.role || '',
+    }));
+  } catch {
+    return [];
+  }
+}
