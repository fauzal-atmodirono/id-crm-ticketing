@@ -0,0 +1,39 @@
+<!-- ProtonScopeBadge.vue — OUR file. A small pill stating whether a Weekly
+     Report section's numbers are scoped to the selected week ("This week"),
+     all-time ("All time"), or degraded ("Temporarily unavailable" /
+     "Not available at week granularity") -- see reportScope.js for why these
+     four states exist and what each one means. Every section on the page
+     shows one of these, always, regardless of whether its rows are empty --
+     the badge answers "what period is this?", the section body separately
+     answers "is there data?". -->
+<script setup>
+import { computed } from 'vue';
+import { scopeLabel, scopeColor } from './reportScope';
+
+const props = defineProps({
+  status: {
+    type: String,
+    required: true,
+  },
+});
+
+const label = computed(() => scopeLabel(props.status));
+
+const colorClass = computed(() => {
+  const classMap = {
+    teal: 'bg-n-teal-3 text-n-teal-11',
+    amber: 'bg-n-amber-3 text-n-amber-11',
+    slate: 'bg-n-slate-3 text-n-slate-11',
+  };
+  return classMap[scopeColor(props.status)] || classMap.slate;
+});
+</script>
+
+<template>
+  <span
+    class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium whitespace-nowrap"
+    :class="colorClass"
+  >
+    {{ label }}
+  </span>
+</template>
