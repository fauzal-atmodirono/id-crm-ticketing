+          <span
+            class="px-2 py-0.5 text-xs font-medium rounded-full whitespace-nowrap"
+            :class="{
+              'bg-n-slate-3 text-n-slate-11': dmsStatus.tone === 'neutral',
+              'bg-n-teal-3 text-n-teal-11': dmsStatus.tone === 'positive',
+              'bg-n-ruby-3 text-n-ruby-11': dmsStatus.tone === 'negative',
+            }"
+          >
+            {{ dmsStatus.label }}
+          </span>
+        </div>
+        <p class="text-xs text-n-slate-11">
+          Dealer Management / Telematics Service Provider connection, used to
+          look up vehicle and service history from Customer 360.
+        </p>
+        <p
+          v-if="dmsStatus.tone === 'positive'"
+          class="mt-2 text-xs text-n-slate-11"
