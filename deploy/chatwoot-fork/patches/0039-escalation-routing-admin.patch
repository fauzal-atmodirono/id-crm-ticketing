+          <input
+            v-model="picForm.pic_email"
+            type="email"
+            required
+            class="w-full px-3 py-2 text-sm border rounded-lg border-n-weak bg-n-alpha-black2 text-n-slate-12"
+          />
+        </div>
+        <div>
+          <label class="block mb-1 text-sm text-n-slate-11">PIC WhatsApp</label>
+          <input
+            v-model="picForm.pic_whatsapp"
+            type="text"
+            class="w-full px-3 py-2 text-sm border rounded-lg border-n-weak bg-n-alpha-black2 text-n-slate-12"
