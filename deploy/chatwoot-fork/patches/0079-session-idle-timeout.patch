diff --git a/config/initializers/zz_proton_session.rb b/config/initializers/zz_proton_session.rb
new file mode 100644
index 0000000..0354a24
--- /dev/null
+++ b/config/initializers/zz_proton_session.rb
@@ -0,0 +1,13 @@
+# FIX-18 (patch 0079): optional cap on the devise_token_auth session lifetime.
+#
+# Upstream Chatwoot sets DeviseTokenAuth.token_lifespan to 2 months in
+# config/initializers/devise_token_auth.rb. This file is named zz_ so it loads
+# AFTER that one and can override it. SESSION_TOKEN_LIFESPAN_HOURS unset (or
+# not a positive integer) changes nothing.
+#
+# Note the semantics: with change_headers_on_each_request off, the token expiry
+# is fixed when it is issued, so this is an ABSOLUTE session cap, not an idle
+# timer (the idle timer is client side, SESSION_IDLE_TIMEOUT_MINUTES). Tokens
+# already issued keep their old expiry; the cap applies from the next login.
+hours = ENV.fetch('SESSION_TOKEN_LIFESPAN_HOURS', '').to_i
+DeviseTokenAuth.token_lifespan = hours.hours if hours.positive?
