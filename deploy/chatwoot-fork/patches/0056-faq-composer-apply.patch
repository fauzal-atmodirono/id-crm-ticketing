+// Task 7 (P7): confidence threshold above which a live-FAQ suggestion is
+// promoted from the side panel into the composer's dismissible strip.
+// Only live_faq entries carry a `score` (kb_suggest_router.py's Vertex
+// items never do), so an undefined score always fails this check --
+// Vertex-only results are never shown as a popup, by construction.
+const FAQ_SUGGESTION_CONFIDENCE_THRESHOLD = 0.65;
 
 export default {
   name: 'ReplyTopPanel',
@@ -97,13 +104,182 @@ export default {
     };
 
     const { captainTasksEnabled } = useCaptain();
-    const { hasFeature } = useProtonConfig();
+    const { hasFeature, backendUrl } = useProtonConfig();
     const { updateUISettings } = useUISettings();
     const store = useStore();
     const protonEnabled = computed(() => hasFeature('ai_assist'));
     const showAiButton = computed(
       () => captainTasksEnabled.value || protonEnabled.value
     );
+    const faqSuggestion = ref(null);
+    const dismissedFaqMessageId = ref(null);
+    const faqSuggestionPopupEnabled = computed(() =>
+      hasFeature('faq_suggestion_popup')
+    );
+    const faqSuggestionVisible = computed(
+      () =>
+        faqSuggestionPopupEnabled.value &&
+        !!faqSuggestion.value &&
+        faqSuggestion.value.messageId !== dismissedFaqMessageId.value
+    );
+
+    // Task 7 (P7): GET /kb/suggest for the latest customer message and
+    // keep only the top hit, and only when its confidence clears the
+    // threshold. This is the same endpoint the agent-assist side panel
+    // already calls; the strip is an additional, dismissible surface for
+    // the same data, gated independently by FAQ_SUGGESTION_POPUP_ENABLED
+    // via the 'faq_suggestion_popup' feature name.
+    const fetchFaqSuggestion = async message => {
+      if (!faqSuggestionPopupEnabled.value || !message?.content) return;
+      try {
+        const url = `${backendUrl}/kb/suggest?q=${encodeURIComponent(
+          message.content
+        )}&limit=1`;
+        const response = await fetch(url);
+        if (!response.ok) return;
+        const data = await response.json();
+        const top = (data.suggestions || [])[0];
+        if (
+          top &&
+          typeof top.score === 'number' &&
+          top.score >= FAQ_SUGGESTION_CONFIDENCE_THRESHOLD
+        ) {
+          faqSuggestion.value = { ...top, messageId: message.id };
+        } else {
+          faqSuggestion.value = null;
+        }
+      } catch (err) {
+        // eslint-disable-next-line no-console
+        console.error('[proton-assist]', 'kb-suggest', 'failed', err);
+        faqSuggestion.value = null;
+      }
+    };
+
+    const applyFaqSuggestion = () => {
+      if (!faqSuggestion.value) return;
+      // `answer` is the full FAQ text; `snippet` is a 280-char DISPLAY
+      // truncation. Pasting the snippet sends the customer a warranty clause
+      // cut off mid-word, so Apply must never use it. Falls back to snippet
+      // only for a backend older than the `answer` field.
+      const text = faqSuggestion.value.answer || faqSuggestion.value.snippet;
+      if (!text) return;
+      emit('protonAssistResult', { text, mode: 'reply' });
+    };
+
+    // FIX-23 (RFP 3.2.1/4.19/4.28): thumbs up/down on the suggested FAQ, with
+    // an optional reason on a thumbs-down. One rating per agent per FAQ per
+    // conversation: the backend keys on (faq, agent, conversation), so a
+    // re-click replaces the earlier vote, and `faqRatings` (keyed the same way)
+    // only drives which thumb is shown as selected. Best-effort -- a failed
+    // POST alerts and leaves the strip usable.
+    const { backendKey } = useProtonConfig();
+    const faqRatings = ref({});
+    const faqReasonOpen = ref(false);
+    const faqReason = ref('');
+    const faqRatingKey = () => {
+      const chatId = store.getters.getSelectedChat?.id;
+      return faqSuggestion.value?.id ? `${chatId}:${faqSuggestion.value.id}` : '';
+    };
+    const faqRating = computed(() => faqRatings.value[faqRatingKey()] || '');
+    const submitFaqRating = async (isUp, reason = '') => {
+      const faq = faqSuggestion.value;
+      const key = faqRatingKey();
+      if (!faq?.id || !key) return;
+      const authData = Auth.hasAuthCookie() ? Auth.getAuthData() : null;
+      try {
+        const response = await fetch(`${backendUrl}/kb/feedback`, {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+            ...(backendKey ? { 'x-api-key': backendKey } : {}),
+            // Session triplet (same pattern as protonAssist.js, patch 0068):
+            // with RBAC on the backend takes the rater from the session and
+            // ignores agent_id; with RBAC off it ignores these headers.
+            ...(authData
+              ? {
+                  'x-chatwoot-access-token': authData['access-token'],
+                  'x-chatwoot-client': authData.client,
+                  'x-chatwoot-uid': authData.uid,
+                }
+              : {}),
+          },
+          body: JSON.stringify({
+            article_id: faq.id,
+            session_id: String(store.getters.getSelectedChat?.id || ''),
+            conversation_id: String(store.getters.getSelectedChat?.id || ''),
+            agent_id: String(store.getters.getCurrentUserID || ''),
+            helpful: isUp,
+            score: isUp ? 5 : 1,
+            reason,
+          }),
+        });
+        if (!response.ok) throw new Error(`HTTP ${response.status}`);
+        faqRatings.value = { ...faqRatings.value, [key]: isUp ? 'up' : 'down' };
+        faqReasonOpen.value = false;
+        faqReason.value = '';
+        useAlert('Thanks for the feedback.');
+      } catch (err) {
+        // eslint-disable-next-line no-console
+        console.error('[proton-assist]', 'faq-rating', 'failed', err);
+        useAlert('Could not save the FAQ rating.');
+      }
+    };
+    // A new suggestion (or a cleared one) must not inherit the previous
+    // one's half-typed reason box.
+    watch(
+      () => faqSuggestion.value?.id,
+      () => {
+        faqReasonOpen.value = false;
+        faqReason.value = '';
+      }
+    );
+    const rateFaqUp = () => submitFaqRating(true);
+    const openFaqDownReason = () => {
+      faqReasonOpen.value = !faqReasonOpen.value;
+    };
+    const submitFaqDown = () => submitFaqRating(false, faqReason.value.trim());
+
+    const dismissFaqSuggestion = () => {
+      if (faqSuggestion.value) {
+        dismissedFaqMessageId.value = faqSuggestion.value.messageId;
+      }
+    };
+
+    const refreshFaqSuggestion = () => {
+      const chat = store.getters.getSelectedChat;
+      const lastCustomerMessage = [...(chat?.messages || [])]
+        .reverse()
+        .find(m => m.content && m.message_type === 0);
+      if (lastCustomerMessage) {
+        fetchFaqSuggestion(lastCustomerMessage);
+      } else {
+        // A conversation with no customer message yet must show nothing --
+        // NOT whatever the previously-open conversation was showing.
+        faqSuggestion.value = null;
+      }
+    };
+
+    // Watch the conversation id as well as the message count. Watching only
+    // the count leaked across conversations: switching from A to B with an
+    // equal message count fired no callback at all, so the strip kept showing
+    // A's suggestion and Apply pasted A's answer into B's composer. Clearing
+    // eagerly on an id change also stops a stale suggestion being visible
+    // during B's fetch, and `immediate` means the strip appears on entering a
+    // conversation rather than only after its next inbound message.
+    watch(
+      () => [
+        store.getters.getSelectedChat?.id,
+        store.getters.getSelectedChat?.messages?.length,
+      ],
+      ([newId], oldValue) => {
+        if (!oldValue || newId !== oldValue[0]) {
+          faqSuggestion.value = null;
+          dismissedFaqMessageId.value = null;
+        }
+        refreshFaqSuggestion();
+      },
+      { immediate: true }
+    );
 
