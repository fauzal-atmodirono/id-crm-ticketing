        {
          "event": "noMatch",
          "next": "after_hours_en"
        },
        {
          "event": "match",
          "next": "language_gather",
          "conditions": [
            {
              "friendly_name": "before 17:30",
              "arguments": [
                "{{ 'now' | date: '%s' | plus: 28800 | modulo: 86400 | divided_by: 60 }}"
              ],
              "type": "less_than",
              "value": "1050"
