@@ -0,0 +1,522 @@
+<!-- ProtonEscalationRoutingPage.vue — OUR file. Escalation Routing admin:
+     department -> PIC (person-in-charge) contact mapping, and dealer ->
+     email mapping, backing SLA/escalation notification routing. Two
+     independent add/edit/delete tables sharing one page shell (mirrors
+     ProtonRsaPage.vue's shell: header, n-* tokens, useAlert toasts, inline
+     row edit). department/dealer are the PUT/DELETE URL path key in the
+     backend (pic_admin_router.py) and so are immutable once created —
+     editing a row updates the other fields via that same key; changing the
+     key itself means delete + re-add. -->
+<script>
+import { useAlert } from 'dashboard/composables';
+import {
+  listPics,
+  upsertPic,
+  deletePic,
+  listDealers,
+  upsertDealer,
+  deleteDealer,
+} from 'dashboard/api/protonAdmin';
+
+const EMPTY_PIC_FORM = {
+  department: '',
+  pic_name: '',
+  pic_email: '',
+  pic_whatsapp: '',
+  cc_emails: '', // comma-separated in the UI; split to an array on submit
+};
+
+const EMPTY_DEALER_FORM = {
+  dealer: '',
+  email: '',
+};
+
+function splitEmails(value) {
+  return String(value || '')
+    .split(',')
+    .map(s => s.trim())
+    .filter(Boolean);
+}
+
+export default {
+  name: 'ProtonEscalationRoutingPage',
+  data() {
+    return {
+      pics: [],
+      dealers: [],
+      picForm: { ...EMPTY_PIC_FORM },
+      dealerForm: { ...EMPTY_DEALER_FORM },
+      editingPicDepartment: null,
+      editPicForm: { ...EMPTY_PIC_FORM },
+      editingDealerName: null,
+      editDealerForm: { ...EMPTY_DEALER_FORM },
+      loading: true,
+      errored: false,
+      savingPic: false,
+      savingDealer: false,
+    };
+  },
+  async mounted() {
+    await this.load();
+  },
+  methods: {
+    async load() {
+      this.loading = true;
+      this.errored = false;
+      try {
+        const [pics, dealers] = await Promise.all([listPics(), listDealers()]);
+        this.pics = pics;
+        this.dealers = dealers;
+      } catch (err) {
+        this.errored = true;
+        useAlert(
+          'Failed to load escalation routing: ' + (err.message || String(err))
+        );
+      } finally {
+        this.loading = false;
+      }
+    },
+    // ── PIC (department -> contact) ─────────────────────────────────────
+    async createPic() {
+      if (
+        !this.picForm.department ||
+        !this.picForm.pic_name ||
+        !this.picForm.pic_email
+      ) {
+        useAlert('Department, PIC name and PIC email are required.');
+        return;
+      }
+      this.savingPic = true;
+      try {
+        await upsertPic(this.picForm.department, {
+          pic_name: this.picForm.pic_name,
+          pic_email: this.picForm.pic_email,
+          pic_whatsapp: this.picForm.pic_whatsapp,
+          cc_emails: splitEmails(this.picForm.cc_emails),
+        });
+        useAlert('PIC saved.');
+        this.picForm = { ...EMPTY_PIC_FORM };
+        await this.load();
+      } catch (err) {
+        useAlert('Failed to save PIC: ' + (err.message || String(err)));
+      } finally {
+        this.savingPic = false;
+      }
+    },
+    startEditPic(pic) {
+      this.editingPicDepartment = pic.department;
+      this.editPicForm = {
+        department: pic.department,
+        pic_name: pic.pic_name || '',
+        pic_email: pic.pic_email || '',
+        pic_whatsapp: pic.pic_whatsapp || '',
+        cc_emails: Array.isArray(pic.cc_emails) ? pic.cc_emails.join(', ') : '',
+      };
+    },
+    cancelEditPic() {
+      this.editingPicDepartment = null;
+      this.editPicForm = { ...EMPTY_PIC_FORM };
+    },
+    async saveEditPic() {
+      this.savingPic = true;
+      try {
+        await upsertPic(this.editingPicDepartment, {
+          pic_name: this.editPicForm.pic_name,
+          pic_email: this.editPicForm.pic_email,
+          pic_whatsapp: this.editPicForm.pic_whatsapp,
+          cc_emails: splitEmails(this.editPicForm.cc_emails),
+        });
+        useAlert('PIC updated.');
+        this.cancelEditPic();
+        await this.load();
+      } catch (err) {
+        useAlert('Failed to update PIC: ' + (err.message || String(err)));
+      } finally {
+        this.savingPic = false;
+      }
+    },
+    async removePic(department) {
+      // eslint-disable-next-line no-alert
+      if (
+        !window.confirm(
+          `Delete the PIC for "${department}"? This cannot be undone.`
+        )
+      ) {
+        return;
+      }
+      this.savingPic = true;
+      try {
+        await deletePic(department);
+        useAlert('PIC deleted.');
+        if (this.editingPicDepartment === department) this.cancelEditPic();
+        await this.load();
+      } catch (err) {
+        useAlert('Failed to delete PIC: ' + (err.message || String(err)));
+      } finally {
+        this.savingPic = false;
+      }
+    },
+    // ── Dealer (dealer -> email) ─────────────────────────────────────────
+    async createDealer() {
+      if (!this.dealerForm.dealer || !this.dealerForm.email) {
+        useAlert('Dealer and email are required.');
+        return;
+      }
+      this.savingDealer = true;
+      try {
+        await upsertDealer(this.dealerForm.dealer, {
+          email: this.dealerForm.email,
+        });
+        useAlert('Dealer saved.');
+        this.dealerForm = { ...EMPTY_DEALER_FORM };
+        await this.load();
+      } catch (err) {
+        useAlert('Failed to save dealer: ' + (err.message || String(err)));
+      } finally {
+        this.savingDealer = false;
+      }
+    },
+    startEditDealer(dealer) {
+      this.editingDealerName = dealer.dealer;
+      this.editDealerForm = { dealer: dealer.dealer, email: dealer.email || '' };
+    },
+    cancelEditDealer() {
+      this.editingDealerName = null;
+      this.editDealerForm = { ...EMPTY_DEALER_FORM };
+    },
+    async saveEditDealer() {
+      this.savingDealer = true;
+      try {
+        await upsertDealer(this.editingDealerName, {
+          email: this.editDealerForm.email,
+        });
+        useAlert('Dealer updated.');
+        this.cancelEditDealer();
+        await this.load();
+      } catch (err) {
+        useAlert('Failed to update dealer: ' + (err.message || String(err)));
+      } finally {
+        this.savingDealer = false;
+      }
+    },
+    async removeDealer(dealer) {
+      // eslint-disable-next-line no-alert
+      if (!window.confirm(`Delete dealer "${dealer}"? This cannot be undone.`)) {
+        return;
+      }
+      this.savingDealer = true;
+      try {
+        await deleteDealer(dealer);
+        useAlert('Dealer deleted.');
+        if (this.editingDealerName === dealer) this.cancelEditDealer();
+        await this.load();
+      } catch (err) {
+        useAlert('Failed to delete dealer: ' + (err.message || String(err)));
+      } finally {
+        this.savingDealer = false;
+      }
+    },
+  },
+};
+</script>
