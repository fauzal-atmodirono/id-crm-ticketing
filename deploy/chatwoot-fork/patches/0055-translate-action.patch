diff --git a/app/javascript/dashboard/components/widgets/WootWriter/ReplyTopPanel.vue b/app/javascript/dashboard/components/widgets/WootWriter/ReplyTopPanel.vue
index 0a6cec2..7c1d2e3 100644
--- a/app/javascript/dashboard/components/widgets/WootWriter/ReplyTopPanel.vue
+++ b/app/javascript/dashboard/components/widgets/WootWriter/ReplyTopPanel.vue
@@ -12,4 +12,5 @@
 import { useProtonConfig } from 'dashboard/composables/useProtonConfig';
 import { callAssist } from 'dashboard/api/protonAssist';
 import { useStore } from 'dashboard/composables/store';
+import { useAlert } from 'dashboard/composables';

@@ -135,5 +136,44 @@ export default {
       emit('executeCopilotAction', actionKey, data || props.editorContent);
     };

+    // Task 3 (P7): translate the latest customer message into English.
+    // POST /assist/translate posts the result directly into the
+    // conversation as a private note (translate_router.py) -- there is no
+    // reply/note text for this panel to insert, so this stays a separate
+    // method rather than folding into PROTON_ACTIONS/handleCopilotAction
+    // above, which both assume exactly that: text to insert somewhere.
+    const translating = ref(false);
+    const handleTranslateLastCustomerMessage = async () => {
+      if (!protonEnabled.value || translating.value) return;
+      const chat = store.getters.getSelectedChat;
+      const lastCustomerMessage = [...(chat?.messages || [])]
+        .reverse()
+        .find(m => m.content && m.message_type === 0);
+      if (!lastCustomerMessage) {
+        useAlert('No customer message to translate yet.');
+        return;
+      }
+      translating.value = true;
+      try {
+        const result = await callAssist('translate', {
+          conversation_id: String(props.conversationId),
+          text: lastCustomerMessage.content,
+        });
+        if (result.disabled) {
+          useAlert('Translation is not enabled on this account.');
+        } else {
+          useAlert(
+            `Translated (${result.detected_source_language} → en) and posted as a private note.`
+          );
+        }
+      } catch (err) {
+        // eslint-disable-next-line no-console
+        console.error('[proton-assist]', 'translate', 'failed', err);
+        useAlert('Translation failed. Please try again.');
+      } finally {
+        translating.value = false;
+      }
+    };
+
     const toggleCopilotMenu = () => {
       const isOpening = !showCopilotMenu.value;
@@ -168,8 +208,10 @@ export default {
       handleNoteClick,
       REPLY_EDITOR_MODES,
       captainTasksEnabled,
       protonEnabled,
       showAiButton,
+      translating,
+      handleTranslateLastCustomerMessage,
       handleCopilotAction,
       showCopilotMenu,
       copilotToggleRef,
@@ -217,5 +259,16 @@ export default {
         </span>
       </div>
     </div>
+    <div v-if="protonEnabled" class="flex items-center gap-2">
+      <button
+        class="flex items-center gap-1 px-2 py-1 text-xs border rounded-lg border-n-weak text-n-slate-11"
+        :disabled="translating"
+        title="Translate the customer's last message to English"
+        @click="handleTranslateLastCustomerMessage"
+      >
+        <span class="i-lucide-languages" />
+        {{ translating ? 'Translating…' : 'Translate' }}
+      </button>
+    </div>
     <div v-if="showAiButton" class="flex items-center gap-2">
