+++ b/app/javascript/dashboard/views/escalationRouting/LadderStatusBanner.vue
@@ -0,0 +1,75 @@
+<script setup>
+// What the dealer ladder is doing right now, in one line (patch 0101). Reads
+// the `effective` block of GET /admin/escalation/ladder -- what is in force,
+// not what the form holds -- so an unsaved edit never changes the banner.
+import { computed } from 'vue';
+import { ladderMode } from './routingHelpers';
+
+const props = defineProps({
+  effective: { type: Object, default: null },
+  showLink: { type: Boolean, default: false },
+});
+const emit = defineEmits(['open-ladder']);
+
+const mode = computed(() => (props.effective ? ladderMode(props.effective) : null));
+const COPY = {
+  off: {
+    badge: 'OFF',
+    title: 'Dealer ladder is off',
+    text: 'Only the first escalation email is sent. No reminders follow.',
+    tone: 'bg-n-slate-3 border-n-weak text-n-slate-12',
+    badgeTone: 'bg-n-slate-6 text-n-slate-12',
+  },
+  dry_run: {
+    badge: 'DRY RUN',
+    title: 'Dealer ladder is running, but emails nobody',
+    text: 'It logs the reminders it would send.',
+    tone: 'bg-n-amber-3 border-n-amber-6 text-n-amber-12',
+    badgeTone: 'bg-n-amber-5 text-n-amber-12',
+  },
+  live: {
+    badge: 'LIVE',
+    title: 'Dealer ladder is emailing real dealer contacts',
+    text: 'Reminders go out as each step falls due.',
+    tone: 'bg-n-ruby-3 border-n-ruby-6 text-n-ruby-12',
+    badgeTone: 'bg-n-ruby-9 text-white',
+  },
+};
+const copy = computed(() => (mode.value ? COPY[mode.value] : null));
+</script>
+
+<template>
+  <section
+    v-if="copy"
+    aria-label="Ladder status"
+    class="flex flex-wrap items-center gap-4 px-5 py-4 border rounded-xl"
+    :class="copy.tone"
+  >
+    <div class="flex flex-col flex-1 gap-1 min-w-[280px]">
+      <div class="flex items-center gap-2">
+        <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full" :class="copy.badgeTone">
+          {{ copy.badge }}
+        </span>
+        <strong class="text-sm font-semibold">{{ copy.title }}</strong>
+      </div>
+      <p class="text-sm">
+        {{ copy.text }}
+        <template v-if="mode !== 'off' && effective.scan_interval_seconds">
+          Checks every {{ effective.scan_interval_seconds }} s.
+        </template>
+        <template v-if="effective.from_store === false">
+          (From the deployment — nothing set here yet.)
+        </template>
+      </p>
+    </div>
+    <button
+      v-if="showLink"
+      type="button"
+      class="px-3.5 py-2 text-sm font-medium border rounded-lg bg-n-solid-1 border-n-weak text-n-slate-12 hover:bg-n-alpha-2"
+      @click="emit('open-ladder')"
+    >
+      Open ladder settings
+    </button>
+  </section>
+  <p v-else class="text-sm text-n-slate-11">Ladder status is not available.</p>
+</template>
diff --git a/app/javascript/dashboard/views/escalationRouting/LadderTab.vue b/app/javascript/dashboard/views/escalationRouting/LadderTab.vue
new file mode 100644
index 0000000..340a7ba
--- /dev/null
+++ b/app/javascript/dashboard/views/escalationRouting/LadderTab.vue
@@ -0,0 +1,201 @@
+<script setup>
+// Ladder tab (patch 0101): Off / Dry run / Live plus the steps as a timeline.
+// The three-way choice is stored as the same two booleans as before
+// (modeToFlags); blank hours are sent as null ("use the deployment's value"),
+// never 0 -- a 0-hour reminder would email principals at once. Same PUT and
+// body as the pre-0101 saveLadder.
+import { computed, ref, watch } from 'vue';
+import { useAlert } from 'dashboard/composables';
+import { adminRequest } from 'dashboard/api/protonAdmin';
+import LadderStatusBanner from './LadderStatusBanner.vue';
+import { LADDER_PATH, ladderMode, modeToFlags, numOrNull, skippingDealers } from './routingHelpers';
+
+const props = defineProps({
+  form: { type: Object, required: true }, // the loaded ladder form
+  effective: { type: Object, default: null },
+  dealers: { type: Array, default: () => [] },
+  labels: { type: Object, default: () => ({}) },
+});
+const emit = defineEmits(['saved']);
+
+const local = ref({});
+const mode = ref('off');
+const saving = ref(false);
+
+watch(
+  () => props.form,
+  f => {
+    local.value = { ...f };
+    mode.value = ladderMode(f);
+  },
+  { immediate: true, deep: true }
+);
+
+const MODES = [
+  { value: 'off', label: 'Off', active: 'bg-n-slate-3 text-n-slate-12' },
+  { value: 'dry_run', label: 'Dry run', active: 'bg-n-amber-3 text-n-amber-12' },
+  { value: 'live', label: 'Live', active: 'bg-n-ruby-3 text-n-ruby-12' },
+];
+
+const principal = computed(() => props.labels.principal || 'Dealer Principal');
+const owner = computed(() => props.labels.owner || 'Dealer Owner');
+const rep = computed(() => props.labels.rep || 'CRE');
+const skip3 = computed(() => skippingDealers(3, props.dealers));
+const skip4 = computed(() => skippingDealers(4, props.dealers));
+
+function skipText(list, role) {
+  if (!list.length) return '';
+  const who = list.slice(0, 3).join(', ') + (list.length > 3 ? ` and ${list.length - 3} more` : '');
+  return `${list.length} ${list.length === 1 ? props.labels.partnerLower || 'dealer' : props.labels.partnerPluralLower || 'dealers'} ${list.length === 1 ? 'has' : 'have'} no ${role} (${who}): this step is skipped for ${list.length === 1 ? 'it' : 'them'}.`;
+}
+
+const steps = computed(() => [
+  { no: 1, title: 'Step 1 · First escalation', when: '0 h', note: 'sent by the escalate label', to: `${rep.value}, Sales/Aftersales Manager`, cc: `${principal.value}, Area/Regional Manager, HOD` },
+  { no: 2, key: 'step2_hours', title: 'Step 2 · Acknowledgement due', quiet: true, body: "Nothing is sent. The dealer's window to acknowledge." },
+  { no: 3, key: 'step3_hours', title: 'Step 3 · 1st reminder', to: principal.value, cc: `${owner.value}, Sales/AS Manager, ${rep.value}, Area/Regional Manager, HOD`, warn: skipText(skip3.value, principal.value) },
+  { no: 4, key: 'step4_hours', title: 'Step 4 · 2nd reminder', to: owner.value, cc: `${principal.value}, Sales/AS Manager, ${rep.value}, Area/Regional Manager, HOD`, warn: skipText(skip4.value, owner.value) },
+  { no: 5, key: 'step5_hours', title: 'Step 5 · Final escalation by telephone', note: 'the sweep after step 4', body: `Raises a call task for the ${principal.value} and ${owner.value}. Sends no email.` },
+  { no: 6, title: 'Step 6 · 48 h unresolved alert', when: '48 h', fixed: true, to: owner.value, cc: `${principal.value}, Area/Regional Manager, HOD`, body: 'Fires even if the dealer replied; only resolving the case stops it.' },
+]);
+
+async function save() {
+  saving.value = true;
+  const flags = modeToFlags(mode.value);
+  try {
+    await adminRequest(LADDER_PATH, {
+      method: 'PUT',
+      body: {
+        enabled: flags.enabled,
+        dry_run: flags.dry_run,
+        scan_interval_seconds: numOrNull(local.value.scan_interval_seconds),
+        step2_hours: numOrNull(local.value.step2_hours),
+        step3_hours: numOrNull(local.value.step3_hours),
+        step4_hours: numOrNull(local.value.step4_hours),
+        step5_hours: numOrNull(local.value.step5_hours),
+      },
+    });
+    useAlert(
+      mode.value === 'live'
+        ? 'Ladder saved. It is now sending reminders for real.'
+        : 'Ladder settings saved.'
+    );
+    emit('saved');
+  } catch (err) {
+    useAlert('Failed to save ladder settings: ' + (err.message || String(err)));
+  } finally {
+    saving.value = false;
+  }
+}
+
+const hoursInput =
+  'w-16 h-9 px-2 !mb-0 text-sm font-semibold text-right border rounded-lg border-n-weak bg-n-alpha-black2 text-n-slate-12';
+</script>
+
+<template>
+  <div class="flex flex-col gap-5">
+    <LadderStatusBanner :effective="effective" />
+
+    <section aria-label="Ladder mode" class="flex flex-wrap items-center gap-5 px-5 py-4 border rounded-xl border-n-weak">
+      <div class="flex flex-col flex-1 gap-1 min-w-[260px]">
+        <strong class="text-sm font-semibold text-n-slate-12">How the ladder runs</strong>
+        <span class="text-sm text-n-slate-11">
+          Timers count <strong class="font-semibold text-n-slate-12">working hours</strong> from the moment the case was escalated.
+        </span>
+      </div>
+      <div role="radiogroup" aria-label="Ladder mode" class="flex overflow-hidden border rounded-lg border-n-weak">
+        <label
+          v-for="m in MODES"
+          :key="m.value"
+          class="flex items-center gap-2 px-3.5 py-2 text-sm cursor-pointer border-l first:border-l-0 border-n-weak"
+          :class="mode === m.value ? `${m.active} font-medium` : 'text-n-slate-11'"
+        >
+          <input v-model="mode" type="radio" name="ladder-mode" :value="m.value" class="!mb-0" />
+          {{ m.label }}
+        </label>
+      </div>
+      <label class="flex items-center gap-2 text-sm text-n-slate-12">
+        Check every
+        <input
+          v-model="local.scan_interval_seconds"
+          type="number"
+          min="30"
+          placeholder="300"
+          class="w-20 h-9 px-2 !mb-0 text-sm border rounded-lg border-n-weak bg-n-alpha-black2 text-n-slate-12"
+        />
+        seconds
+      </label>
+    </section>
+
+    <p v-if="mode === 'live'" class="px-4 py-3 text-sm rounded-lg bg-n-ruby-3 text-n-ruby-12">
+      Reminders will be emailed to real {{ labels.partnerLower || 'dealer' }} contacts. Run with dry run on first and read
+      the log for a full working week before switching it off.
+    </p>
+    <p v-else-if="mode === 'dry_run'" class="px-4 py-3 text-sm rounded-lg bg-n-amber-3 text-n-amber-12">
+      Dry run: the ladder logs what it would send and emails nobody.
+    </p>
+
+    <ol class="flex flex-col">
+      <li v-for="(s, i) in steps" :key="s.no" class="grid gap-x-4 grid-cols-[96px_28px_minmax(0,1fr)]">
+        <div class="flex flex-col items-end gap-1 pt-3">
+          <template v-if="s.key">
+            <input v-model="local[s.key]" type="number" min="0" step="0.5" :aria-label="`Step ${s.no} hours`" :class="hoursInput" />
+            <span class="text-xs text-n-slate-11">hours</span>
+          </template>
+          <template v-else>
+            <span class="pt-1.5 text-sm font-semibold text-n-slate-12">{{ s.when }}</span>
+            <span v-if="s.fixed" class="text-xs text-n-slate-11">fixed</span>
+          </template>
+        </div>
+        <div class="flex flex-col items-center">
+          <span
+            class="mt-[18px] size-3.5 shrink-0"
+            :class="
+              s.fixed
+                ? 'rounded-sm bg-n-ruby-9 rotate-45'
+                : s.quiet
+                  ? 'rounded-full border-2 border-n-slate-9 bg-n-solid-1'
+                  : 'rounded-full bg-n-brand'
+            "
+            aria-hidden="true"
+          />
+          <span v-if="i < steps.length - 1" class="flex-1 w-0.5 bg-n-weak" aria-hidden="true" />
+        </div>
+        <div
+          class="flex flex-col gap-1.5 px-4 py-3.5 mb-3.5 border rounded-xl"
+          :class="
+            s.fixed
+              ? 'border-n-ruby-6 bg-n-ruby-2'
+              : s.quiet
+                ? 'border-dashed border-n-slate-7 bg-n-alpha-1'
+                : 'border-n-weak'
+          "
+        >
+          <div class="flex flex-wrap items-baseline gap-2">
+            <strong class="text-sm font-semibold text-n-slate-12">{{ s.title }}</strong>
+            <span v-if="s.note" class="text-sm text-n-slate-11">{{ s.note }}</span>
+          </div>
+          <div v-if="s.to" class="text-sm leading-relaxed text-n-slate-12">
+            <span class="text-n-slate-11">To</span> {{ s.to }}
+            <template v-if="s.cc"> · <span class="text-n-slate-11">CC</span> {{ s.cc }}</template>
+          </div>
+          <div v-if="s.body" class="text-sm leading-relaxed" :class="s.quiet ? 'text-n-slate-11' : 'text-n-slate-12'">
+            {{ s.body }}
+          </div>
+          <div v-if="s.warn" class="text-xs text-n-ruby-11">{{ s.warn }}</div>
+        </div>
+      </li>
+    </ol>
+
+    <div class="flex flex-wrap items-center gap-4 pt-2 border-t border-n-weak">
+      <button
+        type="button"
+        :disabled="saving"
+        class="h-10 px-5 text-sm font-medium text-white rounded-lg bg-n-brand hover:opacity-90 disabled:opacity-50"
+        @click="save"
+      >
+        {{ saving ? 'Saving…' : 'Save ladder' }}
+      </button>
+      <span class="text-xs text-n-slate-11">Blank hours use the deployment's value.</span>
+    </div>
+  </div>
+</template>
diff --git a/app/javascript/dashboard/views/escalationRouting/OverviewTab.vue b/app/javascript/dashboard/views/escalationRouting/OverviewTab.vue
