+// protonAlerts.js (api) — OUR file. The five /alerts/rules endpoints
+// features/alerts/rules_router.py exposes.
+//
+// It reuses `adminRequest` from protonAdmin.js rather than adding a sixth
+// request helper: these endpoints are gated by require_permission
+// (`alerts.set_own_preferences` for the /mine* paths, `alerts.manage` for the
+// defaults) and adminRequest is the one helper that already forwards the
+// devise_token_auth access-token/client/uid triplet those checks need — see
+// patch 0030, which fixed exactly this for the earlier admin pages.
+//
+// WHY agent_id IS ALWAYS SENT. With RBAC on, the router resolves the caller
+// from their own Chatwoot session and IGNORES this parameter entirely — there
+// is no way to point a /mine call at a colleague. With RBAC off there is no
+// verifiable caller identity at all, and the router returns 400 unless
+// agent_id is supplied. Sending it unconditionally is therefore the only form
+// that works in both modes, and it grants nothing in the mode that matters.
+import { adminRequest } from 'dashboard/api/protonAdmin';
+
+function withAgent(path, agentId) {
+  if (agentId === null || agentId === undefined || agentId === '') return path;
+  const separator = path.includes('?') ? '&' : '?';
+  return `${path}${separator}agent_id=${encodeURIComponent(agentId)}`;
+}
+
+// What will actually fire for me, per event: my override, else the account
+// default, else the built-in default — already resolved by the backend.
+export function getMyAlertRules(agentId) {
+  return adminRequest(withAgent('/alerts/rules/mine', agentId));
+}
+
+export function putMyAlertRule(event, rule, agentId) {
+  return adminRequest(withAgent(`/alerts/rules/mine/${encodeURIComponent(event)}`, agentId), {
+    method: 'PUT',
+    body: rule,
+  });
+}
+
+// Delete MY override for one event, reverting me to the account default. The
+// router answers with the rule that resolves after the reset, so the caller
+// repaints the row without a second round trip.
+export function resetMyAlertRule(event, agentId) {
+  return adminRequest(withAgent(`/alerts/rules/mine/${encodeURIComponent(event)}`, agentId), {
+    method: 'DELETE',
+  });
+}
+
+// Readable by any agent — knowing what you inherit is not privileged.
+export function getAlertDefaults() {
+  return adminRequest('/alerts/rules/defaults');
+}
+
+// `alerts.manage` only. One agent quietly turning down the account-wide
+// sla_breach default would go unnoticed until the whole team missed one.
+export function putAlertDefault(event, rule) {
+  return adminRequest(`/alerts/rules/defaults/${encodeURIComponent(event)}`, {
+    method: 'PUT',
+    body: rule,
+  });
+}
