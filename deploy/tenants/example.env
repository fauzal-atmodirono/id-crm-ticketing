# Template for a per-tenant env file. scripts/add-tenant.sh generates a real
# deploy/tenants/<tenant>.env from this shape (secrets auto-filled; agent
# tokens left blank for the operator to fill after onboarding).
#
# Bring a tenant up manually with:
#   docker compose -p <tenant> -f docker-compose.tenant.yml --env-file tenants/<tenant>.env up -d

# --- Identity --------------------------------------------------------------
TENANT=example
PUBLIC_IP=127-0-0-1
# Public-hostname label prefix. Normally "<tenant>." (e.g. proton.) so the
# tenant is served at proton.crm.<ip>.nip.io. Set empty (via add-tenant.sh
# --bare, or automatically for the tenant named "default") to serve at the
# bare crm.<ip>.nip.io hostnames. Container aliases are unaffected.
HOST_PREFIX=example.

# --- Secrets (auto-generated per tenant; no single quotes in passwords) -----
CHATWOOT_DB_PASSWORD=changeme
ZAMMAD_DB_PASSWORD=changeme
AGENT_DB_PASSWORD=changeme
BACKEND_DB_PASSWORD=changeme
REDIS_PASSWORD=changeme
SECRET_KEY_BASE=changeme

# --- Agent service config --------------------------------------------------
# Filled by the operator AFTER running the Chatwoot setup wizard and
# generating tokens (see README §5–6). Blank is fine until then.
CHATWOOT_API_TOKEN=
CHATWOOT_PLATFORM_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_BOT_TOKEN=
CHATWOOT_BOT_SECRET=
# Gemini auth: by default both agent + backend use Vertex AI via ADC
# (GOOGLE_GENAI_USE_VERTEXAI=true + VERTEX_PROJECT_ID/LOCATION + GCP_ADC_PATH),
# so GEMINI_API_KEY can be left blank. Only set it to use the AI-Studio path
# (GOOGLE_GENAI_USE_VERTEXAI=false).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_MODE=suggest
# Demo-only. When true, a trailing `[slug]` in a customer's WhatsApp message
# repoints that contact at a different demo persona -- it REWRITES the contact
# record (name + the nine profile attributes), so the agent sidebar and the AI
# never disagree about who the customer is. Personas live in
# agent/app/services/demo_persona.py: [moderat] [konservatif] [agresif].
# Leave false on any tenant carrying real customers: this is one stray bracket
# away from overwriting a live contact.
DEMO_PERSONA_SLUGS_ENABLED=false
# When true, the WhatsApp/agent-bot sources its reply text from the backend
# KB-grounded copilot (/assist/copilot) instead of the local Gemini draft.
# Requires PROTON_BACKEND_URL/KEY set. Off = local draft (unchanged).
KB_GROUNDED_REPLIES=false
AUTO_RESOLVE=false
# Voice-note + image + video understanding for the agent-bot's chat-agent path
# (CHAT_AGENT_ENABLED=true only). Off = today's text-only behavior. When on,
# incoming WhatsApp audio/image/video attachments are downloaded and forwarded
# to backend/'s /chat/turn as multimodal Parts alongside the text.
WHATSAPP_MEDIA_UNDERSTANDING_ENABLED=false
# Inline-media budget for one turn, in RAW (pre-encode) bytes. Applied both to
# a single video and to the turn's combined audio+image+video payload; anything
# over it is dropped and logged, and the turn still proceeds on what remains
# (text only if need be). Default 14 MB: google-genai sends inline_data as
# base64 in a JSON REST body (~1.335x inflation) against Gemini's ~20 MB inline
# request cap, so 14 MB raw is ~18.7 MB on the wire and leaves headroom for the
# conversation history and the system instruction. Do NOT raise this to
# WhatsApp's own 16 MB inbound cap — 16 MB encodes to ~21.4 MB and Gemini
# rejects the request.
WHATSAPP_VIDEO_MAX_BYTES=14680064

# --- Outbound email (optional) ---
# Blank → uses the shared Mailpit catcher (no real delivery). Set these to send
# real mail (agent replies, auto-acks, escalation transcripts, notifications)
# via an SMTP host, e.g. Gmail. NOTE: Gmail needs 2FA + an App Password (enter it
# WITHOUT spaces). This is send-only; a two-way Email inbox is added via the
# Chatwoot UI (Settings → Inboxes → Email) with IMAP + SMTP.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_DOMAIN=gmail.com
SMTP_ENABLE_STARTTLS_AUTO=true
MAILER_SENDER_EMAIL=

# --- Conversation lifecycle & auto-close (agent service) ---
# Master switch. When false the whole feature is a no-op (default).
LIFECYCLE_ENABLED=false
# How often the scanner ticks over open/pending conversations (seconds).
LIFECYCLE_SCAN_INTERVAL_SECONDS=60
# Minutes of customer inactivity before the idle warning is posted.
LIFECYCLE_IDLE_WARN_MINUTES=10
# Grace after the warning before auto-close, IN business hours (10+5=15m total).
LIFECYCLE_IDLE_CLOSE_GRACE_MINUTES=5
# Grace after the warning before auto-close, OUTSIDE business hours (10+0=10m total).
LIFECYCLE_IDLE_CLOSE_OUT_OF_HOURS_GRACE_MINUTES=0
# Minutes to wait for a YES/NO (or rating) reply before treating as resolved.
LIFECYCLE_CONFIRM_GRACE_MINUTES=10
# Auto-resolve a handed-off (assigned) conversation after this many minutes idle,
# so an abandoned handoff self-clears instead of swallowing the customer's later
# messages. 0 = disabled (assigned conversations left entirely to the human).
LIFECYCLE_ASSIGNED_IDLE_RESOLVE_MINUTES=0
# Skip `pending` conversations in the idle scanner. Set true ONLY on a tenant
# whose inbox is driven by a third-party agent bot (aeon360): there `pending`
# means that bot is mid-conversation, and our idle warning posts as an outgoing
# message from a user — which its decision table reads as a human taking over,
# cancelling the AI and flipping the conversation to `open`. Leave false where
# our own orchestrator is the bot, or idle warnings stop entirely.
LIFECYCLE_SKIP_PENDING=false
# Post the rating survey after resolution.
LIFECYCLE_SURVEY_ENABLED=true
# Post the AI disclaimer/welcome on conversation-created.
LIFECYCLE_DISCLAIMER_ENABLED=true
# Optionally apply a case-category label on bot auto-close (off by default).
LIFECYCLE_AUTO_CATEGORIZE=false

# --- SOP completion (agent service) ---
# Category slugs the bot may assign on resolution (comma-separated); must match
# the tenant's taxonomy. Empty disables auto-categorization even if
# LIFECYCLE_AUTO_CATEGORIZE=true.
LIFECYCLE_CATEGORY_LABELS=
# Email once-per-thread auto-acknowledgement.
EMAIL_AUTOACK_ENABLED=false
# EMAIL_AUTOACK_TEMPLATE has a built-in SOP default; override only to customize.

# EM-7: two-thread email escalation for natively-escalated Email-channel
# conversations. Requires PROTON_BACKEND_URL/KEY (below) to be set --
# fail-open, no-op otherwise. Default off, byte-identical when unset.
EMAIL_ESCALATION_ENABLED=false

# P1: on the first inbound message, stamp received_in_business_hours,
# received_at_local and (when out of hours) attend_after onto the
# conversation. Written once at intake and never overwritten -- a flag
# recomputed at report time answers a different question, because an
# operator can edit the inbox's working hours in between. Feeds the
# after-hours volume reporting. Default off.
BUSINESS_HOURS_STAMP_ENABLED=false

# Suggest-only AI escalation-department nudge: on an incoming customer message
# to an Email-channel conversation with no dept_* label yet, posts a private
# note suggesting one of the departments that has a PIC configured. Never
# applies the label itself. Requires PROTON_BACKEND_URL/KEY (below) -- fail-
# open, no-op otherwise. Default off, byte-identical when unset.
DEPT_SUGGESTION_ENABLED=false

# Customer-facing acknowledgment posted publicly before a human handoff.
# Empty = nothing posted (behaviour-preserving). Set to a tenant greeting.
HANDOFF_DEFAULT_MESSAGE=

# --- Proton fork image & AI-assist -------------------------------------------
# Override to use the patched Chatwoot image. Empty → stock chatwoot/chatwoot:v4.15.1
# The Chatwoot image this tenant boots. BLANK MEANS UPSTREAM: compose falls
# back to `chatwoot/chatwoot:v4.15.1`, and `:-` fires on an empty value as
# well as an unset one. A tenant left blank here comes up as stock Chatwoot —
# Captain and the SAML settings present, and no Knowledge / RBAC / SLA /
# Audit Log pages at all. add-tenant.sh fills this in for new tenants; set it
# by hand if you are provisioning without that script.
CHATWOOT_IMAGE=
# Internal (server-side) base URL of this tenant's AI backend, used by the AGENT
# service over the Docker network (no trailing slash). Defaults to the in-stack
# http://<tenant>-backend:8080. Only "proton" tenant has one today; others leave
# blank (feature stays disabled).
PROTON_BACKEND_URL=
# BROWSER-facing backend origin injected into the Chatwoot SPA (window.__PROTON_CONFIG__).
# MUST be an origin the browser can reach — NOT the internal <tenant>-backend host.
# Caddy proxies /metrics,/kb,/assist on this origin to the backend, so setting it to
# the SPA's own origin (the crm vhost) means same-origin calls with no CORS.
# Defaults to http://crm.localhost for local dev; set to the public crm URL in prod.
# The address the SPA reaches the backend from IN THE BROWSER. Distinct from
# PROTON_BACKEND_URL above, which is container-to-container and unusable from
# a browser. BLANK MEANS BROKEN: compose falls back to http://crm.localhost,
# every SPA call fails, useCustomFeatures fails closed, and the CRM shows no
# custom menus and no Custom features page — while the backend is healthy.
# add-tenant.sh fills this in as https://<prefix>crm.<PUBLIC_IP>.nip.io.
PROTON_BACKEND_PUBLIC_URL=
# API key matching PROTON_BACKEND_KEY in the backend's Settings.
PROTON_BACKEND_KEY=
# *** VESTIGIAL as of the custom-feature switchboard (fork patches 0072-0074,
# *** 2026-08-22 plan). DO NOT EDIT THIS TO TURN A SURFACE ON OR OFF -- it no
# *** longer has that effect on an image built with patch 0074. Every gate this
# *** variable used to drive (`hasFeature('...')` in the Chatwoot fork) now
# *** reads the platform superadmin's per-tenant Firestore document
# *** (`platform_config/custom_features`) via `useCustomFeatures()` instead of
# *** the `window.__PROTON_CONFIG__` list this env var renders into. To switch
# *** a surface on for a tenant, use the in-app "Custom features" superadmin
# *** page (or the equivalent POST /admin/custom-features -- see the plan doc's
# *** "Rollout" section for a worked curl example and the Firestore fallback).
# *** As of fork patch 0074 NOTHING reads this list for gating any more --
# *** every `hasFeature(...)` call site in the fork (Sidebar.vue,
# *** ReplyTopPanel.vue, ConversationView.vue, CollaboratorsPage.vue,
# *** useProtonInboundAlerts.js) was migrated onto useCustomFeatures(). This
# *** variable is kept only because `useProtonConfig()` -- the composable that
# *** renders `window.__PROTON_CONFIG__` from it -- also carries `backendUrl`/
# *** `backendKey`, which several unrelated API helpers (protonAdmin.js,
# *** protonKnowledge.js, protonMetrics.js, ...) still read; removing the
# *** variable outright means touching that plumbing too, which is why removal
# *** is pending rather than done here. Do not add this to your tenant runbook
# *** as a way to turn features on; it will look like it worked (no error) and
# *** do nothing on a 0074+ image. See
# *** docs/superpowers/plans/2026-08-22-custom-feature-switchboard.md for the
# *** "Rollout" section.
#
# Comma-separated feature flags. Default (when left blank) is the full set
# ai_assist,nav_menu,copilot,knowledge — applied via the compose default so every
# tenant on the custom image gets the Proton UI (Knowledge nav replaces native
# Captain, Ask Copilot panel, ✨ assist). Set an explicit value to override, or
# set to a single space " " to opt a tenant out entirely.
# (copilot = the multi-turn Ask Copilot panel → PROTON_BACKEND_URL/assist/copilot)
#
# THIS IS NO LONGER THE WHOLE LIST. On an image built with fork patch 0058 the
# rendered feature list is this value UNIONED with the feature name of every
# mapped backend flag that is truthy — today `INBOUND_ALERTS_ENABLED` →
# `inbound_alerts` and `FAQ_SUGGESTION_POPUP_ENABLED` → `faq_suggestion_popup`.
# The union is additive only: a name listed here is never removed by a flag being
# false, so setting this explicitly is always safe. Adding a mapped name here by
# hand remains the way to enable it on a pre-0058 image -- but see the VESTIGIAL
# notice above: on a 0074+ image none of this union reaches a feature gate any
# more, so this paragraph describes dead behaviour kept for pre-0074 images only.
PROTON_FEATURES=
# Phase-3 Reporting: Power BI embed URL for the Reports nav item.
# Get this from Power BI Service → Report → File → Embed report → Website or portal.
# Leave blank to show a placeholder (or use a Looker Studio URL as an alternative).
REPORTS_EMBED_URL=

# --- Phase-5 Agent Routing & Presence (set on the proton-conversational-ai backend) ---
# Master switch: true → escalations/handoffs route to an available individual agent
# by per-agent channel priority (with idle-fallback); false (default) keeps the static
# team assignment. Behavior-preserving when off. Backend Settings: routing_enabled.
ROUTING_ENABLED=false
# x-api-key guarding writes to the backend's /routing/priorities (the routing-admin
# dashboard app sends it via ?apiKey=). Empty → writes locked. Setting: routing_admin_api_key.
ROUTING_ADMIN_API_KEY=

# --- Phase-6 Task Timers & Reminders (set on the proton-conversational-ai backend) ---
# x-api-key gating GET /tasks/mine (returns customer PII). Empty → 401 for everyone
# (fail-closed). Required to enable the "My Tasks" dashboard app. Setting: tasks_api_key.
TASKS_API_KEY=
# Minutes before the resolution SLA at which My Tasks warns / a reminder fires.
TASKS_REMINDER_WARNING_MINUTES=60
# true → the SLA scan also sends a WhatsApp reminder (via the global SLA PIC number)
# as a conversation nears its resolution SLA. Requires the backend SLA engine enabled.
TASKS_REMINDER_WHATSAPP_ENABLED=false

# ============================================================================
# AI BACKEND (vendored from proton-conversational-ai; runs as ${TENANT}-backend)
# ----------------------------------------------------------------------------
# Provider selection
CRM_PROVIDER=chatwoot
KNOWLEDGE_PROVIDER=mock                 # mock | zendesk | vertex_search
VOICE_PROVIDER=mock

# Gates /kb/faq admin WRITES only (POST/PUT/DELETE). NOTE: /assist/* (the Ask
# Copilot panel) is gated by PROTON_BACKEND_KEY, set above under "Proton fork
# image & AI-assist" — not this key. The two are independent; /kb/* reads accept
# either. Leave empty to lock FAQ admin writes.
FAQ_ADMIN_API_KEY=

# --- pgvector knowledge base (subsystems A+B; default-off) ---
# NOTE: the Knowledge admin UI's document-upload button (Knowledge > Uploads)
# depends on this being enabled — /kb/knowledge/* routes are only mounted
# when KNOWLEDGE_PG_ENABLED=true AND KNOWLEDGE_DATABASE_URL is set. Left off,
# the upload button now shows a clear "not enabled" message instead of a
# raw 404 (see deploy/chatwoot-fork/patches/0021-knowledge-uploads-native.patch).
KNOWLEDGE_PG_ENABLED=false
KNOWLEDGE_DATABASE_URL=postgresql://backend_example:changeme@postgres:5432/backend_example
KB_CHUNK_SIZE_TOKENS=800
KB_CHUNK_OVERLAP_TOKENS=100
KB_SCORE_FLOOR=0.55
KB_MAX_UPLOAD_BYTES=10485760

# --- RBAC (Phase 1 of own-SLA-audit-RBAC) ---
# Independent Postgres connection, NOT shared with KNOWLEDGE_DATABASE_URL.
# Empty/false -> require_permission falls back to today's shared-secret check
# (FAQ_ADMIN_API_KEY/PROTON_BACKEND_KEY), byte-identical to pre-RBAC behavior.
RBAC_ENABLED=false
RBAC_DATABASE_URL=
# Break-glass bootstrap: Chatwoot user id to auto-assign the seeded
# 'administrator' role to on every startup (idempotent). Without this, a
# fresh RBAC-enabled DB has no way to grant the first admin except direct
# SQL, since POST /authz/roles/{id}/assign itself requires roles.manage.
# Unset (default) = no auto-assignment.
RBAC_BOOTSTRAP_ADMIN_USER_ID=
# The "SLA Policies", "Audit Log", and "Roles & Permissions" admin pages
# (Chatwoot fork patches 0025-0027) all depend on RBAC_ENABLED=true and
# RBAC_DATABASE_URL being set — they reuse the same Postgres connection and
# the same require_permission enforcement Phase 1 added. Without both set,
# these pages are neither mounted server-side nor shown in the nav.

# Gates GET /metrics/{departments,callcenter,lifecycle} (agent/PIC-level report data)
METRICS_API_KEY=

# Gemini / Vertex. Two auth paths (see "GCP credentials" note below):
#   - GOOGLE_GENAI_USE_VERTEXAI=false + a Gemini API key (GOOGLE_API_KEY), or
#   - GOOGLE_GENAI_USE_VERTEXAI=true + GCP Application Default Credentials (set
#     GCP_ADC_PATH below) — this is how the proton backend runs.
# NOTE: GEMINI_MODEL already set above under "Agent service config".
GOOGLE_GENAI_USE_VERTEXAI=false
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# Vertex AI Search — only needed when the knowledge provider is vertex_search.
VERTEX_SEARCH_PROJECT_ID=
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_DATA_STORE_ID=
VERTEX_SEARCH_ENGINE_ID=

# Persistence: memory (default, ephemeral) or firestore (needs GCP creds + DB).
HANDOFF_STORE=memory
SESSION_STORE=memory
# Each tenant gets its OWN Firestore database — the custom-feature
# switchboard, the term dictionary and the escalation stores all live there.
# BLANK MEANS BROKEN, not "disabled": every store read raises
# CustomFeatureStoreUnavailable, the switchboard 503s, the SPA fails closed,
# and the CRM opens with no features and no page to switch any on.
# add-tenant.sh creates the database and fills these in; set them by hand if
# you provision without it. The database's LOCATION IS IMMUTABLE — pick the
# customer's data-residency region up front (bahana is Jakarta /
# asia-southeast2; proton and aeon360 are asia-southeast1).
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=

# Phase toggles (all default-off / behavior-preserving)
# Routing + task vars already set above under Phase-5/6 sections.
SLA_ENGINE_ENABLED=false
# Per-channel first-response (ack) SLA overrides in MINUTES (JSON object).
# Empty = global SLA_RESPONSE_HOURS for all channels. Example:
# {"whatsapp":2,"call":0.333,"facebook":120,"instagram":120,"email":240}
SLA_ACK_MINUTES_BY_CHANNEL_JSON=
# P1: measure every SLA threshold on the inbox's configured business hours
# instead of the wall clock.
#
#   With this ON, an SLA target of "2 hours" means 2 WORKING hours,
#   measured against this inbox's configured business hours. Your existing
#   configured targets do not need changing -- they were always intended as
#   working-hours targets. A case that arrives at 18:00 Friday will breach a
#   2-hour target on Monday morning, not on Friday evening.
#
# Default off; with it off the arithmetic is byte-identical to before.
# Per-inbox override: the SLA Policies admin page's working_hours_enabled.
SLA_WORKING_HOURS_ENABLED=false
# Let an explicit acknowledgement satisfy the first-response SLA, so
# "acknowledge the customer" (Appendix B B-WA-14, 2 minutes) and "update the
# customer" (B-EM-05, 4 working hours) become two measurable events instead of
# one. The ACKNOWLEDGED transition is written by the agent service's reply
# linker -- see ESCALATION_REPLY_ACKNOWLEDGEMENT_ENABLED, which must also be on
# for anything to record it. Default off = first agent reply is the only
# signal, exactly as before. Can only ever suppress a breach, never create one.
SLA_ACKNOWLEDGEMENT_ENABLED=false
# SLA engine inbox scope: blank = CHATWOOT_INBOX_ID only, "4,5" = those
# inboxes, "*" = all. Email timers need the Email inbox listed here.
SLA_INBOX_IDS=
# SLA breach delivery beyond the WhatsApp ping: email to the department PIC
# group (resolved from the conversation's dept_<slug> label) and a private
# Chatwoot note. Both default false (behavior-preserving).
SLA_ALERT_EMAIL_ENABLED=false
SLA_ALERT_NOTE_ENABLED=false
METRICS_SYNC_ENABLED=false
# Package D risk mitigation: demo-seeded conversations otherwise inflate every
# report. false (default) = byte-identical to today; true = drop conversations
# carrying custom_attributes.demo_seed before they reach BigQuery. Flip to
# true on a tenant that was demo-seeded before any real reporting.
METRICS_EXCLUDE_DEMO_SEED=false

# Escalation / PIC (Phase 2). JSON map dept->PIC; empty disables PIC notify.
PIC_MAP_JSON=

# Escalation reply correlation. Empty disables the reply loop entirely.
# Must be an address that delivers to the tenant's Email inbox mailbox.
ESCALATION_REPLY_TO_TEMPLATE=

# Escalation reply loop (agent). All default off.
ESCALATION_REPLY_LINKING_ENABLED=false
ESCALATION_REPLY_DRAFT_ENABLED=false
# Record an ACKNOWLEDGED transition when a PIC/dealer reply is linked. A PIC
# answering by email IS an acknowledgement, but it left no trace the SLA engine
# could read, so the case kept counting as un-answered. Inert on its own: the
# backend's SLA_ACKNOWLEDGEMENT_ENABLED decides whether any breach reads it.
ESCALATION_REPLY_ACKNOWLEDGEMENT_ENABLED=false

# --- The customer-update clock (agent AND backend read this) ----------------
# B-EM-05: once a dealer or PIC answers, the agent has N working hours to pass
# that answer on to the customer. Nothing measured this before -- the two SLA
# breaches both run from the case's creation and are satisfied by the first
# agent reply, which on an escalated case happened long before the dealer
# answered. Fires CUSTOMER_UPDATE_DUE (and a warning at half-time) and shows
# in My-Tasks. Measured in working hours when SLA_WORKING_HOURS_ENABLED is on.
#
# One flag, both services: the backend runs the clock, and the agent writes the
# `customer_updated_at` stamp that stops it (only the agent sees the message
# stream closely enough to tell an outgoing public reply from the private notes
# that carry the dealer's answer). Recreate both when you change it.
ESCALATION_CUSTOMER_UPDATE_ENABLED=false
ESCALATION_CUSTOMER_UPDATE_HOURS=4

# --- The five-step dealer escalation ladder (backend) ------------------------
# Walks an unanswered escalation up Proton's SOP matrix: acknowledgement window
# at 2 working hours, 1st reminder to the Dealer Principal at 4, 2nd reminder
# to the Dealer Owner at 8, then a telephone task. Halts the moment the dealer
# replies, an agent marks the case acknowledged, or it is resolved.
#
# READ THIS BEFORE ENABLING. With the ladder on, DRY RUN stays on until you
# turn it off: the sweep logs `escalation_ladder_dry_run` with the step, the
# recipients and the timing, and sends nothing. Run it that way for a full
# working week and read the output. A ladder firing on wrong timers mails a
# Dealer Owner about a case they were never shown, and that is not recoverable
# with a hotfix. Populate every dealer's four roles in Escalation Routing
# first -- a role with no address skips its rung and logs.
ESCALATION_POLICY_ENABLED=false
ESCALATION_POLICY_DRY_RUN=true
ESCALATION_POLICY_SCAN_INTERVAL_SECONDS=300
# Override the step table. Empty = the SOP's five steps. A JSON list of
# {step_no, delay_working_hours, to_roles[], cc_roles[], label, channel}, where
# roles are cre|sales_aftersales_mgr|principal|owner|area_regional_mgr|hod and
# channel is email|phone. Malformed JSON falls back to the full default table,
# never a half-parsed ladder with a rung silently missing.
# ESCALATION_POLICY_STEPS_JSON=

# Escalate on EVERY channel, not just Email (agent). Before this, applying the
# `escalate` label to a WhatsApp/Web/Phone case notified NOBODY and said
# nothing about it -- the label stuck and the operator assumed it had worked.
# Default off preserves the Email-only behaviour exactly.
ESCALATION_ALL_CHANNELS_ENABLED=false
# The acknowledgement posted into the conversation thread when a non-Email case
# is escalated (backend). Blank = post nothing. This message is customer-facing
# and goes out as a normal outgoing reply, not a private note.
ESCALATION_ACK_CHAT_TEMPLATE=

# NOTE: the reply loop also needs `message_created` added to the account
# webhook's subscribed events in Chatwoot (Settings -> Integrations ->
# Webhooks). Without it the agent never sees dealer replies.

# SMTP for BACKEND-sent mail (escalation emails, customer acks, metric reports).
# These are DISTINCT from the Chatwoot SMTP_ADDRESS/SMTP_USERNAME/
# MAILER_SENDER_EMAIL block above: the backend's pydantic Settings reads
# SMTP_HOST/SMTP_USER/SMTP_FROM and ignores Chatwoot's spellings (extra=
# "ignore"), so setting only the Chatwoot names leaves smtp_host empty and
# SmtpEmailSender.send() no-ops SILENTLY — no email, no log line. Set both
# blocks to the same mailbox. SMTP_PORT/SMTP_PASSWORD are shared by name.
SMTP_HOST=
SMTP_USER=
SMTP_FROM=

# Case category/subcategory taxonomy — JSON object keyed by main-category slug:
# {"slug": {"label": "Display Name", "subcategories": ["Sub A", "Sub B"]}}.
# Set the SAME value in both the backend and agent tenant env sections below —
# each service parses it independently (no shared config store between them).
# Empty -> backend/'s classify_ticket_tool falls back to free text, agent/'s
# resolution-time fallback classifier no-ops. Ships with a working default in
# code (see backend config.py) if left unset here — the client's own taxonomy
# from RFP 2026_028's "APPENDIX A - Case Categorisation" (8 divisions: Sales,
# Product, Network, Charging, Apps, After Sales, Others, Marketing; see
# docs/client-materials/RFP 2026_028/case-categorisation.json for the full
# transcription). Level 2 (with Level 3/4 folded in) is a SEPARATE var, below.
CASE_TAXONOMY_JSON=

# Vehicle-model / case-type dimensions (Inquiry/Complaint/Compliment &
# Feedback). Same fail-open pattern as CASE_TAXONOMY_JSON; set the SAME value
# in both the backend and agent tenant env sections.
VEHICLE_MODELS_JSON=
CASE_TYPE_OPTIONS_JSON=

# Case-detail dimension — RFP 2026_028 Appendix A's Level 2, with Level 3/4
# folded into each value (em dash-joined). Flat {"options": [str, ...]} shape
# like CASE_TYPE_OPTIONS_JSON/VEHICLE_MODELS_JSON above, each value prefixed
# against the FULL case_subcategory value ("<Division>: <Level 1>: <Level
# 2>[ — <Level 3>[ — <Level 4>]]") — see agent/app/config.py's
# CASE_DETAIL_OPTIONS_JSON docstring for the full convention and why. Same
# fail-open pattern; set the SAME value in both the backend and agent tenant
# env sections. Ships with a working default in code (246 values covering
# 258 of the RFP's 300 rows) if left unset here. The Chatwoot "case_detail"
# custom attribute definition that renders this as a third cascading sidebar
# dropdown is provisioned by chatwoot-config/provision_case_taxonomy.py, not
# by this env var directly — see that script's docstring.
CASE_DETAIL_OPTIONS_JSON=

# SOP resolution-time targets in working hours, per case_type (backend only —
# only the metrics sync/BigQuery-view side needs this).
RESOLUTION_SLA_TARGETS_JSON=

# RSA (roadside assistance) incident log — own Postgres table, default-off.
# Needs BOTH flags to activate (mirrors KNOWLEDGE_PG_ENABLED/RBAC_ENABLED).
RSA_ENABLED=false
RSA_DATABASE_URL=

# DMS/TSP integration shell (Package F) — DEMO DATA SWITCH. Phase 1 ships no
# real DMS adapter, so this is the only thing that can put records in Customer
# 360's optional `dms` block, and those records are fabricated ("(Demo data)"
# markers in every field, `"mock": true` on the block). Set true ONLY for a
# demo; on a real customer's panel it must stay false. Off (default) leaves
# the block reading "unreachable"/not connected, which is the correct state
# until a Phase 2 adapter exists.
# The integration's actual connection config (enabled / base URL / credential
# / timeout) is NOT set here — operators edit it in the CRM's Integrations >
# DMS / TSP card and it is stored per-tenant in Firestore. The credential is
# write-only: settable and replaceable, never readable back.
DMS_MOCK_CLIENT_ENABLED=false

# Which environment this deployment is. Its ONLY consumer is the mock-DMS guard
# above: the demo client refuses to construct — and the service refuses to boot —
# unless this is "sandbox", "test" or "development". Leave it at "production" on
# anything a real customer's data reaches. Setting DMS_MOCK_CLIENT_ENABLED=true
# on a production environment is now a startup error rather than a silent
# fabricated service history on a real customer's Customer 360 panel; before
# this setting existed the guard could not fire at all. It gates nothing else,
# and with DMS_MOCK_CLIENT_ENABLED=false (the default, and every tenant today)
# it is never read.
APP_ENVIRONMENT=production

# GCP Application Default Credentials (ADC). Host path to a readable
# application_default_credentials.json (from `gcloud auth application-default
# login`) or a service-account JSON. The backend service bind-mounts it read-only
# at /gcp/adc.json and sets GOOGLE_APPLICATION_CREDENTIALS to it. Leave EMPTY to
# run without GCP (mock/off providers). Required when GOOGLE_GENAI_USE_VERTEXAI=
# true, KNOWLEDGE_PROVIDER=vertex_search, or HANDOFF_STORE/SESSION_STORE=firestore.
GCP_ADC_PATH=
# ============================================================================

# --- GCP credentials (per-tenant) ---
# The AI backend reaches Gemini/Vertex/Firestore via ADC. Point GCP_ADC_PATH
# (above) at a credentials JSON on the host; the compose backend service mounts
# it and exports GOOGLE_APPLICATION_CREDENTIALS automatically. Alternatively run
# GOOGLE_GENAI_USE_VERTEXAI=false with a Gemini API key and leave GCP_ADC_PATH
# empty. Each tenant needs its own project / data store / Firestore DB — do NOT
# point two tenants at the same FIRESTORE_PROJECT_ID + FIRESTORE_DATABASE_ID.

# CC the dealer's "relevant personnel" (DealerRecord.cc_emails) on the dealer
# forward. Default FALSE, unlike ESCALATION_CC_PIC's default of true: this mail
# carries the full transcript to an address outside the company, so widening
# its recipient list must be deliberate. A CC entry equal to the customer's own
# address is always dropped, flag on or off.
ESCALATION_CC_DEALER=false
# Byte budget for attachments carried into the PIC/dealer escalation mail
# (photos of the damaged part, PDFs). 0 = feature off, and off costs not even
# an API call. Applies to the whole mail, not per file. Newest attachments win
# when it cannot fit everything, and whatever was left out is described in the
# body rather than silently dropped. The customer acknowledgement NEVER carries
# attachments. Suggested starting value: 10485760 (10 MB).
ESCALATION_ATTACHMENT_BUDGET_BYTES=0
# Post a private note on the conversation when an escalation leg fails to send
# (§4.39, SMTP half). Without it, a failed escalation is only a log line: the
# operator sees the `escalate` label and assumes the PIC was told. The note is
# ALWAYS private -- the customer must never be shown our SMTP problems.
# NOTE: this covers send failures only. Bounces and invalid recipients need a
# bounce mailbox (client question Q6) and are NOT handled.
ESCALATION_FAILURE_NOTE_ENABLED=false
# Consult Chatwoot agent availability when escalating, so an offline PIC's
# online colleagues are told too. Can only ever WIDEN the recipient list -- the
# PIC is always included, and every failure (presence unreachable, PIC not a
# Chatwoot agent) falls back to notifying everyone. Off by default: it costs an
# extra API call per escalation.
ESCALATION_PRESENCE_CHECK_ENABLED=false

# Notice when an escalation email BOUNCED (agent). §4.39's other half: the
# send-failure note covers SMTP refusing the handoff, this covers SMTP
# accepting it and the recipient's server rejecting it minutes later.
# No bounce mailbox needed -- the delivery-status notification comes back to
# this tenant's own Email inbox, where it was previously filed as an unread
# conversation. Notes the failure on the case that caused it and resolves the
# DSN conversation so it stops inflating the SLA backlog.
BOUNCE_HANDLING_ENABLED=false

# --- P3: case record fields -------------------------------------------------
# The case-record panel (vehicle plate/chassis, purchased-from dealer, delay
# reason, the three WIP notes) and its GET/PATCH endpoints. Off = the
# endpoints 404. The SIDEBAR PANEL ITSELF needs no fork patch: these are
# ordinary Chatwoot conversation custom attributes, so run
# `chatwoot-config/provision_case_record_fields.py` once per tenant and
# Chatwoot renders the panel natively.
CASE_FIELDS_ENABLED=false
# Attach a coverage note to any report block grouped by one of these sparse,
# agent-entered fields. ON by default, unlike every other flag here: a chart
# built on a half-filled column that does not say so invites exactly the wrong
# conclusion.
REPORT_COVERAGE_DISCLOSURE=true

# Addresses this platform must NEVER send to, comma-separated. Enforced inside
# SmtpEmailSender, so no routing record, env var, stale automation rule or
# hand-typed CC can get past it. Not cosmetic: sustained delivery failures to a
# dead domain get the sending mail account rate-limited or suspended, which
# takes every real escalation down with it.
EMAIL_BLOCKED_RECIPIENTS=

# --- P4: reporting -----------------------------------------------------------
# The calendar the report buckets use. UTC (the default) is the IDENTITY
# TRANSFORM: view DDL is byte-identical to pre-P4, so no existing dashboard
# number moves. CHANGING THIS RE-BUCKETS EVERY HISTORICAL FIGURE on every chart
# the next time ensure_views() runs -- a case created 23:00 MYT lands in the
# next UTC day, so cases shift between adjacent weeks. Run
# scripts/compare-reporting-timezone.py first and keep the output.
# Allowed: UTC, Asia/Kuala_Lumpur, Asia/Jakarta, Asia/Singapore, Asia/Bangkok.
REPORTING_TIMEZONE=UTC
# Count reopens (agent). A reopen is a resolved -> not-resolved transition and
# nothing else. `reopen_count` has been a warehouse column and a v_reopen_rate
# view since Phase 3 with NOTHING writing it, so the reopen rate has been a
# chart of zeroes that renders perfectly. Default off.
REOPEN_TRACKING_ENABLED=false

# --- P5: control-item slide --------------------------------------------------
# The 14-metric control-item page (C1 p48) and its targets store. Nine rows
# render from real data; five report "not measured" WITH A REASON, never zero.
# A zero would be a claim about performance; a blank is a statement about
# instrumentation.
CONTROL_ITEMS_ENABLED=false
# Seed targets from RESOLUTION_SLA_TARGETS_JSON at startup. Creates only --
# never overwrites an operator edit, so an operator who tightens a target does
# not have it reverted on the next restart.
TARGETS_SEED_ENABLED=false

# --- P6: agent presence, custom statuses & workforce dashboard --------------
# Seven independent flags (all default false, backend Settings). A first
# deploy with all seven off is behavior-preserving: routing_enabled (set
# above under Phase-5) is untouched by this package and still defaults off.
#
# true -> a poller runs every PRESENCE_POLL_SECONDS, diffs each agent's
# Chatwoot presence against the last known value, and appends a presence
# event on change. This is the primitive every other flag below depends on
# -- leave it off and the rest of this section is inert. Setting:
# presence_tracking_enabled.
PRESENCE_TRACKING_ENABLED=false
# true -> the eight-status catalogue (Available, Busy, Lunch, Break,
# Coaching, Training, Toilet, Prayer) can be SELECTED by agents, and
# added to/edited by administrators, through the /routing/presence endpoints
# (features/routing/status_router.py). Off means the three native Chatwoot
# statuses only: those endpoints answer {"disabled": true} and write nothing.
# Each named status still mirrors into a native one, so routing keeps
# excluding unavailable agents even if this is off or the custom-status store
# is down.
#   The agent-facing "My status" page that drives those endpoints ships in
#   fork patch 0054, which has NOT been verified against a real Chatwoot
#   checkout yet (see docs/analysis/2026-08-09-blocked-work-register.md). The
#   API is usable before that build goes green; the UI is not, so do not
#   promise agents the page until it has.
#   This flag is NOT a prerequisite for ACW_ENABLED or
#   PRESENCE_THRESHOLD_ALERTS_ENABLED: the catalogue resolves from built-in
#   defaults even on a tenant where nothing was ever seeded, which is what
#   stopped ACW-only tenants from logging custom_status_set_unknown_key
#   forever. It only gates SELECTING and EDITING statuses.
# Setting: presence_custom_statuses_enabled.
PRESENCE_CUSTOM_STATUSES_ENABLED=false
# true -> an agent unavailable past PRESENCE_WARN_MINUTES/
# PRESENCE_ESCALATE_MINUTES triggers the 10-minute and 1-hour alerts.
# Requires PRESENCE_TRACKING_ENABLED to have anything to measure against.
# Note which statuses actually alert: the away-from-desk ones an agent picks
# (Lunch, Break, Toilet, Prayer). Chatwoot's own native Busy and Offline
# never do -- Busy is an agent working, Offline is an agent off shift -- so
# an account that never enables PRESENCE_CUSTOM_STATUSES_ENABLED will see no
# alerts at all, correctly, because it has no way to record an absence.
# Setting: presence_threshold_alerts_enabled.
PRESENCE_THRESHOLD_ALERTS_ENABLED=false
# true -> a call ending places the agent into an After-Call-Work status
# instead of immediately being routable again. Independent of
# PRESENCE_CUSTOM_STATUSES_ENABLED (see that flag's note).
# Setting: acw_enabled.
ACW_ENABLED=false
# true -> pick_agent chooses the eligible agent with the fewest open
# conversations within a tier (tie-broken by least-recently-assigned)
# instead of today's first-match-in-iteration-order pick. Setting:
# routing_fair_share_enabled.
ROUTING_FAIR_SHARE_ENABLED=false
# true -> a sweeper periodically assigns unassigned conversations older than
# ROUTING_SWEEP_MIN_AGE_SECONDS, on top of the existing event-driven
# assignment at handoff time. Setting: routing_sweep_enabled.
ROUTING_SWEEP_ENABLED=false
# true -> the conversation panel exposes an operator-settable follow-up date
# (distinct from the SLA deadline), feeding the existing /tasks/mine reminder
# machinery. Setting: follow_up_date_enabled.
FOLLOW_UP_DATE_ENABLED=false
# Poller interval, seconds. 60s is a deliberate compromise: the thresholds
# below are 10 minutes and 1 hour, so tighter polling buys no decision-
# relevant precision, only more Chatwoot API calls.
PRESENCE_POLL_SECONDS=60
# Minutes unavailable before the agent + admin get the first alert.
PRESENCE_WARN_MINUTES=10
# Minutes unavailable before the admin gets the escalated alert, with the
# agent's WIP list attached.
PRESENCE_ESCALATE_MINUTES=60
# Seconds an agent may stay in After-Call-Work before being auto-exited back
# to routable, so a forgotten wrap-up state can't trap them out of routing.
ACW_TIMEOUT_SECONDS=120
# Minimum age (seconds) an unassigned conversation must reach before the
# sweeper (ROUTING_SWEEP_ENABLED) will pick it up. Must comfortably exceed
# the event-driven assignment path's own latency, or the sweeper and that
# path race each other for the same conversation.
ROUTING_SWEEP_MIN_AGE_SECONDS=120
# How often the sweeper itself ticks, seconds.
ROUTING_SWEEP_INTERVAL_SECONDS=60

# --- P7: AI conversational quality ------------------------------------------
# Nine settings (backend only -- agent/ is untouched by this package), all
# default-off/default-zero. A tenant that sets none of these gets
# byte-identical behaviour to before P7: sentiment stays unclassified, no
# translate action exists, FAQ ranking is pure semantic search, media
# attachments get today's generic instruction, and nothing is
# auto-summarised or indexed on resolve.
#
# true -> classify sentiment (positive/neutral/negative/urgent) on every turn
# as an extra argument on the existing per-turn Gemini call (never a second
# round-trip) and write it to session_state plus a conversation custom
# attribute, which the existing ticket-creation gate and API response
# already read. Off = sentiment stays unclassified (None), exactly as today.
SENTIMENT_CLASSIFIER_ENABLED=false
# true -> replace the static "## Tone" persona paragraph with one selected by
# the current sentiment (operator-editable in Knowledge Settings). Inert
# without SENTIMENT_CLASSIFIER_ENABLED above. Off = the static paragraph,
# unchanged.
SENTIMENT_TONE_ADJUSTMENT_ENABLED=false
# true -> enables the agent-facing translate action (POST /assist/translate):
# lets an agent who does not read a customer's language render an inbound
# message into their own, on demand, as a private note. Off = no translate
# action exists.
TRANSLATION_ENABLED=false
# true -> lets the bot send OUTBOUND replies to customers in Tamil. NOT
# symmetric with TRANSLATION_ENABLED above: inbound Tamil translation (so an
# agent can READ a Tamil message) works today via TRANSLATION_ENABLED alone
# and is low-risk. Outbound Tamil is unverified machine translation reaching
# a customer directly in a regulated automotive-support context, and ships
# disabled pending an evaluation of 30 real Tamil enquiries scored by a
# Tamil speaker. Do not enable this just because TRANSLATION_ENABLED is on --
# they answer different questions. Keep false until that evaluation is
# signed off by the client.
TRANSLATION_OUTBOUND_TAMIL_ENABLED=false
# Weight (float) given to a keyword-overlap score against the authored FAQ
# `keywords` field, blended into FAQ ranking alongside cosine similarity.
# 0.0 is not merely "off": it is required to reproduce today's ranking
# EXACTLY, entry for entry and score for score -- that equivalence is the
# safety argument for shipping hybrid ranking onto a live tenant. Raise it
# only after the calibration evaluation set shows a net improvement (a large
# weight regresses the common case -- semantic search, which works today --
# to fix the rare one -- exact codes like e.MAS7 that embed poorly).
FAQ_KEYWORD_WEIGHT=0.0
# true -> shows a transient, dismissible FAQ-suggestion strip above the
# fork's composer when a suggestion's confidence exceeds a threshold. Off =
# side panel only -- an agent's typing path is left alone by default.
#
# NOTHING ON THE BACKEND READS THIS FIELD. The strip is entirely client-side.
#
# STOP -- on an image built with fork patch 0074 or later, PROTON_FEATURES no
# longer has any effect here. The gate `hasFeature('faq_suggestion_popup')` in
# ReplyTopPanel.vue now reads the platform superadmin's per-tenant Firestore
# switchboard document (`platform_config/custom_features`) via
# useCustomFeatures(), not this variable's rendered feature list. Adding
# `faq_suggestion_popup` to PROTON_FEATURES by hand does nothing on such an
# image and will not surface an error -- the strip simply stays off. To turn
# it on, use the "Custom features" superadmin page (or POST
# /admin/custom-features) instead; see
# docs/superpowers/plans/2026-08-22-custom-feature-switchboard.md's "Rollout"
# section. (This paragraph's original advice -- adding the name to
# PROTON_FEATURES by hand on a pre-0058 image -- is preserved below only for
# operators still on such an image; the blocked-work register's section 3g
# is the older, now-superseded context for it.)
FAQ_SUGGESTION_POPUP_ENABLED=false
# true -> appends a media-diagnosis instruction (describe what's visible,
# name the likely fault, state a confidence level, ask at most one follow-up
# question) whenever an image/video attachment reaches the model. Off =
# today's generic instruction, unchanged.
MEDIA_DIAGNOSIS_PROMPT_ENABLED=false
# true -> indexes a resolved conversation's SUMMARY (never its transcript)
# into its own pgvector namespace, separate from the authored FAQ corpus, so
# it can be purged independently of curated content and its suggestions
# labelled in the panel as machine-generated rather than approved guidance.
# This is a PII mitigation, not PII masking (the real fix is gap R16,
# separately tracked) -- off by default for that reason. Off = nothing
# indexed.
RESOLVED_CASE_INDEX_ENABLED=false
# true -> fires the existing agent-triggered POST /assist/summarize
# automatically on the resolve event and posts the summary as a private
# note; a case resolved, reopened and resolved again appends a second
# summary rather than overwriting the first. Off = summaries stay
# agent-triggered only, exactly as today.
AUTO_SUMMARY_ON_RESOLVE_ENABLED=false

# --- P8: AI & agent measurement (backend only -- agent/ is untouched by this
# package) ---------------------------------------------------------------
# Six settings, all default-off/default-zero. A tenant that sets none of
# these gets byte-identical behaviour to before P8: no Gemini call is
# metered, no cost view or endpoint exists, no NPS question is ever asked,
# CSAT stays channel-level only (v_csat is unchanged), and QA stays today's
# channel-agnostic manual rubric.
#
# true -> routes every backend Gemini call through the metering wrapper
# (client-boundary, not a per-call-site change) and records a TokenUsage row
# per call. Off = the wrapper records nothing and adds no latency -- the
# backend keeps recording zero token counts, exactly as today. Missing usage
# metadata on a wrapped call always records None, never 0: a zero-token call
# is real; "not captured" is a different fact, and conflating the two would
# understate spend in a cost report. Setting: token_metering_enabled.
TOKEN_METERING_ENABLED=false
# true -> mounts GET /metrics/ai-cost and the v_ai_cost view (day x service x
# surface x model), priced from the operator-editable price table. An
# unpriced model is reported as "unpriced", never as free. Only meaningful
# once TOKEN_METERING_ENABLED has been on long enough to have rows to price.
# Setting: ai_cost_reporting_enabled.
AI_COST_REPORTING_ENABLED=false
# Fraction (0.0-1.0) of end-of-conversation surveys that ask NPS ("how likely
# are you to recommend") INSTEAD OF CSAT, for the sampled slice -- never
# both, since asking both halves the response rate for each. 0.0 (default) =
# no NPS question is ever asked; v_nps_by_agent stays correctly empty rather
# than sparse. The agent attributed is the one assigned at the moment the
# survey is answered, recorded then and never re-derived from a later
# reassignment. Setting: nps_sample_rate.
NPS_SAMPLE_RATE=0.0
# true -> mounts v_csat_by_agent, a sibling view of v_csat (which this does
# NOT change -- existing dashboards keep reading it as-is). Every row
# returns the rating count alongside the average score, flag on or off --
# a per-agent score with no sample size is how a measurement becomes a
# grievance. Off = CSAT stays channel-level only. Setting:
# csat_by_agent_enabled.
CSAT_BY_AGENT_ENABLED=false
# An agent with fewer ratings than this is excluded from RANKED league-table
# views but still appears, with their count, in the unranked listing --
# suppressed from rankings, never from existence. Inert while
# CSAT_BY_AGENT_ENABLED is off. Setting: csat_ranking_min_samples.
CSAT_RANKING_MIN_SAMPLES=10
# true -> adds a `channel` dimension to QA records and, for calls, a
# five-criterion rubric (greeting, identification, resolution, closing,
# compliance) scored as a percentage against P5's targets-store 85% value.
# Off = today's channel-agnostic manual qa_labels mechanism, unchanged;
# v_quality is unaffected. Manual only, deliberately -- the phone transcript
# path has never run against a real Twilio call (see
# docs/testing/phone-channel-package-c-verification.md), so automated
# scoring on it would be confident noise. Setting: call_qa_enabled.
CALL_QA_ENABLED=false

# ---------------------------------------------------------------------------
# P9 — Notification & alerting UX
# ---------------------------------------------------------------------------
# All default-off/default-inert: a tenant that sets none of these behaves
# exactly as before P9. No new alert surface, no hourly detector, no
# freshness line.

# STOP — read this before touching PROTON_FEATURES for inbound_alerts. On an
# image built with fork patch 0074 or later, the client-side gate
# `hasFeature('inbound_alerts')` (useProtonInboundAlerts.js) reads the
# platform superadmin's per-tenant Firestore switchboard document
# (`platform_config/custom_features`) via useCustomFeatures(), NOT the fork's
# PROTON_FEATURES-rendered list. Adding `inbound_alerts` to PROTON_FEATURES by
# hand no longer works and no longer wins on such an image -- it silently does
# nothing; the surface stays off until a superadmin switches on the
# `inbound_alerts` key via the "Custom features" page (or POST
# /admin/custom-features). See
# docs/superpowers/plans/2026-08-22-custom-feature-switchboard.md's "Rollout"
# section for how.
#
# THIS variable (INBOUND_ALERTS_ENABLED) is DIFFERENT from that front-end gate
# and still does something real: it is a backend runtime behaviour (exposed
# read-only in the switchboard page as `behavior_inbound_alerts`), independent
# of whether the front-end surface is switched on. Both must be true for a
# tenant to see working inbound alerts: this variable true, AND the
# `inbound_alerts` feature key on in the switchboard.
#
# The paragraph below (fork patch 0057/0058, the two-condition explanation) is
# kept for operators still running a pre-0074 image, where it was accurate:
#
# The alert module ships in Chatwoot-fork patch 0057 and its client-side gate
# was originally `hasFeature('inbound_alerts')`, read from the fork's
# PROTON_FEATURES list. For a long time this back-end setting did not
# populate that list, so the two were INDEPENDENT switches and setting this
# alone changed nothing (blocked-work register 3g/3h). Patch 0058 closed
# that: docker-compose.tenant.yml forwards this same variable into the
# Chatwoot containers, and 0058's Rails layout adds `inbound_alerts` to the
# feature list whenever it is truthy. So on a stack running a 0058-but-not-
# yet-0074 image, setting this to true was sufficient and PROTON_FEATURES
# needed no hand-editing.
#
# TWO CONDITIONS, BOTH REAL (pre-0074 images only):
#   1. The Chatwoot custom image must have been REBUILT with patch 0058 (Cloud
#      Build, amd64, off-VM) and pulled. Until then the old two-switch behaviour
#      is what a live tenant has, and `inbound_alerts` must still be added to
#      PROTON_FEATURES by hand.
#   2. The stack must be deployed with `--env-file tenants/<tenant>.env`.
#      Compose interpolates only from the shell and --env-file, never from a
#      service's own `env_file:`, so omitting it puts the backend on and leaves
#      Chatwoot off — the same bug, restored silently. Every script and README
#      command here passes it.
#
# What the alert module itself does, once enabled: moves the
# three working alert primitives (on-screen toast, sound, desktop notification)
# out of the my-tasks iframe and into the main Chatwoot UI, subscribed to the
# event stream the CRM already uses — so an agent is alerted in the window they
# are actually looking at.
#
# NEW-INBOUND ALERTS ARE TOAST-ONLY BY DEFAULT, AND THAT IS DELIBERATE. Sound
# and desktop notifications exist for the event and are off. On a tenant where
# WhatsApp carries most of the volume, an audible alert per inbound message is
# a beep every few seconds, and the first thing every agent does is switch off
# ALL alerting — including the SLA breach alerts that actually matter. Each
# agent can turn sound on for new-inbound in their own alert preferences.
#
# The my-tasks app keeps its SLA alerts either way. This is an addition; it
# never removes a working alert surface.
# Setting: inbound_alerts_enabled.
INBOUND_ALERTS_ENABLED=false

# Mounts the per-agent alert-rule store and the alert-preferences page behind
# it, so an agent can choose which events alert them and how loudly without
# an administrator editing env vars. Off = no rules exist, no preferences page
# is mounted, and every agent gets the built-in defaults.
# Setting: alert_rules_enabled.
ALERT_RULES_ENABLED=false

# Turns on the HOURLY channel-volume anomaly detector (the existing daily one
# is governed by ANOMALY_ZSCORE_K / ANOMALY_MIN_BASELINE and is unaffected).
#
# The baseline is SAME-HOUR-ACROSS-DAYS — this Tuesday 14:00 compared with
# recent 14:00s — never the preceding few hours. A trailing-hours baseline
# flags every lunchtime dip as an anomaly.
# Setting: anomaly_hourly_enabled.
ANOMALY_HOURLY_ENABLED=false

# How many standard deviations from that same-hour baseline counts as an
# anomaly. Deliberately looser than the daily detector's 3.0: hourly buckets
# are smaller and noisier, and reusing the daily threshold produces alerts
# nobody can act on. Setting: anomaly_hourly_zscore_k.
ANOMALY_HOURLY_ZSCORE_K=3.5

# The minimum-volume floor, and it is mandatory rather than a refinement: an
# hour with fewer conversations than this is never flagged however large its
# deviation looks. Without it the detector alerts every night at 03:00, when
# two messages instead of the usual one is a 100% deviation. Lower than the
# daily floor because an hour legitimately carries far less volume than a day.
# Setting: anomaly_hourly_min_baseline.
ANOMALY_HOURLY_MIN_BASELINE=5

# Shows, on every report page, what its numbers are as-of and where they came
# from. Alerting and the anomaly page are live; BigQuery-backed dashboards are
# a batch sync (METRICS_SYNC_INTERVAL_HOURS, default 6) and say so.
#
# The point is that a gap between a dashboard figure and the live CRM is
# EXPECTED, and this makes its size visible instead of leaving it to be
# reported as a bug. Off = pages render exactly as today, with no freshness
# line. Setting: dashboard_freshness_enabled.
DASHBOARD_FRESHNESS_ENABLED=false

# ---------------------------------------------------------------------------
# P10 — Self-service taxonomy admin, category->department, data-scoped RBAC
# ---------------------------------------------------------------------------
# Four settings, all default-off/default-inert (backend only -- agent/ reads
# none of these; its own CASE_TAXONOMY_JSON/CASE_TYPE_OPTIONS_JSON/
# CASE_DETAIL_OPTIONS_JSON copies are untouched by this package). A tenant
# that sets none of these gets byte-identical behaviour to before P10.

# true -> mounts the Firestore-backed taxonomy admin's CRUD endpoints and
# seeds the store on the next boot. It does NOT push anything into Chatwoot:
# the custom-attribute sync has its own flag (TAXONOMY_CHATWOOT_SYNC_ENABLED
# below) and is off. Off = those endpoints 404 (the fork's admin page does not
# render) and CASE_TAXONOMY_JSON/CASE_TYPE_OPTIONS_JSON/CASE_DETAIL_OPTIONS_JSON
# below stay the only source, read exactly as before.
#
# Turning this on seeds the store from CASE_TYPE_OPTIONS_JSON,
# CASE_TAXONOMY_JSON and CASE_DETAIL_OPTIONS_JSON on the next backend boot --
# with the shipped RFP 2026_028 Appendix A defaults that is 346 nodes (3 case
# types + a neutral "Case divisions" root + 8 divisions + 89 categories + 245
# details -- 246 detail strings, two of which differ only by letter case and
# collapse to one node). The seed runs in the background so it never delays
# the container's health check, and it re-runs on every boot: after the first
# it reads once and writes nothing. Watch for `taxonomy_startup_seed_complete`
# in the backend log.
#
# ONCE A TENANT'S STORE HAS BEEN SEEDED FROM THOSE THREE VARS (one-time,
# non-destructive), THEY BECOME THE SEED ONLY -- editing them afterwards has
# no further effect on that tenant. Edit the taxonomy through the admin
# endpoints/page instead.
#
# Categories are RETIRED, never deleted -- a category attached to historical
# cases stays resolvable forever, so a report grouped by category never
# silently loses rows and old cases never stop resolving their own category.
# A retired category disappears from the picker but keeps appearing in
# reports covering the period it was in use.
#
# The store is authoritative; the Chatwoot sync is downstream -- a sync
# failure (a transient Chatwoot API error) never rolls back an operator's
# edit, it surfaces an explicit out-of-sync/retry state instead.
# Setting: taxonomy_admin_enabled.
TAXONOMY_ADMIN_ENABLED=false

# *** LEAVE THIS false. TURNING IT ON WILL BREAK THE AGENT'S CASE PICKERS. ***
#
# true -> every save/retire on the taxonomy admin page PATCHes Chatwoot's
# case_category / case_subcategory / case_detail custom-attribute definitions
# from the store. The sync AS WRITTEN does not produce what those attributes
# actually hold:
#
#   - case_category is derived from LEVEL-1 nodes -- the three case types plus
#     the neutral "Case divisions" root -- but Chatwoot holds the 8 DIVISION
#     labels (Sales, Product, Network, Charging, Apps, After Sales, Others,
#     Marketing);
#   - case_detail is derived from BARE level-4 labels ("Rejected", "Others")
#     but Chatwoot holds full "Division: Subcategory: Detail" strings;
#   - the attribute's display name is set from its KEY, renaming the
#     conversation-sidebar labels to "case_category"/"case_detail".
#
# Fork patch 0050 filters each attribute's options by prefix against its
# parent's selected value, so replacing case_category with case types kills the
# conversation-sidebar cascade for every agent, and every conversation already
# stamped case_category="Sales" is left carrying a value outside its
# attribute's allowed list.
#
# chatwoot-config/provision_case_taxonomy.py is what provisioned the live
# definitions (8 categories / 89 subcategories / 246 details, run 2026-08-08)
# and REMAINS THE SUPPORTED WAY TO UPDATE THE PICKERS. Re-run it after editing
# the taxonomy; do not flip this flag instead.
# Setting: taxonomy_chatwoot_sync_enabled.
TAXONOMY_CHATWOOT_SYNC_ENABLED=false

# true -> mounts GET /admin/taxonomy/coverage (every active category with no
# mapped department; every dept_* slug no category maps to). Off = that report
# 404s. Requires TAXONOMY_ADMIN_ENABLED as well, since the store is what the
# report reads.
#
# WHAT THIS DOES NOT DO YET. A `TaxonomyNode` carries a `department` field and
# the coverage report reads it, but **nothing suggests a dept_<slug> label to an
# agent from it** -- the escalation suggestion path was never wired, so the
# reporting taxonomy (case_category) and the escalation taxonomy (dept_* labels)
# remain the two disconnected lists they are today. The half that ships is the
# operationally valuable half: the report that makes an unroutable category
# visible before it misroutes a complaint.
#
# When the suggestion is built it must be SUGGEST-ONLY, matching the existing
# AI-suggested escalation department (DEPT_SUGGESTION_ENABLED, agent service):
# pre-fill a value an agent can override, and record the override. Auto-applying
# it would misroute exactly the exceptional cases that get escalated.
#
# `retired_department_categories` in the report body is always [] -- flagging a
# category whose mapped department has been retired needs a retired/active
# distinction the PicStore read does not expose. Empty because it was not
# measured, not because nothing was found.
# Setting: category_department_mapping_enabled.
CATEGORY_DEPARTMENT_MAPPING_ENABLED=false

# *** THIS SETTING DOES NOT CURRENTLY GATE ANYTHING. LEAVE IT false. ***
#
# The intended behaviour is: resolve each caller's roles to a DataScope
# (inboxes / teams / dealers / own_only) and enforce it, server-side, in the
# metrics and admin query layers plus Chatwoot-native inbox membership,
# extending the existing RBAC permission model rather than replacing it.
#
# What actually shipped is the intersection logic alone
# (features/authz/data_scope.py, proven by test_data_scope.py). Nothing imports
# it: no query is narrowed, no FastAPI dependency exists, role scopes live in an
# in-process dict with no admin surface to set them, and chatwoot_role_mirror.py
# was not touched. **No code reads this variable**, so turning it on has no
# effect whatsoever -- it neither narrows nor widens anything. It is documented
# here rather than deleted because the logic is real and the enforcement is the
# recorded next step; see the module docstring and
# docs/analysis/2026-08-09-blocked-work-register.md.
#
# The invariants the logic does guarantee, for when enforcement is wired:
# `None` on every scope field means account-wide, so every role that exists
# today keeps behaving exactly as it does today. Scopes are INTERSECTIVE, never
# additive: giving a caller a second role can only ever narrow what they see,
# never widen it, and an EMPTY intersection means access to NOTHING -- never to
# everything. A bug there is data exposure, not a reporting inconvenience, and
# enforcement must land in the query layer, never by hiding UI.
# Setting: data_scoped_rbac_enabled.
DATA_SCOPED_RBAC_ENABLED=false

# --- P11: voice partials (DTMF menu, after-hours, voicemail, retention) -----
# READ THIS BEFORE ENABLING ANY OF THE SEVEN: no real Twilio call has ever
# reached this code. The suite is green and the phone path is unverified --
# see docs/testing/phone-channel-package-c-verification.md and
# docs/analysis/2026-08-09-blocked-work-register.md. Three of the seven have no
# consumer at all today and are marked as such; leave those false.

# true -> mounts GET /calls/<conversation_id>/recording, gated on the
# call_recording.listen permission. Off = 404 even for a permitted caller.
# Recordings are customer voice data, so retrieval is permission-gated and each
# access is logged with the caller's identity.
#
# WHAT IT IS NOT YET: the handler reads an in-process registry that nothing in
# production writes, so against a real conversation it answers "no recording
# exists". It emits a structured log line rather than an audit-log row. And the
# URL it returns carries a fixed `?signature=signed_token` literal -- a
# placeholder for a signing step, not a short-lived credential. Do not describe
# this to a client as returning signed URLs yet.
# Setting: call_recording_retrieval_enabled.
CALL_RECORDING_RETRIEVAL_ENABLED=false

# *** DOES NOT CURRENTLY GATE ANYTHING. LEAVE false. ***
# Intent: a <Gather> in front of the media stream offering Appendix B's menu
# (1 Roadside Assistance / 2 Inquiry / 3 Complaint / 0 repeat), with timeout,
# 0-twice and any invalid key all falling through to the conversational bridge
# so the menu can never trap a caller. dtmf_menu.py exists and its prompts are
# verbatim from deploy/twilio/ivr-studio-flow.json, but twiml.py was never
# modified and no code reads this variable.
# Setting: phone_dtmf_menu_enabled.
PHONE_DTMF_MENU_ENABLED=false

# true -> the out-of-hours branch plays the bilingual after-hours message and
# offers voicemail. The wording is verbatim from the Studio flow's
# after_hours_en/after_hours_ms, including the real published hours (Mon-Fri
# 8:30-17:30; Sat/Sun/Public Holidays 9:00-17:00).
#
# NOT REACHABLE YET: the evaluator reads this flag but nothing calls the
# evaluator, so the call path is unchanged whichever way this is set.
# Setting: phone_after_hours_enabled.
PHONE_AFTER_HOURS_ENABLED=false

# *** DEFAULTS TO true. THE ONLY DEFAULT-ON FLAG IN THIS PROGRAMME. ***
# §8.1.6 requires roadside assistance 24/7, so when the after-hours path runs,
# an out-of-hours RSA caller must reach the RSA target rather than a
# closed-for-the-day message: a stranded motorist at 2 a.m. hitting a voicemail
# box is the one failure in this package with a safety dimension rather than a
# reporting one. Takes effect only in combination with
# PHONE_AFTER_HOURS_ENABLED. Setting it false is a deliberate act and is logged
# as one. Do not "tidy" it to false for consistency with its neighbours.
# Setting: phone_rsa_after_hours_bypass.
PHONE_RSA_AFTER_HOURS_BYPASS=true

# true -> a Twilio voicemail recording becomes a case on the phone inbox with
# the audio and a transcript, deduplicated by RecordingSid.
#
# NOT REACHABLE YET, and incomplete when it is: there is no RecordingUrl webhook
# route, and the processor creates no Chatwoot conversation -- it returns the
# record it would create. Its `attend_after` is now+12h rather than the next
# working instant, so it does not yet make the after-hours "next business day"
# promise true. Leave false.
# Setting: phone_voicemail_ingest_enabled.
PHONE_VOICEMAIL_INGEST_ENABLED=false

# *** DOES NOT CURRENTLY GATE ANYTHING. LEAVE false. ***
# Intent: flush the call transcript per utterance while a human agent is on the
# call, keeping today's fifteen-second cadence for an AI-only call (per-utterance
# writes for an AI-only call are API load for an audience of nobody). Described
# as near-real-time append, NOT streaming captions. transcript_sink.py was never
# modified and no code reads this.
# NOTE: the separate, pre-existing PHONE_TRANSCRIPT_LIVE_ENABLED is what
# actually controls today's live transcript. Do not confuse the two.
# Setting: phone_live_transcript_enabled.
PHONE_LIVE_TRANSCRIPT_ENABLED=false

# true -> a daily tick looks for recordings older than
# PHONE_RECORDING_RETENTION_DAYS, and (when a deleter is wired) deletes them at
# the provider and clears the stored attributes, leaving a deleted state
# distinguishable from "no recording was ever made".
#
# SCHEDULED, BUT IT STILL DELETES NOTHING. main.py starts the tick (first run one
# interval after boot, never at boot), but no candidate source and no deleter are
# wired: there is no Twilio recording-delete adapter, and nothing lists
# recordings due for purge. The tick therefore reports "not_executable" with null
# counts -- null rather than 0, because "no recordings are past retention" is not
# something it can know. **The 90-day recording policy is not in force on any
# tenant**, and turning this on does not change that; what it changes is that the
# gap is now logged every day instead of being invisible.
#
# It also does NOT mark recordings deleted without a deleter. Marking a recording
# deleted while the audio still exists at the provider would make the retrieval
# endpoint tell an agent "deleted under the retention policy" about audio that is
# still there -- the policy looking enforced exactly where it is not.
# Setting: phone_retention_job_enabled.
PHONE_RETENTION_JOB_ENABLED=false

# How many days of call audio to keep. Default 90. Read by the retention tick
# above, so it only has an effect once that tick has a deleter (see above).
# 0 or negative is REFUSED AT BOOT -- the cutoff is now minus the window, so 0
# would select every recording ever made; to switch the job off use
# PHONE_RETENTION_JOB_ENABLED=false.
#
# NOTE the open question in docs/runbooks/data-retention.md §1: §4.84 asks for
# seven years of operations data, which contradicts 90 days for call audio. 90 is
# the assumption engineering is working to and it needs the client's
# confirmation.
# Setting: phone_recording_retention_days.
PHONE_RECORDING_RETENTION_DAYS=90

# --- P13: audit-log retention -----------------------------------------------
# true -> a daily tick lists audit-log rows older than AUDIT_LOG_RETENTION_DAYS
# and purges them. Off is the default and should stay off unless a retention
# decision has been written down: this job deletes rows from the trail that
# exists to be consulted after something has gone wrong.
#
# WHAT IT ACTUALLY DOES TODAY: the schedule is real (main.py starts it; the first
# tick is one interval after boot, never at boot) but the DELETE is not wired.
# The audit-log port has no delete method and its entries carry no document id,
# so the tick counts and logs the rows that are past the window and removes
# nothing -- reported as "dry_run", never as rows purged. Turning this on gives
# you a daily measurement of how much trail is past retention, not a purge.
#
# Both of these were previously read via getattr defaults and were not Settings
# fields at all, so before 2026-08-11 setting either of them here had no effect
# whatsoever. They are real fields now.
# Setting: audit_purge_job_enabled.
AUDIT_PURGE_JOB_ENABLED=false

# How many days of audit trail to keep. 2557 = 7*365 + 2 leap days, the same
# arithmetic docs/runbooks/data-retention.md uses for the BigQuery seven-year
# expiration, because §4.84 requires operations data to be retained at least
# seven years and the authorisation trail is operations data. Deliberately NOT
# 365 -- that was the value the unreachable code assumed, and defaulting to it
# would have made "enable the purge" a contract breach performed by a default
# nobody chose. Shorten per tenant only against a written retention decision.
# 0 or negative is REFUSED AT BOOT (it would purge everything on the first run);
# to switch the job off use AUDIT_PURGE_JOB_ENABLED=false.
# Setting: audit_log_retention_days.
AUDIT_LOG_RETENTION_DAYS=2557

# --- Term dictionary ------------------------------------------------------
# Which vocabulary this tenant's UI renders.
#   generic     industry-neutral: Partner, Asset, Field Incident, Job No.
#               Correct for every tenant outside automotive, and what
#               add-tenant.sh writes for a new tenant.
#   automotive  Dealer, Vehicle, RSA Incident, WIP No.
#
# UNSET MEANS `automotive`, and that is deliberate rather than a product
# statement: every tenant deployed before this setting existed is rendering
# automotive wording today, and an unset value must keep it that way
# byte-identically. proton in particular has no value here and must not get
# one — it keeps its vocabulary by falling through this default.
#
# A platform superadmin's choice in the Custom Features page overrides this.
# Setting: term_profile.
# TERM_PROFILE=generic

# ===========================================================================
# Settings that existed only in code until now
# ===========================================================================
# P14's generated configuration document compared `Settings` against this file
# and both compose files and found 88 settings named in none of them. They were
# not broken — each has a code default and the platform runs on those — but an
# operator had no way to discover they existed, which is why all eight Twilio
# credentials were invisible even though no phone or WhatsApp feature works
# without them.
#
# Every value below is the CODE DEFAULT, so uncommenting a line changes nothing
# by itself. They are listed to be discoverable, not because they need setting.
# Anything genuinely required for a feature says so.
#
# Regenerate the audit with:  python3 scripts/generate-config-doc.py
# It has a --check mode, so drift between code and this file is a failing test
# rather than something noticed a year later.

# --- Two defaults worth changing on a real tenant -------------------------
# DEBUG ships TRUE. It controls structured-log verbosity via configure_logging;
# on a production tenant set it false, both to cut log volume and because debug
# logging is the usual way a request payload ends up in a log aggregator.
# DEBUG=false
#
# FRONTEND_ORIGINS is the CORS allow-list, and its code default carries eight
# localhost dev ports plus a hard-coded `crm.34-50-103-151.nip.io` from an
# earlier demo VM. A tenant on any other host must set this or the browser app
# is blocked; leaving the stale entry also allows an origin nobody controls.
# FRONTEND_ORIGINS=["http://crm.<your-ip>.nip.io"]

# --- Twilio: nothing on voice or WhatsApp works without these -------------
# The eight credentials plus the public base URLs. All blank by default, so the
# phone and WhatsApp channels are inert until they are filled in — silently, and
# with no log line saying why, which is what made their absence from this file
# expensive.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=          # e.g. whatsapp:+60123456789
# TWILIO_PHONE_NUMBER=             # E.164, the inbound voice number
# TWILIO_WEBHOOK_BASE_URL=         # public https base Twilio posts callbacks to
# TWILIO_API_KEY_SID=              # browser-softphone Voice grant
# TWILIO_API_KEY_SECRET=
# TWILIO_TWIML_APP_SID=
# PUBLIC_WSS_BASE_URL=             # wss base for <Stream>; falls back to the
#                                  # webhook base with https:// -> wss://

# --- Phone channel behaviour ----------------------------------------------
# All off by default. Note PHONE_RECORDING_ENABLED and PHONE_HANDOFF_ENABLED
# both DEPEND on PHONE_TRANSCRIPT_LIVE_ENABLED and the app refuses to boot
# otherwise (config.py::_phone_flag_dependencies) — without it the conversation
# only exists inside PhoneBridge.finalize(), and a recording-status or
# no-answer callback can win that race and lose the write silently.
# VOICE_DEFAULT_LANG=en-US
# PHONE_LANGUAGE_NUDGE_ENABLED=false
# PHONE_TRANSCRIPT_LIVE_ENABLED=false
# PHONE_TRANSCRIPT_FLUSH_SECONDS=15.0
# PHONE_TRANSCRIPT_CLASSIFICATION_ENABLED=false
# PHONE_RECORDING_ENABLED=false
# PHONE_RECORDING_ANNOUNCEMENT=    # required by law in many jurisdictions
# PHONE_TOKEN_TTL_SECONDS=300
# PHONE_TOKEN_RATE_LIMIT=10
# PHONE_TOKEN_RATE_WINDOW_SECONDS=60
# PHONE_HANDOFF_ENABLED=false
# PHONE_HANDOFF_TARGET_NUMBER=     # a placeholder here dials an unallocated
#                                  # number; startup now refuses one
# PHONE_HANDOFF_TIMEOUT_SECONDS=30
# PHONE_HANDOFF_CALLER_ID=         # required: a PSTN <Dial> with no callerId
#                                  # inherits client:<id> and Twilio rejects it

# --- In-CRM agent softphone -------------------------------------------------
# Ring the conversation's assigned agent in their browser (then fan out to
# everyone available) instead of dialling PHONE_HANDOFF_TARGET_NUMBER.
# REQUIRES PHONE_HANDOFF_ENABLED=true -- the app refuses to boot otherwise.
# Also requires the fork's `agent_softphone` feature and the `voice.answer`
# permission granted to the agents who should receive calls. The fork's
# feature gate follows this flag automatically via patch 0058's unified
# mechanism (no separate PROTON_FEATURES edit needed) -- see
# docker-compose.tenant.yml's PHONE_AGENT_SOFTPHONE_ENABLED passthrough.
# ALSO REQUIRES RBAC_ENABLED=true (and RBAC_DATABASE_URL set, so /authz is
# mounted): POST /voice/agent/token is gated by require_permission_with_
# identity, which deliberately 401s on a None repo/validator or RBAC off --
# it refuses the shared-secret path outright, because the token it mints
# must carry a specific agent's identity, not a service's. With RBAC off,
# every /voice/agent/* call 401s regardless of this flag.
# PHONE_AGENT_SOFTPHONE_ENABLED=false
# PHONE_AGENT_TOKEN_TTL_SECONDS=300
# PHONE_SOFTPHONE_REGISTRATION_TTL_SECONDS=90
# PHONE_AGENT_RING_TIMEOUT_SECONDS=20
# PHONE_FANOUT_RING_TIMEOUT_SECONDS=25
# PHONE_FANOUT_MAX_AGENTS=10          # Twilio's hard <Dial> noun limit

# --- Chatwoot wiring ------------------------------------------------------
# The inbox/team ids default to 0, which means "unset" rather than inbox zero —
# several features no-op silently until a real id is supplied.
# CHATWOOT_ENABLED=true
# CHATWOOT_INBOX_ID=0
# CHATWOOT_EMAIL_INBOX_ID=0
# CHATWOOT_AGENT_TEAM_ID=0
# CHATWOOT_ESCALATION_LABEL=ai-escalation
# CHATWOOT_COMPLAINT_LABEL=escalate
# CHATWOOT_COMPLAINT_REASONS=negative_sentiment
# CHATWOOT_CUSTOMER_EMAIL_DOMAIN=proton-demo.my
# CHATWOOT_BOT_REPLIES_TO_INCOMING=false

# --- SLA engine (Chatwoot has no native SLA engine) -----------------------
# SLA_RESPONSE_HOURS=8
# SLA_RESOLUTION_HOURS=48
# SLA_SCAN_INTERVAL_MINUTES=15
# SLA_PIC_WHATSAPP=               # blank = no WhatsApp leg on a breach alert
# SLA_WEBHOOK_SECRET=

# --- Escalation and email -------------------------------------------------
# EMAIL_DRAFT_ASSIST=false
# ESCALATION_EMAIL_ENABLED=false
# ESCALATION_CC_PIC=true
# ESCALATION_LEVEL2_WHATSAPP=
# ESCALATION_TIER2_HOURS=4.0
# EMAIL_ESCALATION_ACK_ENABLED=false
# EMAIL_ESCALATION_ACK_TEMPLATE=Your case has been escalated to a specialist team who will follow up shortly.

# --- Metrics warehouse ----------------------------------------------------
# METRICS_PROVIDER and QA_PROVIDER default to `noop`, so nothing is written to
# BigQuery until they are set to `bigquery`. The BIGQUERY_* defaults point at a
# shared demo project (`lv-playground-genai` / `demo_proton`) — a real tenant
# must override them or its metrics land in someone else's dataset.
#
# METRICS_PROVIDER is also the READ side's switch — what the Reports pages
# query. Its three values are not interchangeable:
#   noop      (default) every report renders EMPTY. Correct for a tenant with
#             no warehouse: it has no data, so it shows none.
#   mock      canned demo rows — one tenant's fixtures ("Dealer KL",
#             "Aftersales"/"Ali", "e.MAS 5"). Local dev and demos only. NEVER
#             on a tenant a customer can log into; it renders as that
#             customer's own figures.
#   bigquery  the real warehouse (set the BIGQUERY_* vars below with it).
# METRICS_PROVIDER=noop
# QA_PROVIDER=noop
# BIGQUERY_PROJECT_ID=lv-playground-genai
# BIGQUERY_DATASET=demo_proton
# BIGQUERY_CONVERSATIONS_TABLE=conversations
# BIGQUERY_TURN_EVENTS_TABLE=turn_events
# BIGQUERY_QA_LABELS_TABLE=qa_labels
# BIGQUERY_FAQ_FEEDBACK_TABLE=faq_feedback
# METRICS_SYNC_INTERVAL_HOURS=6
# QA_API_KEY=
# REPORT_ENABLED=false
# REPORT_RECIPIENTS=              # comma-separated
# REPORT_INTERVAL_HOURS=24
# ANOMALY_ZSCORE_K=3.0            # the DAILY detector; hourly is separate above
# ANOMALY_MIN_BASELINE=20

# --- AI models ------------------------------------------------------------
# EMBEDDING_MODEL=text-embedding-004
# ASSIST_GEMINI_MODEL=gemini-2.5-flash
# COPILOT_GEMINI_MODEL=gemini-2.5-flash
# COPILOT_MAX_TOOL_ITERATIONS=5
# GEMINI_TTS_MODEL=gemini-2.5-flash-tts
# GEMINI_TTS_VOICE=Kore
# GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
# GEMINI_LIVE_VOICE=Kore
# GEMINI_LIVE_LANGUAGE=           # blank = let the model decide

# --- Agent-facing AI assist: attachments ----------------------------------
# When an agent clicks "Suggest a reply" (or Summarize / Ask Copilot) on a
# conversation where the customer sent a photo, video, voice note or PDF, this
# controls whether the AI actually SEES that attachment.
#
# OFF (default): the transcript still tells the model an attachment exists
#   ("Customer: this one [sent a video]") -- that half is never gated, because
#   a caption-less attachment silently vanishing from the transcript is a bug
#   under any configuration. The model can acknowledge the video but not
#   describe it, so it will ask the customer what they want to know about it.
# ON: the backend fetches the conversation from the Chatwoot API, downloads the
#   attachments, and sends them to Gemini inline. The draft can then answer
#   about what is actually in the video.
#
# Cost warning: this applies to all three assist actions, so a Summarize click
# on a thread with a 14 MB video pays video tokens for a few bullet points.
# ASSIST_MEDIA_UNDERSTANDING_ENABLED=false
#
# Byte budget for the WHOLE request, not per attachment (several attachments
# are base64'd into one JSON body). Oversized files are rejected on their
# Content-Length before the body transfers; the rest are dropped whole, video
# first and voice notes last. Requires ASSIST_MEDIA_UNDERSTANDING_ENABLED.
# ASSIST_MEDIA_MAX_BYTES=14680064   # 14 MiB
#
# NOTE: this flag needs no line in docker-compose.tenant.yml's PROTON_FEATURES
# passthrough block. That block exists only for flags whose feature also has a
# hasFeature(...) gate in the Chatwoot SPA; this one has no frontend gate.

# --- Firestore collections, routing and tool allow-lists ------------------
# CUSTOM_TOOL_ALLOWED_HOSTS is a security boundary: it is the allow-list for
# operator-authored tool calls, and empty means no host is permitted.
# FIRESTORE_HANDOFF_COLLECTION=handoff_sessions
# FIRESTORE_AUDIT_COLLECTION=case_audit_log
# LIVE_FAQ_COLLECTION=live_faq
# ROUTING_MAX_CONCURRENT_PER_AGENT=0   # 0 = no cap
# CUSTOM_TOOL_ALLOWED_HOSTS=[]
# ASSIST_CORS_ORIGINS=[]
# DEALER_EMAIL_MAP_JSON=          # superseded by the Escalation Routing admin
#                                 # page; kept as a fallback for tenants that
#                                 # never open it

# --- Zendesk: NOT the deployed path --------------------------------------
# These eleven only apply when CRM_PROVIDER=zendesk. This platform runs on
# Chatwoot, and the Zendesk adapter is an alternative implementation that no
# tenant currently uses. Listed for completeness so the drift audit is clean —
# not because they should be filled in. ZENDESK_SUBDOMAIN's default is the
# literal string 'your-zendesk-subdomain', which is a placeholder, not a value.
# ZENDESK_SUBDOMAIN=your-zendesk-subdomain
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=
# ZENDESK_APP_ID=
# ZENDESK_KEY_ID=
# ZENDESK_SECRET_KEY=
# ZENDESK_REQUESTER_DOMAIN=proton.devoteam.example
# ZENDESK_CUSTOMER_NAME_PREFIX=Proton AI Customer
# ZENDESK_TICKET_TAG=
# ZENDESK_SUPPORT_WEBHOOK_SECRET=
# SUNSHINE_WEBHOOK_SECRET=

# --- The last two, and the first is a dependency people miss ---------------
# CHAT_AGENT_ENABLED routes the agent-bot's decision through the backend
# /chat/turn ADK agent. It is off by default, and NOTHING in P7's sentiment,
# tone or media-diagnosis work reaches production without it — a tenant can set
# all eight of those flags true, see no effect, and get no warning. The media
# instruction additionally needs WHATSAPP_MEDIA_UNDERSTANDING_ENABLED.
# CHAT_AGENT_ENABLED=false
#
# EMAIL_AUTOACK_TEMPLATE is the body of the automatic acknowledgement sent when
# an email-channel case arrives, used only when EMAIL_AUTOACK_ENABLED is on.
# Blank falls back to the built-in wording.
# EMAIL_AUTOACK_TEMPLATE=
