+++ b/app/javascript/dashboard/composables/useProtonPiiMask.js
@@ -0,0 +1,143 @@
+// useProtonPiiMask.js — OUR file (patch 0085, Wave 2 Task 29 / FIX-49).
+// Masks personal identifiers (phone, e-mail, IC, passport, VIN, bank/card)
+// in Chatwoot's own contact views for a user without the `pii.view`
+// permission, when the backend's PII_MASKING_ENABLED is on.
+//
+// Asks the Proton backend once per page session: GET /authz/me/pii ->
+// { masking_enabled, masked } (under /authz/*, which every tenant's Caddy
+// vhost already routes to the backend).
+//
+// FAIL CLOSED (Task 29 review ruling):
+//   * while the answer is pending -> masked (no flash of raw data);
+//   * an error -> masked, retried after a few seconds;
+//   * EXCEPT a 404 (an older backend without the route, or nothing routed)
+//     and a tenant with no Proton backend configured at all -> unmasked,
+//     exactly as before this patch: neither can have masking switched on.
+//   * an answer -> masked only when { masking_enabled: true, masked: true }.
+// So a flag-off tenant shows masked values for the length of one request on
+// first load, then everything.
+//
+// This is UX only: Chatwoot's own API still returns the raw value to the
+// browser. The backend-owned surfaces (Customer 360, RSA, case fields, AI
+// activity) are masked server-side.
+//
+// Formats match the backend's features/privacy/pii.py display format:
+//   +60•••••6789   s•••@gmail.com   ******-**-5678   •••••••••••••2345
+import { ref, computed } from 'vue';
+import { adminRequest } from 'dashboard/api/protonAdmin';
+
+const MASK = '•';
+const RETRY_MS = 5000;
+const masked = ref(true); // pending = masked
+let loaded = false;
+let loadPromise = null;
+let retryTimer = null;
+
+function ensureLoaded() {
+  if (loaded || loadPromise) return;
+  loadPromise = adminRequest('/authz/me/pii')
+    .then(data => {
+      masked.value = !!(data && data.masking_enabled && data.masked);
+      loaded = true;
+    })
+    .catch(err => {
+      const noBackend =
+        err?.status === 404 ||
+        /PROTON_BACKEND_URL not configured/.test(err?.message || '');
+      if (noBackend) {
+        masked.value = false;
+        loaded = true;
+        return;
+      }
+      masked.value = true;
+      if (retryTimer === null) {
+        retryTimer = setTimeout(() => {
+          retryTimer = null;
+          ensureLoaded();
+        }, RETRY_MS);
+      }
+    })
+    .finally(() => {
+      loadPromise = null;
+    });
+}
+
+function tail(value, keep = 4) {
+  const chars = String(value).replace(/[^0-9A-Za-z]/g, '');
+  if (chars.length <= keep) return MASK.repeat(chars.length);
+  return MASK.repeat(chars.length - keep) + chars.slice(-keep);
+}
+
+export function maskPhone(value) {
+  const raw = String(value);
+  const digits = raw.replace(/\D/g, '');
+  if (digits.length < 6) return raw;
+  const head = (raw.trim().startsWith('+') ? '+' : '') + digits.slice(0, 2);
+  return head + MASK.repeat(digits.length - 6) + digits.slice(-4);
+}
+
+export function maskEmail(value) {
+  const raw = String(value);
+  const at = raw.indexOf('@');
+  if (at < 1) return raw;
+  return `${raw[0]}${MASK.repeat(3)}${raw.slice(at)}`;
+}
+
+export function maskIc(value) {
+  const digits = String(value).replace(/\D/g, '');
+  if (digits.length < 4) return MASK.repeat(digits.length);
+  return `******-**-${digits.slice(-4)}`;
+}
+
+// Which rule a field NAME calls for, or null for a field that is not
+// personal data. Same anchored rules as the backend's _KEY_RULES: start at a
+// name-part boundary and END the name (optional _no/_number), so bank_name
+// ("Maybank"), passport_country and ic_expiry are not masked.
+const NUM = '(_?(no|number|num))?';
+const KEY_RULES = [
+  [new RegExp('(^|_)e-?mail(_?address)?$'), 'email'],
+  [
+    new RegExp(
+      `(^|[_\\s-])(ic|nric|mykad|new_ic|old_ic|national_id|identity(_card)?)${NUM}$`
+    ),
+    'ic',
+  ],
+  [new RegExp(`(^|_)passport${NUM}$`), 'tail'],
+  [new RegExp(`(^|_)(vin|chassis)${NUM}$`), 'tail'],
+  [
+    new RegExp(
+      `(^|_)(bank_account${NUM}|(bank_)?(account|acct|card)_?(no|number|num))$`
+    ),
+    'tail',
+  ],
+  [new RegExp(`(^|_)(phone|mobile|whatsapp|msisdn|tel)${NUM}$`), 'phone'],
+];
+
+export function piiKindForKey(key) {
+  const k = String(key || '').toLowerCase();
+  const hit = KEY_RULES.find(([pattern]) => pattern.test(k));
+  return hit ? hit[1] : null;
+}
+
+export function maskPiiValue(value, kind) {
+  if (value === null || value === undefined || value === '') return value;
+  if (kind === 'email') return maskEmail(value);
+  if (kind === 'phone') return maskPhone(value);
+  if (kind === 'ic') return maskIc(value);
+  if (kind === 'tail') return tail(value);
+  // 'identifier': a contact identifier is usually a phone number or a
+  // WhatsApp/e-mail style address.
+  const raw = String(value);
+  if (raw.includes('@')) return maskEmail(raw);
+  if (raw.replace(/\D/g, '').length >= 9) return maskPhone(raw);
+  return raw;
+}
+
+export function useProtonPiiMask() {
+  ensureLoaded();
+  const piiMasked = computed(() => masked.value);
+  return {
+    piiMasked,
+    maskPii: (value, kind) => (masked.value ? maskPiiValue(value, kind) : value),
+  };
+}
