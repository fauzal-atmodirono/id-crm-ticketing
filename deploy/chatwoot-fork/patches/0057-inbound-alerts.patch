diff --git a/app/javascript/dashboard/views/ProtonAlertPreferencesPage.vue b/app/javascript/dashboard/views/ProtonAlertPreferencesPage.vue
new file mode 100644
index 0000000..cce2181
--- /dev/null
+++ b/app/javascript/dashboard/views/ProtonAlertPreferencesPage.vue
@@ -0,0 +1,352 @@
+<!-- ProtonAlertPreferencesPage.vue — OUR file. Two audiences on one page,
+     matching the two permissions features/alerts/rules_router.py splits on:
+
+       My alerts        (every agent — alerts.set_own_preferences)
+         GET    /alerts/rules/mine
+         PUT    /alerts/rules/mine/:event
+         DELETE /alerts/rules/mine/:event   ← back to the account default
+
+       Account defaults (administrators — alerts.manage)
+         GET /alerts/rules/defaults
+         PUT /alerts/rules/defaults/:event
+
+     WHY AN AGENT EDITS THEIR OWN ROW AT ALL. Tolerance for interruption
+     genuinely varies by person, and a single account-wide setting produces a
+     workaround rather than compliance: the agent who cannot work with a beep
+     every few seconds turns off ALL alerting, including the sla_breach alert
+     that actually matters. That is the whole reason the store has a per-agent
+     override layer, and this page is the only thing that makes it reachable.
+
+     NEW-INBOUND IS TOAST-ONLY BY DEFAULT and the page says so in the row
+     itself, not in a tooltip, because the next person to look at this screen
+     and think "why is sound off?" needs the answer in front of them.
+
+     `alerts.manage` is deliberately NOT required to VIEW the defaults — the
+     GET is agent-readable, and knowing what you inherit is not privileged
+     information. It is required to change one. -->
+<script>
+import { useAlert } from 'dashboard/composables';
+import { useProtonPermissions } from 'dashboard/composables/useProtonPermissions';
+import { DEFAULT_ALERT_RULES, MODALITIES, SCOPES } from 'dashboard/helper/protonAlerts';
+import {
+  getAlertDefaults,
+  getMyAlertRules,
+  putAlertDefault,
+  putMyAlertRule,
+  resetMyAlertRule,
+} from 'dashboard/api/protonAlerts';
+
+const { hasPermission: protonHasPermission } = useProtonPermissions();
+
+// Why each event exists, in the agent's language. Shown per row so the
+// preferences page explains the alert rather than just toggling it.
+const EVENT_LABELS = {
+  assigned_to_me: 'A conversation is assigned to me',
+  new_inbound: 'A customer sends a new message',
+  sla_warn: 'An SLA deadline is approaching',
+  sla_breach: 'An SLA deadline has been missed',
+  escalated: 'A conversation is escalated',
+  anomaly: 'A channel volume anomaly is detected',
+};
+
+const EVENT_NOTES = {
+  new_inbound:
+    'Toast only by default. Sound and desktop notification are available here — on a busy WhatsApp shift they fire every few seconds, so they are off unless you turn them on.',
+  anomaly: 'Supervisors only in practice: it fires on account-wide volume, not on your own queue.',
+};
+
+const SCOPE_LABELS = {
+  mine: 'Only conversations assigned to me',
+  my_inbox: 'Any conversation in my inboxes',
+  my_team: 'Any conversation in my team',
+  all: 'Every conversation on this account',
+};
+
+const MODALITY_LABELS = {
+  toast: 'On-screen',
+  sound: 'Sound',
+  desktop: 'Desktop notification',
+};
+
+export default {
+  name: 'ProtonAlertPreferencesPage',
+  data() {
+    return {
+      events: Object.keys(DEFAULT_ALERT_RULES),
+      scopes: SCOPES,
+      modalities: MODALITIES,
+      eventLabels: EVENT_LABELS,
+      eventNotes: EVENT_NOTES,
+      scopeLabels: SCOPE_LABELS,
+      modalityLabels: MODALITY_LABELS,
+      mine: {},
+      defaults: {},
+      loading: true,
+      saving: '',
+      disabled: false,
+      disabledReason: '',
+    };
+  },
+  computed: {
+    // A computed rather than a data field: useProtonPermissions resolves the
+    // caller's permission set asynchronously, so a value snapshotted in data()
+    // would be false on first render and never correct itself — the exact bug
+    // ProtonMyStatusPage.vue documents for canManage.
+    canManageDefaults() {
+      return protonHasPermission('alerts.manage');
+    },
+    // Read through `this.$store` rather than useMapGetter: this is an Options
+    // API component, and a composable called from a computed (or from module
+    // scope, as useProtonPermissions safely can be) has no active setup
+    // context to inject the store from.
+    //
+    // The id is only needed for the RBAC-OFF case, where the router has no
+    // verifiable caller identity to infer it from and 400s without it. With
+    // RBAC on it is ignored — see api/protonAlerts.js.
+    agentId() {
+      const getters = this.$store && this.$store.getters;
+      const user = getters && getters.getCurrentUser;
+      return (user && user.id) || null;
+    },
+  },
+  async mounted() {
+    await this.load();
+  },
+  methods: {
+    async load() {
+      this.loading = true;
+      try {
+        const [mine, defaults] = await Promise.all([
+          getMyAlertRules(this.agentId),
+          getAlertDefaults(),
+        ]);
+        // ALERT_RULES_ENABLED off: the router answers {disabled:true} on every
+        // endpoint. Say so plainly — an empty page would read as "you have no
+        // alerts", which is the opposite of the truth (everyone gets the
+        // built-in defaults).
+        if (mine.disabled) {
+          this.disabled = true;
+          this.disabledReason = mine.reason || 'Alert rules are not enabled on this account.';
+        }
+        this.mine = this.hydrate(mine.rules);
+        this.defaults = this.hydrate(defaults.defaults);
+      } catch (err) {
+        useAlert(`Could not load alert preferences: ${err.message}`);
+        this.mine = this.hydrate(null);
+        this.defaults = this.hydrate(null);
+      } finally {
+        this.loading = false;
+      }
+    },
+    // Always render six rows. A row missing from the response falls back to
+    // the built-in default, which is what would actually fire, so the page
+    // never shows a blank where an alert exists.
+    hydrate(rules) {
+      const out = {};
+      for (const event of this.events) {
+        const source = (rules && rules[event]) || DEFAULT_ALERT_RULES[event];
+        out[event] = {
+          scope: source.scope,
+          modalities: [...(source.modalities || [])],
+          enabled: source.enabled !== false,
+        };
+      }
+      return out;
+    },
+    toggleModality(row, modality) {
+      const index = row.modalities.indexOf(modality);
+      if (index === -1) row.modalities.push(modality);
+      else row.modalities.splice(index, 1);
+    },
+    body(row) {
+      return { scope: row.scope, modalities: row.modalities, enabled: row.enabled };
+    },
+    async saveMine(event) {
+      this.saving = `mine:${event}`;
+      try {
+        const result = await putMyAlertRule(event, this.body(this.mine[event]), this.agentId);
+        if (result.disabled) useAlert(result.reason || 'Alert rules are not enabled.');
+        else useAlert('Saved. This applies to you only.');
+      } catch (err) {
+        useAlert(`Could not save: ${err.message}`);
+      } finally {
+        this.saving = '';
+      }
+    },
+    async resetMine(event) {
+      this.saving = `reset:${event}`;
+      try {
+        const result = await resetMyAlertRule(event, this.agentId);
+        if (result.disabled) {
+          useAlert(result.reason || 'Alert rules are not enabled.');
+        } else if (result.rule) {
+          // The router returns the rule that resolves AFTER the reset, so the
+          // row repaints with the inherited value rather than with a guess.
+          this.mine[event] = {
+            scope: result.rule.scope,
+            modalities: [...(result.rule.modalities || [])],
+            enabled: result.rule.enabled !== false,
+          };
+          useAlert('Reset. You now follow the account default for this event.');
+        }
+      } catch (err) {
+        useAlert(`Could not reset: ${err.message}`);
+      } finally {
+        this.saving = '';
+      }
+    },
+    async saveDefault(event) {
+      this.saving = `default:${event}`;
+      try {
+        const result = await putAlertDefault(event, this.body(this.defaults[event]));
+        if (result.disabled) useAlert(result.reason || 'Alert rules are not enabled.');
+        else useAlert('Account default saved. Agents with their own override keep it.');
+      } catch (err) {
+        useAlert(`Could not save the account default: ${err.message}`);
+      } finally {
+        this.saving = '';
+      }
+    },
+  },
+};
+</script>
+
+<template>
+  <div class="flex flex-col h-full overflow-y-auto">
+    <div class="p-6 mx-auto w-full max-w-5xl">
+      <h1 class="text-xl font-medium text-n-slate-12">Alert preferences</h1>
+      <p class="mt-1 mb-4 text-sm text-n-slate-11">
+        Choose which events alert you, and how loudly. These settings apply to you only.
+      </p>
+
+      <div
+        v-if="disabled"
+        class="p-3 mb-4 text-sm rounded-lg border border-amber-300 bg-amber-50 text-amber-900"
+      >
+        {{ disabledReason }} Every agent currently gets the built-in defaults shown below, and
+        changes on this page will not be stored until it is enabled.
+      </div>
+
+      <div v-if="loading" class="text-sm text-n-slate-11">Loading…</div>
+
+      <template v-else>
+        <div
+          v-for="event in events"
+          :key="event"
+          class="p-4 mb-3 rounded-lg border border-n-weak"
+        >
+          <div class="flex justify-between items-center gap-3">
+            <label class="flex items-center gap-2 text-sm font-medium text-n-slate-12">
+              <input v-model="mine[event].enabled" type="checkbox" />
+              {{ eventLabels[event] }}
+            </label>
+            <span class="font-mono text-xs text-n-slate-10">{{ event }}</span>
+          </div>
+          <p v-if="eventNotes[event]" class="mt-1 text-xs text-n-slate-11">
+            {{ eventNotes[event] }}
+          </p>
+          <div class="flex flex-wrap gap-4 items-center mt-3">
+            <label class="text-xs text-n-slate-11">
+              Which conversations
+              <select
+                v-model="mine[event].scope"
+                class="block mt-1 text-sm rounded-lg border-n-weak"
+              >
+                <option v-for="scope in scopes" :key="scope" :value="scope">
+                  {{ scopeLabels[scope] }}
+                </option>
+              </select>
+            </label>
+            <div class="flex gap-3 items-center">
+              <label
+                v-for="modality in modalities"
+                :key="modality"
+                class="flex items-center gap-1 text-xs text-n-slate-11"
+              >
+                <input
+                  type="checkbox"
+                  :checked="mine[event].modalities.includes(modality)"
+                  @change="toggleModality(mine[event], modality)"
+                />
+                {{ modalityLabels[modality] }}
+              </label>
+            </div>
+            <div class="flex gap-2 items-center ml-auto">
+              <button
+                type="button"
+                class="px-3 py-1 text-xs rounded-lg border border-n-weak text-n-slate-11"
+                :disabled="saving === `reset:${event}`"
+                @click="resetMine(event)"
+              >
+                Reset to account default
+              </button>
+              <button
+                type="button"
+                class="px-3 py-1 text-xs text-white rounded-lg bg-n-brand"
+                :disabled="saving === `mine:${event}`"
+                @click="saveMine(event)"
+              >
+                {{ saving === `mine:${event}` ? 'Saving…' : 'Save' }}
+              </button>
+            </div>
+          </div>
+        </div>
+
+        <h2 class="mt-8 text-lg font-medium text-n-slate-12">Account defaults</h2>
+        <p class="mt-1 mb-4 text-sm text-n-slate-11">
+          What an agent who has not set their own preference gets. Changing a default does not
+          overwrite an agent who has already chosen for themselves.
+        </p>
+        <p v-if="!canManageDefaults" class="mb-4 text-xs text-n-slate-10">
+          Read-only: changing an account default needs the
+          <span class="font-mono">alerts.manage</span> permission.
+        </p>
+        <div
+          v-for="event in events"
+          :key="`default-${event}`"
+          class="flex flex-wrap gap-4 items-center p-3 mb-2 rounded-lg border border-n-weak"
+        >
+          <label class="flex items-center gap-2 text-sm text-n-slate-12">
+            <input
+              v-model="defaults[event].enabled"
+              type="checkbox"
+              :disabled="!canManageDefaults"
+            />
+            <span class="font-mono text-xs">{{ event }}</span>
+          </label>
+          <select
+            v-model="defaults[event].scope"
+            :disabled="!canManageDefaults"
+            class="text-sm rounded-lg border-n-weak"
+          >
+            <option v-for="scope in scopes" :key="scope" :value="scope">
+              {{ scopeLabels[scope] }}
+            </option>
+          </select>
+          <label
+            v-for="modality in modalities"
+            :key="`default-${event}-${modality}`"
+            class="flex items-center gap-1 text-xs text-n-slate-11"
+          >
+            <input
+              type="checkbox"
+              :checked="defaults[event].modalities.includes(modality)"
+              :disabled="!canManageDefaults"
+              @change="toggleModality(defaults[event], modality)"
+            />
+            {{ modalityLabels[modality] }}
+          </label>
+          <button
+            v-if="canManageDefaults"
+            type="button"
+            class="px-3 py-1 ml-auto text-xs rounded-lg border border-n-weak text-n-slate-11"
+            :disabled="saving === `default:${event}`"
+            @click="saveDefault(event)"
+          >
+            {{ saving === `default:${event}` ? 'Saving…' : 'Save default' }}
+          </button>
+        </div>
+      </template>
+    </div>
+  </div>
+</template>
