+<script setup>
+// ProtonSoftphonePanel.vue — OUR file. Ring + in-call UI for a transferred
+// phone call. Teleported to <body> so it floats above the app rather than
+// being clipped by the sidebar it is mounted from.
+//
+// PLAIN HTML BUTTONS, NOT THE `Button` COMPONENT. Chatwoot's own `Button`
+// props and `n-*` colour tokens are not verifiable from this checkout --
+// ProtonSlaPoliciesPage.vue (patch 0025), the file this patch was told to
+// cross-check against, does not use `Button` anywhere either: every action in
+// that page is a plain `<button>` styled with Tailwind and the `n-*` tokens
+// this fork's OTHER already-merged patches actually use (bg-n-brand,
+// text-n-ruby-9, border-n-weak, bg-n-background, text-n-slate-11/12 -- see
+// 0010/0012/0025/0044). A wrong guess at a component prop renders a broken
+// button, not a build error, so this patch does not guess one.
+import { computed, onMounted } from 'vue';
+import { useRouter } from 'vue-router';
+import { useProtonSoftphone } from 'dashboard/composables/useProtonSoftphone';
+
+const router = useRouter();
+const { status, incoming, elapsed, muted, register, accept, reject, hangup, toggleMute } =
+  useProtonSoftphone();
+
+onMounted(register);
+
+const visible = computed(() =>
+  ['ringing', 'in-call', 'ended'].includes(status.value)
+);
+
+const elapsedLabel = computed(() => {
+  const m = Math.floor(elapsed.value / 60);
+  const s = elapsed.value % 60;
+  return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
+});
+
+function openConversation() {
+  if (incoming.value?.conversationId) {
+    router.push({
+      name: 'inbox_conversation',
+      params: { conversation_id: incoming.value.conversationId },
+    });
+  }
+}
+</script>
+
+<template>
+  <Teleport to="body">
+    <div
+      v-if="visible"
+      class="fixed z-50 flex flex-col gap-3 p-4 shadow-lg bottom-6 ltr:right-6 rtl:left-6 w-80 rounded-xl bg-n-background border border-n-weak"
+    >
+      <div class="flex items-center justify-between">
+        <span class="text-sm font-medium text-n-slate-12">
+          {{
+            status === 'ringing'
+              ? 'Incoming call'
+              : status === 'ended'
+                ? 'Call ended'
+                : 'On call'
+          }}
+        </span>
+        <span v-if="status === 'in-call'" class="font-mono text-sm text-n-slate-11">
+          {{ elapsedLabel }}
+        </span>
+      </div>
+
+      <div class="text-base font-semibold text-n-slate-12">
+        {{ incoming?.from || 'Unknown number' }}
+      </div>
+      <p v-if="incoming?.reason" class="text-sm text-n-slate-11">{{ incoming.reason }}</p>
+
+      <button
+        v-if="incoming?.conversationId"
+        type="button"
+        class="text-sm text-left underline text-n-brand"
+        @click="openConversation"
+      >
+        Open conversation
+      </button>
+
+      <div v-if="status === 'ringing'" class="flex gap-2">
+        <button
+          type="button"
+          class="flex-1 px-3 py-2 text-sm font-medium text-white rounded-lg bg-n-brand hover:brightness-95"
+          @click="accept"
+        >
+          Accept
+        </button>
+        <button
+          type="button"
+          class="flex-1 px-3 py-2 text-sm font-medium border rounded-lg border-n-ruby-9 text-n-ruby-9 hover:bg-n-ruby-9/10"
+          @click="reject"
+        >
+          Reject
+        </button>
+      </div>
+      <p v-else-if="status === 'ended'" class="text-sm text-n-slate-11">
+        This call is no longer ringing.
+      </p>
+      <div v-else class="flex gap-2">
+        <button
+          type="button"
+          class="flex-1 px-3 py-2 text-sm font-medium border rounded-lg border-n-weak text-n-slate-12 hover:bg-n-alpha-black1"
+          @click="toggleMute"
+        >
+          {{ muted ? 'Unmute' : 'Mute' }}
+        </button>
+        <button
+          type="button"
+          class="flex-1 px-3 py-2 text-sm font-medium border rounded-lg border-n-ruby-9 text-n-ruby-9 hover:bg-n-ruby-9/10"
+          @click="hangup"
+        >
+          Hang up
+        </button>
+      </div>
+    </div>
+  </Teleport>
+</template>
