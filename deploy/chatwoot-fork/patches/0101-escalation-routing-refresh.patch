diff --git a/app/javascript/dashboard/views/escalationRouting/EmailChips.vue b/app/javascript/dashboard/views/escalationRouting/EmailChips.vue
new file mode 100644
index 0000000..94a96f1
--- /dev/null
+++ b/app/javascript/dashboard/views/escalationRouting/EmailChips.vue
@@ -0,0 +1,84 @@
+<script setup>
+// Emails as removable chips (patch 0101). Enter, comma, Tab or blur turns the
+// typed text into a chip; a pasted "a@x.com, b@y.com" becomes two. An invalid
+// address stays visible as a red chip and reports `invalid` so the drawer can
+// block Save -- it is never silently dropped.
+import { computed, ref, watch } from 'vue';
+import { isEmail } from './routingHelpers';
+
+const props = defineProps({
+  modelValue: { type: Array, default: () => [] },
+  label: { type: String, required: true },
+  placeholder: { type: String, default: 'Type an email, press Enter' },
+});
+const emit = defineEmits(['update:modelValue', 'invalid']);
+
+const draft = ref('');
+const bad = computed(() => props.modelValue.filter(e => !isEmail(e)));
+watch(bad, list => emit('invalid', list.length > 0), { immediate: true });
+
+function commit() {
+  const parts = draft.value
+    .split(/[,\s]+/)
+    .map(s => s.trim())
+    .filter(Boolean);
+  if (!parts.length) return;
+  const next = [...props.modelValue];
+  parts.forEach(p => {
+    if (!next.includes(p)) next.push(p);
+  });
+  emit('update:modelValue', next);
+  draft.value = '';
+}
+
+function remove(email) {
+  emit('update:modelValue', props.modelValue.filter(e => e !== email));
+}
+
+function onKeydown(event) {
+  if (event.key === 'Enter' || event.key === ',') {
+    event.preventDefault();
+    commit();
+  } else if (event.key === 'Backspace' && !draft.value && props.modelValue.length) {
+    remove(props.modelValue[props.modelValue.length - 1]);
+  }
+}
+</script>
+
+<template>
+  <div class="flex flex-col gap-1.5">
+    <div
+      class="flex flex-wrap items-center gap-1.5 p-2 min-h-10 border rounded-lg bg-n-alpha-black2"
+      :class="bad.length ? 'border-n-ruby-9' : 'border-n-weak'"
+    >
+      <span
+        v-for="email in modelValue"
+        :key="email"
+        class="inline-flex items-center gap-1 py-1 pl-2.5 pr-1 text-sm rounded-full"
+        :class="isEmail(email) ? 'bg-n-alpha-2 text-n-slate-12' : 'bg-n-ruby-3 text-n-ruby-11'"
+      >
+        {{ email }}
+        <button
+          type="button"
+          :aria-label="`Remove ${email}`"
+          class="flex items-center justify-center rounded-full size-5 hover:bg-n-alpha-black1"
+          @click="remove(email)"
+        >
+          <span class="i-lucide-x size-3" aria-hidden="true" />
+        </button>
+      </span>
+      <input
+        v-model="draft"
+        type="text"
+        :aria-label="label"
+        :placeholder="modelValue.length ? '' : placeholder"
+        class="flex-1 min-w-[140px] !mb-0 !p-0 text-sm bg-transparent border-0 outline-none !h-auto text-n-slate-12"
+        @keydown="onKeydown"
+        @blur="commit"
+      />
+    </div>
+    <p v-if="bad.length" class="text-xs text-n-ruby-11">
