--- a/app/javascript/dashboard/composables/useProtonPiiMask.js
+++ b/app/javascript/dashboard/composables/useProtonPiiMask.js
@@ -14,8 +14,9 @@
 //     and a tenant with no Proton backend configured at all -> unmasked,
 //     exactly as before this patch: neither can have masking switched on.
 //   * an answer -> masked only when { masking_enabled: true, masked: true }.
-// So a flag-off tenant shows masked values for the length of one request on
-// first load, then everything.
+// Patch 0088: all of the above applies only when the Rails layout says
+// PII_MASKING_ENABLED is on (window.__PROTON_PII_MASKING__); a flag-off
