diff --git a/app/javascript/dashboard/views/escalationRouting/DealerDrawer.vue b/app/javascript/dashboard/views/escalationRouting/DealerDrawer.vue
new file mode 100644
index 0000000..4bebe42
--- /dev/null
+++ b/app/javascript/dashboard/views/escalationRouting/DealerDrawer.vue
@@ -0,0 +1,161 @@
+<script setup>
+// Add / edit one dealer group (patch 0101): Basics, Members (chips), Ladder
+// contacts. Works on a copy; same upsertDealer / deleteDealer calls and body
+// ({ emails, contacts, region }) as the pre-0101 page. A dealer configured by
+// named contacts alone is valid -- that is the shape the ladder wants.
+import { computed, ref, watch } from 'vue';
+import { useAlert } from 'dashboard/composables';
+import { upsertDealer, deleteDealer } from 'dashboard/api/protonAdmin';
+import RecordDrawer from './RecordDrawer.vue';
+import EmailChips from './EmailChips.vue';
+import { contactsFrom, dealerMembers, isEmail } from './routingHelpers';
+
+const props = defineProps({
+  open: { type: Boolean, default: false },
+  dealer: { type: Object, default: null }, // null = a new dealer
+  roles: { type: Array, required: true }, // DEALER_ROLES with term labels
+  labels: { type: Object, default: () => ({}) },
+});
+const emit = defineEmits(['close', 'saved']);
+
+const blank = () => ({ dealer: '', region: '', emails: [], cre: '', sales_aftersales_mgr: '', principal: '', owner: '' });
+const form = ref(blank());
+const membersInvalid = ref(false);
+const saving = ref(false);
+const isNew = computed(() => !props.dealer);
+const partner = computed(() => props.labels.partnerTitle || 'Dealer');
+const partnerLower = computed(() => props.labels.partnerLower || 'dealer');
+
+watch(
+  () => [props.open, props.dealer],
+  () => {
+    if (!props.open) return;
+    const d = props.dealer;
+    const c = d?.contacts || {};
+    form.value = d
+      ? {
+          dealer: d.dealer,
+          region: d.region || '',
+          emails: [...dealerMembers(d)],
+          cre: c.cre || '',
+          sales_aftersales_mgr: c.sales_aftersales_mgr || '',
+          principal: c.principal || '',
+          owner: c.owner || '',
+        }
+      : blank();
+  },
+  { immediate: true }
+);
+
+const badContacts = computed(() =>
+  props.roles.filter(r => form.value[r.key].trim() && !isEmail(form.value[r.key])).map(r => r.key)
+);
+const somebody = computed(
+  () => form.value.emails.length > 0 || Object.keys(contactsFrom(form.value)).length > 0
+);
+const canSave = computed(
+  () => Boolean(form.value.dealer.trim()) && somebody.value && !membersInvalid.value && !badContacts.value.length
+);
+
+async function save() {
+  if (!canSave.value) {
+    useAlert(`${partner.value} name and at least one valid member email or named contact are required.`);
+    return;
+  }
+  saving.value = true;
+  try {
+    await upsertDealer(form.value.dealer.trim(), {
+      emails: form.value.emails.map(e => e.trim()),
+      contacts: contactsFrom(form.value),
+      region: form.value.region,
+    });
+    useAlert(isNew.value ? `${partner.value} saved.` : `${partner.value} updated.`);
+    emit('saved');
+  } catch (err) {
+    useAlert(`Failed to save ${partnerLower.value}: ` + (err.message || String(err)));
+  } finally {
+    saving.value = false;
+  }
+}
+
+async function remove() {
+  const name = props.dealer?.dealer;
+  if (!name) return;
+  // eslint-disable-next-line no-alert
+  if (!window.confirm(`Delete ${partnerLower.value} "${name}"? This cannot be undone.`)) return;
+  saving.value = true;
+  try {
+    await deleteDealer(name);
+    useAlert(`${partner.value} deleted.`);
+    emit('saved');
+  } catch (err) {
+    useAlert(`Failed to delete ${partnerLower.value}: ` + (err.message || String(err)));
+  } finally {
+    saving.value = false;
+  }
+}
+
+const input =
+  'w-full h-10 px-3 !mb-0 text-sm border rounded-lg bg-n-alpha-black2 text-n-slate-12 min-w-0';
+</script>
+
+<template>
+  <RecordDrawer
+    :open="open"
+    :eyebrow="isNew ? `Add ${partnerLower}` : `Edit ${partnerLower}`"
+    :title="isNew ? `New ${partnerLower}` : dealer.dealer"
+    :saving="saving"
+    :can-save="canSave"
+    :deletable="!isNew"
+    :delete-label="`Delete ${partnerLower}`"
+    @save="save"
+    @cancel="emit('close')"
+    @delete="remove"
+  >
+    <fieldset class="flex flex-col gap-4">
+      <legend class="mb-3 text-sm font-semibold text-n-slate-12">Basics</legend>
+      <label v-if="isNew" class="flex flex-col gap-1.5">
+        <span class="text-sm font-medium text-n-slate-12">Group name</span>
+        <input v-model="form.dealer" type="text" required placeholder="petaling_jaya" :class="[input, 'border-n-weak']" />
+        <span class="text-xs text-n-slate-11">Matches the dealer_… label agents put on a case.</span>
+      </label>
+      <label class="flex flex-col gap-1.5">
+        <span class="text-sm font-medium text-n-slate-12">PRO-NET region</span>
+        <input v-model="form.region" type="text" placeholder="central" :class="[input, 'border-n-weak']" />
+        <span class="text-xs text-n-slate-11">Decides which Area/Regional Manager and HOD are CC'd.</span>
+      </label>
+    </fieldset>
+
+    <fieldset class="flex flex-col gap-2">
+      <legend class="mb-3 text-sm font-semibold text-n-slate-12">
+        Members <span class="font-normal text-n-slate-11">— all get the escalation email</span>
+      </legend>
+      <EmailChips v-model="form.emails" label="Add a member email" @invalid="membersInvalid = $event" />
+    </fieldset>
+
+    <fieldset class="flex flex-col gap-3">
+      <legend class="mb-1.5 text-sm font-semibold text-n-slate-12">Ladder contacts</legend>
+      <p class="text-xs leading-relaxed text-n-slate-11">
+        Each reminder goes to someone more senior. A blank role means that step is skipped, never sent to someone else.
+      </p>
+      <label
+        v-for="role in roles"
+        :key="role.key"
+        class="grid items-center gap-2.5 grid-cols-[150px_minmax(0,1fr)]"
+      >
+        <span class="flex flex-col">
+          <span class="text-sm font-medium text-n-slate-12">{{ role.label }}</span>
+          <span class="text-xs text-n-slate-11">{{ role.rung }}</span>
+        </span>
+        <input
+          v-model="form[role.key]"
+          type="email"
+          :class="[input, badContacts.includes(role.key) ? 'border-n-ruby-9' : 'border-n-weak']"
+        />
+      </label>
+      <p v-if="!somebody" class="text-xs text-n-ruby-11">
+        Add at least one member email or one named contact.
+      </p>
+    </fieldset>
+  </RecordDrawer>
+</template>
diff --git a/app/javascript/dashboard/views/escalationRouting/DealersTab.vue b/app/javascript/dashboard/views/escalationRouting/DealersTab.vue
