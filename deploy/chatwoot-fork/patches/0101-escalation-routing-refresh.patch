+++ b/app/javascript/dashboard/views/escalationRouting/PicDrawer.vue
@@ -0,0 +1,162 @@
+<script setup>
+// Add / edit one department's PIC (patch 0101). Works on a COPY of the record:
+// Cancel leaves the list exactly as it was. Same API calls and bodies as the
+// pre-0101 page (upsertPic / deletePic, cc_emails as an array).
+import { computed, ref, watch } from 'vue';
+import { useAlert } from 'dashboard/composables';
+import { upsertPic, deletePic } from 'dashboard/api/protonAdmin';
+import RecordDrawer from './RecordDrawer.vue';
+import EmailChips from './EmailChips.vue';
+import { isEmail, splitEmails } from './routingHelpers';
+
+const props = defineProps({
+  open: { type: Boolean, default: false },
+  // null = a new department
+  pic: { type: Object, default: null },
+});
+const emit = defineEmits(['close', 'saved']);
+
+const blank = () => ({
+  department: '',
+  pic_name: '',
+  pic_email: '',
+  pic_whatsapp: '',
+  cc_emails: [],
+  escalation_manager_email: '',
+});
+const form = ref(blank());
+const ccInvalid = ref(false);
+const saving = ref(false);
+const isNew = computed(() => !props.pic);
+
+watch(
+  () => [props.open, props.pic],
+  () => {
+    if (!props.open) return;
+    const p = props.pic;
+    form.value = p
+      ? {
+          department: p.department,
+          pic_name: p.pic_name || '',
+          pic_email: p.pic_email || '',
+          pic_whatsapp: p.pic_whatsapp || '',
+          cc_emails: splitEmails(p.cc_emails),
+          escalation_manager_email: p.escalation_manager_email || '',
+        }
+      : blank();
+  },
+  { immediate: true }
+);
+
+const managerOk = computed(
+  () => !form.value.escalation_manager_email.trim() || isEmail(form.value.escalation_manager_email)
+);
+const canSave = computed(
+  () =>
+    Boolean(form.value.department.trim() && form.value.pic_name.trim()) &&
+    isEmail(form.value.pic_email) &&
+    managerOk.value &&
+    !ccInvalid.value
+);
+
+async function save() {
+  if (!canSave.value) {
+    useAlert('Department, PIC name and a valid PIC email are required.');
+    return;
+  }
+  saving.value = true;
+  try {
+    await upsertPic(form.value.department.trim(), {
+      pic_name: form.value.pic_name,
+      pic_email: form.value.pic_email.trim(),
+      pic_whatsapp: form.value.pic_whatsapp,
+      cc_emails: splitEmails(form.value.cc_emails),
+      escalation_manager_email: form.value.escalation_manager_email.trim(),
+    });
+    useAlert(isNew.value ? 'PIC saved.' : 'PIC updated.');
+    emit('saved');
+  } catch (err) {
+    useAlert('Failed to save PIC: ' + (err.message || String(err)));
+  } finally {
+    saving.value = false;
+  }
+}
+
+async function remove() {
+  const department = props.pic?.department;
+  if (!department) return;
+  // eslint-disable-next-line no-alert
+  if (!window.confirm(`Delete the PIC for "${department}"? This cannot be undone.`)) return;
+  saving.value = true;
+  try {
+    await deletePic(department);
+    useAlert('PIC deleted.');
+    emit('saved');
+  } catch (err) {
+    useAlert('Failed to delete PIC: ' + (err.message || String(err)));
+  } finally {
+    saving.value = false;
+  }
+}
+
+const input =
+  'w-full h-10 px-3 !mb-0 text-sm border rounded-lg border-n-weak bg-n-alpha-black2 text-n-slate-12';
+</script>
+
+<template>
+  <RecordDrawer
+    :open="open"
+    :eyebrow="isNew ? 'Add department' : 'Edit department'"
+    :title="isNew ? 'New department' : pic.department"
+    :saving="saving"
+    :can-save="canSave"
+    :deletable="!isNew"
+    delete-label="Delete department"
+    @save="save"
+    @cancel="emit('close')"
+    @delete="remove"
+  >
+    <fieldset class="flex flex-col gap-4">
+      <legend class="mb-3 text-sm font-semibold text-n-slate-12">Person in charge</legend>
+      <label v-if="isNew" class="flex flex-col gap-1.5">
+        <span class="text-sm font-medium text-n-slate-12">Department label</span>
+        <input v-model="form.department" type="text" required placeholder="dept_engineer" :class="input" />
+        <span class="text-xs text-n-slate-11">The dept_… label agents put on a case.</span>
+      </label>
+      <label class="flex flex-col gap-1.5">
+        <span class="text-sm font-medium text-n-slate-12">Name</span>
+        <input v-model="form.pic_name" type="text" required :class="input" />
+      </label>
+      <label class="flex flex-col gap-1.5">
+        <span class="text-sm font-medium text-n-slate-12">Email</span>
+        <input v-model="form.pic_email" type="email" required :class="input" />
+      </label>
+      <label class="flex flex-col gap-1.5">
+        <span class="text-sm font-medium text-n-slate-12">
+          WhatsApp <span class="font-normal text-n-slate-11">(optional)</span>
+        </span>
+        <input v-model="form.pic_whatsapp" type="text" placeholder="+60…" :class="input" />
+      </label>
+    </fieldset>
+
+    <fieldset class="flex flex-col gap-2">
+      <legend class="mb-3 text-sm font-semibold text-n-slate-12">Also copied (CC)</legend>
+      <EmailChips v-model="form.cc_emails" label="Add a CC email" @invalid="ccInvalid = $event" />
+    </fieldset>
+
+    <fieldset class="flex flex-col gap-1.5">
+      <legend class="mb-3 text-sm font-semibold text-n-slate-12">If nobody answers</legend>
+      <label class="flex flex-col gap-1.5">
+        <span class="text-sm font-medium text-n-slate-12">Tier-2 manager email</span>
+        <input v-model="form.escalation_manager_email" type="email" placeholder="manager@example.com" :class="input" />
+      </label>
+      <span class="text-xs leading-relaxed" :class="managerOk ? 'text-n-slate-11' : 'text-n-ruby-11'">
+        {{
+          managerOk
+            ? 'Alerted when an escalation goes unanswered past the tier-2 window. Leave blank to re-alert the PIC.'
+            : 'Not a valid email.'
+        }}
+      </span>
+    </fieldset>
+  </RecordDrawer>
+</template>
diff --git a/app/javascript/dashboard/views/escalationRouting/RecordDrawer.vue b/app/javascript/dashboard/views/escalationRouting/RecordDrawer.vue
new file mode 100644
index 0000000..560e1c2
--- /dev/null
+++ b/app/javascript/dashboard/views/escalationRouting/RecordDrawer.vue
@@ -0,0 +1,90 @@
+<script setup>
+// The right-side panel every Escalation Routing form opens in (patch 0101).
+// Replaces the old inline row editing: one full-size form, Save/Cancel/Delete
+// in a fixed footer. Escape and the backdrop close it like Cancel.
+import { onBeforeUnmount, onMounted } from 'vue';
+
+const props = defineProps({
+  open: { type: Boolean, default: false },
+  eyebrow: { type: String, default: '' },
+  title: { type: String, default: '' },
+  saving: { type: Boolean, default: false },
+  canSave: { type: Boolean, default: true },
+  deletable: { type: Boolean, default: false },
+  deleteLabel: { type: String, default: 'Delete' },
+});
+const emit = defineEmits(['save', 'cancel', 'delete']);
+
+function onKey(event) {
+  if (props.open && event.key === 'Escape') emit('cancel');
+}
+onMounted(() => window.addEventListener('keydown', onKey));
+onBeforeUnmount(() => window.removeEventListener('keydown', onKey));
+</script>
+
+<template>
+  <div v-if="open" class="fixed inset-0 z-50 flex justify-end">
+    <div
+      class="absolute inset-0 bg-n-alpha-black1"
+      aria-hidden="true"
+      @click="emit('cancel')"
+    />
+    <aside
+      role="dialog"
+      aria-modal="true"
+      :aria-label="title"
+      class="relative flex flex-col w-full h-full max-w-[480px] bg-n-solid-1 border-l border-n-weak shadow-xl"
+    >
+      <div class="flex items-center justify-between px-6 py-5 border-b border-n-weak">
+        <div class="min-w-0">
+          <p v-if="eyebrow" class="text-xs font-medium tracking-wide uppercase text-n-slate-11">
+            {{ eyebrow }}
+          </p>
+          <h2 class="mt-0.5 text-base font-semibold truncate text-n-slate-12">{{ title }}</h2>
+        </div>
+        <button
+          type="button"
+          aria-label="Close"
+          class="flex items-center justify-center rounded-lg size-9 text-n-slate-11 hover:bg-n-alpha-2"
+          @click="emit('cancel')"
+        >
+          <span class="i-lucide-x size-4" aria-hidden="true" />
+        </button>
+      </div>
+      <form
+        class="flex flex-col flex-1 gap-6 px-6 py-5 overflow-y-auto"
+        @submit.prevent="canSave && !saving && emit('save')"
+      >
+        <slot />
+        <button type="submit" class="hidden" aria-hidden="true" tabindex="-1" />
+      </form>
+      <div class="flex items-center gap-3 px-6 py-4 border-t border-n-weak">
+        <button
+          v-if="deletable"
+          type="button"
+          :disabled="saving"
+          class="px-1 py-2 text-sm font-medium text-n-ruby-11 hover:underline disabled:opacity-50"
+          @click="emit('delete')"
+        >
+          {{ deleteLabel }}
+        </button>
+        <span class="flex-1" />
+        <button
+          type="button"
+          class="h-10 px-4 text-sm font-medium border rounded-lg border-n-weak text-n-slate-12 hover:bg-n-alpha-2"
+          @click="emit('cancel')"
+        >
+          Cancel
+        </button>
+        <button
+          type="button"
+          :disabled="saving || !canSave"
+          class="h-10 px-5 text-sm font-medium text-white rounded-lg bg-n-brand hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed"
+          @click="emit('save')"
+        >
+          {{ saving ? 'Saving…' : 'Save' }}
+        </button>
+      </div>
+    </aside>
+  </div>
+</template>
diff --git a/app/javascript/dashboard/views/escalationRouting/routingHelpers.js b/app/javascript/dashboard/views/escalationRouting/routingHelpers.js
new file mode 100644
index 0000000..d0165e3
--- /dev/null
+++ b/app/javascript/dashboard/views/escalationRouting/routingHelpers.js
@@ -0,0 +1,130 @@
+// Escalation Routing refresh (patch 0101, 16 Nov 2026): the pure helpers the
+// tabs share. No I/O here -- the page shell owns every request, so these stay
+// testable and the tabs stay presentational.
+
+export const LADDER_PATH = '/admin/escalation/ladder';
+
+// Blank input means "inherit the deployment's value", which the API expresses
+// as null. '' would be a 422 and 0 would be a real (and very wrong) timer.
+export function numOrNull(value) {
+  const raw = String(value ?? '').trim();
+  if (!raw) return null;
+  const n = Number(raw);
+  return Number.isNaN(n) ? null : n;
+}
+
+export function splitEmails(value) {
+  if (Array.isArray(value)) return value.map(s => String(s).trim()).filter(Boolean);
+  return String(value || '')
+    .split(',')
+    .map(s => s.trim())
+    .filter(Boolean);
+}
+
+const EMAIL_RE = /^[^\s@,]+@[^\s@,]+\.[^\s@,]+$/;
+export function isEmail(value) {
+  return EMAIL_RE.test(String(value || '').trim());
+}
+
+export const LADDER_RUNGS = [
+  { key: 'step2_hours', label: 'Step 2 — acknowledgement due', hint: 'Dealer CRE is expected to reply by now. Nothing is sent.' },
+  { key: 'step3_hours', label: 'Step 3 — 1st reminder', hint: 'Emails the Dealer Principal.' },
+  { key: 'step4_hours', label: 'Step 4 — 2nd reminder', hint: 'Emails the Dealer Owner.' },
+  { key: 'step5_hours', label: 'Step 5 — telephone', hint: 'Raises a call task. Sends no email.' },
+];
+
+// role key -> the label an operator recognises, and which rung uses it.
+export const DEALER_ROLES = [
+  { key: 'cre', label: 'Dealer CRE', short: 'CRE', rung: 'Step 1' },
+  { key: 'sales_aftersales_mgr', label: 'Sales / Aftersales Mgr', short: 'Sales/AS Mgr', rung: 'Step 1' },
+  { key: 'principal', label: 'Dealer Principal', short: 'Principal', rung: 'Step 3 · 1st reminder' },
+  { key: 'owner', label: 'Dealer Owner', short: 'Owner', rung: 'Step 4 · 2nd reminder' },
+];
+
+export function contactsFrom(form) {
+  const out = {};
+  DEALER_ROLES.forEach(({ key }) => {
+    const value = String(form[key] || '').trim();
+    if (value) out[key] = value;
+  });
+  return out;
+}
+
+export function dealerMembers(dealer) {
+  if (Array.isArray(dealer?.emails)) return dealer.emails;
+  return dealer?.email ? [dealer.email] : [];
+}
+
+function hasContacts(dealer) {
+  return Boolean(dealer?.contacts && Object.keys(dealer.contacts).length);
+}
+
+// The step a missing role silences. A dealer configured as a plain group (no
+// named contacts at all) is not on the ladder, so it is never "missing" one.
+const SKIP_ROLE = { 3: 'principal', 4: 'owner' };
+
+export function skippingDealers(step, dealers) {
+  const role = SKIP_ROLE[step];
+  if (!role) return [];
+  return (dealers || [])
+    .filter(d => hasContacts(d) && !d.contacts[role])
+    .map(d => d.dealer);
+}
+
+// What the operator should fix. Lists only what the API returned, so a
+// dealer-scoped user is never told about dealers they cannot see.
+export function attentionItems(pics, dealers, labels = {}) {
+  const partner = labels.partner || 'dealer';
+  const items = [];
+  (dealers || []).forEach(d => {
+    if (!dealerMembers(d).length && !hasContacts(d)) {
+      items.push({ kind: 'dealer', id: d.dealer, severity: 'high', text: `${d.dealer} has nobody to email`, detail: `Escalations to this ${partner} reach no one.` });
+      return;
+    }
+    if (hasContacts(d) && !d.contacts.principal) {
+      items.push({ kind: 'dealer', id: d.dealer, severity: 'high', text: `${d.dealer} has no ${labels.principal || 'Dealer Principal'}`, detail: 'Step 3 (1st reminder) will be skipped for its cases.' });
+    }
+    if (hasContacts(d) && !d.contacts.owner) {
+      items.push({ kind: 'dealer', id: d.dealer, severity: 'high', text: `${d.dealer} has no ${labels.owner || 'Dealer Owner'}`, detail: 'Step 4 (2nd reminder) will be skipped for its cases.' });
+    }
+    if (!String(d.region || '').trim()) {
+      items.push({ kind: 'dealer', id: d.dealer, severity: 'medium', text: `${d.dealer} has no PRO-NET region`, detail: "No Area/Regional Manager or HOD is CC'd." });
+    }
+  });
+  (pics || []).forEach(p => {
+    if (!isEmail(p.pic_email)) {
+      items.push({ kind: 'pic', id: p.department, severity: 'high', text: `${p.department} has no valid PIC email`, detail: 'Escalations to this department reach no one.' });
+    } else if (!String(p.escalation_manager_email || '').trim()) {
+      items.push({ kind: 'pic', id: p.department, severity: 'medium', text: `${p.department} has no tier-2 manager`, detail: 'An unanswered escalation re-alerts the PIC instead.' });
+    }
+  });
+  return items;
+}
+
+// The three-way control over the two stored booleans. Off keeps dry_run on,
+// so turning the ladder back on can never start in live mode by accident.
+export function ladderMode({ enabled, dry_run: dryRun } = {}) {
+  if (!enabled) return 'off';
+  return dryRun ? 'dry_run' : 'live';
+}
+
+export function modeToFlags(mode) {
+  if (mode === 'live') return { enabled: true, dry_run: false };
+  if (mode === 'dry_run') return { enabled: true, dry_run: true };
+  return { enabled: false, dry_run: true };
+}
+
+// An in-flight case whose next rung names a role its dealer does not have.
+export function rowGap(row, dealers) {
+  const role = SKIP_ROLE[row?.next_step_no];
+  if (!role) return null;
+  const dealer = (dealers || []).find(d => d.dealer === row.dealer);
+  if (!dealer || !hasContacts(dealer) || dealer.contacts[role]) return null;
+  return `Step ${row.next_step_no} skipped — no ${role === 'principal' ? 'Principal' : 'Owner'}`;
+}
+
+export function matches(query, ...fields) {
+  const q = String(query || '').trim().toLowerCase();
+  if (!q) return true;
+  return fields.some(f => String(f || '').toLowerCase().includes(q));
+}
