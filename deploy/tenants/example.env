# Template for a per-tenant env file. scripts/add-tenant.sh generates a real
# deploy/tenants/<tenant>.env from this shape (secrets auto-filled; agent
# tokens left blank for the operator to fill after onboarding).
#
# Bring a tenant up manually with:
#   docker compose -p <tenant> -f docker-compose.tenant.yml --env-file tenants/<tenant>.env up -d

# --- Identity --------------------------------------------------------------
TENANT=example
PUBLIC_IP=127-0-0-1
# Public-hostname label prefix. Normally "<tenant>." (e.g. proton.) so the
# tenant is served at proton.crm.<ip>.nip.io. Set empty (via add-tenant.sh
# --bare, or automatically for the tenant named "default") to serve at the
# bare crm.<ip>.nip.io hostnames. Container aliases are unaffected.
HOST_PREFIX=example.

# --- Secrets (auto-generated per tenant; no single quotes in passwords) -----
CHATWOOT_DB_PASSWORD=changeme
ZAMMAD_DB_PASSWORD=changeme
AGENT_DB_PASSWORD=changeme
BACKEND_DB_PASSWORD=changeme
REDIS_PASSWORD=changeme
SECRET_KEY_BASE=changeme

# --- Agent service config --------------------------------------------------
# Filled by the operator AFTER running the Chatwoot setup wizard and
# generating tokens (see README §5–6). Blank is fine until then.
CHATWOOT_API_TOKEN=
CHATWOOT_PLATFORM_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_BOT_TOKEN=
CHATWOOT_BOT_SECRET=
# Gemini auth: by default both agent + backend use Vertex AI via ADC
# (GOOGLE_GENAI_USE_VERTEXAI=true + VERTEX_PROJECT_ID/LOCATION + GCP_ADC_PATH),
# so GEMINI_API_KEY can be left blank. Only set it to use the AI-Studio path
# (GOOGLE_GENAI_USE_VERTEXAI=false).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_MODE=suggest
# When true, the WhatsApp/agent-bot sources its reply text from the backend
# KB-grounded copilot (/assist/copilot) instead of the local Gemini draft.
# Requires PROTON_BACKEND_URL/KEY set. Off = local draft (unchanged).
KB_GROUNDED_REPLIES=false
AUTO_RESOLVE=false
# Voice-note + image + video understanding for the agent-bot's chat-agent path
# (CHAT_AGENT_ENABLED=true only). Off = today's text-only behavior. When on,
# incoming WhatsApp audio/image/video attachments are downloaded and forwarded
# to backend/'s /chat/turn as multimodal Parts alongside the text.
WHATSAPP_MEDIA_UNDERSTANDING_ENABLED=false
# Inline-media budget for one turn, in RAW (pre-encode) bytes. Applied both to
# a single video and to the turn's combined audio+image+video payload; anything
# over it is dropped and logged, and the turn still proceeds on what remains
# (text only if need be). Default 14 MB: google-genai sends inline_data as
# base64 in a JSON REST body (~1.335x inflation) against Gemini's ~20 MB inline
# request cap, so 14 MB raw is ~18.7 MB on the wire and leaves headroom for the
# conversation history and the system instruction. Do NOT raise this to
# WhatsApp's own 16 MB inbound cap — 16 MB encodes to ~21.4 MB and Gemini
# rejects the request.
WHATSAPP_VIDEO_MAX_BYTES=14680064

# --- Outbound email (optional) ---
# Blank → uses the shared Mailpit catcher (no real delivery). Set these to send
# real mail (agent replies, auto-acks, escalation transcripts, notifications)
# via an SMTP host, e.g. Gmail. NOTE: Gmail needs 2FA + an App Password (enter it
# WITHOUT spaces). This is send-only; a two-way Email inbox is added via the
# Chatwoot UI (Settings → Inboxes → Email) with IMAP + SMTP.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_DOMAIN=gmail.com
SMTP_ENABLE_STARTTLS_AUTO=true
MAILER_SENDER_EMAIL=

# --- Conversation lifecycle & auto-close (agent service) ---
# Master switch. When false the whole feature is a no-op (default).
LIFECYCLE_ENABLED=false
# How often the scanner ticks over open/pending conversations (seconds).
LIFECYCLE_SCAN_INTERVAL_SECONDS=60
# Minutes of customer inactivity before the idle warning is posted.
LIFECYCLE_IDLE_WARN_MINUTES=10
# Grace after the warning before auto-close, IN business hours (10+5=15m total).
LIFECYCLE_IDLE_CLOSE_GRACE_MINUTES=5
# Grace after the warning before auto-close, OUTSIDE business hours (10+0=10m total).
LIFECYCLE_IDLE_CLOSE_OUT_OF_HOURS_GRACE_MINUTES=0
# Minutes to wait for a YES/NO (or rating) reply before treating as resolved.
LIFECYCLE_CONFIRM_GRACE_MINUTES=10
# Auto-resolve a handed-off (assigned) conversation after this many minutes idle,
# so an abandoned handoff self-clears instead of swallowing the customer's later
# messages. 0 = disabled (assigned conversations left entirely to the human).
LIFECYCLE_ASSIGNED_IDLE_RESOLVE_MINUTES=0
# Post the rating survey after resolution.
LIFECYCLE_SURVEY_ENABLED=true
# Post the AI disclaimer/welcome on conversation-created.
LIFECYCLE_DISCLAIMER_ENABLED=true
# Optionally apply a case-category label on bot auto-close (off by default).
LIFECYCLE_AUTO_CATEGORIZE=false

# --- SOP completion (agent service) ---
# Category slugs the bot may assign on resolution (comma-separated); must match
# the tenant's taxonomy. Empty disables auto-categorization even if
# LIFECYCLE_AUTO_CATEGORIZE=true.
LIFECYCLE_CATEGORY_LABELS=
# Email once-per-thread auto-acknowledgement.
EMAIL_AUTOACK_ENABLED=false
# EMAIL_AUTOACK_TEMPLATE has a built-in SOP default; override only to customize.

# EM-7: two-thread email escalation for natively-escalated Email-channel
# conversations. Requires PROTON_BACKEND_URL/KEY (below) to be set --
# fail-open, no-op otherwise. Default off, byte-identical when unset.
EMAIL_ESCALATION_ENABLED=false

# P1: on the first inbound message, stamp received_in_business_hours,
# received_at_local and (when out of hours) attend_after onto the
# conversation. Written once at intake and never overwritten -- a flag
# recomputed at report time answers a different question, because an
# operator can edit the inbox's working hours in between. Feeds the
# after-hours volume reporting. Default off.
BUSINESS_HOURS_STAMP_ENABLED=false

# Suggest-only AI escalation-department nudge: on an incoming customer message
# to an Email-channel conversation with no dept_* label yet, posts a private
# note suggesting one of the departments that has a PIC configured. Never
# applies the label itself. Requires PROTON_BACKEND_URL/KEY (below) -- fail-
# open, no-op otherwise. Default off, byte-identical when unset.
DEPT_SUGGESTION_ENABLED=false

# Customer-facing acknowledgment posted publicly before a human handoff.
# Empty = nothing posted (behaviour-preserving). Set to a tenant greeting.
HANDOFF_DEFAULT_MESSAGE=

# --- Proton fork image & AI-assist -------------------------------------------
# Override to use the patched Chatwoot image. Empty → stock chatwoot/chatwoot:v4.15.1
CHATWOOT_IMAGE=
# Internal (server-side) base URL of this tenant's AI backend, used by the AGENT
# service over the Docker network (no trailing slash). Defaults to the in-stack
# http://<tenant>-backend:8080. Only "proton" tenant has one today; others leave
# blank (feature stays disabled).
PROTON_BACKEND_URL=
# BROWSER-facing backend origin injected into the Chatwoot SPA (window.__PROTON_CONFIG__).
# MUST be an origin the browser can reach — NOT the internal <tenant>-backend host.
# Caddy proxies /metrics,/kb,/assist on this origin to the backend, so setting it to
# the SPA's own origin (the crm vhost) means same-origin calls with no CORS.
# Defaults to http://crm.localhost for local dev; set to the public crm URL in prod.
PROTON_BACKEND_PUBLIC_URL=
# API key matching PROTON_BACKEND_KEY in the backend's Settings.
PROTON_BACKEND_KEY=
# Comma-separated feature flags. Default (when left blank) is the full set
# ai_assist,nav_menu,copilot,knowledge — applied via the compose default so every
# tenant on the custom image gets the Proton UI (Knowledge nav replaces native
# Captain, Ask Copilot panel, ✨ assist). Set an explicit value to override, or
# set to a single space " " to opt a tenant out entirely.
# (copilot = the multi-turn Ask Copilot panel → PROTON_BACKEND_URL/assist/copilot)
PROTON_FEATURES=
# Phase-3 Reporting: Power BI embed URL for the Reports nav item.
# Get this from Power BI Service → Report → File → Embed report → Website or portal.
# Leave blank to show a placeholder (or use a Looker Studio URL as an alternative).
REPORTS_EMBED_URL=

# --- Phase-5 Agent Routing & Presence (set on the proton-conversational-ai backend) ---
# Master switch: true → escalations/handoffs route to an available individual agent
# by per-agent channel priority (with idle-fallback); false (default) keeps the static
# team assignment. Behavior-preserving when off. Backend Settings: routing_enabled.
ROUTING_ENABLED=false
# x-api-key guarding writes to the backend's /routing/priorities (the routing-admin
# dashboard app sends it via ?apiKey=). Empty → writes locked. Setting: routing_admin_api_key.
ROUTING_ADMIN_API_KEY=

# --- Phase-6 Task Timers & Reminders (set on the proton-conversational-ai backend) ---
# x-api-key gating GET /tasks/mine (returns customer PII). Empty → 401 for everyone
# (fail-closed). Required to enable the "My Tasks" dashboard app. Setting: tasks_api_key.
TASKS_API_KEY=
# Minutes before the resolution SLA at which My Tasks warns / a reminder fires.
TASKS_REMINDER_WARNING_MINUTES=60
# true → the SLA scan also sends a WhatsApp reminder (via the global SLA PIC number)
# as a conversation nears its resolution SLA. Requires the backend SLA engine enabled.
TASKS_REMINDER_WHATSAPP_ENABLED=false

# ============================================================================
# AI BACKEND (vendored from proton-conversational-ai; runs as ${TENANT}-backend)
# ----------------------------------------------------------------------------
# Provider selection
CRM_PROVIDER=chatwoot
KNOWLEDGE_PROVIDER=mock                 # mock | zendesk | vertex_search
VOICE_PROVIDER=mock

# Gates /kb/faq admin WRITES only (POST/PUT/DELETE). NOTE: /assist/* (the Ask
# Copilot panel) is gated by PROTON_BACKEND_KEY, set above under "Proton fork
# image & AI-assist" — not this key. The two are independent; /kb/* reads accept
# either. Leave empty to lock FAQ admin writes.
FAQ_ADMIN_API_KEY=

# --- pgvector knowledge base (subsystems A+B; default-off) ---
# NOTE: the Knowledge admin UI's document-upload button (Knowledge > Uploads)
# depends on this being enabled — /kb/knowledge/* routes are only mounted
# when KNOWLEDGE_PG_ENABLED=true AND KNOWLEDGE_DATABASE_URL is set. Left off,
# the upload button now shows a clear "not enabled" message instead of a
# raw 404 (see deploy/chatwoot-fork/patches/0021-knowledge-uploads-native.patch).
KNOWLEDGE_PG_ENABLED=false
KNOWLEDGE_DATABASE_URL=postgresql://backend_example:changeme@postgres:5432/backend_example
KB_CHUNK_SIZE_TOKENS=800
KB_CHUNK_OVERLAP_TOKENS=100
KB_SCORE_FLOOR=0.55
KB_MAX_UPLOAD_BYTES=10485760

# --- RBAC (Phase 1 of own-SLA-audit-RBAC) ---
# Independent Postgres connection, NOT shared with KNOWLEDGE_DATABASE_URL.
# Empty/false -> require_permission falls back to today's shared-secret check
# (FAQ_ADMIN_API_KEY/PROTON_BACKEND_KEY), byte-identical to pre-RBAC behavior.
RBAC_ENABLED=false
RBAC_DATABASE_URL=
# Break-glass bootstrap: Chatwoot user id to auto-assign the seeded
# 'administrator' role to on every startup (idempotent). Without this, a
# fresh RBAC-enabled DB has no way to grant the first admin except direct
# SQL, since POST /authz/roles/{id}/assign itself requires roles.manage.
# Unset (default) = no auto-assignment.
RBAC_BOOTSTRAP_ADMIN_USER_ID=
# The "SLA Policies", "Audit Log", and "Roles & Permissions" admin pages
# (Chatwoot fork patches 0025-0027) all depend on RBAC_ENABLED=true and
# RBAC_DATABASE_URL being set — they reuse the same Postgres connection and
# the same require_permission enforcement Phase 1 added. Without both set,
# these pages are neither mounted server-side nor shown in the nav.

# Gates GET /metrics/{departments,callcenter,lifecycle} (agent/PIC-level report data)
METRICS_API_KEY=

# Gemini / Vertex. Two auth paths (see "GCP credentials" note below):
#   - GOOGLE_GENAI_USE_VERTEXAI=false + a Gemini API key (GOOGLE_API_KEY), or
#   - GOOGLE_GENAI_USE_VERTEXAI=true + GCP Application Default Credentials (set
#     GCP_ADC_PATH below) — this is how the proton backend runs.
# NOTE: GEMINI_MODEL already set above under "Agent service config".
GOOGLE_GENAI_USE_VERTEXAI=false
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# Vertex AI Search — only needed when the knowledge provider is vertex_search.
VERTEX_SEARCH_PROJECT_ID=
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_DATA_STORE_ID=
VERTEX_SEARCH_ENGINE_ID=

# Persistence: memory (default, ephemeral) or firestore (needs GCP creds + DB).
HANDOFF_STORE=memory
SESSION_STORE=memory
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=

# Phase toggles (all default-off / behavior-preserving)
# Routing + task vars already set above under Phase-5/6 sections.
SLA_ENGINE_ENABLED=false
# Per-channel first-response (ack) SLA overrides in MINUTES (JSON object).
# Empty = global SLA_RESPONSE_HOURS for all channels. Example:
# {"whatsapp":2,"call":0.333,"facebook":120,"instagram":120,"email":240}
SLA_ACK_MINUTES_BY_CHANNEL_JSON=
# P1: measure every SLA threshold on the inbox's configured business hours
# instead of the wall clock.
#
#   With this ON, an SLA target of "2 hours" means 2 WORKING hours,
#   measured against this inbox's configured business hours. Your existing
#   configured targets do not need changing -- they were always intended as
#   working-hours targets. A case that arrives at 18:00 Friday will breach a
#   2-hour target on Monday morning, not on Friday evening.
#
# Default off; with it off the arithmetic is byte-identical to before.
# Per-inbox override: the SLA Policies admin page's working_hours_enabled.
SLA_WORKING_HOURS_ENABLED=false
# Let an explicit acknowledgement satisfy the first-response SLA, so
# "acknowledge the customer" (Appendix B B-WA-14, 2 minutes) and "update the
# customer" (B-EM-05, 4 working hours) become two measurable events instead of
# one. The ACKNOWLEDGED transition is written by the agent service's reply
# linker -- see ESCALATION_REPLY_ACKNOWLEDGEMENT_ENABLED, which must also be on
# for anything to record it. Default off = first agent reply is the only
# signal, exactly as before. Can only ever suppress a breach, never create one.
SLA_ACKNOWLEDGEMENT_ENABLED=false
# SLA engine inbox scope: blank = CHATWOOT_INBOX_ID only, "4,5" = those
# inboxes, "*" = all. Email timers need the Email inbox listed here.
SLA_INBOX_IDS=
# SLA breach delivery beyond the WhatsApp ping: email to the department PIC
# group (resolved from the conversation's dept_<slug> label) and a private
# Chatwoot note. Both default false (behavior-preserving).
SLA_ALERT_EMAIL_ENABLED=false
SLA_ALERT_NOTE_ENABLED=false
METRICS_SYNC_ENABLED=false
# Package D risk mitigation: demo-seeded conversations otherwise inflate every
# report. false (default) = byte-identical to today; true = drop conversations
# carrying custom_attributes.demo_seed before they reach BigQuery. Flip to
# true on a tenant that was demo-seeded before any real reporting.
METRICS_EXCLUDE_DEMO_SEED=false

# Escalation / PIC (Phase 2). JSON map dept->PIC; empty disables PIC notify.
PIC_MAP_JSON=

# Escalation reply correlation. Empty disables the reply loop entirely.
# Must be an address that delivers to the tenant's Email inbox mailbox.
ESCALATION_REPLY_TO_TEMPLATE=

# Escalation reply loop (agent). All default off.
ESCALATION_REPLY_LINKING_ENABLED=false
ESCALATION_REPLY_DRAFT_ENABLED=false
# Record an ACKNOWLEDGED transition when a PIC/dealer reply is linked. A PIC
# answering by email IS an acknowledgement, but it left no trace the SLA engine
# could read, so the case kept counting as un-answered. Inert on its own: the
# backend's SLA_ACKNOWLEDGEMENT_ENABLED decides whether any breach reads it.
ESCALATION_REPLY_ACKNOWLEDGEMENT_ENABLED=false

# Escalate on EVERY channel, not just Email (agent). Before this, applying the
# `escalate` label to a WhatsApp/Web/Phone case notified NOBODY and said
# nothing about it -- the label stuck and the operator assumed it had worked.
# Default off preserves the Email-only behaviour exactly.
ESCALATION_ALL_CHANNELS_ENABLED=false
# The acknowledgement posted into the conversation thread when a non-Email case
# is escalated (backend). Blank = post nothing. This message is customer-facing
# and goes out as a normal outgoing reply, not a private note.
ESCALATION_ACK_CHAT_TEMPLATE=

# NOTE: the reply loop also needs `message_created` added to the account
# webhook's subscribed events in Chatwoot (Settings -> Integrations ->
# Webhooks). Without it the agent never sees dealer replies.

# SMTP for BACKEND-sent mail (escalation emails, customer acks, metric reports).
# These are DISTINCT from the Chatwoot SMTP_ADDRESS/SMTP_USERNAME/
# MAILER_SENDER_EMAIL block above: the backend's pydantic Settings reads
# SMTP_HOST/SMTP_USER/SMTP_FROM and ignores Chatwoot's spellings (extra=
# "ignore"), so setting only the Chatwoot names leaves smtp_host empty and
# SmtpEmailSender.send() no-ops SILENTLY — no email, no log line. Set both
# blocks to the same mailbox. SMTP_PORT/SMTP_PASSWORD are shared by name.
SMTP_HOST=
SMTP_USER=
SMTP_FROM=

# Case category/subcategory taxonomy — JSON object keyed by main-category slug:
# {"slug": {"label": "Display Name", "subcategories": ["Sub A", "Sub B"]}}.
# Set the SAME value in both the backend and agent tenant env sections below —
# each service parses it independently (no shared config store between them).
# Empty -> backend/'s classify_ticket_tool falls back to free text, agent/'s
# resolution-time fallback classifier no-ops. Ships with a working default in
# code (see backend config.py) if left unset here — the client's own taxonomy
# from RFP 2026_028's "APPENDIX A - Case Categorisation" (8 divisions: Sales,
# Product, Network, Charging, Apps, After Sales, Others, Marketing; see
# docs/client-materials/RFP 2026_028/case-categorisation.json for the full
# transcription). Level 2 (with Level 3/4 folded in) is a SEPARATE var, below.
CASE_TAXONOMY_JSON=

# Vehicle-model / case-type dimensions (Inquiry/Complaint/Compliment &
# Feedback). Same fail-open pattern as CASE_TAXONOMY_JSON; set the SAME value
# in both the backend and agent tenant env sections.
VEHICLE_MODELS_JSON=
CASE_TYPE_OPTIONS_JSON=

# Case-detail dimension — RFP 2026_028 Appendix A's Level 2, with Level 3/4
# folded into each value (em dash-joined). Flat {"options": [str, ...]} shape
# like CASE_TYPE_OPTIONS_JSON/VEHICLE_MODELS_JSON above, each value prefixed
# against the FULL case_subcategory value ("<Division>: <Level 1>: <Level
# 2>[ — <Level 3>[ — <Level 4>]]") — see agent/app/config.py's
# CASE_DETAIL_OPTIONS_JSON docstring for the full convention and why. Same
# fail-open pattern; set the SAME value in both the backend and agent tenant
# env sections. Ships with a working default in code (246 values covering
# 258 of the RFP's 300 rows) if left unset here. The Chatwoot "case_detail"
# custom attribute definition that renders this as a third cascading sidebar
# dropdown is provisioned by chatwoot-config/provision_case_taxonomy.py, not
# by this env var directly — see that script's docstring.
CASE_DETAIL_OPTIONS_JSON=

# SOP resolution-time targets in working hours, per case_type (backend only —
# only the metrics sync/BigQuery-view side needs this).
RESOLUTION_SLA_TARGETS_JSON=

# RSA (roadside assistance) incident log — own Postgres table, default-off.
# Needs BOTH flags to activate (mirrors KNOWLEDGE_PG_ENABLED/RBAC_ENABLED).
RSA_ENABLED=false
RSA_DATABASE_URL=

# DMS/TSP integration shell (Package F) — DEMO DATA SWITCH. Phase 1 ships no
# real DMS adapter, so this is the only thing that can put records in Customer
# 360's optional `dms` block, and those records are fabricated ("(Demo data)"
# markers in every field, `"mock": true` on the block). Set true ONLY for a
# demo; on a real customer's panel it must stay false. Off (default) leaves
# the block reading "unreachable"/not connected, which is the correct state
# until a Phase 2 adapter exists.
# The integration's actual connection config (enabled / base URL / credential
# / timeout) is NOT set here — operators edit it in the CRM's Integrations >
# DMS / TSP card and it is stored per-tenant in Firestore. The credential is
# write-only: settable and replaceable, never readable back.
DMS_MOCK_CLIENT_ENABLED=false

# GCP Application Default Credentials (ADC). Host path to a readable
# application_default_credentials.json (from `gcloud auth application-default
# login`) or a service-account JSON. The backend service bind-mounts it read-only
# at /gcp/adc.json and sets GOOGLE_APPLICATION_CREDENTIALS to it. Leave EMPTY to
# run without GCP (mock/off providers). Required when GOOGLE_GENAI_USE_VERTEXAI=
# true, KNOWLEDGE_PROVIDER=vertex_search, or HANDOFF_STORE/SESSION_STORE=firestore.
GCP_ADC_PATH=
# ============================================================================

# --- GCP credentials (per-tenant) ---
# The AI backend reaches Gemini/Vertex/Firestore via ADC. Point GCP_ADC_PATH
# (above) at a credentials JSON on the host; the compose backend service mounts
# it and exports GOOGLE_APPLICATION_CREDENTIALS automatically. Alternatively run
# GOOGLE_GENAI_USE_VERTEXAI=false with a Gemini API key and leave GCP_ADC_PATH
# empty. Each tenant needs its own project / data store / Firestore DB — do NOT
# point two tenants at the same FIRESTORE_PROJECT_ID + FIRESTORE_DATABASE_ID.

# CC the dealer's "relevant personnel" (DealerRecord.cc_emails) on the dealer
# forward. Default FALSE, unlike ESCALATION_CC_PIC's default of true: this mail
# carries the full transcript to an address outside the company, so widening
# its recipient list must be deliberate. A CC entry equal to the customer's own
# address is always dropped, flag on or off.
ESCALATION_CC_DEALER=false
# Byte budget for attachments carried into the PIC/dealer escalation mail
# (photos of the damaged part, PDFs). 0 = feature off, and off costs not even
# an API call. Applies to the whole mail, not per file. Newest attachments win
# when it cannot fit everything, and whatever was left out is described in the
# body rather than silently dropped. The customer acknowledgement NEVER carries
# attachments. Suggested starting value: 10485760 (10 MB).
ESCALATION_ATTACHMENT_BUDGET_BYTES=0
# Post a private note on the conversation when an escalation leg fails to send
# (§4.39, SMTP half). Without it, a failed escalation is only a log line: the
# operator sees the `escalate` label and assumes the PIC was told. The note is
# ALWAYS private -- the customer must never be shown our SMTP problems.
# NOTE: this covers send failures only. Bounces and invalid recipients need a
# bounce mailbox (client question Q6) and are NOT handled.
ESCALATION_FAILURE_NOTE_ENABLED=false
# Consult Chatwoot agent availability when escalating, so an offline PIC's
# online colleagues are told too. Can only ever WIDEN the recipient list -- the
# PIC is always included, and every failure (presence unreachable, PIC not a
# Chatwoot agent) falls back to notifying everyone. Off by default: it costs an
# extra API call per escalation.
ESCALATION_PRESENCE_CHECK_ENABLED=false

# Notice when an escalation email BOUNCED (agent). §4.39's other half: the
# send-failure note covers SMTP refusing the handoff, this covers SMTP
# accepting it and the recipient's server rejecting it minutes later.
# No bounce mailbox needed -- the delivery-status notification comes back to
# this tenant's own Email inbox, where it was previously filed as an unread
# conversation. Notes the failure on the case that caused it and resolves the
# DSN conversation so it stops inflating the SLA backlog.
BOUNCE_HANDLING_ENABLED=false

# --- P3: case record fields -------------------------------------------------
# The case-record panel (vehicle plate/chassis, purchased-from dealer, delay
# reason, the three WIP notes) and its GET/PATCH endpoints. Off = the
# endpoints 404. The SIDEBAR PANEL ITSELF needs no fork patch: these are
# ordinary Chatwoot conversation custom attributes, so run
# `chatwoot-config/provision_case_record_fields.py` once per tenant and
# Chatwoot renders the panel natively.
CASE_FIELDS_ENABLED=false
# Attach a coverage note to any report block grouped by one of these sparse,
# agent-entered fields. ON by default, unlike every other flag here: a chart
# built on a half-filled column that does not say so invites exactly the wrong
# conclusion.
REPORT_COVERAGE_DISCLOSURE=true

# Addresses this platform must NEVER send to, comma-separated. Enforced inside
# SmtpEmailSender, so no routing record, env var, stale automation rule or
# hand-typed CC can get past it. Not cosmetic: sustained delivery failures to a
# dead domain get the sending mail account rate-limited or suspended, which
# takes every real escalation down with it.
EMAIL_BLOCKED_RECIPIENTS=

# --- P4: reporting -----------------------------------------------------------
# The calendar the report buckets use. UTC (the default) is the IDENTITY
# TRANSFORM: view DDL is byte-identical to pre-P4, so no existing dashboard
# number moves. CHANGING THIS RE-BUCKETS EVERY HISTORICAL FIGURE on every chart
# the next time ensure_views() runs -- a case created 23:00 MYT lands in the
# next UTC day, so cases shift between adjacent weeks. Run
# scripts/compare-reporting-timezone.py first and keep the output.
# Allowed: UTC, Asia/Kuala_Lumpur, Asia/Jakarta, Asia/Singapore, Asia/Bangkok.
REPORTING_TIMEZONE=UTC
# Count reopens (agent). A reopen is a resolved -> not-resolved transition and
# nothing else. `reopen_count` has been a warehouse column and a v_reopen_rate
# view since Phase 3 with NOTHING writing it, so the reopen rate has been a
# chart of zeroes that renders perfectly. Default off.
REOPEN_TRACKING_ENABLED=false

# --- P5: control-item slide --------------------------------------------------
# The 14-metric control-item page (C1 p48) and its targets store. Nine rows
# render from real data; five report "not measured" WITH A REASON, never zero.
# A zero would be a claim about performance; a blank is a statement about
# instrumentation.
CONTROL_ITEMS_ENABLED=false
# Seed targets from RESOLUTION_SLA_TARGETS_JSON at startup. Creates only --
# never overwrites an operator edit, so an operator who tightens a target does
# not have it reverted on the next restart.
TARGETS_SEED_ENABLED=false

# --- P6: agent presence, custom statuses & workforce dashboard --------------
# Seven independent flags (all default false, backend Settings). A first
# deploy with all seven off is behavior-preserving: routing_enabled (set
# above under Phase-5) is untouched by this package and still defaults off.
#
# true -> a poller runs every PRESENCE_POLL_SECONDS, diffs each agent's
# Chatwoot presence against the last known value, and appends a presence
# event on change. This is the primitive every other flag below depends on
# -- leave it off and the rest of this section is inert. Setting:
# presence_tracking_enabled.
PRESENCE_TRACKING_ENABLED=false
# true -> the eight-status catalogue (Available, Busy, Lunch, Break,
# Coaching, Training, Toilet, Prayer) can be SELECTED by agents, and
# added to/edited by administrators, through the /routing/presence endpoints
# (features/routing/status_router.py). Off means the three native Chatwoot
# statuses only: those endpoints answer {"disabled": true} and write nothing.
# Each named status still mirrors into a native one, so routing keeps
# excluding unavailable agents even if this is off or the custom-status store
# is down.
#   The agent-facing "My status" page that drives those endpoints ships in
#   fork patch 0054, which has NOT been verified against a real Chatwoot
#   checkout yet (see docs/analysis/2026-08-09-blocked-work-register.md). The
#   API is usable before that build goes green; the UI is not, so do not
#   promise agents the page until it has.
#   This flag is NOT a prerequisite for ACW_ENABLED or
#   PRESENCE_THRESHOLD_ALERTS_ENABLED: the catalogue resolves from built-in
#   defaults even on a tenant where nothing was ever seeded, which is what
#   stopped ACW-only tenants from logging custom_status_set_unknown_key
#   forever. It only gates SELECTING and EDITING statuses.
# Setting: presence_custom_statuses_enabled.
PRESENCE_CUSTOM_STATUSES_ENABLED=false
# true -> an agent unavailable past PRESENCE_WARN_MINUTES/
# PRESENCE_ESCALATE_MINUTES triggers the 10-minute and 1-hour alerts.
# Requires PRESENCE_TRACKING_ENABLED to have anything to measure against.
# Note which statuses actually alert: the away-from-desk ones an agent picks
# (Lunch, Break, Toilet, Prayer). Chatwoot's own native Busy and Offline
# never do -- Busy is an agent working, Offline is an agent off shift -- so
# an account that never enables PRESENCE_CUSTOM_STATUSES_ENABLED will see no
# alerts at all, correctly, because it has no way to record an absence.
# Setting: presence_threshold_alerts_enabled.
PRESENCE_THRESHOLD_ALERTS_ENABLED=false
# true -> a call ending places the agent into an After-Call-Work status
# instead of immediately being routable again. Independent of
# PRESENCE_CUSTOM_STATUSES_ENABLED (see that flag's note).
# Setting: acw_enabled.
ACW_ENABLED=false
# true -> pick_agent chooses the eligible agent with the fewest open
# conversations within a tier (tie-broken by least-recently-assigned)
# instead of today's first-match-in-iteration-order pick. Setting:
# routing_fair_share_enabled.
ROUTING_FAIR_SHARE_ENABLED=false
# true -> a sweeper periodically assigns unassigned conversations older than
# ROUTING_SWEEP_MIN_AGE_SECONDS, on top of the existing event-driven
# assignment at handoff time. Setting: routing_sweep_enabled.
ROUTING_SWEEP_ENABLED=false
# true -> the conversation panel exposes an operator-settable follow-up date
# (distinct from the SLA deadline), feeding the existing /tasks/mine reminder
# machinery. Setting: follow_up_date_enabled.
FOLLOW_UP_DATE_ENABLED=false
# Poller interval, seconds. 60s is a deliberate compromise: the thresholds
# below are 10 minutes and 1 hour, so tighter polling buys no decision-
# relevant precision, only more Chatwoot API calls.
PRESENCE_POLL_SECONDS=60
# Minutes unavailable before the agent + admin get the first alert.
PRESENCE_WARN_MINUTES=10
# Minutes unavailable before the admin gets the escalated alert, with the
# agent's WIP list attached.
PRESENCE_ESCALATE_MINUTES=60
# Seconds an agent may stay in After-Call-Work before being auto-exited back
# to routable, so a forgotten wrap-up state can't trap them out of routing.
ACW_TIMEOUT_SECONDS=120
# Minimum age (seconds) an unassigned conversation must reach before the
# sweeper (ROUTING_SWEEP_ENABLED) will pick it up. Must comfortably exceed
# the event-driven assignment path's own latency, or the sweeper and that
# path race each other for the same conversation.
ROUTING_SWEEP_MIN_AGE_SECONDS=120
# How often the sweeper itself ticks, seconds.
ROUTING_SWEEP_INTERVAL_SECONDS=60

# --- P7: AI conversational quality ------------------------------------------
# Nine settings (backend only -- agent/ is untouched by this package), all
# default-off/default-zero. A tenant that sets none of these gets
# byte-identical behaviour to before P7: sentiment stays unclassified, no
# translate action exists, FAQ ranking is pure semantic search, media
# attachments get today's generic instruction, and nothing is
# auto-summarised or indexed on resolve.
#
# true -> classify sentiment (positive/neutral/negative/urgent) on every turn
# as an extra argument on the existing per-turn Gemini call (never a second
# round-trip) and write it to session_state plus a conversation custom
# attribute, which the existing ticket-creation gate and API response
# already read. Off = sentiment stays unclassified (None), exactly as today.
SENTIMENT_CLASSIFIER_ENABLED=false
# true -> replace the static "## Tone" persona paragraph with one selected by
# the current sentiment (operator-editable in Knowledge Settings). Inert
# without SENTIMENT_CLASSIFIER_ENABLED above. Off = the static paragraph,
# unchanged.
SENTIMENT_TONE_ADJUSTMENT_ENABLED=false
# true -> enables the agent-facing translate action (POST /assist/translate):
# lets an agent who does not read a customer's language render an inbound
# message into their own, on demand, as a private note. Off = no translate
# action exists.
TRANSLATION_ENABLED=false
# true -> lets the bot send OUTBOUND replies to customers in Tamil. NOT
# symmetric with TRANSLATION_ENABLED above: inbound Tamil translation (so an
# agent can READ a Tamil message) works today via TRANSLATION_ENABLED alone
# and is low-risk. Outbound Tamil is unverified machine translation reaching
# a customer directly in a regulated automotive-support context, and ships
# disabled pending an evaluation of 30 real Tamil enquiries scored by a
# Tamil speaker. Do not enable this just because TRANSLATION_ENABLED is on --
# they answer different questions. Keep false until that evaluation is
# signed off by the client.
TRANSLATION_OUTBOUND_TAMIL_ENABLED=false
# Weight (float) given to a keyword-overlap score against the authored FAQ
# `keywords` field, blended into FAQ ranking alongside cosine similarity.
# 0.0 is not merely "off": it is required to reproduce today's ranking
# EXACTLY, entry for entry and score for score -- that equivalence is the
# safety argument for shipping hybrid ranking onto a live tenant. Raise it
# only after the calibration evaluation set shows a net improvement (a large
# weight regresses the common case -- semantic search, which works today --
# to fix the rare one -- exact codes like e.MAS7 that embed poorly).
FAQ_KEYWORD_WEIGHT=0.0
# true -> shows a transient, dismissible FAQ-suggestion strip above the
# fork's composer when a suggestion's confidence exceeds a threshold. Off =
# side panel only -- an agent's typing path is left alone by default.
FAQ_SUGGESTION_POPUP_ENABLED=false
# true -> appends a media-diagnosis instruction (describe what's visible,
# name the likely fault, state a confidence level, ask at most one follow-up
# question) whenever an image/video attachment reaches the model. Off =
# today's generic instruction, unchanged.
MEDIA_DIAGNOSIS_PROMPT_ENABLED=false
# true -> indexes a resolved conversation's SUMMARY (never its transcript)
# into its own pgvector namespace, separate from the authored FAQ corpus, so
# it can be purged independently of curated content and its suggestions
# labelled in the panel as machine-generated rather than approved guidance.
# This is a PII mitigation, not PII masking (the real fix is gap R16,
# separately tracked) -- off by default for that reason. Off = nothing
# indexed.
RESOLVED_CASE_INDEX_ENABLED=false
# true -> fires the existing agent-triggered POST /assist/summarize
# automatically on the resolve event and posts the summary as a private
# note; a case resolved, reopened and resolved again appends a second
# summary rather than overwriting the first. Off = summaries stay
# agent-triggered only, exactly as today.
AUTO_SUMMARY_ON_RESOLVE_ENABLED=false
