sync:
    uv sync

test:
    uv run pytest -q

test-live:
    uv run pytest -q -m live

lint:
    uv run ruff check .

web:
    uv run adk web adk_apps

serve agent="uc2":
    LOGISLY_AGENT={{agent}} PORT=8078 uv run python serve.py

# Deploy one agent to Cloud Run: just deploy agent=uc2
deploy agent="uc2":
    ./deploy.sh {{agent}}
